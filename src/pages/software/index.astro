---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import { formatReviewMonth, softwareCategories, softwareVendors } from '../../data/operator-software';

// Static hints for the repository's AutoRelated generator.
const autoRelatedMetadata = {
  title: 'Maine Cannabis Software Directory',
  section: 'Operations & Technology',
};
const topics = ['operator-guide', 'software'];

const categoryCards = [
  {
    title: 'Cannabis POS & retail systems',
    description: 'Compare Flowhub, Dutchie, Cova, Treez, BLAZE, Meadow, and other retail platforms through a Maine operator lens.',
    href: '/guides/maine-cannabis-pos-comparison',
    label: 'Existing in-depth guide',
  },
  ...softwareCategories.map((entry) => ({
    title: entry.title,
    description: entry.answer,
    href: `/software/${entry.slug}`,
    label: 'Category guide',
  })),
];

const faqs = [
  {
    question: 'Does MDG rank cannabis software vendors?',
    answer: 'Not in this release. These pages organize vendor choices, public product information, Maine-specific questions, limitations, and official sources. Inclusion is not an endorsement or a best-of ranking.',
  },
  {
    question: 'Are the vendor links affiliate links?',
    answer: 'No active compensated vendor link is represented at launch. Several vendors publish referral or partner programs. If MDG activates one, the applicable page and link will carry a clear disclosure.',
  },
  {
    question: 'Can software guarantee Maine cannabis compliance?',
    answer: 'No. Software can support inventory, tasks, records, and integrations, but the licensed operator remains responsible for current OCP rules, municipal requirements, accurate reporting, and professional advice where needed.',
  },
  {
    question: 'How often are these pages reviewed?',
    answer: 'Each page shows its last-reviewed date and official source list. Software features, state availability, pricing, partner programs, and terms can change, so material buying decisions should be confirmed directly with the vendor.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Maine Cannabis Business Software Directory',
  description: 'Independent category guides and vendor profiles for Maine cannabis operators.',
  url: Astro.url.href,
  hasPart: [
    ...categoryCards.map((item) => ({ '@type': 'WebPage', name: item.title, url: new URL(item.href, Astro.url).href })),
    ...softwareVendors.map((item) => ({ '@type': 'WebPage', name: item.title, url: new URL(`/software/${item.slug}`, Astro.url).href })),
  ],
};
---

<Layout
  title="Maine Cannabis Business Software Directory"
  description="Independent software category guides and vendor profiles for Maine dispensaries, cultivators, manufacturers, wholesalers, and prospective operators."
  topics={['cannabis business software', 'Maine cannabis operators', 'dispensary technology']}
  tags={['operator resources', 'software directory', 'vendor comparisons']}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="software-hub">
    <header class="hub-hero">
      <div class="hero-copy">
        <p class="eyebrow">Maine operator resource center</p>
        <h1>Choose cannabis software with clearer questions.</h1>
        <p class="dek">Independent guides to POS, CRM, ecommerce, compliance, ERP, wholesale, and market-intelligence platforms—built for Maine operators and people planning a licensed cannabis business.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#categories">Find software by job</a>
          <a class="button button-secondary" href="#vendors">Browse vendor profiles</a>
        </div>
      </div>
      <aside class="decision-card" aria-label="Software buying principles">
        <p class="kicker">Before the sales demo</p>
        <ol>
          <li><span>1</span>Map the real workflow.</li>
          <li><span>2</span>Verify Maine support.</li>
          <li><span>3</span>Price the whole stack.</li>
          <li><span>4</span>Protect data portability.</li>
        </ol>
      </aside>
    </header>

    <section class="trust-strip" aria-label="Editorial standards">
      <div><strong>Independent</strong><span>Compensation does not determine coverage.</span></div>
      <div><strong>Maine-specific</strong><span>State and municipal realities stay visible.</span></div>
      <div><strong>Source-linked</strong><span>Material claims point to official pages.</span></div>
      <div><strong>Decision-first</strong><span>Limitations and switching questions are included.</span></div>
    </section>

    <section id="categories" class="hub-section" aria-labelledby="categories-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start with the operational job</p>
          <h2 id="categories-title">Seven software categories</h2>
        </div>
        <p>Do not compare a POS, CRM, state tracking system, and market-data platform as if they solve the same problem. Start with the workflow, then build the shortlist.</p>
      </div>
      <div class="category-grid">
        {categoryCards.map((item, index) => (
          <a class:list={['category-card', index === 0 && 'category-card--featured']} href={item.href}>
            <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="card-label">{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="card-action">Open guide <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <section id="vendors" class="hub-section vendor-section" aria-labelledby="vendors-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Initial profile set</p>
          <h2 id="vendors-title">Six vendor profiles</h2>
        </div>
        <p>These are detailed orientation pages, not paid rankings. Each profile covers operator fit, buying questions, limitations, official sources, and the current public referral-program status.</p>
      </div>
      <div class="vendor-grid">
        {softwareVendors.map((vendor) => (
          <article class="vendor-card">
            <div class="vendor-topline">
              <span>{vendor.eyebrow.replace('Vendor profile · ', '')}</span>
              <span>Reviewed {formatReviewMonth(vendor.reviewedDate)}</span>
            </div>
            <h3>{vendor.title}</h3>
            <p>{vendor.answer}</p>
            <div class="vendor-footer">
              <span class:list={['relationship-badge', vendor.referral && 'relationship-badge--program']}>
                {vendor.referral ? 'Public referral path found' : 'No program verified'}
              </span>
              <a href={`/software/${vendor.slug}`}>Read profile <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="method-section" aria-labelledby="method-title">
      <div class="method-copy">
        <p class="eyebrow">Editorial method</p>
        <h2 id="method-title">Useful before monetized.</h2>
        <p>MDG may earn referral revenue in the future, but the content must stand on its own first. A commercial relationship will never purchase a ranking, remove a limitation, or replace the operator’s own due diligence.</p>
        <a href="/about/editorial-policy">Read MDG’s editorial policy <span aria-hidden="true">→</span></a>
      </div>
      <div class="method-rules">
        <article>
          <span>01</span>
          <h3>No hidden relationships</h3>
          <p>Commissions, credits, sponsorships, free access, and material vendor support will be disclosed on the affected page.</p>
        </article>
        <article>
          <span>02</span>
          <h3>No unsupported “best” claims</h3>
          <p>A vendor is not called best without a published method, consistent evidence, and a clearly defined operator use case.</p>
        </article>
        <article>
          <span>03</span>
          <h3>No compliance guarantee</h3>
          <p>Software supports workflows. Maine OCP rules, local requirements, accurate records, and operator judgment remain controlling.</p>
        </article>
      </div>
    </section>

    <section class="local-intelligence" aria-labelledby="local-intelligence-title">
      <p class="eyebrow">Where MDG is different</p>
      <h2 id="local-intelligence-title">National software cannot replace Maine market context.</h2>
      <p>MDG’s software directory explains the vendor landscape. The planned Maine Cannabis Market Watch will address a different gap: municipal authorization, licenses, zoning, moratoria, local fees, market density, state metrics, and source-linked changes.</p>
      <div class="local-links">
        <a class="button" href="/market-stats">Explore Maine market statistics <span aria-hidden="true">→</span></a>
        <a class="button" href="/guides/maine-cannabis-opt-in-tracker">Open the municipal opt-in tracker <span aria-hidden="true">→</span></a>
        <a class="button" href="/guides/maine-cannabis-vendor-directory">Browse the broader vendor directory <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <p class="eyebrow">Directory questions</p>
      <h2 id="faq-title">Frequently asked questions</h2>
      <Faq faqs={faqs} />
    </section>

    <footer class="hub-footer">
      <p><strong>Current commercial status:</strong> No active compensated software-vendor link is represented in this launch. Public referral and partner opportunities are documented on relevant profiles so MDG can evaluate them transparently.</p>
      <p>Last directory review: 2026-07-21. Vendor products, pricing, state support, integrations, and referral terms can change.</p>
    </footer>
  </div>
</Layout>

<style>
  .software-hub {
    --hub-ink: var(--color-text);
    --hub-forest: var(--color-primary);
    --hub-teal: var(--color-link);
    --hub-paper: var(--color-surface);
    --hub-cream: var(--color-surface-2);
    --hub-gold: var(--color-accent);
    width: min(100% - 2rem, 1220px);
    margin: 0 auto;
    padding: 2rem 0 5rem;
    color: var(--color-text, var(--hub-ink));
  }

  .hub-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.75fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4.8rem);
    border-radius: 18px;
    background:
      linear-gradient(125deg, color-mix(in srgb, var(--color-on-secondary) 5%, transparent), transparent 42%),
      var(--color-secondary);
    box-shadow: var(--elev-3-shadow);
  }

  .eyebrow,
  .kicker {
    margin: 0 0 0.75rem;
    color: var(--hub-teal);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hub-hero .eyebrow {
    color: var(--color-accent);
  }

  .hub-hero h1,
  .hub-section h2,
  .method-section h2,
  .local-intelligence h2,
  .faq-section h2 {
    margin: 0;
    font-family: var(--font-serif);
    line-height: 1.02;
    text-wrap: balance;
  }

  .hub-hero h1 {
    max-width: 820px;
    color: var(--color-on-secondary);
    font-size: clamp(2.7rem, 6.5vw, 5.8rem);
    font-weight: 650;
    letter-spacing: -0.05em;
  }

  .dek {
    max-width: 780px;
    margin: 1.5rem 0 0;
    color: var(--color-on-secondary);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.7rem;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.05rem;
    border: 2px solid var(--color-on-secondary);
    border-radius: 9px;
    font-weight: 800;
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-on-secondary);
    color: var(--color-cream-ink);
  }

  .button-secondary {
    color: var(--color-on-secondary);
  }

  .button:focus-visible,
  .software-hub a:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .decision-card {
    padding: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--color-on-secondary) 18%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-on-secondary) 8%, transparent);
    backdrop-filter: blur(8px);
  }

  .decision-card .kicker {
    color: var(--color-on-secondary);
  }

  .decision-card ol {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decision-card li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 0.7rem;
    align-items: center;
    color: var(--color-on-secondary);
    font-weight: 750;
  }

  .decision-card li span {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-on-secondary) 28%, transparent);
    border-radius: 50%;
    color: var(--color-accent);
    font-family: var(--font-serif);
  }

  .trust-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 1rem 0 0;
    border: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent);
    border-radius: 12px;
    background: var(--hub-paper);
  }

  .trust-strip div {
    display: grid;
    gap: 0.25rem;
    padding: 1.15rem;
    border-right: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
  }

  .trust-strip div:last-child {
    border-right: 0;
  }

  .trust-strip strong {
    color: var(--hub-forest);
    font-family: var(--font-serif);
    font-size: 1.08rem;
  }

  .trust-strip span {
    color: var(--color-text-light);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .hub-section,
  .method-section,
  .local-intelligence,
  .faq-section {
    margin-top: 5rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.6rem;
  }

  .hub-section h2,
  .method-section h2,
  .local-intelligence h2,
  .faq-section h2 {
    color: var(--hub-ink);
    font-size: clamp(2.1rem, 4.5vw, 4rem);
    letter-spacing: -0.035em;
  }

  .section-heading > p,
  .method-copy > p,
  .local-intelligence > p,
  .vendor-card p,
  .method-rules p,
  .hub-footer p {
    color: var(--color-text-light);
    line-height: 1.68;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .category-card {
    position: relative;
    display: grid;
    min-height: 330px;
    grid-template-rows: auto auto auto 1fr auto;
    gap: 0.75rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
    border-radius: 14px;
    background: var(--hub-paper);
    color: var(--hub-ink);
    text-decoration: none;
    box-shadow: var(--elev-1-shadow);
  }

  .category-card--featured {
    grid-column: 1 / -1;
    min-height: 260px;
    background: linear-gradient(135deg, var(--color-surface-2), var(--color-surface) 64%);
  }

  .card-index {
    position: absolute;
    top: 1.2rem;
    right: 1.4rem;
    color: var(--color-text-light);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
  }

  .card-label {
    color: var(--hub-teal);
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .category-card h3,
  .vendor-card h3,
  .method-rules h3 {
    max-width: 88%;
    margin: 0;
    color: var(--hub-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 2.5vw, 2.05rem);
    line-height: 1.12;
  }

  .category-card p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--color-text-light);
    line-height: 1.62;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .card-action {
    color: var(--hub-teal);
    font-weight: 850;
  }

  .category-card:hover,
  .category-card:focus-visible {
    border-color: color-mix(in srgb, var(--color-link) 50%, transparent);
    box-shadow: var(--elev-2-shadow);
    transform: translateY(-2px);
  }

  .vendor-section {
    padding: clamp(1.4rem, 4vw, 3.2rem);
    border-radius: 18px;
    background: var(--color-surface-2);
  }

  .vendor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .vendor-card {
    display: grid;
    min-height: 330px;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.9rem;
    padding: 1.45rem;
    border-top: 5px solid var(--hub-forest);
    border-radius: 8px 8px 12px 12px;
    background: var(--color-surface);
  }

  .vendor-topline,
  .vendor-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    justify-content: space-between;
  }

  .vendor-topline {
    color: var(--color-text-light);
    font-size: 0.75rem;
    font-weight: 750;
    text-transform: capitalize;
  }

  .vendor-card h3 {
    max-width: 100%;
  }

  .vendor-footer a,
  .method-copy a,
  .local-links a {
    color: var(--hub-teal);
    font-weight: 850;
  }

  .relationship-badge {
    padding: 0.35rem 0.55rem;
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-text-light);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .relationship-badge--program {
    background: color-mix(in srgb, var(--color-primary) 10%, var(--color-surface));
    color: var(--color-link);
  }

  .method-section {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(1.6rem, 5vw, 4rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
    border-radius: 18px;
    background: var(--hub-paper);
  }

  .method-rules {
    display: grid;
    gap: 0;
  }

  .method-rules article {
    display: grid;
    grid-template-columns: 50px 1fr;
    column-gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .method-rules article:first-child {
    border-top: 0;
  }

  .method-rules span {
    grid-row: 1 / 3;
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-weight: 700;
  }

  .method-rules h3,
  .method-rules p {
    margin: 0;
  }

  .method-rules h3 {
    max-width: none;
  }

  .local-intelligence {
    padding: clamp(1.7rem, 5vw, 4rem);
    border-radius: 18px;
    background: var(--color-secondary);
  }

  .local-intelligence .eyebrow {
    color: var(--color-on-secondary);
  }

  .local-intelligence h2 {
    max-width: 900px;
    color: var(--color-on-secondary);
  }

  .local-intelligence > p:not(.eyebrow) {
    max-width: 820px;
    color: var(--color-on-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .local-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .local-intelligence .local-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0.65rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-on-secondary) 28%, transparent);
    border-radius: 8px;
    color: var(--color-on-secondary);
    text-decoration: none;
  }

  .faq-section {
    max-width: 900px;
    margin-right: auto;
    margin-left: auto;
  }

  .hub-footer {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.4rem;
    border-top: 2px solid color-mix(in srgb, var(--color-primary) 16%, transparent);
    font-size: 0.9rem;
  }

  .hub-footer p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .hub-hero,
    .section-heading,
    .method-section {
      grid-template-columns: 1fr;
    }

    .decision-card {
      max-width: 520px;
    }

    .trust-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-strip div:nth-child(2) {
      border-right: 0;
    }
  }

  @media (max-width: 680px) {
    .software-hub {
      width: min(100% - 1rem, 1220px);
      padding-top: 1rem;
    }

    .hub-hero,
    .vendor-section,
    .method-section,
    .local-intelligence {
      border-radius: 12px;
    }

    .category-grid,
    .vendor-grid,
    .hub-footer,
    .trust-strip {
      grid-template-columns: 1fr;
    }

    .category-card--featured {
      grid-column: auto;
    }

    .trust-strip div {
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
    }

    .trust-strip div:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card {
      transition: none;
    }

    .category-card:hover,
    .category-card:focus-visible {
      transform: none;
    }
  }
</style>
