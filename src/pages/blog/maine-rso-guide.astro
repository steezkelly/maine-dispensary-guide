const topics = ["rso", "medical", "concentrates"];

const faqItems = [
  { question: "What is RSO used for?", answer: "RSO is most commonly used by Maine patients for chronic pain, severe insomnia, chemotherapy-induced nausea, MS spasticity, and as a general-purpose full-spectrum cannabis oil for patients who want the entire cannabinoid and terpene profile of the plant in a single product. The original Rick Simpson protocol promoted RSO as a treatment for skin cancer and other conditions; the modern clinical consensus is that RSO is a useful symptomatic tool for the conditions above, but it is not a cure for cancer or any other disease. Buyer beware of any source that claims RSO cures cancer, multiple sclerosis, Crohn's disease, or any other specific condition — the research does not support those claims, and Maine medical providers will not prescribe RSO as a curative therapy." },
  { question: "How do you take RSO?", answer: "RSO is taken orally, typically by dispensing a small amount (rice-grain-sized for the standard dose, slightly larger for a stronger dose) from the syringe under the tongue, or onto a piece of food. Sublingual administration produces faster onset (15-30 minutes) than swallowing directly. The onset for swallowed RSO is 45-90 minutes, with a peak at 2-3 hours and a duration of 6-10 hours. RSO is also sometimes applied topically for localized skin conditions, though the research on topical RSO efficacy is limited. Do not smoke or vape RSO; the formulation is too viscous for vaporization and combustion destroys the minor cannabinoids." },
  { question: "Is RSO legal in Maine?", answer: "Yes. RSO is legal under both the Maine medical cannabis program (MMMP) and the adult-use program, and it is sold at licensed dispensaries throughout the state. Medical patients purchase RSO under the provider-discretion model of Title 22 ch. 558-C and have access to higher-dose RSO products (often at 50-80% THC in 1g syringes), paying the 5.5% state sales tax rather than the 14% adult-use sales-tax rate. Adult-use customers can purchase RSO subject to the general Title 28-B §703 packaging constraints; because RSO is sold as a concentrate, the per-serving and per-package edible caps in §703(1)(F) (10mg/200mg) do not apply to RSO syringes in the same way. The practical adult-use ceiling is set by the operator's packaging — most Maine adult-use RSO is sold as 1g syringes that the buyer self-measures in grain-of-rice increments. There is no Maine-specific restriction on RSO format or potency beyond the standard OCP product safety and labeling rules." },
  { question: "How much RSO should a beginner take?", answer: "A beginner should start at a rice-grain-sized dose of RSO (approximately 25-50mg of RSO, containing roughly 15-30mg of THC depending on the potency of the specific product) and wait a full 24 hours before taking more. The 24-hour window is the original Rick Simpson protocol and remains the modern standard for a first-time RSO user, because the full effect of a single dose can take 12-24 hours to fully resolve. After the initial dose, a beginner can increase by a similar rice-grain amount every 2-3 days, building slowly toward the target therapeutic dose. The risk of overconsumption is real; RSO is highly concentrated, and a 1g syringe contains 500-800mg of THC at typical potency. The dosing discipline matters more than the product." },
  { question: "How do I tell real RSO from fake RSO?", answer: "Real RSO is dark brown to black, has a thick sticky consistency that holds its shape in the syringe, and has a strong cannabis aroma that often includes a sharp solvent note (ethanol) that fades after the cure is complete. The COA on real RSO will show a total THC content of 50-80% with a meaningful minor cannabinoid profile (CBD, CBG, CBN, CBC) and a total terpene content of 2-6%. Fake RSO — usually distillate with re-added cannabis-derived terpenes, or distillate cut with coconut oil or MCT — is lighter in color, more liquid, and has a COA showing 85-95% THC with little or no terpene or minor cannabinoid content. The visual difference is real and the COA difference is definitive. If a product is labeled RSO but the COA looks like distillate, it is not RSO." }
];

const faqPageSchema = {
  "@context": "https://schema.org",
