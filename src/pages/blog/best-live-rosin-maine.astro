import authors from '../../data/authors.json';
const editorialAuthor = authors.find(a => a.id === 'thalia-greene');
const complianceReviewer = authors.find(a => a.id === 'eliot-nash');
const article = {
  author: "Thalia Greene",
  authorId: "thalia-greene",
  authorTitle: "Cultivation & Horticulture Reviewer",
  publishDate: "2026-06-05",
  modifiedDate: "2026-06-05",
  section: "Cultivation & Products"
};
const topics = ["concentrates", "live-rosin", "solventless"];

const faqItems = [
  { question: "What is live rosin?", answer: "Live rosin is a solventless cannabis concentrate made by separating trichomes from fresh-frozen cannabis plant material using ice water (the resulting product is called bubble hash or ice-water hash), then pressing the hash at low temperature with a rosin press to extract the cannabinoids and terpenes. The 'live' refers to the fresh-frozen starting material — the plant is frozen immediately after harvest rather than dried and cured, which preserves the terpene profile that would otherwise degrade during the drying process. No chemical solvents (butane, propane, CO2) are used at any point in the process, which is what makes rosin a solventless extract and what justifies the price premium over BHO or distillate." },
  { question: "Is live rosin better than live resin?", answer: "Solventless live rosin is generally considered the highest-quality cannabis concentrate available. The production process preserves more of the original terpene profile than hydrocarbon extraction (which uses butane or propane as a solvent and then strips the solvent through purging), and it leaves no residual solvent at detectable levels. Live resin (a hydrocarbon extract made from fresh-frozen material) preserves terpenes better than BHO made from dried flower, but the solvent purging process still costs some volatile compounds. For buyers who prioritize flavor and full-spectrum effect, live rosin is the right answer. For buyers who prioritize price per milligram of THC, distillate is a better value." },
  { question: "Why is live rosin so expensive in Maine?", answer: "Live rosin is expensive because the production economics are unforgiving. The fresh-frozen starting material yields only 2-5% rosin by weight (compared to 15-25% for a BHO extraction), the ice-water hash process requires specialized equipment and dedicated labor, the rosin press is a slow-batch operation, and the labor cost of solventless production runs 2-3x the cost of hydrocarbon extraction. A pound of fresh-frozen flower that produces 15-20g of rosin costs the same as a pound that produces 60-100g of BHO. The price premium — typically 2-3x distillate and 1.5-2x live resin in Maine dispensaries — reflects the underlying cost of production, not retailer markup." },
  { question: "How can I tell if my rosin is good quality?", answer: "Good live rosin has four visual and sensory markers: (1) color should be light blonde to amber, not dark brown or black (darker rosin has been exposed to heat, oxidation, or low-quality starting material); (2) consistency should be budder, badder, or jam — a wet, glossy, scoopable texture that holds its shape; (3) the cold cure should pull away cleanly from parchment; (4) the aroma should be loud and strain-specific, not flat or burnt. If your rosin is dark, dry, crumbly, or has a hay/burnt taste, it is either old, was made from low-grade material, or was over-pressed at high temperatures. The COA on every batch should show a total terpene content of 5-15% — a rosin with less than 3% terpenes is a sign of degraded starting material." },
  { question: "What is a hash hole in Maine?", answer: "A hash hole is an infused pre-roll that uses a rosin wrap (a thin sheet of pressed rosin) around the outside of a joint, often with rosin and kief added to the inside of the joint as well. The result is a high-potency, high-terpene infused pre-roll that produces a more flavorful and more intense effect than a standard flower pre-roll. The format is popular in Maine because the state's rosin producers (Firestorm, HIGHLY Cannaco, SeaWeed Co., Cannabis Cured) all sell rosin wraps or pre-rolled hash holes at the standard 1g pre-roll size. Expect to pay 2-3x the price of a standard pre-roll — a hash hole runs $20-30 in Maine, versus $8-12 for a flower-only pre-roll." }
];

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer.replace(/<[^>]+>/g, "")
    }
  }))
};
