---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
import optInData from '../data/maine-opt-in-towns.json';
import gscSummary from '../data/gsc-search-demand-summary.json';

const article = {
  author: "Eliot Nash",
  authorId: "eliot-nash",
  authorTitle: "Market & Real Estate Analyst",
  publishDate: "2026-07-07",
  modifiedDate: "2026-08-11",
  section: "Market Research"
};

type Town = {
  town: string;
  county: string;
  type: string;
  year_opted_in: number | null;
  license_fee_usd: number | null;
  dispensaries_operating: number | null;
  notes: string;
};
const meta = optInData.meta as { as_of: string; town_count: number; counties_covered: number; source: string; source_url: string; license: string; last_updated: string };
const towns: Town[] = optInData.towns as Town[];

// Public GSC aggregate only. Query-level records remain in private operational storage.
const totalImpressions = gscSummary.totalImpressions;
const totalClicks = gscSummary.totalClicks;
const totalQueries = gscSummary.uniqueQueryCount;

// Town-by-town aggregations
const townsByYear: Record<number, number> = {};
for (const t of towns) {
  if (t.year_opted_in) townsByYear[t.year_opted_in] = (townsByYear[t.year_opted_in] || 0) + 1;
}
const yearEntries = Object.entries(townsByYear).sort();

const townsByFee = [...towns].filter(t => t.license_fee_usd).sort((a, b) => (b.license_fee_usd || 0) - (a.license_fee_usd || 0));
const totalOperating = towns.reduce((s, t) => s + (t.dispensaries_operating || 0), 0);
const totalFeeRevenue = towns.reduce((s, t) => s + (t.license_fee_usd || 0), 0);

// Counties
const townsByCounty: Record<string, number> = {};
for (const t of towns) {
  townsByCounty[t.county] = (townsByCounty[t.county] || 0) + 1;
}
const topCounties = Object.entries(townsByCounty).sort((a, b) => b[1] - a[1]).slice(0, 8);
---

<Layout 
  title="Maine Cannabis Market Pulse 2026 — Original Research" 
  description="The first annual Maine Cannabis Market Pulse — original data synthesis on municipal opt-ins, search demand, license fees, and operator economics. Free to cite under CC BY 4.0."
  heroImage="/images/heroes/ocp-license-map.jpg"
  article={article}
  isHub={true}
>
<style>
  .article-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .article-header h1 { margin-bottom: 0.5rem; }
  .lead { font-size: 1.25rem; color: var(--color-text-light); margin-top: 1rem; }
  .byline { font-size: 0.875rem; color: var(--color-text-light); margin-top: 1rem; }
  section { margin-bottom: 3rem; }
  section h2 { color: var(--color-text); font-family: var(--font-serif); margin-bottom: 1rem; }
  section h3 { margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--color-text); }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; margin: 1.5rem 0; }
  .stat-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1.25rem; text-align: center; }
  .stat-card .num { font-size: 2rem; font-weight: 700; color: var(--color-text); font-family: var(--font-serif); line-height: 1; }
  .stat-card .label { font-size: 0.875rem; color: var(--color-text-light); margin-top: 0.5rem; }
  .data-table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.875rem; }
  .data-table th, .data-table td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--color-border); text-align: left; }
  .data-table th { background: var(--color-surface); font-weight: 600; }
  .data-table tr:hover { background: var(--color-surface); }
  .bar-chart { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.5rem; padding: 1.25rem; margin: 1rem 0; }
  .bar-row { display: grid; grid-template-columns: 140px 1fr 60px; align-items: center; gap: 0.75rem; margin: 0.4rem 0; font-size: 0.875rem; }
  .bar { background: var(--color-primary); height: 1.25rem; border-radius: 0.125rem; }
  .citation { font-family: monospace; background: var(--color-surface); padding: 0.5rem 0.75rem; border-radius: 0.25rem; font-size: 0.875rem; }
  .methodology { background: var(--color-disclaimer-bg); border: 1px solid var(--color-disclaimer-border); padding: 1rem 1.25rem; border-radius: 0.5rem; margin: 1.5rem 0; }
  .methodology h3 { margin-top: 0; }
  ul { padding-left: 1.5rem; }
  li { margin-bottom: 0.5rem; }
  .share-buttons { display: flex; gap: 0.75rem; margin: 1.5rem 0; }
  .share-buttons a { padding: 0.5rem 1rem; background: #143027; color: white; text-decoration: none; border-radius: 0.375rem; font-size: 0.875rem; }
</style>

<div class="article-header">
  <h1>Maine Cannabis Market Pulse 2026</h1>
  <p class="lead">The first annual original-research synthesis on Maine's cannabis market — municipal opt-ins, search demand, license fees, and operator economics, in one place.</p>
  <p class="byline">By Eliot Nash &amp; Margaret Finch · Published July 7, 2026 · Maine Dispensary Guide · Cite as: Nash &amp; Finch, 2026</p>
</div>

<Callout title="Free to Cite" type="passion">
  All data in this report is released under <strong>CC BY 4.0</strong>. Journalists, researchers, and trade publications are encouraged to use, republish, and adapt with attribution to <a href="https://mainedispensaryguide.com">mainedispensaryguide.com</a>. For the underlying data, see the <a href="/for-journalists">For Journalists</a> page.
</Callout>

<nav class="toc" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.5rem; padding: 1.25rem; margin: 1.5rem 0;">
  <h2 style="margin-top: 0; font-size: 1.125rem;">On This Page</h2>
  <ul style="columns: 2; column-gap: 2rem;">
    <li><a href="#headline">Headline Numbers</a></li>
    <li><a href="#opt-in-timeline">Opt-In Timeline</a></li>
    <li><a href="#license-fees">License Fees</a></li>
    <li><a href="#county-breakdown">County Breakdown</a></li>
    <li><a href="#search-demand">Search Demand</a></li>
    <li><a href="#methodology">Methodology</a></li>
  </ul>
</nav>

<section id="headline">
  <h2>Headline Numbers</h2>
  <div class="stat-grid">
    <div class="stat-card"><div class="num">{meta.town_count}</div><div class="label">OCP-authorized incorporated municipalities statewide</div></div>
    <div class="stat-card"><div class="num">{totalOperating}</div><div class="label">Active adult-use Store licenses linked to authorized municipalities</div></div>
    <div class="stat-card"><div class="num">${totalFeeRevenue.toLocaleString()}</div><div class="label">Sum of known municipal fee values in the 21-row detail subset (not revenue)</div></div>
    <div class="stat-card"><div class="num">{meta.counties_covered}</div><div class="label">Maine counties represented in the statewide authorization model</div></div>
    <div class="stat-card"><div class="num">{totalQueries.toLocaleString()}</div><div class="label">Unique queries in the multi-snapshot GSC aggregate</div></div>
    <div class="stat-card"><div class="num">{totalImpressions.toLocaleString()}</div><div class="label">Aggregate search impressions observed on MDG</div></div>
  </div>

  <h3>What this means in one paragraph</h3>
  <p>Maine's adult-use cannabis market is a <strong>patchwork of {meta.town_count} OCP-authorized incorporated municipalities</strong> spanning all {meta.counties_covered} counties, with {totalOperating} active adult-use Store licenses linked to those municipalities in the roster retrieved 2026-08-11. Municipal fee details are independently retained for 21 rows only: within that detail subset, the average listed fee is <strong>${Math.round(totalFeeRevenue / towns.filter(t => t.license_fee_usd).length).toLocaleString()}</strong>, ranging from $750 to $5,000. The reviewed GSC aggregate shows recurring search demand for Maine cannabis information, but does not publish individual query text or infer a single reporting-period trend.</p>
</section>

<section id="opt-in-timeline">
  <h2>Verified Opt-In Years in the 21-Row Detail Subset</h2>
  <p>The chart below is <strong>not</strong> a statewide authorization timeline. It shows only the 21 municipalities for which this dataset retains an independently reviewed opt-in year. The other 57 authorized municipalities remain in the statewide table with a null year until that field is verified; they are not silently excluded from the authorization count.</p>

  <div class="bar-chart">
    {yearEntries.map(([year, count]) => (
      <div class="bar-row">
        <span style="font-weight: 600;">{year}</span>
        <div class="bar" style={`width: ${(count / Math.max(...yearEntries.map(([_, c]) => c))) * 100}%;`}></div>
        <span style="text-align: right; color: var(--color-text-light);">{count} {count === 1 ? 'town' : 'towns'}</span>
      </div>
    ))}
  </div>

  <p class="citation">Source: MDG 2026 Opt-In Tracker. Statewide authorization count: {meta.town_count} of Maine's 485 incorporated municipalities. Timeline coverage: 21 rows with a verified opt-in year; 57 authorized rows have year=null pending verification.</p>
</section>

<section id="license-fees">
  <h2>Known Municipal License Fees — 21-Row Detail Subset</h2>
  <p>Independently retained municipal fee values in this dataset range from $750 to $5,000. These 21 values are a reviewed detail subset, not comprehensive statewide fee coverage; the other 57 authorized rows use <code>null</code> rather than an estimate.</p>

  <div class="bar-chart">
    {townsByFee.slice(0, 12).map(t => (
      <div class="bar-row">
        <span>{t.town}</span>
        <div class="bar" style={`width: ${((t.license_fee_usd || 0) / 5000) * 100}%;`}></div>
        <span style="text-align: right; color: var(--color-text-light);">${(t.license_fee_usd || 0).toLocaleString()}</span>
      </div>
    ))}
  </div>

  <h3>Key fee-related statistics</h3>
  <ul>
    <li><strong>Median known fee:</strong> ${townsByFee.map(t => t.license_fee_usd!).sort((a, b) => a - b)[Math.floor(townsByFee.length / 2)].toLocaleString()}</li>
    <li><strong>Average known fee:</strong> ${Math.round(totalFeeRevenue / townsByFee.length).toLocaleString()}</li>
    <li><strong>Sum of known fee values:</strong> ${totalFeeRevenue.toLocaleString()} across 21 reviewed rows (not municipal revenue collected)</li>
    <li><strong>Highest known fee:</strong> Portland ($5,000) — also the most active Store licenses (27, OCP roster retrieved 2026-08-11)</li>
    <li><strong>Lowest known fee:</strong> Gardiner, Presque Isle, Winslow, and Wiscasset ($750 each)</li>
  </ul>

  <p>For perspective: a $2,500 license fee in a market like Bangor (10 active adult-use store licenses) is a very different cost equation than a $1,000 fee in Sanford (4 licenses). The fee structure does not always match market saturation.</p>
</section>

<section id="county-breakdown">
  <h2>County Breakdown — Authorized Municipalities by County</h2>
  <p>All 16 counties contain at least one OCP-authorized incorporated municipality. York leads with nine, followed by Kennebec with eight; Penobscot and Oxford each have seven. These are authorization counts, not store counts.</p>

  <div class="bar-chart">
    {topCounties.map(([county, count]) => (
      <div class="bar-row">
        <span>{county}</span>
        <div class="bar" style={`width: ${(count / Math.max(...topCounties.map(([_, c]) => c))) * 100}%;`}></div>
        <span style="text-align: right; color: var(--color-text-light);">{count} {count === 1 ? 'town' : 'towns'}</span>
      </div>
    ))}
  </div>

  <p>The full table on <a href="/for-journalists#opt-in-data">For Journalists</a> lists all {meta.town_count} authorized municipalities and their linked active Store counts.</p>
</section>

<section id="search-demand">
  <h2>Search Demand — Aggregate Signal</h2>
  <p>MDG's public research summary combines {gscSummary.snapshotCount} historical GSC exports, recording <strong>{totalQueries.toLocaleString()} unique queries</strong>, {totalImpressions.toLocaleString()} impressions, and {totalClicks} clicks. It is a multi-snapshot aggregate, not a single reporting window. Individual query text remains private operational data and is not published in this report.</p>

  <div class="stat-grid">
    <div class="stat-card"><div class="num">{totalQueries.toLocaleString()}</div><div class="label">Unique queries in the aggregate snapshot</div></div>
    <div class="stat-card"><div class="num">{totalImpressions.toLocaleString()}</div><div class="label">Aggregate impressions</div></div>
    <div class="stat-card"><div class="num">{totalClicks.toLocaleString()}</div><div class="label">Aggregate clicks</div></div>
  </div>

  <p>These numbers describe demand observed on MDG pages, not total Maine-cannabis search volume. Query-level data is used privately for editorial and technical analysis; publication requires a separately reviewed aggregate.</p>
</section>

<section id="methodology">
  <div class="methodology">
    <h3>Methodology &amp; Data Sources</h3>
    <p><strong>Authorization data:</strong> Complete statewide universe of {meta.town_count} incorporated municipalities where the OCP municipal model (refreshed 2026-07-09) records adult-use retail authorization. The canonical model covers 485 cities, towns, and plantations; it does not classify an OCP activity flag of N as an evidence-backed opt-out without primary local evidence.</p>
    <p><strong>License fees and opt-in years:</strong> Independently retained for 21 reviewed rows only. The other 57 authorized rows use null rather than an estimate. Fee values describe local schedules, not municipal revenue collected; confirm current amounts with the town clerk.</p>
    <p><strong>Store counts:</strong> Distinct active adult-use Store license IDs in the OCP roster retrieved 2026-08-11 (the source URL filename says 2026-07-01; OCP's HTTP Last-Modified was 2026-08-10), grouped by canonical host municipality with documented place-name normalization. Pending, conditional, expired, and non-Store licenses are excluded; roster locations that conflict with the authorization model are excluded pending reconciliation.</p>
    <p><strong>Search demand data:</strong> A reviewed multi-snapshot aggregate from MDG's Google Search Console exports, published {gscSummary.publishedAt}; it is not a single reporting window. It reports counts only; raw query text is retained in private operational storage and is not published. The figures describe impressions on MDG, not total Maine-cannabis search volume.</p>
    <p><strong>License:</strong> All data in this report is released under CC BY 4.0. Cite as: Nash, E. &amp; Finch, M. (2026). <em>Maine Cannabis Market Pulse 2026.</em> Maine Dispensary Guide. mainedispensaryguide.com/market-pulse-2026.</p>
    <p><strong>Caveats:</strong> This is observational data, not a controlled study. Numbers are point-in-time snapshots. Maine's regulatory environment changes frequently; verify current status with the OCP and individual town clerks before relying on any specific figure for a business decision.</p>
  </div>
</section>

<section>
  <h2>How to Cite This Report</h2>
  <p>Three suggested citation formats, ordered by length:</p>

  <p class="citation">Nash, E. &amp; Finch, M. (2026). <em>Maine Cannabis Market Pulse 2026.</em> Maine Dispensary Guide. mainedispensaryguide.com/market-pulse-2026</p>

  <p class="citation">Maine Dispensary Guide's 2026 Market Pulse records {meta.town_count} OCP-authorized incorporated municipalities across all 16 counties, linked to {totalOperating} active adult-use Store licenses in the OCP roster retrieved August 11, 2026 (mainedispensaryguide.com, August 2026).</p>

  <p class="citation">According to the 2026 Maine Cannabis Market Pulse, {meta.town_count} of Maine's 485 incorporated municipalities are recorded as authorized for adult-use retail. The full statewide table includes Store-license counts for every authorized municipality; municipal fee and opt-in-year details are independently populated for 21 rows and null elsewhere rather than estimated.</p>

  <p class="citation" style="margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-text-light);">For the sales-volume, transaction-count, and tax-revenue context that this opt-in dataset complements — $246.4M adult-use retail sales in 2025 across 4.84M transactions, $43.72M in AUCP state revenue, and the Jan 1, 2026 tax reset — see the companion <a href="/market-stats">Maine Cannabis Market Stats 2026</a> hub.</p>
</section>

<Callout title="Want the raw data?" type="info">
  The full opt-in dataset is at <a href="/for-journalists">/for-journalists</a> with an embeddable widget and JSON API. For the GSC-derived query aggregations or the underlying spreadsheets, contact us at <a href="mailto:press@mainedispensaryguide.com">press@mainedispensaryguide.com</a>.
</Callout>

</Layout>
