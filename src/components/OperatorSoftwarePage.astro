---
import Layout from '../layouts/Layout.astro';
import Faq from './Faq.astro';
import { formatReviewMonth, softwareEntries, type SoftwareEntry } from '../data/operator-software';

interface Props {
  entry: SoftwareEntry;
}

const { entry } = Astro.props;
const reviewedLabel = formatReviewMonth(entry.reviewedDate);
const relatedEntries = entry.relatedSlugs
  .map((slug) => softwareEntries.find((candidate) => candidate.slug === slug))
  .filter((candidate): candidate is SoftwareEntry => Boolean(candidate));
const pageUrl = Astro.url.href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.title,
  description: entry.description,
  dateModified: entry.reviewedDate,
  datePublished: entry.reviewedDate,
  mainEntityOfPage: pageUrl,
  author: {
    '@type': 'Organization',
    name: 'Maine Dispensary Guide Editorial Team',
    url: new URL('/about', Astro.url).href,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Maine Dispensary Guide',
    url: new URL('/', Astro.url).href,
  },
  citation: entry.sources.map((item) => item.url),
};
const referralLabels = {
  'cash-referral': 'Public cash referral program',
  'customer-credit': 'Public customer referral reward',
  'partner-application': 'Partner or referral application',
  none: 'No public referral program verified',
};
---

<Layout
  title={entry.title}
  description={entry.description}
  topics={['cannabis business software', 'Maine cannabis operators', entry.kind]}
  tags={['operator resources', 'software comparison', entry.kind]}
  breadcrumbs={[
    { label: 'Software', href: '/software' },
    { label: entry.kind === 'vendor' ? 'Vendor profile' : 'Category guide', href: `/software/${entry.slug}` },
  ]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="software-page">
    <header class="software-hero">
      <p class="eyebrow">{entry.eyebrow}</p>
      <h1>{entry.title}</h1>
      <p class="answer">{entry.answer}</p>
      <div class="hero-meta" aria-label="Page details">
        <span>Independent editorial profile</span>
        <span>Reviewed {reviewedLabel}</span>
        <span>Maine operator focus</span>
      </div>
      <div class="hero-actions">
        {entry.officialUrl && (
          <a class="button button-primary software-outbound" href={entry.officialUrl} rel="nofollow noopener" target="_blank">
            Visit official website <span aria-hidden="true">↗</span>
          </a>
        )}
        <a class="button button-secondary" href="/software">Browse all software</a>
      </div>
    </header>

    <aside class="editorial-standard" aria-labelledby="editorial-standard-title">
      <div>
        <p class="kicker" id="editorial-standard-title">How to use this page</p>
        <p>Use it to prepare a shortlist and a better vendor demo. Verify current pricing, Maine availability, integrations, and contract terms directly before buying.</p>
      </div>
      <a href="/about/editorial-policy">Editorial policy</a>
    </aside>

    {entry.evidence && (
      <section class="evidence-snapshot" aria-labelledby="evidence-title">
        <div class="evidence-intro">
          <p class="kicker">Evidence boundary</p>
          <h2 id="evidence-title">What MDG could verify publicly</h2>
          <p>{entry.evidence.evaluationStatus}</p>
        </div>
        <div class="evidence-grid">
          <article>
            <h3>Pricing status</h3>
            <p>{entry.evidence.pricingStatus}</p>
          </article>
          <article>
            <h3>Vendor-specific evidence</h3>
            <ul>
              {entry.evidence.publicEvidence.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </section>
    )}

    {entry.referral && (
      <section class="referral-panel" aria-labelledby="referral-title">
        <div class="referral-heading">
          <p class="kicker">Commercial transparency</p>
          <h2 id="referral-title">{referralLabels[entry.referral.kind]}</h2>
        </div>
        <p>{entry.referral.summary}</p>
        <p class="relationship"><strong>No active MDG commercial relationship.</strong> Maine Dispensary Guide is not currently representing an approved, tracked, or compensated relationship with this vendor.</p>
        {entry.referral.officialUrl && (
          <a class="text-link software-program-link" href={entry.referral.officialUrl} rel="nofollow noopener" target="_blank">
            Read the vendor’s public program terms <span aria-hidden="true">↗</span>
          </a>
        )}
      </section>
    )}

    <div class="software-body">
      {entry.sections.map((section, index) => (
        <section id={section.id} class:list={['content-section', index % 3 === 1 && 'content-section--tinted']}>
          <div class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
          <div class="section-copy">
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="checklist">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </div>
        </section>
      ))}
    </div>

    {entry.comparison && (
      <section class="comparison-section" aria-labelledby="comparison-title">
        <div class="section-intro">
          <p class="kicker">Shortlist builder</p>
          <h2 id="comparison-title">Platforms worth evaluating</h2>
          <p>Public positioning is a starting point, not a ranking. Ask each vendor to demonstrate the same Maine-specific workflow.</p>
        </div>
        <div class="comparison-grid">
          {entry.comparison.map((row) => (
            <article class="comparison-card">
              <h3>{row.name}</h3>
              <p class="best-for"><strong>Best starting fit:</strong> {row.bestFor}</p>
              <p>{row.notes}</p>
              {row.profileSlug ? (
                <a href={`/software/${row.profileSlug}`}>Read MDG profile <span aria-hidden="true">→</span></a>
              ) : row.officialUrl ? (
                <a class="software-outbound" href={row.officialUrl} rel="nofollow noopener" target="_blank">Official website <span aria-hidden="true">↗</span></a>
              ) : null}
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="demo-script" aria-labelledby="demo-script-title">
      <p class="kicker">Bring this to the sales call</p>
      <h2 id="demo-script-title">Five questions every Maine operator should ask</h2>
      <ol>
        <li><span>01</span><p>Show the exact Maine workflow from opening through reconciliation—not a generic dashboard.</p></li>
        <li><span>02</span><p>Itemize every recurring, transactional, implementation, hardware, messaging, and support charge.</p></li>
        <li><span>03</span><p>Explain which system owns inventory, customer, consent, product, cost, and audit records.</p></li>
        <li><span>04</span><p>Provide the export, cancellation, and migration procedure in writing before the contract is signed.</p></li>
        <li><span>05</span><p>Identify which claims are live today in Maine and which are roadmap, partner, or custom-development work.</p></li>
      </ol>
    </section>

    <section class="faq-wrap" aria-labelledby="faq-heading">
      <p class="kicker">Operator questions</p>
      <h2 id="faq-heading">Frequently asked questions</h2>
      <Faq faqs={entry.faqs} />
    </section>

    <section class="sources-section" aria-labelledby="sources-title">
      <div class="section-intro">
        <p class="kicker">Primary-source record</p>
        <h2 id="sources-title">Sources</h2>
        <p>Material product and program claims were checked against these official pages on {entry.reviewedDate}. Vendor pages and terms can change.</p>
      </div>
      <ol>
        {entry.sources.map((item) => (
          <li>
            <a class="software-outbound" href={item.url} rel="nofollow noopener" target="_blank">{item.title} <span aria-hidden="true">↗</span></a>
            <span>Accessed {item.accessed}</span>
          </li>
        ))}
      </ol>
    </section>

    {relatedEntries.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <p class="kicker">Continue comparing</p>
        <h2 id="related-title">Related software guides</h2>
        <div class="related-grid">
          {relatedEntries.map((related) => (
            <a href={`/software/${related.slug}`}>
              <span>{related.kind === 'vendor' ? 'Vendor profile' : 'Category guide'}</span>
              <strong>{related.title}</strong>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="editorial-footer">
      <p><strong>Editorial independence:</strong> Compensation never determines inclusion, rankings, or conclusions. No product on this page is presented as “best” without a published, repeatable methodology.</p>
      <p>This business information is not legal advice. Verify current Maine OCP rules, municipal requirements, contracts, and professional guidance for your operation.</p>
    </footer>
  </article>

</Layout>

<style>
  .software-page {
    --software-ink: var(--color-text);
    --software-forest: var(--color-primary);
    --software-teal: var(--color-link);
    --software-paper: var(--color-surface);
    --software-cream: var(--color-surface-2);
    --software-gold: var(--color-accent);
    width: min(100% - 2rem, 1180px);
    margin: 0 auto;
    padding: 2rem 0 5rem;
    color: var(--color-text, var(--software-ink));
  }

  .software-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4.75rem);
    border: 1px solid color-mix(in srgb, var(--software-forest) 24%, transparent);
    border-radius: 18px;
    background:
      radial-gradient(circle at 88% 14%, color-mix(in srgb, var(--software-gold) 24%, transparent) 0 12%, transparent 13%),
      linear-gradient(145deg, var(--color-surface-2) 0%, var(--software-paper) 58%, color-mix(in srgb, var(--color-primary) 10%, var(--color-surface)) 100%);
    box-shadow: var(--elev-2-shadow);
  }

  .software-hero::after {
    position: absolute;
    right: -2rem;
    bottom: -5rem;
    width: 16rem;
    height: 16rem;
    border: 2px solid color-mix(in srgb, var(--software-forest) 18%, transparent);
    border-radius: 50%;
    content: '';
  }

  .eyebrow,
  .kicker {
    margin: 0 0 0.75rem;
    color: var(--software-teal);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .software-hero h1 {
    position: relative;
    z-index: 1;
    max-width: 930px;
    margin: 0;
    color: var(--software-ink);
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 6vw, 5.1rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .answer {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 1.5rem 0 0;
    color: var(--color-text-light);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.7;
  }

  .hero-meta,
  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero-meta {
    margin-top: 1.5rem;
  }

  .hero-meta span {
    padding: 0.45rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    color: var(--color-text-light);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .hero-actions {
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0.78rem 1.05rem;
    border: 2px solid var(--software-forest);
    border-radius: 9px;
    font-weight: 800;
    text-decoration: none;
  }

  .button-primary {
    background: var(--software-forest);
    color: var(--color-on-primary);
  }

  .button-secondary {
    background: transparent;
    color: var(--software-forest);
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--elev-1-shadow);
  }

  .button:focus-visible,
  .software-page a:focus-visible {
    outline: 3px solid var(--software-gold);
    outline-offset: 3px;
  }

  .editorial-standard {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: center;
    margin: 1rem 0 2rem;
    padding: 1.2rem 1.35rem;
    border-left: 5px solid var(--software-gold);
    background: var(--color-surface-2);
  }

  .editorial-standard p:last-child {
    margin: 0;
    color: var(--color-text-light);
  }

  .editorial-standard a,
  .text-link {
    color: var(--software-teal);
    font-weight: 800;
  }

  .evidence-snapshot {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    margin: var(--space-xl) 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-editorial-md);
    background: var(--color-surface-2);
  }

  .evidence-intro h2,
  .evidence-grid h3 {
    margin: 0 0 var(--space-sm);
    color: var(--color-text);
    font-family: var(--font-serif);
  }

  .evidence-intro h2 {
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: var(--leading-tight);
  }

  .evidence-intro p:last-child,
  .evidence-grid p,
  .evidence-grid li {
    color: var(--color-text-light);
    line-height: var(--leading-normal);
  }

  .evidence-grid {
    display: grid;
    gap: var(--space-md);
  }

  .evidence-grid article {
    padding: var(--space-lg);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
  }

  .evidence-grid h3 {
    font-size: var(--text-xl);
  }

  .evidence-grid ul {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding-left: var(--space-lg);
  }

  .referral-panel {
    margin: 2rem 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid color-mix(in srgb, var(--color-link) 25%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
  }

  .referral-panel h2,
  .section-copy h2,
  .section-intro h2,
  .demo-script h2,
  .faq-wrap h2,
  .related-section h2 {
    margin: 0 0 0.8rem;
    color: var(--software-ink);
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: 1.12;
  }

  .relationship {
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-link) 18%, transparent);
  }

  .software-body {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
  }

  .content-section {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: clamp(1rem, 3vw, 2.3rem);
    padding: clamp(1.5rem, 4vw, 3.3rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 13%, transparent);
    border-radius: 14px;
    background: var(--software-paper);
  }

  .content-section--tinted {
    background: var(--color-surface-2);
  }

  .section-number {
    color: var(--color-text-light);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .section-copy {
    max-width: 820px;
  }

  .section-copy p,
  .section-intro p,
  .comparison-card p,
  .demo-script p,
  .editorial-footer p {
    color: var(--color-text-light);
    line-height: 1.72;
  }

  .checklist {
    display: grid;
    gap: 0.7rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .checklist li {
    position: relative;
    padding-left: 1.8rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .checklist li::before {
    position: absolute;
    top: 0.1rem;
    left: 0;
    color: var(--software-teal);
    content: '✓';
    font-weight: 900;
  }

  .comparison-section,
  .demo-script,
  .faq-wrap,
  .sources-section,
  .related-section {
    margin-top: 3.5rem;
  }

  .section-intro {
    max-width: 780px;
    margin-bottom: 1.4rem;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .comparison-card {
    padding: 1.45rem;
    border-top: 5px solid var(--software-forest);
    border-radius: 8px 8px 12px 12px;
    background: var(--color-surface);
    box-shadow: var(--elev-1-shadow);
  }

  .comparison-card h3 {
    margin: 0 0 0.7rem;
    color: var(--software-ink);
    font-family: var(--font-serif);
    font-size: 1.45rem;
  }

  .comparison-card a,
  .related-grid a {
    color: var(--software-teal);
    font-weight: 800;
  }

  .best-for {
    min-height: 4.9rem;
  }

  .demo-script {
    padding: clamp(1.5rem, 4vw, 3.2rem);
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .demo-script .kicker,
  .demo-script h2 {
    color: var(--color-text);
  }

  .demo-script ol {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .demo-script li {
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .demo-script li span {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-weight: 700;
  }

  .demo-script li p {
    margin: 0;
    color: var(--color-text-light);
  }

  .sources-section {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid color-mix(in srgb, var(--color-primary) 13%, transparent);
    border-radius: 12px;
    background: var(--color-surface-2);
  }

  .sources-section ol {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding-left: 1.4rem;
  }

  .sources-section li {
    padding-left: 0.35rem;
    color: var(--color-text-light);
  }

  .sources-section li span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.82rem;
  }

  .sources-section a {
    color: var(--software-teal);
    font-weight: 750;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .related-grid a {
    display: grid;
    min-height: 150px;
    grid-template-rows: auto 1fr auto;
    gap: 0.6rem;
    padding: 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 16%, transparent);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--software-ink);
    text-decoration: none;
  }

  .related-grid a > span:first-child {
    color: var(--software-teal);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-grid .arrow {
    color: var(--software-gold);
    font-size: 1.35rem;
  }

  .editorial-footer {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.4rem;
    border-top: 2px solid color-mix(in srgb, var(--color-primary) 16%, transparent);
    font-size: 0.92rem;
  }

  .editorial-footer p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .software-page {
      width: min(100% - 1rem, 1180px);
      padding-top: 1rem;
    }

    .software-hero {
      border-radius: 12px;
    }

    .editorial-standard,
    .evidence-snapshot,
    .content-section,
    .comparison-grid,
    .related-grid,
    .editorial-footer {
      grid-template-columns: 1fr;
    }

    .editorial-standard {
      align-items: start;
    }

    .content-section {
      gap: 0.5rem;
    }

    .section-number {
      font-size: 1rem;
    }

    .best-for {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button:hover,
    .button:focus-visible {
      transform: none;
    }
  }
</style>
