---
/**
 * AnimatedBackdrop.astro — GPU-friendly animated SVG background.
 *
 * Pure-CSS layered backdrop for hero sections and the site header:
 *   1. Aurora — slow-drifting blurred radial blobs (42-70s loops)
 *   2. Pine ridge — static horizon silhouette
 *   3. Fireflies — ~28 staggered particle dots
 *
 * Variants: "hero" (all 3 layers), "subtle" (aurora only — for header).
 *
 * Honors prefers-reduced-motion and [data-theme="dark"] via existing tokens.
 *
 * Usage:
 *   <AnimatedBackdrop variant="hero" />               // homepage hero
 *   <AnimatedBackdrop variant="subtle" intensity={0.4} />  // header
 */

interface Props {
  variant?: "hero" | "subtle";
  /** Overall opacity multiplier, 0..1. */
  intensity?: number;
  class?: string;
}

const {
  variant = "hero",
  intensity = 1,
  class: className = "",
} = Astro.props;

// Clamp intensity, then build a unique gradient id so multiple backdrops on
// the same page (hero + header) don't collide on `<linearGradient id="…">`.
const intensityValue = Math.max(0, Math.min(1, intensity));
const gradId = `mdg-ridge-grad-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={["mdg-anim-backdrop", `mdg-anim-backdrop--${variant}`, className]}
  aria-hidden="true"
  style={`--mdg-bg-intensity: ${intensityValue};`}
>
  {variant !== "subtle" && (
    <svg
      class="mdg-anim-backdrop__ridge"
      viewBox="0 0 1440 200"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id={gradId} x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
          <stop offset="60%" stop-color="currentColor" stop-opacity="0.55" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0.85" />
        </linearGradient>
      </defs>
      <path
        d="M0,140 L60,128 L120,135 L180,115 L240,122 L320,98 L380,108 L460,82 L540,92 L620,70 L700,85 L780,60 L860,75 L940,55 L1020,68 L1100,48 L1180,62 L1260,42 L1340,55 L1440,38 L1440,200 L0,200 Z"
        fill={`url(#${gradId})`}
      />
      <path
        d="M0,165 L80,158 L160,162 L240,150 L320,155 L400,142 L480,148 L560,135 L640,140 L720,128 L800,133 L880,122 L960,128 L1040,118 L1120,122 L1200,112 L1280,118 L1360,108 L1440,115 L1440,200 L0,200 Z"
        fill="currentColor"
        fill-opacity="0.35"
      />
    </svg>
  )}

  <div class="mdg-anim-backdrop__aurora">
    <span class="mdg-blob mdg-blob--1"></span>
    <span class="mdg-blob mdg-blob--2"></span>
    <span class="mdg-blob mdg-blob--3"></span>
  </div>

  {variant !== "subtle" && (
    <div class="mdg-anim-backdrop__fireflies">
      {Array.from({ length: 28 }).map((_, i) => {
        const left = (i * 37) % 100;
        const top = (i * 53 + 11) % 100;
        const delay = (i * 0.7) % 6;
        const dur = 6 + ((i * 1.3) % 7);
        const size = 2 + ((i * 0.9) % 3);
        return (
          <span
            class="mdg-firefly"
            style={`left:${left}%;top:${top}%;animation-delay:${delay}s;animation-duration:${dur}s;width:${size}px;height:${size}px;`}
          />
        );
      })}
    </div>
  )}
</div>

<style>
  .mdg-anim-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
    color: var(--mdg-ridge-color, var(--color-primary-dark, #143027));
  }

  /* Aurora — three drifting blurred blobs */
  .mdg-anim-backdrop__aurora {
    position: absolute;
    inset: -10%;
    filter: blur(40px);
    opacity: calc(var(--mdg-bg-intensity, 1) * 0.55);
  }

  .mdg-blob {
    position: absolute;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    will-change: transform;
    mix-blend-mode: screen;
    animation: mdg-aurora-drift 50s ease-in-out infinite;
  }
  .mdg-blob--1 { background: radial-gradient(circle, var(--color-primary, #1F4D3A) 0%, transparent 65%); top: -20%;  left:  -10%; animation-duration: 42s; --drift-x:  12%; --drift-y:   6%; --drift-s: 1.15; }
  .mdg-blob--2 { background: radial-gradient(circle, var(--color-accent, #3D5A40) 0%, transparent 65%); top:   30%; right: -15%; width: 45%;      animation-duration: 56s; --drift-x: -14%; --drift-y:   8%; --drift-s: 1.2; }
  .mdg-blob--3 { background: radial-gradient(circle, var(--color-soft-green, #5F7E50) 0%, transparent 65%); bottom:-25%; left:  30%; width: 50%;      animation-duration: 70s; --drift-x:  10%; --drift-y: -10%; --drift-s: 1.1; }

  /* Ridge — static horizon silhouette */
  .mdg-anim-backdrop__ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 38%;
    opacity: calc(var(--mdg-bg-intensity, 1) * 0.85);
  }

  /* Fireflies — staggered particle dots */
  .mdg-anim-backdrop__fireflies {
    position: absolute;
    inset: 0;
    opacity: calc(var(--mdg-bg-intensity, 1) * 0.7);
  }
  .mdg-firefly {
    position: absolute;
    background: var(--color-soft-green, #5F7E50);
    border-radius: 50%;
    box-shadow: 0 0 6px 1px color-mix(in oklab, var(--color-soft-green, #5F7E50) 60%, transparent);
    opacity: 0;
    will-change: opacity, transform;
    animation: mdg-firefly-twinkle 10s ease-in-out infinite;
  }

  /* Accessibility: freeze animations */
  @media (prefers-reduced-motion: reduce) {
    .mdg-blob, .mdg-firefly { animation: none !important; }
    .mdg-firefly { opacity: 0; }
  }

  /* Dark-mode palette swap */
  :global([data-theme="dark"]) .mdg-anim-backdrop { color: var(--color-primary, #A8C49A); }
  :global([data-theme="dark"]) .mdg-blob { opacity: calc(var(--mdg-bg-intensity, 1) * 0.45); }
  :global([data-theme="dark"]) .mdg-firefly {
    background: var(--color-primary, #A8C49A);
    box-shadow: 0 0 8px 2px color-mix(in oklab, var(--color-primary, #A8C49A) 70%, transparent);
  }

  /* One keyframe per motion primitive */
  @keyframes mdg-aurora-drift {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50%      { transform: translate3d(var(--drift-x, 10%), var(--drift-y, 5%), 0) scale(var(--drift-s, 1.1)); }
  }
  @keyframes mdg-firefly-twinkle {
    0%, 100% { opacity: 0;    transform: translate3d(0, 0, 0); }
    50%      { opacity: 0.85; transform: translate3d(8px, -6px, 0); }
  }
</style>
