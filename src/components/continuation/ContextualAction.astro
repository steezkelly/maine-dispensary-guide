---
import { getContextualAction } from '../../data/continuation/contextual-actions';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const rule = getContextualAction(currentPath);

const familyLabels = {
  directory: 'Directory action',
  calculator: 'Planning tool',
  download: 'Free download',
  lead_magnet: 'Free MDG resource',
  contact: 'Contact action',
  dataset: 'Data resource',
  affiliate: 'Partner resource',
} as const;
---

{rule && (
  <aside
    class="contextual-action"
    aria-labelledby={`contextual-action-${rule.id}`}
    data-action-id={`contextual-action-${rule.id}`}
    data-action-family="cta_navigate"
    data-placement-id="contextual_conversion_action"
    data-destination-family="internal_route"
    data-continuation-slot="contextual-action"
    data-contextual-action-family={rule.actionFamily}
  >
    <div class="contextual-action__copy">
      <p class="contextual-action__eyebrow">{familyLabels[rule.actionFamily]}</p>
      <h2 id={`contextual-action-${rule.id}`}>{rule.label}</h2>
      <p class="contextual-action__description">{rule.description}</p>
      {rule.disclosure && <p class="contextual-action__disclosure">{rule.disclosure}</p>}
    </div>
    <a
      class="contextual-action__link btn"
      href={rule.href}
      data-cta-id={`contextual-action-${rule.id}`}
      data-action-id={`contextual-action-${rule.id}`}
      data-action-family="cta_navigate"
      data-placement-id="contextual_conversion_action"
      data-destination-family="internal_route"
    >
      Open resource <span aria-hidden="true">→</span>
    </a>
  </aside>
)}

<style>
  .contextual-action {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-lg);
    margin-block: var(--space-lg) 0;
    padding: var(--space-lg);
    border-block: 1px solid var(--color-rule);
    border-left: 4px solid var(--color-accent);
    background: transparent;
  }

  .contextual-action__copy {
    min-width: 0;
  }

  .contextual-action__eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: var(--leading-snug);
    text-transform: uppercase;
  }

  .contextual-action h2 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .contextual-action__description {
    max-width: 62ch;
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    line-height: var(--leading-normal);
  }

  .contextual-action__disclosure {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-light);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
  }

  .contextual-action .contextual-action__link {
    display: inline-flex;
    min-height: var(--control-min-size, 44px);
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-primary);
    border: 2px solid var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 800;
    line-height: var(--leading-snug);
    text-align: center;
    text-decoration: none;
  }

  .contextual-action__link:hover {
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .contextual-action__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .contextual-action__link,
    .contextual-action__link::after {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 720px) {
    .contextual-action {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }

    .contextual-action__link {
      width: 100%;
    }
  }
</style>
