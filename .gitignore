# Generated at build time and served as public release provenance.
apps/maine-cannabis/public/build-info.json

# GSC indexing: cache is regenerated on every run (transient), keep dated reports only
apps/maine-cannabis/data/gsc-indexing-cache.json
# Query-level GSC snapshots are operational analytics data. They may contain
# sensitive search terms; keep them local and publish only reviewed aggregates.
apps/maine-cannabis/data/gsc-search-analytics-snapshots/

# Local email pipeline artifacts (per-session sent-mail archive + tracking)
# These are operational state, not source. The MDG email pipeline writes
# .eml files for every send (test, voice check, outreach). They bloat
# the working tree and contain PII (recipient addresses, message bodies).
public/data/sent-mail/
public/data/email-tracking.json
data/email-tracking.json
# Python bytecode (created by running Python scripts in pitches/)
__pycache__/
# Per-session outreach operational state (regenerated on each run;
# contains recipient addresses + submission status; matches the
# "outreach state stays local, only templates + scripts are public"
# convention Steve set 2026-07-11).
pitches/sent-log.json
pitches/webform-sent-log.json

# Engineering-skills workflow state (operational, regenerated per session)
.scratch/

# Agent-local orchestration state; never source or release material
.hermes/

# MDG-DATA-001 Maine Cannabis Data Engine (MDG-DATA-001 v0.5)
# Operational state lives in $MDG_DATA_ROOT (default ~/.hermes/data/mdg-data),
# outside the repository, so ignore the local shadow in case anyone runs
# the engine inside the repo during a one-off debug session.
# The PUBLIC generated-artifact tree under
# apps/maine-cannabis/src/data/generated/mdg-data/current/ IS tracked
# (it is what Astro reads at build time). Test/staging scratch is not.
/mdg-data/
/apps/maine-cannabis/src/data/generated/mdg-data/.current-*.tmp/
/apps/maine-cannabis/src/data/generated/mdg-data/.previous-*.tmp/
/apps/maine-cannabis/docs/data/mdg-data/decisions/.work/
