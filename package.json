{
  "name": "content-network",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "health-check": "turbo run health-check",
    "ci-check": "turbo run ci-check",
    "verify:iterate": "node scripts/git/pre-push-verify.cjs",
    "verify:push": "node scripts/git/pre-push-verify.cjs --with-smoke",
    "verify:pre-push": "node scripts/git/pre-push-verify.cjs --with-smoke",
    "verify:pre-push:fast": "node scripts/git/pre-push-verify.cjs --fast-only",
    "test:image-pipeline": "node --test scripts/image/tests/image-pipeline-hero-variants.test.cjs",
    "test:continuation": "node --test scripts/continuation/tests/ica-release-1.test.cjs",
    "test:continuation:built": "node --test scripts/continuation/tests/ica-built-output.test.cjs",
    "hooks:install": "node scripts/git/install-hooks.cjs",
    "workflow:status": "node scripts/git/mdg-worktree-status.cjs --assert-no-conflicts",
    "workflow:status:fetch": "node scripts/git/mdg-worktree-status.cjs --fetch --assert-no-conflicts",
    "workflow:status:json": "node scripts/git/mdg-worktree-status.cjs --json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "axe-core": "^4.12.1",
    "puppeteer": "^25.0.3",
    "turbo": "^2.5.3"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "path-to-regexp": "6.3.0",
    "yaml": "2.8.3"
  },
  "dependencies": {
    "sharp": "0.34.5"
  }
}
