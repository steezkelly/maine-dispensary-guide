{
  "name": "content-network",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agents:continuity": "node scripts/agent/mdg-continuity-check.cjs",
    "build": "npm run data:blog-index && turbo run build",
    "data:regen": "node scripts/data/prepush-data.cjs",
    "data:regen:prepush": "node scripts/data/prepush-data.cjs",
    "data:blog-index": "node scripts/data/regen-blog-index.cjs",
    "data:blog-index:check": "node scripts/data/regen-blog-index.cjs --check",
    "test:axe": "node scripts/check/axe-built-routes.cjs",
    "test:control-size": "node scripts/check/control-size-audit.mjs",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "health-check": "turbo run health-check",
    "ci-check": "turbo run ci-check",
    "verify:iterate": "node scripts/git/pre-push-verify.cjs",
    "verify:post-deploy": "node scripts/git/pre-push-verify.cjs --with-smoke",
    "verify:pre-push:fast": "node scripts/git/pre-push-verify.cjs --fast-only",
    "test:image-pipeline": "node --test scripts/image/tests/image-pipeline-hero-variants.test.cjs",
    "test:reveal-progressive-enhancement": "node --test apps/maine-cannabis/src/layouts/__tests__/reveal-progressive-enhancement.test.cjs",
    "test:continuation": "node --test scripts/continuation/tests/ica-release-1.test.cjs",
    "test:continuation:built": "node --test scripts/continuation/tests/ica-built-output.test.cjs",
    "agents:validate-contract": "node scripts/agent/validate-task-contract.cjs",
    "hooks:install": "node scripts/git/install-hooks.cjs",
    "test:market-stats-video": "npm --workspace @network/maine-cannabis run test:market-stats-video && node --test scripts/check/market-stats-video-ci-wiring.test.cjs",
    "test:answer-engine-benchmark-manifest": "node --test scripts/analytics/check-answer-engine-benchmark-manifest.test.cjs",
    "test:home-grow-legal-content": "node scripts/check/home-grow-legal-content.test.cjs",
    "workflow:status": "node scripts/git/mdg-worktree-status.cjs --assert-no-conflicts",
    "workflow:status:fetch": "node scripts/git/mdg-worktree-status.cjs --fetch --assert-no-conflicts",
    "workflow:status:json": "node scripts/git/mdg-worktree-status.cjs --json",
    "workflow:lease": "node scripts/git/mdg-worktree-lease.cjs",
    "workflow:preflight": "node scripts/git/mdg-worktree-status.cjs --fetch --assert-no-conflicts",
    "verify:worktree-resolution": "node scripts/build/assert-worktree-isolation.cjs --allow-existing-output",
    "build:isolated": "node scripts/build/assert-worktree-isolation.cjs && bash vercel-build.sh && node scripts/continuation/tests/ica-built-output.test.cjs",
    "agents:preflight": "node scripts/agent/mdg-task-preflight.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "axe-core": "^4.12.1",
    "puppeteer": "^25.0.3",
    "turbo": "^2.5.3"
  },
  "packageManager": "npm@11.9.0",
  "overrides": {
    "path-to-regexp": "6.3.0",
    "yaml": "2.8.3"
  },
  "dependencies": {
    "sharp": "0.34.5"
  }
}
