---
import { splitFaqAnswer } from '../lib/faq-citations.mjs';

interface FAQItem {
  question: string;
  answer: string;
}

interface ShortFAQItem {
  q: string;
  a: string;
}

interface Props {
  faqs?: FAQItem[];
  items?: FAQItem[];
  questions?: ShortFAQItem[];
  // Sprint 78ab: when `true`, suppress the auto-emitted FAQPage JSON-LD.
  // Use this when a page emits its own `<script type="application/ld+json">`
  // block in frontmatter to avoid duplicate schema. Before this flag,
  // pages that combined `<Faq faqs={...} />` with `faqPageSchema` const +
  // matching `<script>` produced two identical FAQPage scripts in dist/.
  // Default `false` preserves backward-compat for callers that relied on
  // the package to emit schema (107 pages).
  withoutSchema?: boolean;
  /** Render bracketed source markers as same-page keyboard-navigable links. */
  citationLinks?: boolean;
  /** Numeric source IDs that are allowed to become citation links. */
  citationSourceIds?: number[];
}

const { faqs, items, questions, withoutSchema = false, citationLinks = false, citationSourceIds = [] } = Astro.props;
const normalizedFaqs = faqs ?? items ?? questions?.map(({ q, a }) => ({ question: q, answer: a })) ?? [];

const siteUrl = "https://mainedispensaryguide.com";
const faqSchema = normalizedFaqs.length === 0 ? null : {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": normalizedFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

{!withoutSchema && faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

{normalizedFaqs.length > 0 && (
  <div class="faq-list">
    {normalizedFaqs.map((faq) => (
      <details class="faq-item">
        <summary>{faq.question}</summary>
        <p>{citationLinks
          ? splitFaqAnswer(faq.answer, citationLinks, citationSourceIds).map((part) => typeof part === 'number'
            ? <a class="faq-citation" href={`#source-${part}`} aria-label={`Source ${part}`}>{`[${part}]`}</a>
            : part)
          : faq.answer}</p>
      </details>
    ))}
  </div>
)}

<div class="faq-schema-wrapper">
  <slot />
</div>

<style>
  .faq-schema-wrapper {
    display: contents;
  }
  .faq-list {
    margin: 1rem 0;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 0;
  }
  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text);
  }
  .faq-item summary:hover {
    color: var(--color-primary);
  }
  .faq-item p {
    margin: 0.5rem 0 0;
    color: var(--color-text-light);
    line-height: 1.6;
  }
  .faq-citation {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    white-space: nowrap;
  }
  .faq-citation:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 0.15rem;
  }
</style>
