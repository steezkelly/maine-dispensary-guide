---
const { url } = Astro;
const pathSegments = url.pathname.split('/').filter(segment => segment !== '');

const breadcrumbs = pathSegments.map((segment, index) => {
  if (segment === 'admin') return null;
  const isDownloadParent = segment === 'download' && index === 0 && pathSegments.length > 1;
  const href = isDownloadParent
    ? '/resources'
    : '/' + pathSegments.slice(0, index + 1).join('/');
  const label = isDownloadParent
    ? 'Resources'
    : segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, char => char.toUpperCase());
  return { href, label };
}).filter((crumb): crumb is { href: string; label: string } => crumb !== null);

const isHome = url.pathname === '/';

// BreadcrumbList JSON-LD is no longer emitted here — apps/maine-cannabis/src/layouts/Layout.astro
// is the single source for it (with human-curated labels like 'ROI Calculator' instead of
// the regex title-case 'Roi Calculator'). See Sprint 78z / 2026-07 BreadcrumbList de-dup.
---

{!isHome && (
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <ol>
      <li>
        <a href="/">Home</a>
      </li>
      {breadcrumbs.map((crumb, index) => (
        <li>
          <span class="separator">/</span>
          {index === breadcrumbs.length - 1 ? (
            <span class="current" aria-current="page">{crumb?.label}</span>
          ) : (
            <a href={crumb?.href}>{crumb?.label}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs {
    max-width: var(--max-width);
    margin: 0 auto 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
  }

  .breadcrumbs a {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumbs a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .separator {
    margin: 0 0.5rem;
    /* Fix 2026-07-06 (visual-readability-polish.md issue #5): was hardcoded
       #ccc which drifted loud in dark mode. Use the existing muted-text token
       (4.7:1 on light, 9.2:1 on dark) so the separator reads the same
       relative weight in both themes. */
    color: var(--color-text-light);
    user-select: none;
  }

  .current {
    font-weight: 500;
    color: var(--color-text);
  }
</style>
