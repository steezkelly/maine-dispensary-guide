---
interface Props {
  title?: string;
  type?: 'passion' | 'tip' | 'success' | 'warning' | 'info';
  level?: 'h2' | 'h3';
}

const { title, type = 'passion', level = 'h3' } = Astro.props;

/* Fix 2026-07-06 (visual-readability-polish.md issue #2): tip and warning
   previously shared the ◆ glyph — semantic collision on a YMYL regulatory
   surface where the distinction matters most. Distinguish by geometric
   family: open diamond ◇ = instructive/non-urgent, open triangle ◬ = heads-up. */
const icons = {
  passion: '✦',
  tip: '◇',
  success: '▲',
  warning: '◬',
  info: '●'
};

const accents = {
  passion: 'var(--color-accent)',
  tip: 'var(--color-soft-green)',
  success: 'var(--color-primary)',
  warning: 'var(--color-warning, #b4643c)',
  info: 'var(--color-info, #4a7c9b)'
};

/* Fix 2026-07-06 (visual-readability-polish.md issue #4): was rgba(255,255,255,0.4)
   which on bone (#F2F2E2) renders ~98% identical — operators couldn't distinguish
   the callout container from the surrounding paragraphs. Step up to ~0.10 alpha
   against the warm gradient so the container reads as a clear visual region
   without overpowering the page rhythm. */
const bgColor = {
  passion: 'rgba(88, 129, 87, 0.10)',
  tip: 'rgba(163, 177, 138, 0.18)',
  success: 'rgba(13, 78, 80, 0.10)',
  warning: 'rgba(180, 100, 60, 0.14)',
  info: 'rgba(74, 124, 155, 0.14)'
};
---

<div class="callout" style={`--callout-accent: ${accents[type]}; background-color: ${bgColor[type]};`}>
  <div class="callout-header">
    <span class="callout-icon" style={`color: ${accents[type]};`}>{icons[type]}</span>
    {title && (level === 'h2' ? <h2>{title}</h2> : <h3>{title}</h3>)}
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    padding: 1.5rem 1.5rem 1.5rem 2rem;
    border-radius: 0 1rem 1rem 0;
    margin: 2.5rem 0;
    border: none;
    border-left: 4px solid var(--callout-accent);
    position: relative;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(6px);
    box-shadow: 0 2px 12px rgba(13, 78, 80, 0.06);
  }

  .callout::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 0 1rem 1rem 0;
    border: 1px solid var(--callout-accent);
    opacity: 0.40;    /* Fix 2026-07-06 (visual-readability-polish.md issue #4): was 0.25 — bumped to give the container a defined right-side edge. */
    pointer-events: none;
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .callout-icon {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }

  .callout-header h2,
  .callout-header h3 {
    margin: 0;
    font-family: var(--font-serif);
    color: var(--color-primary);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .callout-content {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .callout-content :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Fix 2026-07-06 (visual-readability-polish.md issue #3): removed the
     infinite alternate glow (box-shadow pulse every 2s). Read as
     "loading" / "uncertain" / "live-update" on a YMYL regulatory surface —
     undercut the editorial authority the design system projects.
     Entrance animation stays. After: callouts sit calmly, content carries emphasis. */
  @media (prefers-reduced-motion: no-preference) {
    .callout {
      animation: calloutReveal 0.5s ease-out;
    }
  }

  @keyframes calloutReveal {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

