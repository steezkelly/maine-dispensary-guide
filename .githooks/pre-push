#!/usr/bin/env bash
# .githooks/pre-push — MDG pre-push verification
#
# Runs the esbuild parse pass + (optionally) astro check against
# any .astro / .ts files that are about to be pushed. Blocks the
# push if either pass fails. See scripts/git/pre-push-verify.cjs.
#
# Installed automatically via:
#     git config core.hooksPath .githooks
# A bootstrap step in scripts/git/install-hooks.sh does this for
# the local repo. CI is unaffected (it doesn't run git hooks).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERIFY="$REPO_ROOT/scripts/git/pre-push-verify.cjs"

# Read the local ref, local sha, remote ref, and remote sha from stdin.
# Git passes lines like:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# We diff against the *remote-tracking* ref (e.g. refs/remotes/origin/main)
# so we catch what is about to be pushed, not the local branch tip.
REMOTE_REF=""
LOCAL_BRANCH=""
if [ ! -t 0 ]; then
    while read -r line; do
        [ -z "$line" ] && continue
        set -- $line
        LOCAL_BRANCH="$1"
        REMOTE_REF="$3"
        # If git passed us refs/heads/<branch>, resolve to refs/remotes/origin/<branch>
        if [ -n "$REMOTE_REF" ] && [ "$REMOTE_REF" != "(delete)" ] && [ "$REMOTE_REF" != "(local)" ]; then
            case "$REMOTE_REF" in
                refs/heads/*)
                    # translate refs/heads/main -> refs/remotes/origin/main
                    short="${REMOTE_REF#refs/heads/}"
                    if git show-ref --verify --quiet "refs/remotes/origin/$short"; then
                        REMOTE_REF="refs/remotes/origin/$short"
                    fi
                    ;;
            esac
        fi
        break
    done
fi

# Fallback: try origin/<current-branch>, then origin/main
if [ -z "$REMOTE_REF" ] || [ "$REMOTE_REF" = "(delete)" ] || [ "$REMOTE_REF" = "(local)" ]; then
    CUR=$(git symbolic-ref --short HEAD 2>/dev/null || echo "main")
    if git show-ref --verify --quiet "refs/remotes/origin/$CUR"; then
        REMOTE_REF="refs/remotes/origin/$CUR"
    elif git show-ref --verify --quiet "refs/remotes/origin/main"; then
        REMOTE_REF="refs/remotes/origin/main"
    fi
fi

if [ -z "$REMOTE_REF" ]; then
    echo "[pre-push] WARNING: could not determine remote ref; falling back to HEAD~1"
    REMOTE_REF="HEAD~1"
fi

if [ ! -f "$VERIFY" ]; then
    echo "[pre-push] WARNING: $VERIFY not found, skipping verification"
    exit 0
fi

echo "[pre-push] diffing against $REMOTE_REF"
node "$VERIFY" --ref="$REMOTE_REF"
exit $?
