#!/usr/bin/env bash
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
bootstrap="$repo_root/scripts/git/mdg-worktree-bootstrap.cjs"

if [[ -f "$bootstrap" ]]; then
  node "$bootstrap" --quiet || printf '%s\n' \
    '[post-checkout] warning: worktree dependency bootstrap failed; run npm run workflow:bootstrap' >&2
fi

exit 0
