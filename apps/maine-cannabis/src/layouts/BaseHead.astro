---
/**
 * BaseHead.astro — Maine Dispensary Guide
 *
 * Renders the <head>...</head> for every page on the site. Extracted from
 * Layout.astro on 2026-07-02 (Sprint 80 refactor) so SEO behavior lives in
 * ONE place. Before this split, fixing the og:type mismatch on hub pages
 * required coordinating 9 separate page-level frontmatter edits. After
 * this split, future SEO fixes are 1-line edits in this file.
 *
 * Props match what Layout passes in. The JSON-LD graph is computed in
 * Layout (it needs Astro.url + breadcrumb state) and passed as a prop.
 *
 * Test: dist/<page>/index.html <head>...</head> must be byte-identical
 * to the pre-refactor baseline. The pre-push gate's smoke-img-200 +
 * sitemap-postprocess checks catch the regressions that would actually
 * ship (broken image refs, count collapse). For finer-grained head
 * verification, see scripts/build/sitemap-postprocess.test.mjs which
 * asserts og:type=website on hub pages.
 */

import siteConfig from '../data/site-config.json';
import { resolveSocialImage, getHeroImageDimensions } from '../lib/seo';

interface ArticleData {
  author?: string;
  authorTitle?: string;
  authorId?: string;
  publishDate?: string;
  modifiedDate?: string;
  section?: string;
}

interface Props {
  fullTitle: string;
  seoDescription: string;
  socialImage: string;
  socialImageType: string;
  heroImage?: string;
  heroImageDims?: { w: number; h: number };
  isHub: boolean;
  article?: ArticleData;
  noindex: boolean;
  canonicalUrl: string | URL;
  /**
   * Optional override for the `<link rel="canonical">` tag and the
   * `hreflang` alternates. When set, the page emits a cross-page canonical
   * pointing at the override URL instead of its own `Astro.url`. Used by
   * cannibalized sibling pages that should consolidate ranking signals
   * onto a stronger canonical sibling (e.g. the Acadia tourism blog pair:
   * recreational-cannabis-near-acadia → cannabis-friendly-maine-travel).
   */
  canonicalOverride?: string;
  jsonLdGraph: any;
}

const {
  fullTitle,
  seoDescription,
  socialImage,
  socialImageType,
  heroImage,
  heroImageDims = { w: 1200, h: 630 },
  isHub,
  article,
  noindex,
  canonicalUrl,
  canonicalOverride,
  jsonLdGraph,
} = Astro.props;

const canonicalHref = canonicalOverride ?? canonicalUrl;

// Mirror Layout.astro's `isGuide` derivation so the heroImage preload can be
// gated on it. (Layout computes this in its own frontmatter and passes
// nothing to BaseHead because, before Sprint 81, BaseHead only needed URL-
// independent data. Now that the preload needs to know "is this a guide
// page", we recompute the same predicate here rather than threading another
// prop through the layout.)
const isGuide = Astro.url.pathname.startsWith('/guides/') && Astro.url.pathname !== '/guides';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={seoDescription} />
<meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
<meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
<title>{fullTitle}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{/*
  Sprint 81 (2026-07-11) PSI mobile follow-up: switched from display=swap to
  display=optional. The LCP element is the .hero-descriptor body paragraph
  (Plus Jakarta Sans). With swap, the page renders in the system fallback
  and re-flows when the webfont loads — pushing the LCP element's effective
  render time later than necessary. With optional, the browser uses the
  fallback if the webfont doesn't load within ~100ms, no swap, no late LCP
  re-layout. Trade-off: slow-network users see system fonts for body copy,
  but the brand still reads correctly (system sans is close enough to Plus
  Jakarta for body, system serif is acceptable for Newsreader headings).
*/}
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Source+Sans+3:wght@300;400;500;600;700&display=optional" rel="stylesheet" media="print" onload="this.media='all'" />
<noscript><link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Source+Sans+3:wght@300;400;500;600;700&display=optional" rel="stylesheet" /></noscript>

{/*
  Sprint 81 (2026-07-11) cleanup: only preload heroImage when the page
  actually renders it in the body. Previously every page with a heroImage
  frontmatter prop preloaded it, but the body renderer in Layout.astro:473
  only shows the hero image for `isGuide` pages. On non-guide pages
  (homepage, blog index, etc.), the preload fetched 74 KiB of JPG on every
  load and never used it. The browser logs a console warning about the
  unused preload within a few seconds of page load.

  Same isGuide rule as Layout.astro:118 — pathname starts with /guides/ but
  isn't /guides itself.
*/}
{heroImage && isGuide && <link rel="preload" as="image" href={heroImage} fetchpriority="high" crossorigin="anonymous" />}

<link rel="canonical" href={canonicalHref} />
<link rel="alternate" hreflang="en-US" href={canonicalHref} />
<link rel="alternate" hreflang="x-default" href={canonicalHref} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Social profiles — matches WebSite schema sameAs -->
{siteConfig.socialLinks.map(url => (<><link rel="me" href={url} /></>))}

<!-- OpenSearch autodiscovery -->
<link rel="search" href="/opensearch.xml" title="Maine Dispensary Guide" type="application/opensearchdescription+xml" />

<!-- Geo tags for local SEO -->
<meta name="geo.region" content="US-ME" />
<meta name="geo.placename" content="Maine" />
<meta name="geo.position" content="45.2538;-69.4455" />
<meta name="ICBM" content="45.2538, -69.4455" />

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={seoDescription} />
<meta property="og:type" content={isHub || !article ? "website" : "article"} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:url" content={socialImage} />
<meta property="og:image:secure_url" content={socialImage} />
<meta property="og:image:type" content={socialImageType} />
<meta property="og:image:width" content={String(heroImageDims.w)} />
<meta property="og:image:height" content={String(heroImageDims.h)} />
{article && (
  <>
    <meta property="og:article:published_time" content={article.publishDate} />
    <meta property="og:article:modified_time" content={article.modifiedDate || article.publishDate} />
    <meta property="og:article:author" content={article.author} />
    <meta property="og:article:section" content={article.section} />
  </>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:site" content="@MaineDispensary" />
{article && <meta name="twitter:creator" content="@MaineDispensary" />}

{!noindex && jsonLdGraph && (
<script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
)}<!-- touched for pre-push test -->
