---
/**
 * Layout.astro — Maine Dispensary Guide
 *
 * This is the main Layout for the Maine cannabis vertical.
 * It reads configuration from src/data/site-config.json
 *
 * For the content network architecture:
 * - packages/layouts/Layout.astro is the SHARED base layout (template)
 * - Each app's src/layouts/Layout.astro is the CUSTOMIZED version
 *
 * This file contains the actual implementation with Maine-specific config.
 * The shared package provides the component architecture and design system.
 */

import Breadcrumbs from '@network/ui/Breadcrumbs';
import PineTree from '@network/ui/PineTree';
import Leaf from '@network/ui/Leaf';
import GuideSidebar from '@network/ui/GuideSidebar';
import RelatedArticles from '@network/ui/RelatedArticles';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseHead from './BaseHead.astro';
import AffiliateClickTracker from '../components/AffiliateClickTracker.astro';
import siteConfig from '../data/site-config.json';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
// Design system — split into tokens / globals / components for maintainability.
// Theme 2026 (theme-2026.css) is loaded separately in step 4 to win specificity.
import '../styles/index.css';
// SEO + JSON-LD helpers — extracted from frontmatter (Sprint 73d refactor).
import {
  buildFullTitle,
  truncateMetaDescription,
  buildCrumbs,
  resolveSocialImage,
  getHeroImageDimensions,
  type Breadcrumb,
} from '../lib/seo';
import { buildJsonLdGraph, type AuthorMeta } from '../lib/json-ld';
import authorsData from '../data/authors.json';
const authors = authorsData as Array<{
  id: string;
  name: string;
  role: string;
  bio: string;
  description?: string;
  photo?: string;
  knowsAbout?: string[];
  credentials?: string[];
}>;

interface ArticleData {
  author?: string;
  authorTitle?: string;
  authorId?: string;
  publishDate?: string;
  modifiedDate?: string;
  section?: string;
  /**
   * Optional reviewer/medical reviewer. When provided, emits a second
   * `@type:Person` node in the JSON-LD Article graph (attached via
   * `reviewedBy`) — the "double E-E-A-T" pattern Google prefers for YMYL
   * pages per the 2024-2026 Quality Rater Guidelines.
   */
  reviewer?: AuthorMeta;
}

interface Props {
  title: string;
  description?: string;
  stateName?: string;
  isHub?: boolean;
  heroImage?: string;
  article?: ArticleData;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  topics?: string[];
  tags?: string[];
  /**
   * Optional cross-page canonical. When set, the rendered `<link rel="canonical">`
   * (and hreflang alternates) point at this URL instead of the page's own
   * `Astro.url`. Use for cannibalized sibling pages that should consolidate
   * ranking signals onto a stronger canonical sibling.
   * Example: the Acadia tourism blog pair, where recreational-cannabis-near-acadia
   * (149 imp pos 22) points up to cannabis-friendly-maine-travel (146 imp pos 13)
   * as the canonical answer.
   */
  canonicalOverride?: string;
}

const {
  title,
  description = "Your complete guide to opening and operating a cannabis dispensary.",
  stateName = siteConfig.stateName,
  isHub = false,
  heroImage,
  article,
  breadcrumbs = [],
  noindex = false,
  topics = [],
  tags = [],
  canonicalOverride
} = Astro.props;

// Site Metadata & State
const siteName = isHub ? "Dispensary Guide" : siteConfig.siteName;
const siteUrl = siteConfig.siteUrl;
const fullTitle = buildFullTitle(title, siteName);
const seoDescription = truncateMetaDescription(description);
const { url: socialImage, mimeType: socialImageType } = resolveSocialImage(heroImage, siteUrl);
const heroImageDims = getHeroImageDimensions(heroImage);
const heroImageWebp = heroImage?.replace(/\.jpg$/i, '.webp');
const heroImageAvif = heroImage?.replace(/\.jpg$/i, '.avif');
const heroImageMobile = heroImage?.replace(/\.jpg$/i, '-640w.jpg');
const heroImageMobileWebp = heroImage?.replace(/\.jpg$/i, '-640w.webp');
const heroImageMobileAvif = heroImage?.replace(/\.jpg$/i, '-640w.avif');
const isGuide = Astro.url.pathname.startsWith('/guides/') && Astro.url.pathname !== '/guides';
const isContent = isGuide || Astro.url.pathname.startsWith('/founders/') || Astro.url.pathname.startsWith('/blog/');

const allBreadcrumbs = buildCrumbs(Astro.url.pathname.replace(/\/$/, ''), breadcrumbs);

// Author lookup from authors.json — enrich Article schema with each author's
// knowsAbout / description / photo. Stable per-author IDs are critical for
// Google's Knowledge Graph and AI-model author attribution. Looking up via the
// authors.json registry (instead of expecting every page to pass-through these
// fields) means the frontmatter contract stays small while the schema output
// is fully populated. `photo` is a single string URL (the about authors page
// uses the same field for the img src), `description` is the longer bio used
// for the schema Person node, `knowsAbout` is the expertise array AI models
// use for topical author attribution.
const authorRecord = authors.find(a => a.id === article?.authorId);
const authorBio = authorRecord?.description ?? authorRecord?.bio;
const authorPhoto = typeof authorRecord?.photo === 'string' ? authorRecord.photo : undefined;
const authorKnowsAbout = authorRecord?.knowsAbout;
const reviewerRecord = article?.reviewer
  ? authors.find(a => a.id === article.reviewer!.id)
  : undefined;
const reviewerBio = reviewerRecord?.description ?? reviewerRecord?.bio;

// JSON-LD — single @graph with Organization + WebSite (+ Article if content).
// Sprint 73b unified 3 separate <script> tags into one graph.
// Sprint 83: optionally attaches a reviewer Person to the Article via
// the `reviewedBy` property when the page frontmatter declares one.
const jsonLdGraph = noindex ? null : buildJsonLdGraph(
  {
    siteName: siteConfig.siteName,
    siteUrl,
    socialLinks: siteConfig.socialLinks,
  },
  isContent && article && !noindex
    ? {
        title,
        description,
        author: article.author,
        authorTitle: article.authorTitle,
        authorId: article.authorId,
        authorDescription: authorBio,
        authorPhoto,
        authorKnowsAbout,
        publishDate: article.publishDate,
        modifiedDate: article.modifiedDate,
        section: article.section,
        heroImage,
        topics,
        pageUrl: Astro.url.href,
        reviewer: article.reviewer
          ? {
              ...article.reviewer,
              description: reviewerBio,
            }
          : undefined,
      }
    : undefined,
);

// ----------------------------------------------------------------------------
// BreadcrumbList JSON-LD (Sprint 78z — GSC audit remediation)
// Audit finding: 0% BreadcrumbList coverage; 18 page-1 ranking pages were
// missing the schema. Emitting in <head> is the canonical Google guidance
// (the package BodyBreadcrumbs component already emits a valid copy in
// <main>; this <head> copy is the primary one Google parses for SERP
// rich-result eligibility). Section-name map is the canonical MDG taxonomy.
// ----------------------------------------------------------------------------
const BREADCRUMB_SECTION_LABELS: Record<string, string> = {
  'guides': 'Guides',
  'blog': 'Blog',
  'learn': "Consumer's Guide",
  'download': 'Free Downloads',
  'download-checklist': 'Maine Dispensary Roadmap',
  'founders-bible': 'Founders Bible',
  'directory': 'Find a Dispensary',
  'resources': 'Resources',
  'about': 'About',
  'founders': 'Founders',
  'contact': 'Contact',
  'start-here': 'Start Here',
  'roi-calculator': 'ROI Calculator',
  'glossary': 'Glossary',
  'market-stats': 'Market Stats',
  'admin': 'Admin',
  'embed': 'Embeds',
  'maine-cannabis-opt-in-tracker': 'Opt-In Tracker',
};

// Breadcrumb path segments that don't have index pages and shouldn't appear
// as their own breadcrumb leaf in the chain. Each segment listed here is
// either (a) a content path whose /<segment>/index.astro doesn't ship, or
// (b) the dynamic /download/{id} family where the segment is part of the
// canonical URL, not a parent section.
const BREADCRUMB_SKIP_SEGMENTS = new Set([
  'download',
]);

const titleCaseSlug = (slug: string): string =>
    slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

const breadcrumbPath = Astro.url.pathname.replace(/\/$/, '');
const breadcrumbSegments = breadcrumbPath === ''
    ? []
    : breadcrumbPath.split('/').filter(Boolean)
        .reduce<string[]>((acc, seg) => {
            if (acc.length === 0 && BREADCRUMB_SKIP_SEGMENTS.has(seg)) return [];
            return [...acc, seg];
        }, []);
const breadcrumbListSchema = breadcrumbSegments.length > 0 && !noindex
    ? {
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}` },
                ...breadcrumbSegments.map((segment, index) => {
                    const cumulativePath = '/' + breadcrumbSegments.slice(0, index + 1).join('/');
                    const label = BREADCRUMB_SECTION_LABELS[segment] || titleCaseSlug(segment);
                    return {
                        '@type': 'ListItem',
                        position: index + 2,
                        name: label,
                        item: `${siteUrl}${cumulativePath}`,
                    };
                }),
            ],
        }
    : null;
const breadcrumbListJsonLd = breadcrumbListSchema
  ? JSON.stringify(breadcrumbListSchema)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      fullTitle={fullTitle}
      seoDescription={seoDescription}
      socialImage={socialImage}
      socialImageType={socialImageType}
      heroImage={heroImage}
      heroImageDims={heroImageDims}
      isHub={isHub}
      article={article}
      noindex={noindex}
      canonicalUrl={Astro.url}
      canonicalOverride={canonicalOverride}
      jsonLdGraph={jsonLdGraph}
    />
    {breadcrumbListJsonLd && (
      <script type="application/ld+json" set:html={breadcrumbListJsonLd} />
    )}
    <slot name="head" />

    {/* BreadcrumbList is injected by packages/ui/src/components/Breadcrumbs.astro */}

    <script is:inline>
      // Theme bootstrap — runs synchronously in <head> to prevent FOUC.
      // The toggle handler (window.toggleTheme) lives in SiteHeader.astro
      // alongside the toggle button that calls it.
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) return localStorage.getItem('theme');
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);

      window.toggleTheme = function() {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      };
    </script>

    <!-- Google Analytics GA4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analyticsId}`}></script>
    <script define:vars={{ analyticsId: siteConfig.analyticsId }}>
      // @ts-nocheck - GA4 dataLayer global
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', analyticsId);
    </script>

    <!--
      Engagement instrumentation (scroll_depth, page_engaged, faq_open, cta_view).
      Self-contained: no module imports (loaded before ESM bundle), no network
      calls, no setInterval on tight loops. All work via passive listeners +
      IntersectionObserver. Reference impl: src/lib/ga4.ts (typed helpers).
    -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined' || typeof window.gtag !== 'function') return;

        var path = window.location.pathname;
        var title = document.title;
        var pageType = document.body && document.body.dataset ? (document.body.dataset.pageType || '') : '';
        var baseCtx = { page_path: path, page_title: title, page_type: pageType };

        function send(name, params) {
          try { window.gtag('event', name, Object.assign({}, baseCtx, params || {})); }
          catch (_) { /* tracking must never break the page */ }
        }

        // --- scroll_depth (25/50/75/100) --------------------------------------
        var scrollFired = { 25: false, 50: false, 75: false, 100: false };
        var scrollPending = false;
        function checkScroll() {
          scrollPending = false;
          var doc = document.documentElement;
          var scrollTop = window.scrollY || doc.scrollTop || 0;
          var viewport = window.innerHeight || doc.clientHeight || 0;
          var total = (doc.scrollHeight || 0) - viewport;
          if (total <= 0) return;
          var pct = Math.min(100, Math.round((scrollTop / total) * 100));
          var thresholds = [25, 50, 75, 100];
          for (var i = 0; i < thresholds.length; i++) {
            var t = thresholds[i];
            if (!scrollFired[t] && pct >= t) {
              scrollFired[t] = true;
              send('scroll_depth', { percent: t });
            }
          }
        }
        function onScroll() {
          if (scrollPending) return;
          scrollPending = true;
          (window.requestAnimationFrame || function (cb) { window.setTimeout(cb, 120); })(checkScroll);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        window.addEventListener('load', function () { setTimeout(checkScroll, 250); });

        // --- page_engaged (30s of focus, or visible-again after hidden) ------
        var engaged = false;
        function markEngaged(reason) {
          if (engaged) return;
          engaged = true;
          send('page_engaged', { reason: reason });
        }
        window.setTimeout(function () {
          if (!document.hidden) markEngaged('timer_30s_visible');
        }, 30000);
        document.addEventListener('visibilitychange', function () {
          if (!engaged && document.visibilityState === 'visible') {
            markEngaged('visibility_returned');
          }
        });

        // --- faq_open (delegated on <details data-faq>) ----------------------
        document.addEventListener('toggle', function (ev) {
          var t = ev.target;
          if (!t || t.tagName !== 'DETAILS' || !t.hasAttribute('data-faq')) return;
          if (!t.open) return;
          var idx = 1;
          var sib = t.parentElement && t.parentElement.firstElementChild;
          while (sib) {
            if (sib.tagName === 'DETAILS' && sib.hasAttribute('data-faq')) {
              if (sib === t) break;
              idx++;
            }
            sib = sib.nextElementSibling;
          }
          send('faq_open', {
            faq_index: idx,
            faq_id: t.getAttribute('data-faq-id') || '',
            faq_question: (t.querySelector('summary') || {}).textContent || ''
          });
        }, true);

        // --- cta_view (IntersectionObserver on [data-cta-id]) ---------------
        if ('IntersectionObserver' in window) {
          var seen = new WeakSet();
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              var e = entries[i];
              if (!e.isIntersecting) continue;
              var el = e.target;
              if (seen.has(el)) continue;
              seen.add(el);
              io.unobserve(el);
              send('cta_view', {
                cta_id: el.getAttribute('data-cta-id') || '',
                cta_destination: el.getAttribute('href') || '',
                cta_text: (el.textContent || '').trim().slice(0, 80)
              });
            }
          }, { threshold: 0.5 });
          document.addEventListener('DOMContentLoaded', function () {
            var ctas = document.querySelectorAll('[data-cta-id]');
            for (var j = 0; j < ctas.length; j++) io.observe(ctas[j]);
          });
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only skip-link">Skip to main content</a>
    <div class="grain-overlay"></div>

    <!-- GLOBAL BOTANICAL ORNAMENTS (decorative, behind all content) -->
    <div class="bg-ornament p1"><PineTree size={40} color="var(--color-primary)" /></div>
    <div class="bg-ornament p2"><Leaf size={30} color="var(--color-accent)" /></div>
    <div class="bg-ornament p3"><PineTree size={50} color="var(--color-primary)" /></div>
    <div class="bg-ornament p4"><Leaf size={35} color="var(--color-accent)" /></div>
    <div class="bg-ornament p5"><Leaf size={25} color="var(--color-accent)" /></div>
    <div class="bg-ornament p6"><PineTree size={45} color="var(--color-primary)" /></div>
    <div class="bg-ornament p7"><Leaf size={30} color="var(--color-accent)" /></div>
    <div class="bg-ornament p8"><PineTree size={55} color="var(--color-primary)" /></div>
    <div class="bg-ornament p9"><Leaf size={40} color="var(--color-accent)" /></div>
    <div class="bg-ornament p10"><Leaf size={30} color="var(--color-accent)" /></div>
    <div class="bg-ornament p11"><PineTree size={35} color="var(--color-primary)" /></div>
    <div class="bg-ornament p12"><Leaf size={45} color="var(--color-accent)" /></div>

    <SiteHeader />

    <main id="main-content" role="main" tabindex="-1">
      <Breadcrumbs />
      {isGuide ? (
        <div class="guide-layout">
          <div class="guide-content">
            {heroImage && <div class="guide-hero"><picture><source type="image/avif" srcset={`${heroImageMobileAvif} 640w`} sizes="(max-width: 640px) 640px, 1280px" /><source type="image/webp" srcset={`${heroImageMobileWebp} 640w`} sizes="(max-width: 640px) 640px, 1280px" /><img src={heroImage} srcset={`${heroImageMobile} 640w`} sizes="(max-width: 640px) 640px, 1280px" alt={`${stateName} cannabis ${article?.section?.toLowerCase() || 'guide'}: ${title}`} width={heroImageDims.w} height={heroImageDims.h} loading="eager" /></picture></div>}
            <slot />
            {article && (
              <div class="article-meta">
                <span class="article-byline">By {article.author || siteConfig.siteName + " Editorial Team"}</span>
                {article.publishDate && (
                  <span class="article-date">Published {new Date(article.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                )}
                {article.modifiedDate && article.modifiedDate !== article.publishDate && (
                  <span class="article-updated"><time datetime={article.modifiedDate}>Updated {new Date(article.modifiedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
                )}
                {tags.length > 0 && (
                  <span class="article-tags">
                    {tags.map(tag => (
                      <span class={`tag-badge tag-${tag}`}>{tag.replace(/-/g, ' ')}</span>
                    ))}
                  </span>
                )}
              </div>
            )}
            <div class="lead-capture-box">
              <h3>Get the 2026 Maine Launch Checklist</h3>
              <p>Download our step-by-step roadmap. 100% Free.</p>
              <a href="/download-checklist" class="btn-cta">Download PDF Checklist &rarr;</a>
            </div>
            <RelatedArticles currentPath={Astro.url.pathname} currentTopics={topics} section={article?.section} />
            {authorRecord && (
              <aside class="article-author-footer" id={`author-${authorRecord.id}`} aria-label={`About the author ${authorRecord.name}`}>
                <div class="author-footer-card">
                  <img class="author-footer-photo" src={authorRecord.photo} alt={authorRecord.name} width="64" height="64" loading="lazy" />
                  <div class="author-footer-meta">
                    <p class="author-footer-name"><a href={`/about/authors#${authorRecord.id}`}>{authorRecord.name}</a></p>
                    <p class="author-footer-role">{authorRecord.role}</p>
                    <p class="author-footer-bio">{authorRecord.description ?? authorRecord.bio}</p>
                    {authorRecord.credentials && authorRecord.credentials.length > 0 && (
                      <ul class="author-footer-credentials">
                        {authorRecord.credentials.map(c => <li>{c}</li>)}
                      </ul>
                    )}
                    {reviewerRecord && (
                      <p class="author-footer-reviewer"><strong>Reviewed by:</strong> <a href={`/about/authors#${reviewerRecord.id}`}>{reviewerRecord.name}</a>, {reviewerRecord.role}. See the <a href="/about/authors">editorial review process</a> for how this review is conducted.</p>
                    )}
                    <p class="author-footer-link"><a href={`/about/authors#${authorRecord.id}`}>View this author's profile, prior work, and expertise →</a></p>
                  </div>
                </div>
              </aside>
            )}
          </div>
          <aside class="guide-sidebar-container" aria-label="Guide Navigation"><GuideSidebar currentPath={Astro.url.pathname} currentTopics={topics} /></aside>
        </div>
      ) : (
        <>
          <slot />
          {article && (
            <div class="article-meta">
              <span class="article-byline">By {article.author || siteConfig.siteName + " Editorial Team"}</span>
              {article.publishDate && (
                <span class="article-date">Published {new Date(article.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              )}
              {article.modifiedDate && article.modifiedDate !== article.publishDate && (
                <span class="article-updated"><time datetime={article.modifiedDate}>Updated {new Date(article.modifiedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
              )}
              {tags.length > 0 && (
                <span class="article-tags">
                  {tags.map(tag => (
                    <span class={`tag-badge tag-${tag}`}>{tag.replace(/-/g, ' ')}</span>
                  ))}
                </span>
              )}
            </div>
          )}
          {article && authorRecord && (
            <aside class="article-author-footer" id={`author-${authorRecord.id}`} aria-label={`About the author ${authorRecord.name}`}>
              <div class="author-footer-card">
                <img class="author-footer-photo" src={authorRecord.photo} alt={authorRecord.name} width="64" height="64" loading="lazy" />
                <div class="author-footer-meta">
                  <p class="author-footer-name"><a href={`/about/authors#${authorRecord.id}`}>{authorRecord.name}</a></p>
                  <p class="author-footer-role">{authorRecord.role}</p>
                  <p class="author-footer-bio">{authorRecord.description ?? authorRecord.bio}</p>
                  {authorRecord.credentials && authorRecord.credentials.length > 0 && (
                    <ul class="author-footer-credentials">
                      {authorRecord.credentials.map(c => <li>{c}</li>)}
                    </ul>
                  )}
                  {reviewerRecord && (
                    <p class="author-footer-reviewer"><strong>Reviewed by:</strong> <a href={`/about/authors#${reviewerRecord.id}`}>{reviewerRecord.name}</a>, {reviewerRecord.role}. See the <a href="/about/authors">editorial review process</a> for how this review is conducted.</p>
                  )}
                  <p class="author-footer-link"><a href={`/about/authors#${authorRecord.id}`}>View this author's profile, prior work, and expertise →</a></p>
                </div>
              </div>
            </aside>
          )}
        </>
      )}
    </main>

    <button id="back-to-top" class="back-to-top" aria-label="↑ Back to Top">&uarr;</button>

    <Analytics />
    <SpeedInsights />
    <AffiliateClickTracker />

    <div id="theater-overlay" class="theater-overlay" aria-hidden="true"></div>

    <SiteFooter />

    <script is:inline>
      // Scroll handler for header effects, progress bar, and back-to-top
      (function() {
        const header = document.getElementById('site-header');
        if (!header) return;

        const handleScroll = () => {
          const scrolled = window.scrollY > 50;
          header.classList.toggle('scrolled', scrolled);

          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const progress = (winScroll / height) * 100;
          const pb = document.getElementById("progress-bar");
          if (pb) pb.style.width = progress + "%";

          const btt = document.getElementById('back-to-top');
          if (btt) btt.style.display = winScroll > 500 ? "block" : "none";
        };

        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
          window.addEventListener('scroll', handleScroll, { passive: true });
          handleScroll(); // Initial check
        }

        const bttBtn = document.getElementById('back-to-top');
        if (bttBtn) bttBtn.onclick = () => window.scrollTo({top: 0, behavior: 'smooth'});

        // Scroll-triggered reveal animation
        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -80px 0px',
          threshold: 0.1
        };

        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              const delay = entry.target.style.animationDelay || '0s';
              entry.target.style.transitionDelay = delay;
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => {
          revealObserver.observe(el);
        });
      })();
    </script>
  </body>
</html>

