<style is:global>
  /* Layout-level .lcb-cta-btn: bone chip + dark-spruce text in LIGHT mode,
     dark-spruce chip + cream text in DARK mode. Uses a UNIQUE class
     name (lcb-cta-btn) instead of .btn-cta because Vite's CSS minifier
     collapses adjacent .btn-cta rules into one merged selector-list
     that breaks light/dark cascade ordering. */
  .lcb-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #F4F1E4; /* bone */
    color: #0E1A14; /* dark spruce */
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
    border: 1px solid #D6DBC9;
  }
  .lcb-cta-btn:hover {
    background: #FFFFFF;
    transform: translateY(-1px);
  }
  [data-theme="dark"] .lcb-cta-btn {
    background: #11261B; /* dark surface */
    color: #ECF3E4; /* cream */
    border-color: #1E3627;
  }
  [data-theme="dark"] .lcb-cta-btn:hover {
    background: #152F23;
  }
</style>
