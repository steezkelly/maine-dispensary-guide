---
/**
 * Layout.astro — Maine Dispensary Guide
 *
 * This is the main Layout for the Maine cannabis vertical.
 * It reads configuration from src/data/site-config.json
 *
 * For the content network architecture:
 * - packages/layouts/Layout.astro is the SHARED base layout (template)
 * - Each app's src/layouts/Layout.astro is the CUSTOMIZED version
 *
 * This file contains the actual implementation with Maine-specific config.
 * The shared package provides the component architecture and design system.
 */

import Breadcrumbs from '@network/ui/Breadcrumbs';
import PineTree from '@network/ui/PineTree';
import Leaf from '@network/ui/Leaf';
import GuideSidebar from '@network/ui/GuideSidebar';
import RelatedArticles from '@network/ui/RelatedArticles';
import AutoRelated from '../components/AutoRelated.astro';
import LegacyLeadCapture from '../components/LegacyLeadCapture.astro';
import EditorialNextStep from '../components/continuation/EditorialNextStep.astro';
import ContextualAction from '../components/continuation/ContextualAction.astro';
import OnThisPage from '../components/OnThisPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseHead from './BaseHead.astro';
import AffiliateClickTracker from '../components/AffiliateClickTracker.astro';
import siteConfig from '../data/site-config.json';
import Analytics from '@vercel/analytics/astro';

interface TocItem {
  id: string;
  label: string;
}
import SpeedInsights from '@vercel/speed-insights/astro';
// Design system — split into tokens / globals / components for maintainability.
// Theme 2026 (theme-2026.css) is loaded separately in step 4 to win specificity.
import '../styles/index.css';
// SEO + JSON-LD helpers — extracted from frontmatter (Sprint 73d refactor).
import {
  buildFullTitle,
  truncateMetaDescription,
  buildCrumbs,
  resolveSocialImage,
  getHeroImageDimensions,
  type Breadcrumb,
} from '../lib/seo';
import { buildJsonLdGraph, type AuthorMeta } from '../lib/json-ld';
import { dataPageTypeFor } from '../lib/page-route-family';
import authorsData from '../data/authors.json';
const authors = authorsData as Array<{
  id: string;
  name: string;
  role: string;
  bio: string;
  description?: string;
  photo?: string;
  knowsAbout?: string[];
  credentials?: string[];
}>;

interface ArticleData {
  author?: string;
  authorTitle?: string;
  authorId?: string;
  publishDate?: string;
  modifiedDate?: string;
  section?: string;
  /**
   * Optional reviewer/medical reviewer. When provided, emits a second
   * `@type:Person` node in the JSON-LD Article graph (attached via
   * `reviewedBy`) — the "double E-E-A-T" pattern Google prefers for YMYL
   * pages per the 2024-2026 Quality Rater Guidelines.
   */
  reviewer?: AuthorMeta;
}

interface Props {
  title: string;
  description?: string;
  stateName?: string;
  isHub?: boolean;
  heroImage?: string;
  article?: ArticleData;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  topics?: string[];
  tags?: string[];
  continuationMode?: 'legacy' | 'pilot';
  toc?: TocItem[];
  /**
   * Optional cross-page canonical. When set, the rendered `<link rel="canonical">`
   * (and hreflang alternates) point at this URL instead of the page's own
   * `Astro.url`. Use for cannibalized sibling pages that should consolidate
   * ranking signals onto a stronger canonical sibling.
   * Example: the Acadia tourism blog pair, where recreational-cannabis-near-acadia
   * (149 imp pos 22) points up to cannabis-friendly-maine-travel (146 imp pos 13)
   * as the canonical answer.
   */
  canonicalOverride?: string;
}

const {
  title,
  description = "Your complete guide to opening and operating a cannabis dispensary.",
  stateName = siteConfig.stateName,
  isHub = false,
  heroImage,
  article,
  breadcrumbs = [],
  noindex = false,
  topics = [],
  tags = [],
  continuationMode = 'legacy',
  canonicalOverride,
  toc = [],
} = Astro.props;

// Site Metadata & State
const siteName = isHub ? "Dispensary Guide" : siteConfig.siteName;
const siteUrl = siteConfig.siteUrl;
const fullTitle = buildFullTitle(title, siteName);
const seoDescription = truncateMetaDescription(description);
const { url: socialImage, mimeType: socialImageType } = resolveSocialImage(heroImage, siteUrl);
const heroImageDims = getHeroImageDimensions(heroImage);
const heroImageWebp = heroImage?.replace(/\.jpg$/i, '.webp');
const heroImageAvif = heroImage?.replace(/\.jpg$/i, '.avif');
const heroImageMobile = heroImage?.replace(/\.jpg$/i, '-640w.jpg');
const heroImageMobileWebp = heroImage?.replace(/\.jpg$/i, '-640w.webp');
const heroImageMobileAvif = heroImage?.replace(/\.jpg$/i, '-640w.avif');
const isGuide = Astro.url.pathname.startsWith('/guides/') && Astro.url.pathname !== '/guides';
const isContent = isGuide || Astro.url.pathname.startsWith('/founders/') || Astro.url.pathname.startsWith('/blog/');

// MDG-ANALYTICS-001 Ticket 006 Surface A — derive data-page-type for <body>.
// Routes the page-type to GA4 event context (Layout.astro:351 already reads
// document.body.dataset.pageType). Returns null for /admin/* and similar
// excluded routes; body tag omits the attribute.
const dataPageType = dataPageTypeFor(Astro.url.pathname);

const allBreadcrumbs = buildCrumbs(Astro.url.pathname.replace(/\/$/, ''), breadcrumbs);

// Author lookup from authors.json — enrich Article schema with each author's
// knowsAbout / description / photo. Stable per-author IDs are critical for
// Google's Knowledge Graph and AI-model author attribution. Looking up via the
// authors.json registry (instead of expecting every page to pass-through these
// fields) means the frontmatter contract stays small while the schema output
// is fully populated. `photo` is a single string URL (the about authors page
// uses the same field for the img src), `description` is the longer bio used
// for the schema Person node, `knowsAbout` is the expertise array AI models
// use for topical author attribution.
const authorRecord = authors.find(a => a.id === article?.authorId);
const authorBio = authorRecord?.description ?? authorRecord?.bio;
const authorPhoto = typeof authorRecord?.photo === 'string' ? authorRecord.photo : undefined;
const authorKnowsAbout = authorRecord?.knowsAbout;
const reviewerRecord = article?.reviewer
  ? authors.find(a => a.id === article.reviewer!.id)
  : undefined;
const reviewerBio = reviewerRecord?.description ?? reviewerRecord?.bio;

// JSON-LD — single @graph with Organization + WebSite (+ Article if content).
// Sprint 73b unified 3 separate <script> tags into one graph.
// Sprint 83: optionally attaches a reviewer Person to the Article via
// the `reviewedBy` property when the page frontmatter declares one.
const jsonLdGraph = noindex ? null : buildJsonLdGraph(
  {
    siteName: siteConfig.siteName,
    siteUrl,
    socialLinks: siteConfig.socialLinks,
  },
  isContent && article && !noindex
    ? {
        title,
        description,
        author: article.author,
        authorTitle: article.authorTitle,
        authorId: article.authorId,
        authorDescription: authorBio,
        authorPhoto,
        authorKnowsAbout,
        publishDate: article.publishDate,
        modifiedDate: article.modifiedDate,
        section: article.section,
        heroImage,
        topics,
        pageUrl: Astro.url.href,
        reviewer: article.reviewer
          ? {
              ...article.reviewer,
              description: reviewerBio,
            }
          : undefined,
      }
    : undefined,
);

// ----------------------------------------------------------------------------
// BreadcrumbList JSON-LD (Sprint 78z — GSC audit remediation)
// Audit finding: 0% BreadcrumbList coverage; 18 page-1 ranking pages were
// missing the schema. Emitting in <head> is the canonical Google guidance
// (the package BodyBreadcrumbs component already emits a valid copy in
// <main>; this <head> copy is the primary one Google parses for SERP
// rich-result eligibility). Section-name map is the canonical MDG taxonomy.
// ----------------------------------------------------------------------------
const BREADCRUMB_SECTION_LABELS: Record<string, string> = {
  'guides': 'Guides',
  'blog': 'Blog',
  'learn': "Consumer's Guide",
  'download': 'Free Downloads',
  'download-checklist': 'Maine Dispensary Roadmap',
  'founders-bible': 'Founders Bible',
  'directory': 'Find a Dispensary',
  'resources': 'Resources',
  'about': 'About',
  'founders': 'Founders',
  'contact': 'Contact',
  'start-here': 'Start Here',
  'roi-calculator': 'ROI Calculator',
  'glossary': 'Glossary',
  'market-stats': 'Market Stats',
  'admin': 'Admin',
  'embed': 'Embeds',
  'maine-cannabis-opt-in-tracker': 'Opt-In Tracker',
};

// Breadcrumb path segments that don't have index pages and shouldn't appear
// as their own breadcrumb leaf in the chain. Each segment listed here is
// either (a) a content path whose /<segment>/index.astro doesn't ship, or
// (b) the dynamic /download/{id} family where the segment is part of the
// canonical URL, not a parent section.
const BREADCRUMB_SKIP_SEGMENTS = new Set([
  'download',
]);

const titleCaseSlug = (slug: string): string =>
    slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

const breadcrumbPath = Astro.url.pathname.replace(/\/$/, '');
const breadcrumbSegments = breadcrumbPath === ''
    ? []
    : breadcrumbPath.split('/').filter(Boolean)
        .reduce<string[]>((acc, seg) => {
            if (acc.length === 0 && BREADCRUMB_SKIP_SEGMENTS.has(seg)) return [];
            return [...acc, seg];
        }, []);
const breadcrumbListSchema = breadcrumbSegments.length > 0 && !noindex
    ? {
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
                { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}` },
                ...breadcrumbSegments.map((segment, index) => {
                    const cumulativePath = '/' + breadcrumbSegments.slice(0, index + 1).join('/');
                    const label = BREADCRUMB_SECTION_LABELS[segment] || titleCaseSlug(segment);
                    return {
                        '@type': 'ListItem',
                        position: index + 2,
                        name: label,
                        item: `${siteUrl}${cumulativePath}`,
                    };
                }),
            ],
        }
    : null;
const breadcrumbListJsonLd = breadcrumbListSchema
  ? JSON.stringify(breadcrumbListSchema)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      fullTitle={fullTitle}
      seoDescription={seoDescription}
      socialImage={socialImage}
      socialImageType={socialImageType}
      heroImage={heroImage}
      heroImageDims={heroImageDims}
      isHub={isHub}
      article={article}
      noindex={noindex}
      canonicalUrl={Astro.url}
      canonicalOverride={canonicalOverride}
      jsonLdGraph={jsonLdGraph}
    />
    {breadcrumbListJsonLd && (
      <script type="application/ld+json" set:html={breadcrumbListJsonLd} />
    )}
    <slot name="head" />

    {/* BreadcrumbList is injected by packages/ui/src/components/Breadcrumbs.astro */}

    <script is:inline>
      // Theme bootstrap — runs synchronously in <head> to prevent FOUC.
      // The toggle handler (window.toggleTheme) lives in SiteHeader.astro
      // alongside the toggle button that calls it.
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) return localStorage.getItem('theme');
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);

      function syncThemeToggle(nextTheme) {
        const toggle = document.getElementById('theme-toggle');
        if (!toggle) return;
        const isDark = nextTheme === 'dark';
        toggle.setAttribute('aria-pressed', String(isDark));
        toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      }

      window.toggleTheme = function() {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        syncThemeToggle(next);
      };

      document.addEventListener('DOMContentLoaded', () => syncThemeToggle(theme), { once: true });
    </script>

    <!-- Google Analytics GA4 -->
    {/*
      Sprint 81 (2026-07-11) PSI mobile round 4: asynchronous gtag.js load.

      The inline stub queues `js` and `config` before the asynchronous client
      fetch so instrumentation has an ordered destination from the first event.
      The client begins fetching immediately: a CTA may navigate away before an
      idle callback or load-event fallback fires, which would otherwise leave
      its queued exposure/select events stranded in the discarded document.
    */}
    <script is:inline define:vars={{ analyticsId: siteConfig.analyticsId }}>
      // Stub gtag so engagement instrumentation (below) can call window.gtag
      // before the real gtag.js library loads. Calls queue to dataLayer and
      // are flushed when the real gtag initializes.
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', analyticsId);

      // Start the async client immediately. The stub keeps this non-blocking,
      // while avoiding a deliberate 1.5–2.5 second window where a first CTA
      // can navigate before gtag has even begun to load.
      (function () {
        function loadGtag() {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + analyticsId;
          document.head.appendChild(s);
        }
        loadGtag();
      })();
    </script>

    <!--
      Engagement instrumentation (scroll_depth, page_engaged, faq_open, cta_view).
      Self-contained: no module imports (loaded before ESM bundle), no network
      calls, no setInterval on tight loops. All work via passive listeners +
      IntersectionObserver. Reference impl: src/lib/ga4.ts (typed helpers).
    -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined' || typeof window.gtag !== 'function') return;

        var path = window.location.pathname;
        var title = document.title;
        var pageType = document.body && document.body.dataset ? (document.body.dataset.pageType || '') : '';
        var baseCtx = { page_path: path, page_title: title, page_type: pageType };

        function send(name, params) {
          try { window.gtag('event', name, Object.assign({}, baseCtx, params || {})); }
          catch (_) { /* tracking must never break the page */ }
        }

        // --- scroll_depth (25/50/75/100) --------------------------------------
        var scrollFired = { 25: false, 50: false, 75: false, 100: false };
        var scrollPending = false;
        function checkScroll() {
          scrollPending = false;
          var doc = document.documentElement;
          var scrollTop = window.scrollY || doc.scrollTop || 0;
          var viewport = window.innerHeight || doc.clientHeight || 0;
          var total = (doc.scrollHeight || 0) - viewport;
          if (total <= 0) return;
          var pct = Math.min(100, Math.round((scrollTop / total) * 100));
          var thresholds = [25, 50, 75, 100];
          for (var i = 0; i < thresholds.length; i++) {
            var t = thresholds[i];
            if (!scrollFired[t] && pct >= t) {
              scrollFired[t] = true;
              send('scroll_depth', { percent: t });
            }
          }
        }
        function onScroll() {
          if (scrollPending) return;
          scrollPending = true;
          (window.requestAnimationFrame || function (cb) { window.setTimeout(cb, 120); })(checkScroll);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        window.addEventListener('load', function () { setTimeout(checkScroll, 250); });

        // --- page_engaged + v1 active foreground attention -------------------
        // Active attention means foreground time with a recent intentional input,
        // not simply an open tab. This stays anonymous: only timing is retained.
        var activityWindowMs = 30000;
        var lastQualifyingActivityAt = 0;
        function recordQualifyingActivity() {
          if (!document.hidden) {
            lastQualifyingActivityAt = Date.now();
            scheduleActiveAttention();
          }
        }
        window.addEventListener('pointerdown', recordQualifyingActivity, { passive: true });
        window.addEventListener('keydown', recordQualifyingActivity, { passive: true });
        window.addEventListener('touchstart', recordQualifyingActivity, { passive: true });
        window.addEventListener('scroll', recordQualifyingActivity, { passive: true });

        var engaged = false;
        var activeAttentionSent = false;
        var foregroundStartedAt = document.hidden ? 0 : Date.now();
        var foregroundElapsedMs = 0;
        var attentionTimer = 0;
        function markEngaged(reason) {
          if (engaged) return;
          engaged = true;
          send('page_engaged', { reason: reason });
        }
        function foregroundAttentionMs() {
          return foregroundElapsedMs + (foregroundStartedAt ? Date.now() - foregroundStartedAt : 0);
        }
        function sameSiteReferrerPath() {
          try {
            var referrer = new URL(document.referrer || '');
            var currentHost = window.location.hostname.replace(/^www\./, '');
            if (referrer.hostname.replace(/^www\./, '') !== currentHost) return '';
            return referrer.pathname;
          } catch (_) { return ''; }
        }
        function hasRecentQualifyingActivity() {
          return lastQualifyingActivityAt && Date.now() - lastQualifyingActivityAt <= activityWindowMs;
        }
        function markActiveAttention() {
          if (activeAttentionSent || foregroundAttentionMs() < 30000 || !hasRecentQualifyingActivity()) return;
          activeAttentionSent = true;
          var attentionParams = { schema_version: 'v1', attention_seconds_bucket: 30, transport_type: 'beacon' };
          var sourcePath = sameSiteReferrerPath();
          if (sourcePath) attentionParams.same_site_source_path = sourcePath;
          send('mdg_active_attention', attentionParams);
        }
        function scheduleActiveAttention() {
          if (attentionTimer) { window.clearTimeout(attentionTimer); attentionTimer = 0; }
          if (activeAttentionSent || !foregroundStartedAt) return;
          attentionTimer = window.setTimeout(function () {
            attentionTimer = 0;
            markActiveAttention();
            if (!engaged) markEngaged('timer_30s_visible');
          }, Math.max(0, 30000 - foregroundAttentionMs()));
        }
        scheduleActiveAttention();
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') {
            cancelPendingActionDwellTimers();
            foregroundElapsedMs = foregroundAttentionMs();
            foregroundStartedAt = 0;
            if (attentionTimer) { window.clearTimeout(attentionTimer); attentionTimer = 0; }
          } else {
            foregroundStartedAt = Date.now();
            // Retain the legacy page_engaged signal, but do not let a tab
            // return satisfy the v1 foreground-attention threshold by itself.
            if (!engaged) markEngaged('visibility_returned');
            markActiveAttention();
            scheduleActiveAttention();
            restartQualifiedActionDwellTimers();
          }
        });

        // --- faq_open (delegated on <details data-faq>) ----------------------
        document.addEventListener('toggle', function (ev) {
          var t = ev.target;
          if (!t || t.tagName !== 'DETAILS' || !t.hasAttribute('data-faq')) return;
          if (!t.open) return;
          var idx = 1;
          var sib = t.parentElement && t.parentElement.firstElementChild;
          while (sib) {
            if (sib.tagName === 'DETAILS' && sib.hasAttribute('data-faq')) {
              if (sib === t) break;
              idx++;
            }
            sib = sib.nextElementSibling;
          }
          send('faq_open', {
            faq_index: idx,
            faq_id: t.getAttribute('data-faq-id') || '',
            faq_question: (t.querySelector('summary') || {}).textContent || ''
          });
        }, true);

        // --- v1 action exposure/select (queued and beacon-safe) --------------
        // CTA metadata is authored where an ICA module knows it. Existing CTA
        // IDs get stable defaults here so the rollout does not require link
        // navigation to wait for analytics.
        function defaultActionFamily(el) {
          if (el.tagName === 'BUTTON' && (el.getAttribute('type') || '').toLowerCase() === 'submit') {
            return 'cta_form_submit';
          }
          return 'cta_navigate';
        }
        function destinationPath(el, family) {
          if (family !== 'internal_route') return '';
          try { return new URL(el.getAttribute('href') || '', window.location.origin).pathname; }
          catch (_) { return ''; }
        }
        function actionMetadata(el) {
          var ctaId = el.getAttribute('data-cta-id') || '';
          var placementMatch = /^cta-([a-z-]+)-/.exec(ctaId);
          return {
            action_id: el.getAttribute('data-action-id') || ctaId,
            action_family: el.getAttribute('data-action-family') || defaultActionFamily(el),
            placement_id: el.getAttribute('data-placement-id') || (placementMatch ? placementMatch[1] : 'inline'),
            destination_family: destinationFamily(el)
          };
        }
        function destinationFamily(el) {
          var explicit = el.getAttribute('data-destination-family');
          if (explicit) return explicit;
          if (el.tagName === 'BUTTON' && (el.getAttribute('type') || '').toLowerCase() === 'submit') {
            return 'form_submit';
          }
          var href = el.getAttribute('href') || '';
          if (href.indexOf('mailto:') === 0) return 'mailto_open';
          if (href.indexOf('tel:') === 0) return 'tel_open';
          if (href && (href.charAt(0) === '/' || href.indexOf(window.location.origin) === 0)) return 'internal_route';
          if (href) return 'external_url';
          return 'other';
        }
        function sendAction(name, metadata, extra) {
          // gtag queues before its network library loads; transport_type asks
          // the loaded client to use beacon where available. Never await this.
          send(name, Object.assign({ schema_version: 'v1', transport_type: 'beacon' }, metadata, extra || {}));
        }
        var exposedActions = new WeakSet();
        var actionDwellTimers = new Map();
        var actionIntersectionState = new Set();
        var actionObserver = null;
        function cancelPendingActionDwellTimers() {
          actionDwellTimers.forEach(function (timer) { window.clearTimeout(timer); });
          actionDwellTimers.clear();
        }
        function scheduleActionDwell(target) {
          if (exposedActions.has(target) || actionDwellTimers.has(target) || document.hidden) return;
          var timer = window.setTimeout(function () {
            actionDwellTimers.delete(target);
            // A timer cannot convert a backgrounded or no-longer-visible
            // element into a meaningful viewport exposure.
            if (document.hidden || !actionIntersectionState.has(target) || exposedActions.has(target)) return;
            if (actionObserver) actionObserver.unobserve(target);
            exposeAction(target);
          }, 750);
          actionDwellTimers.set(target, timer);
        }
        function restartQualifiedActionDwellTimers() {
          actionIntersectionState.forEach(function (target) {
            scheduleActionDwell(target);
          });
        }
        function legacyCtaView(target) {
          send('cta_view', {
            cta_id: target.getAttribute('data-cta-id') || '',
            cta_destination: target.getAttribute('href') || '',
            cta_text: (target.textContent || '').trim()
          });
        }
        function exposeAction(target) {
          if (exposedActions.has(target)) return;
          exposedActions.add(target);
          sendAction('mdg_action_exposure', actionMetadata(target));
          // Keep the v0 reach report populated until it is explicitly migrated.
          legacyCtaView(target);
        }
        function observeActions() {
          if (!('IntersectionObserver' in window)) return;
          actionObserver = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              var entry = entries[i];
              var el = entry.target;
              if (exposedActions.has(el)) continue;
              if (!entry.isIntersecting || entry.intersectionRatio < 0.5) {
                actionIntersectionState.delete(el);
                var pending = actionDwellTimers.get(el);
                if (pending) { window.clearTimeout(pending); actionDwellTimers.delete(el); }
                continue;
              }
              actionIntersectionState.add(el);
              scheduleActionDwell(el);
            }
          }, { threshold: [0, 0.5] });
          var ctas = document.querySelectorAll('[data-cta-id]');
          for (var j = 0; j < ctas.length; j++) actionObserver.observe(ctas[j]);
        }
        document.addEventListener('click', function (ev) {
          var target = ev.target && ev.target.closest ? ev.target.closest('[data-cta-id]') : null;
          if (!target) return;
          var metadata = actionMetadata(target);
          var path = destinationPath(target, metadata.destination_family);
          // A deliberate selection qualifies the action even when the 750ms
          // viewport dwell has not elapsed or IntersectionObserver is absent.
          exposeAction(target);
          sendAction('mdg_action_select', metadata, path ? { destination_path: path } : {});
          // Deliberately do not preventDefault or await analytics: links and
          // form-control actions must remain reliable even when tracking fails.
        }, true);
        // A native navigation triggered by a first CTA can unload the document
        // before gtag.js has initialized, leaving queued events stranded in
        // the discarded dataLayer. pagehide/visibilitychange flushes ask the
        // (possibly still stubbed) gtag client to drain its queue via beacon
        // while the network stack is still alive.
        function flushQueuedActions() {
          try { if (typeof window.gtag === 'function') window.gtag('event', 'page_unload_before_gtag'); } catch (_) { /* no-op: tracking must never break navigation */ }
        }
        window.addEventListener('pagehide', flushQueuedActions);
        document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') flushQueuedActions(); });
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', observeActions);
        } else {
          observeActions();
        }
      })();
    </script>
  </head>
  <body data-page-type={dataPageType}>
    <a href="#main-content" class="sr-only focus:not-sr-only skip-link">Skip to main content</a>
    <div class="grain-overlay"></div>

    <!-- GLOBAL BOTANICAL ORNAMENTS (decorative, behind all content) -->
