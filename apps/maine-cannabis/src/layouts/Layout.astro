---
/**
 * Layout.astro — Maine Dispensary Guide
 *
 * This is the main Layout for the Maine cannabis vertical.
 * It reads configuration from src/data/site-config.json
 *
 * For the content network architecture:
 * - packages/layouts/Layout.astro is the SHARED base layout (template)
 * - Each app's src/layouts/Layout.astro is the CUSTOMIZED version
 *
 * This file contains the actual implementation with Maine-specific config.
 * The shared package provides the component architecture and design system.
 */

import Breadcrumbs from '@network/ui/Breadcrumbs';
import PineTree from '@network/ui/PineTree';
import Leaf from '@network/ui/Leaf';
import GuideSidebar from '@network/ui/GuideSidebar';
import RelatedArticles from '@network/ui/RelatedArticles';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import siteConfig from '../data/site-config.json';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
// Design system — split into tokens / globals / components for maintainability.
// Theme 2026 (theme-2026.css) is loaded separately in step 4 to win specificity.
import '../styles/index.css';
// SEO + JSON-LD helpers — extracted from frontmatter (Sprint 73d refactor).
import {
  buildFullTitle,
  truncateMetaDescription,
  buildCrumbs,
  resolveSocialImage,
  getHeroImageDimensions,
  type Breadcrumb,
} from '../lib/seo';
import { buildJsonLdGraph } from '../lib/json-ld';

interface ArticleData {
  author?: string;
  authorTitle?: string;
  authorId?: string;
  publishDate?: string;
  modifiedDate?: string;
  section?: string;
}

interface Props {
  title: string;
  description?: string;
  stateName?: string;
  isHub?: boolean;
  heroImage?: string;
  article?: ArticleData;
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
  topics?: string[];
  tags?: string[];
}

const {
  title,
  description = "Your complete guide to opening and operating a cannabis dispensary.",
  stateName = siteConfig.stateName,
  isHub = false,
  heroImage,
  article,
  breadcrumbs = [],
  noindex = false,
  topics = [],
  tags = []
} = Astro.props;

// Site Metadata & State
const siteName = isHub ? "Dispensary Guide" : siteConfig.siteName;
const siteUrl = siteConfig.siteUrl;
const fullTitle = buildFullTitle(title, siteName);
const seoDescription = truncateMetaDescription(description);
const { url: socialImage, mimeType: socialImageType } = resolveSocialImage(heroImage, siteUrl);
const heroImageDims = getHeroImageDimensions(heroImage);
const heroImageWebp = heroImage?.replace(/\.jpg$/i, '.webp');
const heroImageAvif = heroImage?.replace(/\.jpg$/i, '.avif');
const heroImageMobile = heroImage?.replace(/\.jpg$/i, '-640w.jpg');
const heroImageMobileWebp = heroImage?.replace(/\.jpg$/i, '-640w.webp');
const heroImageMobileAvif = heroImage?.replace(/\.jpg$/i, '-640w.avif');
const isGuide = Astro.url.pathname.startsWith('/guides/') && Astro.url.pathname !== '/guides';
const isContent = isGuide || Astro.url.pathname.startsWith('/founders/') || Astro.url.pathname.startsWith('/blog/');

const allBreadcrumbs = buildCrumbs(Astro.url.pathname.replace(/\/$/, ''), breadcrumbs);

// JSON-LD — single @graph with Organization + WebSite (+ Article if content).
// Sprint 73b unified 3 separate <script> tags into one graph.
const jsonLdGraph = noindex ? null : buildJsonLdGraph(
  {
    siteName: siteConfig.siteName,
    siteUrl,
    socialLinks: siteConfig.socialLinks,
  },
  isContent && article && !noindex
    ? {
        title,
        description,
        author: article.author,
        authorTitle: article.authorTitle,
        authorId: article.authorId,
        publishDate: article.publishDate,
        modifiedDate: article.modifiedDate,
        section: article.section,
        heroImage,
        topics,
        pageUrl: Astro.url.href,
      }
    : undefined,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={seoDescription} />
    <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
    <title>{fullTitle}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>

    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" crossorigin="anonymous" />}

    <link rel="canonical" href={Astro.url} />
    <link rel="alternate" hreflang="en-US" href={Astro.url} />
    <link rel="alternate" hreflang="x-default" href={Astro.url} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Social profiles — matches WebSite schema sameAs -->
    {siteConfig.socialLinks.map(url => (<><link rel="me" href={url} /></>))}

    <!-- OpenSearch autodiscovery -->
    <link rel="search" href="/opensearch.xml" title="Maine Dispensary Guide" type="application/opensearchdescription+xml" />

    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="US-ME" />
    <meta name="geo.placename" content="Maine" />
    <meta name="geo.position" content="45.2538;-69.4455" />
    <meta name="ICBM" content="45.2538, -69.4455" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:url" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(heroImageDims.w)} />
    <meta property="og:image:height" content={String(heroImageDims.h)} />
    {article && (
      <>
        <meta property="og:article:published_time" content={article.publishDate} />
        <meta property="og:article:modified_time" content={article.modifiedDate || article.publishDate} />
        <meta property="og:article:author" content={article.author} />
        <meta property="og:article:section" content={article.section} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:site" content="@MaineDispensary" />
    {article && <meta name="twitter:creator" content="@MaineDispensary" />}

    {!noindex && jsonLdGraph && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
    )}

    {/* BreadcrumbList is injected by packages/ui/src/components/Breadcrumbs.astro */}

    <script is:inline>
      // Theme bootstrap — runs synchronously in <head> to prevent FOUC.
      // The toggle handler (window.toggleTheme) lives in SiteHeader.astro
      // alongside the toggle button that calls it.
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) return localStorage.getItem('theme');
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
        return 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);

      window.toggleTheme = function() {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      };
    </script>

    <!-- Google Analytics GA4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analyticsId}`}></script>
    <script define:vars={{ analyticsId: siteConfig.analyticsId }}>
      // @ts-nocheck - GA4 dataLayer global
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', analyticsId);
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only skip-link">Skip to main content</a>
    <div class="grain-overlay"></div>

    <!-- GLOBAL BOTANICAL ORNAMENTS (decorative, behind all content) -->
    <div class="bg-ornament p1"><PineTree size={40} color="var(--color-primary)" /></div>
    <div class="bg-ornament p2"><Leaf size={30} color="var(--color-accent)" /></div>
    <div class="bg-ornament p3"><PineTree size={50} color="var(--color-primary)" /></div>
    <div class="bg-ornament p4"><Leaf size={35} color="var(--color-accent)" /></div>
    <div class="bg-ornament p5"><Leaf size={25} color="var(--color-accent)" /></div>
    <div class="bg-ornament p6"><PineTree size={45} color="var(--color-primary)" /></div>
    <div class="bg-ornament p7"><Leaf size={30} color="var(--color-accent)" /></div>
    <div class="bg-ornament p8"><PineTree size={55} color="var(--color-primary)" /></div>
    <div class="bg-ornament p9"><Leaf size={40} color="var(--color-accent)" /></div>
    <div class="bg-ornament p10"><Leaf size={30} color="var(--color-accent)" /></div>
    <div class="bg-ornament p11"><PineTree size={35} color="var(--color-primary)" /></div>
    <div class="bg-ornament p12"><Leaf size={45} color="var(--color-accent)" /></div>

    <SiteHeader />

    <main id="main-content" role="main" tabindex="-1">
      <Breadcrumbs />
      {isGuide ? (
        <div class="guide-layout">
          <div class="guide-content">
            {heroImage && <div class="guide-hero"><picture><source type="image/avif" srcset={`${heroImageAvif} 1x, ${heroImageMobileAvif} 640w`} sizes="(max-width: 640px) 640px, 1280px" /><source type="image/webp" srcset={`${heroImageWebp} 1x, ${heroImageMobileWebp} 640w`} sizes="(max-width: 640px) 640px, 1280px" /><img src={heroImage} srcset={`${heroImage} 1x, ${heroImageMobile} 640w`} sizes="(max-width: 640px) 640px, 1280px" alt={`${stateName} cannabis ${article?.section?.toLowerCase() || 'guide'}: ${title}`} width={heroImageDims.w} height={heroImageDims.h} loading="eager" /></picture></div>}
            <slot />
            {article && (
              <div class="article-meta">
                <span class="article-byline">By {article.author || siteConfig.siteName + " Editorial Team"}</span>
                {article.publishDate && (
                  <span class="article-date">Published {new Date(article.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                )}
                {article.modifiedDate && article.modifiedDate !== article.publishDate && (
                  <span class="article-updated"><time datetime={article.modifiedDate}>Updated {new Date(article.modifiedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
                )}
                {tags.length > 0 && (
                  <span class="article-tags">
                    {tags.map(tag => (
                      <span class={`tag-badge tag-${tag}`}>{tag.replace(/-/g, ' ')}</span>
                    ))}
                  </span>
                )}
              </div>
            )}
            <div class="lead-capture-box">
              <h3>Get the 2026 Maine Launch Checklist</h3>
              <p>Download our step-by-step roadmap. 100% Free.</p>
              <a href="/download-checklist" class="btn-cta">Download PDF Checklist &rarr;</a>
            </div>
            <RelatedArticles currentPath={Astro.url.pathname} currentTopics={topics} section={article?.section} />
          </div>
          <aside class="guide-sidebar-container" aria-label="Guide Navigation"><GuideSidebar currentPath={Astro.url.pathname} currentTopics={topics} /></aside>
        </div>
      ) : (
        <>
          <slot />
          {article && (
            <div class="article-meta">
              <span class="article-byline">By {article.author || siteConfig.siteName + " Editorial Team"}</span>
              {article.publishDate && (
                <span class="article-date">Published {new Date(article.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              )}
              {article.modifiedDate && article.modifiedDate !== article.publishDate && (
                <span class="article-updated"><time datetime={article.modifiedDate}>Updated {new Date(article.modifiedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
              )}
              {tags.length > 0 && (
                <span class="article-tags">
                  {tags.map(tag => (
                    <span class={`tag-badge tag-${tag}`}>{tag.replace(/-/g, ' ')}</span>
                  ))}
                </span>
              )}
            </div>
          )}
        </>
      )}
    </main>

    <button id="back-to-top" class="back-to-top" aria-label="↑ Back to Top">&uarr;</button>

    <Analytics />
    <SpeedInsights />

    <div id="theater-overlay" class="theater-overlay" aria-hidden="true"></div>

    <SiteFooter />

    <script is:inline>
      // Scroll handler for header effects, progress bar, and back-to-top
      (function() {
        const header = document.getElementById('site-header');
        if (!header) return;

        const handleScroll = () => {
          const scrolled = window.scrollY > 50;
          header.classList.toggle('scrolled', scrolled);

          const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
          const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const progress = (winScroll / height) * 100;
          const pb = document.getElementById("progress-bar");
          if (pb) pb.style.width = progress + "%";

          const btt = document.getElementById('back-to-top');
          if (btt) btt.style.display = winScroll > 500 ? "block" : "none";
        };

        // Check for reduced motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
          window.addEventListener('scroll', handleScroll, { passive: true });
          handleScroll(); // Initial check
        }

        const bttBtn = document.getElementById('back-to-top');
        if (bttBtn) bttBtn.onclick = () => window.scrollTo({top: 0, behavior: 'smooth'});

        // Scroll-triggered reveal animation
        const observerOptions = {
          root: null,
          rootMargin: '0px 0px -80px 0px',
          threshold: 0.1
        };

        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              const delay = entry.target.style.animationDelay || '0s';
              entry.target.style.transitionDelay = delay;
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => {
          revealObserver.observe(el);
        });
      })();
    </script>
  </body>
</html>

