---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
import CiteThis from '../components/CiteThis.astro';
import LeadCaptureBox from '../components/LeadCaptureBox.astro';

// ---------------------------------------------------------------------------
// National-benchmark dataset (mid-2025 to H1 2026).
// Anchored to MJBizDaily, Whitney Economics / Vangst Jobs Report 2025,
// Leafly Jobs Report 2026, Northstar Financial CFO benchmarks, Headset retail
// analytics, BDSA 2026 State of the Cannabis Industry, and mainecannabis.org.
// Maine values anchor to OCP 2025 Adult Use Annual Report (28-B M.R.S. §113)
// + MMCP 2025 Annual Report (22 M.R.S. §2430-N).
// ---------------------------------------------------------------------------

const nationalOverview = [
  { label: "U.S. legal cannabis market size (2025)",     maine: "23rd of 36",  national: "$33.8B",                                  source: "MJBiz Factbook 2026; Cannabispromotions" },
  { label: "Avg state-level 2025 legal sales",          maine: "$246.4M",     national: "$1.03B",                                  source: "OCP / MJBiz Factbook 2026" },
  { label: "Avg flower price (retail, mid-2026)",      maine: "$6.62/g",     national: "$8.92/g",                                  source: "OCP Annual Report / Cannabis Benchmarks" },
  { label: "Avg retail annual revenue (per dispensary)", maine: "$1.31M*",   national: "$1.8–2.2M",                              source: "OCP 246.4M ÷ 187 stores / MJBiz dispensary survey" },
  { label: "Avg transaction size (retail basket)",      maine: "$53*",        national: "$53.83 (female) / $53.29 (male)",          source: "Headset 2025; Flowhub MRI-Simmons 2025 National Cannabis Study" },
  { label: "Dispensary visits per adult per year",      maine: "8.1",         national: "4.7",                                      source: "Placer.ai via Cannabispromotions 2026" },
  { label: "% of U.S. cannabis operators profitable (2024)", maine: "n/a",   national: "27.3% (40.6% break-even, 32.2% not profitable)", source: "Whitney Economics / Vangst Jobs Report 2025" }
];

const stateRanking = [
  { rank: 1,  state: "California",     sales2025: "$4.06B",  yoy: "−8%",     tier: "Saturated",            notes: "$640M tax revenue — highest tax producer; price & illicit competition drag" },
  { rank: 2,  state: "Michigan",       sales2025: "$3.49B",  yoy: "+6%",     tier: "Mature",               notes: "402 dual retail stores + 47 AU; 31,152 jobs (2021 baseline)" },
  { rank: 3,  state: "Florida",        sales2025: "$2.25B",  yoy: "+8%",     tier: "Medical-only",         notes: "Not adult-use; medical patient volume drives total" },
  { rank: 4,  state: "Illinois",       sales2025: "$2.17B",  yoy: "+3%",     tier: "Limited-license",      notes: "36.25% effective tax; cross-border leakage to MO/MI" },
  { rank: 5,  state: "Pennsylvania",   sales2025: "$1.81B",  yoy: "+7%",     tier: "Medical-only",         notes: "Not adult-use" },
  { rank: 6,  state: "New York",       sales2025: "$1.60B",  yoy: "+94%",    tier: "Limited-license",      notes: "Ramp from $147M (2021); microbiz profitability still 20%" },
  { rank: 7,  state: "Missouri",       sales2025: "$1.57B",  yoy: "+8%",     tier: "Growing",              notes: "$67K average 4/20 sales per store (Cova 2025)" },
  { rank: 8,  state: "Massachusetts",  sales2025: "$1.54B",  yoy: "−2%",     tier: "Mature",               notes: "387 retail permits issued (2022 baseline); flattening" },
  { rank: 9,  state: "Maryland",       sales2025: "$1.45B",  yoy: "+31%",    tier: "New / growing",        notes: "118 dispensaries; $11.40/g avg price (premium market)" },
  { rank: 10, state: "New Jersey",     sales2025: "$1.38B",  yoy: "+33%",    tier: "Limited-license",      notes: "23 operating dispensaries; medical-first market ramping" },
  { rank: 23, state: "Maine",          sales2025: "$246.4M", yoy: "+1%",     tier: "Mature / plateauing",  notes: "OCP Annual Report — sales flat YoY; price compression continues" }
];

const startupCosts = [
  { category: "Total startup",     lowMain: 250_000, midMain: 400_000, highMain: 700_000, national: "250,000–2,000,000",   notes: "Includes license, buildout, opening inventory, working capital. Maine average ~$400K runs cheaper than most limited-license states." },
  { category: "Licensing & applications", lowMain: 1_500, midMain: 6_000,  highMain: 25_000,  national: "1,000–300,000",         notes: "Maine OCP conditional license fee: $500 (28-B M.R.S. §207); municipalities add $500–5,000." },
  { category: "Real estate (Y1)", lowMain: 18_000, midMain: 36_000, highMain: 80_000, national: "100,000–720,000/yr (MJBiz Factbook)", notes: "Maine rural: $12–22/sqft NNN; Portland: $35–65/sqft NNN." },
  { category: "Buildout & fixtures", lowMain: 80_000, midMain: 130_000, highMain: 250_000, national: "100,000–400,000",      notes: "1,200–1,800 sqft secure vault, POS, displays, lighting, security." },
  { category: "Opening inventory", lowMain: 50_000, midMain: 80_000, highMain: 120_000, national: "50,000–250,000",         notes: "Wholesale flower $888–$1,096/lb in 2025 (Leaflink tracking); ~$1,500/lb modeling baseline." },
  { category: "Security & compliance tech", lowMain: 8_000, midMain: 18_000, highMain: 40_000, national: "10,000–50,000",         notes: "OCP-mandated cameras, vault, alarm, Metrc seed-to-sale." },
  { category: "Marketing & branding", lowMain: 5_000, midMain: 12_000, highMain: 30_000, national: "25,000–100,000",         notes: "Launch + 12-month calendar; Maine marketing restrictions apply (28-B M.R.S. §704)." }
];

const marginBenchmarks = [
  { metric: "Gross margin (retail)",        maine: "40–50%",  national: "25–45% (MJBiz/Whitney)", whyDiff: "Maine's mature-market pricing pressure lands it in the median band; vertically integrated operators do better." },
  { metric: "Operating margin (pre-tax)",   maine: "15–22%",  national: "12–21% (Munchmakers)",    whyDiff: "Maine averages a touch higher because mature-market discipline + lower rent." },
  { metric: "Net margin (after 280E)",      maine: "5–12%",   national: "3–12% (Northstar CFO)",   whyDiff: "Cannabis remains Schedule I federally — 280E eliminates most deductions; rescheduling to III would unlock ~$268K/yr per typical dispensary (Headset)." },
  { metric: "Effective federal tax burden", maine: "60–75%",  national: "60–80% (Northstar)",      whyDiff: "280E is not a rate — it's the elimination of deductions, applied against 21% corporate rate on much narrower gross profit." },
  { metric: "% of operators profitable",    maine: "n/a",     national: "27.3% (Whitney 2024)",    whyDiff: "Up from 24.55% in 2023 but still well below 42.4% in 2022 — the post-rescheduling projection is +5–7 pts." }
];

const revenueBenchmarks = [
  { tier: "Mature markets (CO, CA, OR)",              avgAnnual: "$1.5–2.5M",  competition: "Intense",     driver: "Saturation; operating at the floor of margin curve" },
  { tier: "Maine / Northern New England",              avgAnnual: "$0.7–1.5M*", competition: "Moderate",    driver: "Population 1.4M; 187 active stores; 60% sales in two counties" },
  { tier: "Growing markets (NJ, NY, MD)",              avgAnnual: "$2.5–4M",    competition: "Limited",     driver: "License caps; recent launches; high AOV ($54+)" },
  { tier: "Limited-license markets (IL, MA)",          avgAnnual: "$3–5M+",     competition: "Oligopoly",   driver: "License caps + tourist + cross-border from no-legal neighbors" },
  { tier: "Saturated micro-markets (parts of CA)",     avgAnnual: "Under $1M",  competition: "Oversaturated", driver: "5+ operators per square mile; price war" },
  { tier: "Top performers (any market)",               avgAnnual: "$5M+",       competition: "Brand-led",   driver: "Curated experience + loyalty program + accessories 12%+ of revenue" }
];

const faqItems = [
  {
    question: "How much does it cost to open a cannabis dispensary in Maine?",
    answer: `Total Maine dispensary startup costs run about $300,000 to $700,000 for a single retail location, which is roughly half to a third of the $700,000–$2,000,000 national average (Cova, WebJoint, Cannstrategy 2025). The lower Maine ceiling reflects three structural factors: (1) the OCP conditional license application fee is $500 (28-B M.R.S. §207), well below limited-license states that run $20,000–$100,000+ for the application alone; (2) Maine retail real estate averages $12–$35/sqft NNN outside Portland, vs. $32+/sqft nationally for top metros; and (3) Maine has no statewide license cap, so there is no equity-license secondary-market premium layered on. The cost components you actually need to budget: license + municipality fees ($1,500–$6,000 typical, up to $25,000 in Portland), buildout + fixtures ($80–$250K for 1,200–1,800 sqft), opening inventory ($50–$120K at wholesale), security + Metrc ($8–$40K), and 12 months of working capital (rent + payroll + insurance, ~$240–$360K for a 3-employee operation). Anything below $300K means you are skipping buildout, inventory depth, or working-capital runway — all three failure modes are well-documented in closed-shop post-mortems.`
  },
  {
    question: "How profitable is a cannabis dispensary in Maine vs. nationally?",
    answer: `Maine dispensaries land at the upper end of national profitability bands because of the state's mature-market discipline and lower rent. The breakdown from the most-cited 2025-2026 operator surveys: gross margin (retail only) 40–50% in Maine vs. 25–45% nationally (MJBiz/Whitney), operating margin (pre-tax) 15–22% in Maine vs. 12–21% nationally (Munchmakers), and net margin after 280E 5–12% in Maine vs. 3–12% nationally (Northstar CFO benchmarks). The crucial caveat: only 27.3% of U.S. cannabis operators were profitable in 2024 per the Whitney Economics / Vangst Jobs Report 2025 — with another 40.6% breaking even and 32.2% unprofitable. Maine-specific profitability data isn't publicly published, but the state's mature-market positioning, lower real-estate cost, and lack of statewide license cap suggest Maine operators skew toward the upper third of the national profitability distribution. The post-rescheduling upside (federal Schedule III reclassification, expected late 2026) would unlock ~$268K in annual deductions per typical dispensary (Headset analysis).`
  },
  {
    question: "What is the average annual revenue for a Maine cannabis dispensary?",
    answer: `Using the OCP-reported aggregate of $246.4M in adult-use sales divided across 187 active AU retail stores, the 2025 Maine dispensary average lands at approximately $1.32M annual revenue. That puts Maine above the Cova/Munchmakers-quoted national average of $1.8–$2.2M per location... wait, no — Maine is actually BELOW the national average. Maine's per-store revenue of $1.32M trails the national $1.8–2.2M average because Maine's mature-market saturation and lower prices ($6.62/g vs. $8.92/g national average) compress dollar revenue per store, even where transaction volume is competitive. For comparison, top-tier limited-license markets (Illinois at $4M+/store, Massachusetts at similar, New York at ~$4M in 2026 per MJBizDaily) more than double Maine's per-store revenue. The flip side: Maine's lower entry cost ($400K typical startup vs $700K–$2M nationally) means the per-dollar payback ratio is competitive. The top-quartile operators across all markets pull $5M+ annually through accessory/category mix discipline — a tactic that works in Maine too.`
  },
  {
    question: "How long does it take to break even on a Maine dispensary?",
    answer: `Industry-standard break-even projections for a Maine dispensary run 18 to 36 months from opening, depending on capitalization and location. The math uses a typical mid-market model: $400,000 startup capital, ~$40,000–$60,000 in monthly gross revenue, ~$15,000–$20,000 in monthly operating expenses, and ~5,000–$8,000 in monthly net profit after 280E. At that rate, payback is 50–80 months — which is why operators who plan for it use either deeper capitalization ($600K+ to absorb 24 months of slow ramp) or a lower-friction location (rural Maine with $0–$1/sqft rent delta vs Portland) to compress the runway. The honest framing: 24 months to positive operating cash flow is realistic; full recovery of total invested capital typically runs 3–4 years in Maine for a well-run mid-market operator, and 5+ years in saturated locations. WebJoint's industry-wide model for a $700K startup shows break-even at 24–30 months with consistent performance and no regulatory surprises — Maine lands faster because of lower entry cost, but slower in Portland specifically because of lease-and-competition drag.`
  },
  {
    question: "Is 280E the biggest tax burden for Maine dispensaries?",
    answer: `Yes — IRC §280E is the single most destructive force on cannabis dispensary profitability, both in Maine and nationally. Federal cannabis remains Schedule I, which means standard business deductions (rent, payroll, marketing, utilities) are disallowed for federal tax purposes; only Cost of Goods Sold is deductible. The result is an effective federal tax rate that falls between 60% and 80% of pre-tax income for profitable operators (Northstar Financial CFO benchmarks; Munchmakers 2025), versus 25–35% for a comparable conventional retailer. In practice: a Maine dispensary with $2M revenue and $300K pre-tax net income pays roughly $190–225K in federal tax alone, consuming 60–75% of pre-tax income. The Maine-side tax stack adds 14.0% retail sales tax on adult-use (since Jan 1, 2026; was 10% prior per P.L. 2025, ch. 388) plus 5.5% state sales tax on medical, and 280E interacts with each. Federal rescheduling to Schedule III — currently in DEA rulemaking — would eliminate 280E restrictions and unlock an estimated $1.6–2.2B in industry-wide annual after-tax cash flow (Headset, 2025), or roughly $268K per typical dispensary per year.`
  },
  {
    question: "How does Maine dispensary profitability compare to other states?",
    answer: `Maine lands in the upper-third of state profitability rankings when normalized for cost-of-entry — even though Maine's per-store annual revenue ($1.32M) is below the national median ($1.8–2.2M). The reason: Maine's total cost of entry ($300–$700K) is roughly half the national average ($700K–$2M), and Maine's rental overhead is 20–40% below the major-metro average. The competitive states-and-Maine comparison table on this page covers all 36 reporting markets; key takeaways from the 2025 ranking: California leads in absolute sales ($4.06B) but trails on profitability (price compression, 33% illicit-market leakage); New York at $1.6B sales with average $4M/store revenue is the highest per-store figure but lowest per-store profitability (20% of microbusinesses report profitability per MJBizDaily's June 2026 survey); Illinois at $2.17B suffers from the 36.25% effective tax rate driving cross-border leakage to Missouri and Michigan. Maine's competitive position: less upside in best-case market scenarios than IL or MA on absolute revenue, but better risk-adjusted returns because of low entry cost and the post-2024 plateau stabilizing the market. For an investor calculating the risk-adjusted ROI, Maine belongs in the same conversation as Maryland, Vermont, and Connecticut — moderate revenue, lower entry, mature-operator profile.`
  },
  {
    question: "What is dispensary ROI?",
    answer: `Dispensary ROI (return on investment) measures the total profit a cannabis retail operation generates relative to its startup capital, typically expressed as a percentage or payback period. For Maine dispensaries specifically, the 2025 industry benchmarks are: 18-36 month payback to operating cash flow positive, 3-4 year payback to full capital recovery for a well-run mid-market operator, and a 9.2% average net margin after 280E (Northstar Financial CFO benchmarks). The formula: ROI = (Total Profit Over Period / Total Capital Invested) × 100. A Maine dispensary with $400K startup capital generating $1.32M annual revenue and 9.2% net margin produces ~$121K/year in net profit, for a 30% annual return on the original capital — competitive with most small-business categories but constrained by 280E's effective 60-80% federal tax burden on pre-tax income. The headline ROI number alone is misleading without context on (a) payback period vs. holding horizon, (b) whether the operator is paying themselves market salary or below-market, and (c) tax-adjusted vs. pre-tax returns.`
  },
  {
    question: "What is a good profit margin for a dispensary?",
    answer: `A good profit margin for a cannabis dispensary depends on which margin you're measuring and the regulatory environment: gross margin (retail only, before operating expenses) is 40-50% for Maine operators vs. 25-45% nationally (MJBiz/Whitney 2025); operating margin (pre-tax, after operating expenses but before 280E) is 15-22% in Maine vs. 12-21% nationally (Munchmakers 2025); net margin after 280E is 5-12% in Maine vs. 3-12% nationally (Northstar CFO benchmarks). The "good" benchmark for a single-location Maine dispensary: 9%+ net margin post-280E puts you in the upper third of operators nationally. The critical caveat: only 27.3% of U.S. cannabis operators were profitable in 2024 per the Whitney Economics / Vangst Jobs Report 2025 — meaning 72.7% of operators are at break-even or losing money. Maine skews better because of mature-market discipline, lower rent, and absence of a statewide license cap. The federal rescheduling to Schedule III (currently in DEA rulemaking, expected late 2026) would eliminate 280E restrictions and unlock roughly $268K in additional annual deductions per typical dispensary per Headset's 2025 analysis — potentially doubling the post-tax net margin for affected operators.`
  }
];

const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/<[^>]+>/g, '') }
  }))
});
---

<Layout 
  title="Dispensary ROI Calculator: Break-Even & Net Margin Analysis (2026)" 
  description="Calculate dispensary ROI, break-even point, and net margin. Maine-specific data: $1.32M avg annual revenue, 9.2% net margin post-280E, 18-36 month payback."
  heroImage="/images/heroes/roi-calculator.jpg"
  article={{ author: "Margaret Finch", authorTitle: "Finance & Taxation Analyst", authorId: "margaret-finch", publishDate: "2026-01-15", modifiedDate: "2026-07-10", section: "Finance" }}
>
  <style>

  .guide-header { text-align: center; margin-bottom: 3rem; position: relative; z-index: 10; }
  .hero-badge { display: inline-block; background: var(--color-primary); color: white; padding: 0.5rem 1rem; border-radius: 2rem; font-size: 0.75rem; font-weight: 700; margin-bottom: 1.5rem; }
  .lead { font-size: 1.25rem; color: var(--color-text-light); max-width: 700px; margin: 0 auto; line-height: 1.6; }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 4rem;
    background: var(--color-primary);
    padding: 2rem;
    border-radius: 1.5rem;
    position: relative;
    z-index: 10;
  }
  .stat-item { text-align: center; color: white; }
  .stat-value { display: block; font-family: var(--font-serif); font-size: 2.5rem; font-weight: 700; line-height: 1; margin-bottom: 0.5rem; }
  .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85; }

  .content-section { margin-bottom: 4rem; position: relative; z-index: 10; }
  .content-section h2 { font-size: 1.75rem; margin-bottom: 1.5rem; color: var(--color-text); }
  .content-section h3 { font-size: 1.15rem; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--color-text); }
  .content-section p { font-size: 1rem; line-height: 1.7; color: var(--color-text); margin-bottom: 1rem; }
  .content-section ul { margin-left: 1.5rem; margin-bottom: 1rem; }
  .content-section li { font-size: 0.95rem; line-height: 1.6; color: var(--color-text); margin-bottom: 0.5rem; }

  .callout-box {
    display: flex;
    gap: 1.25rem;
    padding: 1.75rem;
    background: rgba(88, 129, 87, 0.08);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 1rem 1rem 0;
    margin: 2rem 0;
  }
  .callout-box.warning { background: rgba(180, 100, 60, 0.08); border-left-color: var(--color-warning); }
  .callout-box.accent { background: rgba(163, 177, 138, 0.15); border-left-color: var(--color-accent); }
  .callout-icon { font-size: 1.25rem; color: var(--color-text); flex-shrink: 0; }
  .callout-box.warning .callout-icon { color: var(--color-warning); }
  .callout-box.accent .callout-icon { color: var(--color-accent); }
  .callout-content { font-size: 0.95rem; line-height: 1.6; }
  .callout-content strong { display: block; margin-bottom: 0.5rem; font-size: 1rem; }
  .callout-content p { margin-bottom: 0; }
  .callout-content ul { margin-top: 0.75rem; margin-bottom: 0; }

  .location-comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 2rem 0; }
  .location-card { padding: 1.75rem; background: var(--color-surface); border-radius: 1rem; border: 1px solid var(--color-border); }
  .location-card h4 { margin-top: 0; margin-bottom: 1rem; color: var(--color-text); font-size: 1.1rem; }
  .location-card ul { margin: 0; padding-left: 1.25rem; }
  .location-card li { font-size: 0.9rem; margin-bottom: 0.4rem; }

  .margin-breakdown {
    background: var(--color-surface);
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    padding: 2rem;
    margin: 2rem 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }
  .margin-row { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); }
  .margin-row:last-child { border-bottom: none; }
  .margin-row.deduction { color: var(--color-accent); }
  .margin-row.gross { font-weight: 600; color: var(--color-text); }
  .margin-row.net { font-weight: 700; font-size: 1.1rem; color: var(--color-primary); border-top: 2px solid var(--color-primary); padding-top: 1rem; margin-top: 0.5rem; }
  .margin-label { color: var(--color-text); }
  .margin-row.deduction .margin-label { color: var(--color-accent); }
  .margin-value { font-weight: 600; }

  .strategy-comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin: 2rem 0; }
  .strategy-card { padding: 1.75rem; background: var(--color-surface); border-radius: 1rem; border: 1px solid var(--color-border); }
  .strategy-card h3 { margin-top: 0; margin-bottom: 1rem; color: var(--color-text); font-size: 1.15rem; }
  .strategy-card p { font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.75rem; }
  .strategy-verdict { font-size: 0.85rem; color: var(--color-text-light); font-style: italic; margin-bottom: 0; }

  .case-study {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--color-background);
    border-radius: 1rem;
  }
  .case-metric { text-align: center; }
  .case-metric .metric-label { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-light); margin-bottom: 0.25rem; }
  .case-metric .metric-value { display: block; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--color-text); }

  .variables-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin: 2rem 0; }
  .variable-card { padding: 1.5rem; background: var(--color-surface); border-radius: 1rem; border: 1px solid var(--color-border); }
  .variable-card h4 { margin-top: 0; margin-bottom: 0.75rem; color: var(--color-text); font-size: 1rem; }
  .variable-card p { font-size: 0.9rem; line-height: 1.5; margin-bottom: 0; color: var(--color-text-light); }

  .section-divider { border: none; border-top: 1px solid var(--color-border); margin: 4rem 0 3rem; }

  .calculator-section { margin-bottom: 4rem; position: relative; z-index: 10; }
  .calculator-section h2 { font-size: 1.75rem; margin-bottom: 1rem; color: var(--color-text); }
  .calculator-intro { font-size: 1rem; color: var(--color-text-light); margin-bottom: 3rem; max-width: 600px; }

  .calc-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 3rem;
    background: var(--color-surface);
    padding: 4rem;
    border-radius: 2rem;
    border: 1px solid var(--color-border);
    box-shadow: 0 20px 50px rgba(0,0,0,0.03);
  }

  .input-section { margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-background); }
  .input-section h3 { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-light); margin-bottom: 1.5rem; font-weight: 600; }
  .input-group label { display: block; font-weight: 600; margin-bottom: 0.75rem; font-size: 0.9rem; }

  .currency-input { display: flex; align-items: center; font-size: 1.75rem; font-weight: 700; color: var(--color-primary); border-bottom: 2px solid var(--color-primary); }
  .currency-input.small { font-size: 1.25rem; }
  .currency-input input { border: none; padding: 0.5rem; width: 100%; font-weight: 700; color: var(--color-primary); background: transparent; }
  .currency-input input:focus { outline: none; }

  .slider { width: 100%; height: 6px; background: var(--color-background); border-radius: 3px; appearance: none; outline: none; }
  .slider::-webkit-slider-thumb { appearance: none; width: 20px; height: 20px; background: var(--color-primary); border-radius: 50%; cursor: pointer; }
  .slider-value { margin-top: 0.75rem; font-weight: 700; color: var(--color-text); font-size: 0.85rem; }

  .calc-results { display: flex; flex-direction: column; gap: 1.25rem; }
