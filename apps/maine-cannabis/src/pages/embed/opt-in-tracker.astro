---
import optInData from '../../data/maine-opt-in-towns.json';

const meta = optInData.meta as {
  as_of: string;
  town_count: number;
  counties_covered: number;
  source: string;
  source_url: string;
  license: string;
  last_updated: string;
};
const towns = optInData.towns as Array<{
  town: string;
  county: string;
  type: string;
  year_opted_in: number | null;
  license_fee_usd: number | null;
  dispensaries_operating: number | null;
  notes: string;
}>;
const totalDispensaries: number = towns.reduce((sum: number, t) => sum + (t.dispensaries_operating || 0), 0);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Embeddable Maine cannabis municipal opt-in tracker — towns opted in, towns opted out, source of record from the Maine Office of Cannabis Policy. Authored by Eliot Nash (Maine Dispensary Guide). CC BY 4.0. Reviewed 2026-07-11." />
  <meta name="author" content="Eliot Nash" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href="https://mainedispensaryguide.com/guides/maine-cannabis-opt-in-tracker" />
  <title>Maine Cannabis Opt-In Tracker — Embedded</title>
  <style>
    * { box-sizing: border-box; }
    body { 
      margin: 0; padding: 1rem; 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      background: #faf8f4; color: #1a1a1a; 
    }
    .header { border-bottom: 2px solid #2d5f3f; padding-bottom: 0.75rem; margin-bottom: 1rem; }
    .header h1 { margin: 0; font-size: 1.25rem; color: #2d5f3f; }
    .meta { font-size: 0.75rem; color: #666; margin-top: 0.25rem; }
    .meta a { color: #2d5f3f; text-decoration: none; }
    .meta a:hover { text-decoration: underline; }
    .stats { display: flex; gap: 1rem; margin: 1rem 0; flex-wrap: wrap; }
    .stat { background: white; border: 1px solid #d0c8b8; border-radius: 0.375rem; padding: 0.625rem 0.875rem; }
    .stat-num { font-size: 1.25rem; font-weight: 700; color: #2d5f3f; }
    .stat-label { font-size: 0.75rem; color: #666; }
    table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; background: white; }
    th { background: #2d5f3f; color: white; padding: 0.5rem 0.625rem; text-align: left; font-weight: 600; }
    td { padding: 0.5rem 0.625rem; border-bottom: 1px solid #e8e0d0; }
    tr:nth-child(even) { background: #f8f4ec; }
    tr:hover { background: #f0ebde; }
    .footer { margin-top: 1rem; padding-top: 0.5rem; border-top: 1px solid #d0c8b8; font-size: 0.6875rem; color: #888; text-align: center; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Maine Cannabis Opt-In Tracker</h1>
    <div class="meta">
      As of {meta.as_of} · Source: <a href="https://mainedispensaryguide.com/guides/maine-cannabis-opt-in-tracker" target="_blank" rel="noopener">Maine Dispensary Guide</a>
    </div>
  </div>
  <div class="stats">
    <div class="stat"><div class="stat-num">{meta.town_count}</div><div class="stat-label">Towns opted in</div></div>
    <div class="stat"><div class="stat-num">{totalDispensaries}+</div><div class="stat-label">Dispensaries operating</div></div>
    <div class="stat"><div class="stat-num">{meta.counties_covered}</div><div class="stat-label">Counties</div></div>
  </div>
  <table>
    <thead>
      <tr>
        <th>Town</th>
        <th>County</th>
        <th>Year</th>
        <th>Fee</th>
        <th>Dispo</th>
      </tr>
    </thead>
    <tbody>
      {towns.map(t => (
        <tr>
          <td>{t.town}</td>
          <td>{t.county}</td>
          <td>{t.year_opted_in || '—'}</td>
          <td>{t.license_fee_usd ? `$${t.license_fee_usd.toLocaleString()}` : '—'}</td>
          <td>{t.dispensaries_operating || '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="footer">
    Data: CC BY 4.0 · Cite mainedispensaryguide.com · <a href="https://mainedispensaryguide.com/for-journalists" target="_blank" rel="noopener">Embed this widget</a>
  </div>
</body>
</html>
