const article = {
  author: "Eliot Nash",
  authorId: "eliot-nash",
  authorTitle: "Market & Real Estate Analyst",
  publishDate: "2026-05-13",
  modifiedDate: "2026-05-13",
  section: "City Guides"
};

const topics = ["city", "market"];

const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How many dispensaries are in Bridgton, Maine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bridgton has 3-4 active dispensaries across medical and adult-use markets, including Canuvo Recreational Cannabis at 152 Portland Road and Maine Only Medical at 316 Portland Road. The town serves a regional market of 20,000+ residents."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bridgton require a local cannabis license?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bridgton requires municipal authorization for cannabis businesses in addition to the Maine OCP state license. Town approval fees are typically $2,000-2,500 annually, with OCP state fees adding $500-$1,500 depending on license tier."
      }
    },
    {
      "@type": "Question",
      "name": "Can I deliver cannabis from Bridgton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Licensed dispensaries in Bridgton can deliver to any municipality in Maine, regardless of whether that town has opted in to cannabis retail. This is particularly valuable for serving surrounding towns like Fryeburg, Harrison, and Brownfield that lack dispensaries of their own."
      }
    },
    {
      "@type": "Question",
      "name": "What is the best location for a dispensary in Bridgton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Portland Road (Route 302) is the primary retail corridor in Bridgton, with multiple existing dispensaries. High visibility and easy access from Route 117 and Route 302 intersections provide the best customer capture."
      }
    }
  ]
});
---
<CityGuide
