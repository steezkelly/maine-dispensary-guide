---
import Layout from '../../layouts/Layout.astro';
import Callout from '../../components/Callout.astro';
import authorizationData from '../../data/maine-municipal-authorization.json';

const { meta, municipalities } = authorizationData;
const article = {
  author: 'Eliot Nash',
  authorId: 'eliot-nash',
  reviewer: { name: 'Margaret Finch', jobTitle: 'Finance & Taxation Analyst', id: 'margaret-finch' },
  authorTitle: 'Market & Real Estate Analyst',
  publishDate: meta.retrieved_at,
  modifiedDate: meta.retrieved_at,
  section: 'Business Essentials',
};
const topics = ['licensing', 'compliance', 'real-estate'];
const statusGroups = {
  retail_authorized: municipalities.filter((municipality) => municipality.status === 'retail_authorized'),
  explicit_opt_out: municipalities.filter((municipality) => municipality.status === 'explicit_opt_out'),
  no_recorded_retail_authorization: municipalities.filter((municipality) => municipality.status === 'no_recorded_retail_authorization'),
};
const formatDate = (value: string) => new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(value));
const formatOcpRefresh = (value: string) => value.replace('T', ' ').replace(/\.\d+$/, '');
const typeLabel = (type: string) => type.charAt(0).toUpperCase() + type.slice(1);
---

<Layout
  title={`Maine Cannabis Municipal Authorization Tracker: ${meta.municipality_count} Municipalities`}
  description={`Search all ${meta.municipality_count} incorporated Maine municipalities, including cities, towns, and plantations, with OCP adult-use authorization by activity.`}
  article={article}
  topics={topics}
  heroImage="/images/heroes/ocp-license-map.jpg"
  continuationMode="pilot"
>
  <style>
    .subtitle { font-size: 1.2rem; color: var(--color-text-light); margin: 0 0 1.75rem; }
    .summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1.5rem 0 2rem; }
    .summary-card { border: 1px solid var(--color-border); border-radius: 0.5rem; padding: 1rem; background: var(--color-surface, #fff); }
    .summary-card strong { display: block; font-size: 1.7rem; color: var(--color-primary); }
    .summary-card span { color: var(--color-text-light); font-size: 0.9rem; }
    .metadata { color: var(--color-text-light); font-size: 0.9rem; }
    .tracker-controls { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; margin: 1rem 0; }
    .tracker-controls label { display: grid; gap: 0.35rem; font-weight: 600; }
    .tracker-controls input { min-width: min(100%, 24rem); padding: 0.65rem 0.75rem; border: 1px solid var(--color-border); border-radius: 0.25rem; font: inherit; }
    .table-wrap { overflow-x: auto; margin: 1rem 0 2.5rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.94rem; }
    th, td { padding: 0.7rem; text-align: left; border-bottom: 1px solid var(--color-border); vertical-align: top; }
    th { background: var(--color-surface-alt, #f7f7f5); white-space: nowrap; }
    .activity { font-weight: 700; text-align: center; }
    .activity--yes { color: #176b45; }
    .activity--no { color: var(--color-text-light); }
    .empty-row { color: var(--color-text-light); font-style: italic; }
    .methodology { border-left: 3px solid var(--color-primary); padding: 0.25rem 1rem; margin: 1.25rem 0; }
    @media (max-width: 680px) { .summary-grid { grid-template-columns: 1fr; } th, td { padding: 0.55rem; } }
  </style>

  <article>
    <header class="article-header">
      <h1>Maine Cannabis Municipal Authorization Tracker</h1>
      <p class="subtitle">A searchable, alphabetical directory of all {meta.municipality_count} incorporated Maine municipalities: {meta.municipality_type_counts.city} cities, {meta.municipality_type_counts.town} towns, and {meta.municipality_type_counts.plantation} plantations.</p>
    </header>

    <Callout title="Use this as a starting point, not a lease approval" type="warning">
      OCP’s activity flags show municipal authorization recorded by the state. They do not confirm zoning, a current moratorium, a local license, or an operating cannabis business. Verify your address with the town clerk and OCP before signing a lease or investing.
    </Callout>

    <section>
      <h2>What this directory means</h2>
      <p>This page joins Maine’s incorporated-municipality registry with OCP’s Adult Use Opt-in Communities report. It fixes the old partial lists and separates three different facts: OCP-recorded retail authorization, primary-source-supported explicit opt-outs, and municipalities with no OCP-recorded retail authorization.</p>
      <p class="methodology"><strong>Important:</strong> “No recorded retail authorization” is not an explicit opt-out. It means this OCP snapshot does not record retail authorization for that municipality. We do not label a municipality as opted out without a primary local record.</p>
      <div class="summary-grid" aria-label="Municipal authorization summary">
        <div class="summary-card"><strong>{meta.status_counts.retail_authorized}</strong><span>Retail authorized by OCP</span></div>
        <div class="summary-card"><strong>{meta.status_counts.explicit_opt_out}</strong><span>Explicit opt-outs with primary evidence</span></div>
        <div class="summary-card"><strong>{meta.status_counts.no_recorded_retail_authorization}</strong><span>No recorded retail authorization / no decision</span></div>
      </div>
      <p class="metadata">OCP report model refresh: <strong>{formatOcpRefresh(meta.ocp_model_refreshed_at)}</strong> (timezone not supplied by OCP). Directory retrieved: <strong>{formatDate(meta.retrieved_at)}</strong>. Geography: <a href={meta.geography_source_url} target="_blank" rel="noopener noreferrer">Maine GeoLibrary</a>. Authorization source: <a href={meta.source_url} target="_blank" rel="noopener noreferrer">Maine Office of Cannabis Policy</a>.</p>
    </section>

    <section>
      <h2>Search the statewide directory</h2>
      <div class="tracker-controls">
        <label for="municipality-search">Municipality or county
          <input id="municipality-search" type="search" placeholder="e.g., Portland or Aroostook" autocomplete="off" />
        </label>
      </div>
      <p id="search-result-note" class="metadata" aria-live="polite">Showing all {meta.municipality_count} incorporated municipalities.</p>
    </section>

    <section>
      <h2>Retail authorized ({statusGroups.retail_authorized.length})</h2>
      <p>These municipalities are alphabetically ordered and have an OCP-recorded <strong>Y</strong> for adult-use retail authorization.</p>
      <div class="table-wrap">
        <table aria-label="Maine municipalities with OCP-recorded adult-use retail authorization">
          <thead><tr><th scope="col">Municipality</th><th scope="col">County</th><th scope="col">Type</th><th scope="col">Retail</th><th scope="col">Cultivation</th><th scope="col">Manufacturing</th><th scope="col">Testing</th></tr></thead>
          <tbody>
            {statusGroups.retail_authorized.map((municipality) => <tr data-municipality-row data-status="retail_authorized" data-search={`${municipality.name} ${municipality.county} ${municipality.municipality_type}`.toLowerCase()}><td>{municipality.name}</td><td>{municipality.county}</td><td>{typeLabel(municipality.municipality_type)}</td><td class={`activity activity--${municipality.retail === 'Y' ? 'yes' : 'no'}`}>{municipality.retail}</td><td class={`activity activity--${municipality.cultivation === 'Y' ? 'yes' : 'no'}`}>{municipality.cultivation}</td><td class={`activity activity--${municipality.manufacturing === 'Y' ? 'yes' : 'no'}`}>{municipality.manufacturing}</td><td class={`activity activity--${municipality.testing === 'Y' ? 'yes' : 'no'}`}>{municipality.testing}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Explicit opt-outs ({statusGroups.explicit_opt_out.length})</h2>
      <p>Entries appear here only after we have a primary local record of an explicit opt-out. This snapshot has no such records in the generated dataset; absence from OCP is not an explicit opt-out.</p>
      <div class="table-wrap">
        <table aria-label="Maine municipalities with primary-source-supported explicit opt-outs">
          <thead><tr><th scope="col">Municipality</th><th scope="col">County</th><th scope="col">Type</th><th scope="col">Retail</th><th scope="col">Cultivation</th><th scope="col">Manufacturing</th><th scope="col">Testing</th></tr></thead>
          <tbody>
            {statusGroups.explicit_opt_out.length === 0 ? <tr><td class="empty-row" colspan="7">No explicit opt-outs are presented without primary local evidence.</td></tr> : statusGroups.explicit_opt_out.map((municipality) => <tr data-municipality-row data-status="explicit_opt_out" data-search={`${municipality.name} ${municipality.county} ${municipality.municipality_type}`.toLowerCase()}><td>{municipality.name}</td><td>{municipality.county}</td><td>{typeLabel(municipality.municipality_type)}</td><td>{municipality.retail}</td><td>{municipality.cultivation}</td><td>{municipality.manufacturing}</td><td>{municipality.testing}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>No recorded retail authorization / no decision ({statusGroups.no_recorded_retail_authorization.length})</h2>
      <p>These alphabetically ordered municipalities have no OCP-recorded retail authorization in this snapshot. A <strong>Y</strong> in another column means OCP records authorization for that separate activity. Contact the town clerk for the current local position.</p>
      <div class="table-wrap">
        <table aria-label="Maine municipalities without OCP-recorded adult-use retail authorization">
          <thead><tr><th scope="col">Municipality</th><th scope="col">County</th><th scope="col">Type</th><th scope="col">Retail</th><th scope="col">Cultivation</th><th scope="col">Manufacturing</th><th scope="col">Testing</th></tr></thead>
          <tbody>
            {statusGroups.no_recorded_retail_authorization.map((municipality) => <tr data-municipality-row data-status="no_recorded_retail_authorization" data-search={`${municipality.name} ${municipality.county} ${municipality.municipality_type}`.toLowerCase()}><td>{municipality.name}</td><td>{municipality.county}</td><td>{typeLabel(municipality.municipality_type)}</td><td class={`activity activity--${municipality.retail === 'Y' ? 'yes' : 'no'}`}>{municipality.retail}</td><td class={`activity activity--${municipality.cultivation === 'Y' ? 'yes' : 'no'}`}>{municipality.cultivation}</td><td class={`activity activity--${municipality.manufacturing === 'Y' ? 'yes' : 'no'}`}>{municipality.manufacturing}</td><td class={`activity activity--${municipality.testing === 'Y' ? 'yes' : 'no'}`}>{municipality.testing}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>How to verify a location</h2>
      <ol>
        <li>Check the OCP activity flags above for the business type you plan to operate.</li>
        <li>Ask the town clerk or planning office whether the municipality has changed its ordinance or imposed a moratorium.</li>
        <li>Confirm zoning, separation requirements, local licensing, and your exact address before committing to a lease.</li>
      </ol>
    </section>

    <p class="editorial-note"><strong>Correction note.</strong> This page supersedes the former partial opt-in and opt-out tables. It is generated from the primary sources linked above and will be refreshed when the OCP source changes.</p>
  </article>

  <script>
    const search = document.querySelector<HTMLInputElement>('#municipality-search');
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('[data-municipality-row]')];
    const note = document.querySelector<HTMLParagraphElement>('#search-result-note');
    if (search && note) {
      search.addEventListener('input', () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;
        rows.forEach((row) => {
          const matches = !query || row.dataset.search?.includes(query);
          row.hidden = !matches;
          if (matches) visible += 1;
        });
        note.textContent = query ? `Showing ${visible} matching municipalities.` : `Showing all ${rows.length} incorporated municipalities.`;
      });
    }
  </script>
</Layout>
