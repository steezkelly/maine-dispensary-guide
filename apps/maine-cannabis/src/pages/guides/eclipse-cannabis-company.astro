---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';

const article = {
  author: "Eliot Nash",
  authorId: "eliot-nash",
  authorTitle: "Market & Real Estate Analyst",
  publishDate: "2026-07-04",
  modifiedDate: "2026-07-04",
  section: "City Guides"
};

const topics = ["city", "market"];

const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Where is Eclipse Cannabis in Maine?", "acceptedAnswer": { "@type": "Answer", "text": "Eclipse Cannabis Company operates two Maine locations: the main dispensary at 1259 Roosevelt Trail, Raymond, ME 04071, and a second location at 44 Pigeon Hill Road, Mechanic Falls, ME 04256. Phone 1-(207)-302-0034. The Raymond location is open 8am-8pm every day per the operator's site." }},
    { "@type": "Question", "name": "Is Eclipse a medical or adult-use dispensary?", "acceptedAnswer": { "@type": "Answer", "text": "Per the Weedmaps listing, the Raymond location is listed as 'Medical' with curbside pickup available. Confirm directly with the operator whether the Raymond location accepts adult-use (21+) customers or is medical-only. The operator's site indicates 'recreational' in the address references but the Weedmaps license classification is medical." }},
    { "@type": "Question", "name": "What is the service area for Eclipse Raymond?", "acceptedAnswer": { "@type": "Answer", "text": "Eclipse Cannabis Company at 1259 Roosevelt Trail serves the Sebago Lakes / Route 302 corridor: Raymond, Windham, Casco, Otisfield, Naples, Sebago, Standish, Gray, and the greater Portland / Windham region. Raymond is on Route 302 between Portland and Bridgton, with high visibility from the main highway." }},
    { "@type": "Question", "name": "What products does Eclipse carry?", "acceptedAnswer": { "@type": "Answer", "text": "Per the Weedmaps listing, Eclipse offers curbside pickup and is classified as a medical dispensary. The Raymond location is one of the better-rated operators in Cumberland County at 4.6+ stars. Confirm current menu with the operator." }},
    { "@type": "Question", "name": "Does Eclipse have a second Maine location?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Per the operator's site, Eclipse also operates a dispensary at 44 Pigeon Hill Road, Mechanic Falls, ME 04256. The Mechanic Falls location has different hours: Mon-Thu 10am-7pm, Fri-Sat 8am-8pm, Sun 8am-6pm. Verify hours with the operator before visiting either location." }}
  ]
});
---

<Layout title="Eclipse Cannabis — Raymond Maine Dispensary (2026)" description="Eclipse Cannabis Company is a Maine cannabis dispensary at 1259 Roosevelt Trail, Raymond, ME 04071. Phone 1-(207)-302-0034. Open 8am-8pm daily. Serves the Sebago Lakes / Route 302 corridor. Also operates a second location in Mechanic Falls." heroImage="/images/heroes/raymond-dispensary-guide.jpg" article={article} topics={topics} >
<style>
  article { max-width: 720px; margin: 0 auto; }
  .article-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .subtitle { font-size: 1.125rem; color: var(--color-text-light); }
  section { margin-bottom: 2.5rem; }
  section h2, section h3 { margin-top: 1.5rem; }
  section h2:first-child { margin-top: 0; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { padding: 0.6rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  th { background: var(--color-background); }
  ul, ol { padding-left: 1.5rem; }
  li { margin-bottom: 0.4rem; }
  .disclaimer { background: var(--color-disclaimer-bg); border: 1px solid var(--color-disclaimer-border); padding: 1rem; border-radius: 0.5rem; font-size: 0.875rem; color: var(--color-disclaimer-text); }
  .fact-box { background: rgba(88, 129, 87, 0.1); padding: 1.75rem; border-radius: 1rem; border-left: 4px solid var(--color-primary); }
