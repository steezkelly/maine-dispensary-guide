        <li><a href="/guides/sebago-lakes-region-dispensary-guide">Sebago Lakes Region Dispensary Guide</a> — broader regional overview</li>
      </ul>
    </div>
  </section>

  <section class="faq-section">
    <h2>Frequently Asked Questions</h2>
    <Faq
      questions={[
        { q: "Where is Eclipse Cannabis in Maine?", a: "1259 Roosevelt Trail, Raymond, ME 04071 (main). Also 44 Pigeon Hill Road, Mechanic Falls, ME 04256. Phone 1-(207)-302-0034." },
        { q: "Is Eclipse medical or adult-use?", a: "Per Weedmaps, medical at the Raymond location with curbside pickup. Confirm adult-use acceptance directly with the operator." },
