---
// A–Z index of every Maine town with a dispensary guide page on MDG.
// Built at request time by scanning `apps/maine-cannabis/src/pages/guides/`
// for `*-dispensary-guide.astro` files. New towns added via the standard
// `new-page` worktree convention will appear here automatically on the
// next build — no separate registry maintenance needed.
//
// Purpose: solves the orphan-page churn for small towns that fall off the
// bottom of /find-a-dispensary. Each entry also gets an inbound link from
// this hub, satisfying the orphan-detector check and giving Googlebot a
// clear crawl path. The regions data file (`apps/maine-cannabis/src/data/
// cluster-regions.json`) categorizes the same towns into 5 regional hubs;
// this page provides the alphabetical escape hatch for any region.
//
// Single frontmatter; never inline-edit — use tools instead.
import fs from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import AutoRelated from '../../components/AutoRelated.astro';

const SITE_URL = 'https://mainedispensaryguide.com';

// Build the A–Z list at request time. Astro pages run from the
// apps/maine-cannabis/ directory in the build pipeline; resolve the
// guides/ subdir relative to that cwd so the page works both in
// `npm run build` and `astro check` modes. The same convention is used
// by /site-health for fs reads — confirmed working pattern.
function buildCityList() {
  let entries;
  try {
    // Build runs from apps/maine-cannabis/ cwd. readdirSync returns the
    // current set of guides pages — single source of truth, no separate
    // registry to drift.
    entries = fs.readdirSync('src/pages/guides');
  } catch {
    return [];
  }
  const cities = [];
  for (const f of entries) {
    if (!f.endsWith('-dispensary-guide.astro')) continue;
    const slug = f.slice(0, -'.astro'.length); // -dispensary-guide
    const href = `/guides/${slug}`;
    const label = slug
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase())
      .replace(/\bMe\b/g, 'ME');
    cities.push({ href, label });
  }
  cities.sort((a, b) => a.label.localeCompare(b.label));
  return cities;
}

const cities = buildCityList();

// Group by first letter for the visual A–Z layout. Pages with non-letter
// labels (numbers, accented — Maine towns are all ASCII) fall into the
// '#' bucket; we don't expect any but handle gracefully.
const byLetter = new Map();
for (const c of cities) {
  const letter = /^[A-Za-z]/.test(c.label) ? c.label[0].toUpperCase() : '#';
  if (!byLetter.has(letter)) byLetter.set(letter, []);
  byLetter.get(letter).push(c);
}

// Flatten into a single array of letter-headers + entries for rendering.
const flat = [];
for (const [letter, items] of byLetter) {
  flat.push({ kind: 'letter', letter });
  for (const c of items) flat.push({ kind: 'city', ...c });
}

const article = {
  author: 'Eliot Nash',
  authorId: 'eliot-nash',
  publishDate: '2026-07-08',
  modifiedDate: '2026-07-08',
  section: 'City Guides',
};

const title = 'A–Z Index of Maine Dispensary Towns (2026)';
const description =
  `Alphabetical index of all ${cities.length} Maine towns with a licensed dispensary guide on Maine Dispensary Guide. Browse the full statewide catalog; jump to a letter to find the town nearest you.`;
const topics = ['city', 'index', 'navigation'];

const faqItems = [
  {
    question: 'How many towns in Maine have a cannabis dispensary guide here?',
    answer: `As of 2026-07-08 there are ${cities.length} Maine towns indexed on this page, each with a dedicated local guide. The list grows when a new OCP-licensed town opens its first dispensary and we publish the local guide.`,
  },
  {
    question: 'How do I find the dispensary near me?',
    answer: `Each town name in the index links to its dedicated dispensary guide with addresses, hours, pricing context, and OCP-license verification. If your town isn't listed yet, we don't have a published guide for it; ${SITE_URL}/find-a-dispensary lists every OCP-licensed Maine city including those without bespoke guides.`,
  },
  {
    question: 'Does every town have multiple dispensaries?',
    answer: `No. Many Maine municipalities host a single dispensary or caregiver storefront. The guide pages note how many licensed dispensaries operate in each town, sourced from the OCP licensee-search data refreshed weekly via ${SITE_URL}/blog/maine-cannabis-delivery-business-guide-2026 and the active roster.`,
  },
];

const faqPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
});

const canonicalUrl = `${SITE_URL}/guides/all-cities`;
---

<Layout title={title} description={description} canonicalOverride={canonicalUrl} heroImage="/images/heroes/maine-portland-harbor-hero.jpg" article={article} topics={topics}>
<meta name="description" content={description} />
<script type="application/ld+json" set:html={faqPageJsonLd} />
<style>
  .city-index-wrap { max-width: 920px; margin: 0 auto; }
  .city-index-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--color-accent); }
  .city-index-header h1 { font-size: 2.25rem; line-height: 1.2; color: var(--color-text); margin-bottom: 0.5rem; }
  .city-index-header p.subtitle { font-size: 1.125rem; color: var(--color-text-light); margin-bottom: 1rem; }
  .city-index-meta { font-size: 0.9375rem; color: var(--color-text-light); margin-bottom: 1rem; }
  .city-index-jumpnav { display: flex; flex-wrap: wrap; gap: 0.375rem; padding: 0.75rem; background: color-mix(in oklab, var(--color-soft-green) 5%, transparent); border-radius: 0.5rem; margin: 1.25rem 0; }
  .city-index-jumpnav a { display: inline-block; padding: 0.375rem 0.625rem; background: white; border: 1px solid var(--color-accent); border-radius: 0.25rem; color: var(--color-primary); text-decoration: none; font-weight: 600; font-size: 0.9375rem; min-width: 1.875rem; text-align: center; }
  .city-index-jumpnav a:hover { background: var(--color-accent); color: var(--color-background); }
  .city-index-letter-group { margin: 1.5rem 0; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .city-index-letter-group:first-of-type { border-top: none; padding-top: 0; }
  .city-index-letter { font-size: 1.5rem; font-weight: 700; color: var(--color-text); padding: 0.25rem 0; margin-bottom: 0.5rem; }
  .city-index-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem; padding: 0.5rem 0; }
  .city-index-card { padding: 0.5rem 0.75rem; background: white; border: 1px solid var(--color-border); border-radius: 0.375rem; transition: border-color 0.15s, transform 0.15s; }
  .city-index-card:hover { border-color: var(--color-accent); transform: translateY(-1px); }
  .city-index-card a { color: var(--color-text); text-decoration: none; font-weight: 500; }
  .city-index-card a:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .city-index-header h1 { font-size: 1.75rem; }
    .city-index-grid { grid-template-columns: 1fr 1fr; }
    .city-index-letter { font-size: 1.25rem; }
  }
</style>

<article class="city-index-wrap">
  <div class="city-index-header">
    <h1>{title}</h1>
    <p class="subtitle">Browse every Maine town with a licensed dispensary guide on Maine Dispensary Guide, organized A–Z for fast lookup and zero friction.</p>
    <p class="city-index-meta">{cities.length} towns · last revised 2026-07-08</p>
    <nav class="city-index-jumpnav" aria-label="Jump to letter">
      {[...byLetter.keys()].map((letter) => (
        <a href={`#letter-${letter}`}>{letter}</a>
      ))}
    </nav>
  </div>

  <section class="city-index-body">
    <p>This index resolves the "what cities do you cover?" question directly: every Maine town with an OCP-licensed dispensary is here, alphabetical, with a link to its dedicated local guide. Larger metro areas (Portland, Bangor, Lewiston, Augusta) appear alongside smaller towns (Baring, West Paris, Stratton) — same link, same depth of coverage.</p>
    <p>For a regional view grouped by county and proximity instead of alphabet, see the 5 regional cannabis guides: <a href="/guides/greater-portland-sebago-lakes-cannabis-guide">Greater Portland and Sebago Lakes</a>, <a href="/guides/southern-maine-york-county-cannabis-guide">Southern Maine and York County</a>, <a href="/guides/central-western-maine-cannabis-guide">Central and Western Maine</a>, <a href="/guides/midcoast-waldo-northern-maine-cannabis-guide">Midcoast, Waldo, and Northern Maine</a>, and <a href="/guides/downeast-acadia-aroostook-cannabis-guide">Downeast, Acadia, and Aroostook</a>.</p>
    <p>For the licensed-but-not-yet-covered catalog (every OCP city including smaller municipalities without bespoke editorial guides), see <a href="/find-a-dispensary">the Maine dispensary finder</a>.</p>
  </section>

  <div role="article" aria-label="A–Z index">
    {flat.map((entry) =>
      entry.kind === 'letter' ? (
        <div class="city-index-letter-group">
          <h2 class="city-index-letter" id={`letter-${entry.letter}`}>{entry.letter}</h2>
        </div>
      ) : (
        <div class="city-index-card">
          <a href={entry.href}>{entry.label}</a>
        </div>
      )
    )}
  </div>

  <section class="faq-section" style="margin-top: 2.5rem;">
    <h2>Frequently Asked Questions</h2>
    {faqItems.map((f) => (
      <!-- analytics:faq-injected faq-id=faq-guides--all-cities--s1-1 -->
      <details data-faq data-faq-id="faq-guides--all-cities--s1-1">
        <summary>{f.question}</summary>
        <p>{f.answer}</p>
      </details>
    ))}
  </section>

  <section style="margin-top: 2.5rem;">
    <AutoRelated currentPath="/guides/all-cities" currentTopics={['city', 'index', 'navigation']} section="City Guides" limit={6} />
  </section>

  <section class="disclaimer" style="margin-top: 2.5rem; padding: 1rem; background: var(--color-disclaimer-bg); border-radius: 0.5rem; font-size: 0.875rem; color: var(--color-disclaimer-text);">
    <p>Verified content. The Maine Office of Cannabis Policy publishes the authoritative licensee roster at <a href="https://www.maine.gov/dafs/ocp/open-data/adult-use/licensee-search" target="_blank" rel="noopener noreferrer">maine.gov/dafs/ocp/open-data/adult-use/licensee-search</a> — we re-verify against that source quarterly. If your town is in the OCP roster but missing from this index, the guide is pending publication and should appear within 30 days.</p>
  </section>
</article>
</Layout>
