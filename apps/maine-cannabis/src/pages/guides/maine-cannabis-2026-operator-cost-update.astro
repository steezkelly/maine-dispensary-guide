---
import Layout from '../../layouts/Layout.astro';
import Callout from '../../components/Callout.astro';
import Faq from '../../components/Faq.astro';

const article = { author: "Margaret Finch", authorTitle: "Finance & Taxation Analyst", authorId: "margaret-finch", publishDate: "2026-06-07", modifiedDate: "2026-06-07", section: "Compliance & Legal" };
const topics = ["finance", "compliance", "tax", "operations"];
const titleText = "Maine Cannabis 2026 Operator Cost Update: Excise & Metrc";

const faqItems = [
  { question: "When does the new quarterly cannabis excise tax payment schedule start in Maine?", answer: "The new quarterly payment cadence for the adult-use cannabis excise tax starts with the 2026 tax year. P.L. 2025, ch. 388 (the supplemental budget, LD 210) made the change to 28-B M.R.S. §1501 and §1502; the effective date was January 1, 2026. Cultivation facilities now pay the excise tax on a quarterly cadence (April 30, July 31, October 31, and January 31 for the preceding quarter) rather than the prior monthly schedule. LD 1654 (P.L. 2025, ch. 504), effective July 29, 2026, adds a 30-day grace period for missed payments before interest and penalties begin to accrue." },
  { question: "What is the new excise tax base for adult-use cannabis in Maine?", answer: "Effective January 1, 2026, the adult-use cannabis excise tax moved from a per-ounce weight-based tax to 10% of the average wholesale price of adult-use cannabis sold by a cultivation facility licensee to other licensees. The wholesale-price base is set by rule by the Office of Cannabis Policy using a rolling 90-day average of reported wholesale transactions. The change is part of P.L. 2025, ch. 388 (LD 210), the 2026 supplemental budget. Edibles, pre-rolls, and other manufactured products continue to be taxed at the wholesale-price base of the underlying flower or trim, with no separate excise tier." },
  { question: "How much will the OCP Metrc contract price increase cost my cannabis business in 2026?", answer: "The OCP's new 5-year contract with Metrc took effect February 4, 2026. The price increases were negotiated with a delay to the May 1, 2026 effective date. The new prices are: monthly user fee $45 (up from $40, +12.5%); package tag $0.26 (up from $0.25, +4.0%); individual plant tag $0.46 (up from $0.45, +2.2%); 5-plant batch tag $2.30 (up from $2.25); 10-plant batch tag $4.60 (up from $4.50); 25-plant batch tag $11.50 (up from $11.25); 50-plant batch tag $23.00 (up from $22.50). For a mid-size cultivation facility running 5,000 plants per year on individual tags, the annual tag cost rises by $50; for a 50,000-plant operation, the rise is $500 per year. The monthly user fee change is the bigger number for most operators." },
  { question: "What is the LD 1654 (P.L. 2025, ch. 504) grace period for missed excise tax payments?", answer: "LD 1654, effective July 29, 2026, amends 36 M.R.S. §4924 and adds new subsections to 36 M.R.S. §4921 and §4923 to provide a 30-day grace period for adult-use cultivation excise tax payments before the Maine Revenue Services late-payment interest and penalties begin to accrue. The grace period applies to the quarterly payments due under the post-2026 schedule. The grace period is administrative relief — it is not a waiver of the underlying tax. MRS retains the right to assess interest and penalties on any unpaid balance after the 30-day grace window." },
  { question: "Are there any Maine cannabis excise tax exemptions I should know about?", answer: "Yes. Two important ones effective for the 2026 tax year. First, sales or transfers of adult-use cannabis between cultivation facilities and products manufacturing facilities are exempt from the excise tax under amended 36 M.R.S. §4923(7) (added by P.L. 2025, ch. 504, LD 1654). Second, the 20% sales tax on hemp and hemp products containing THC imposed by P.L. 2025, ch. 388 (LD 210) is a separate tax from the cannabis excise tax and is collected at the retail register, not at the wholesale transfer. The change in percentage transferred from the adult-use cannabis sales tax and excise tax to the Adult Use Cannabis Public Health and Safety and Municipal Opt-in Fund moved from 12% to 6% under the same 2026 budget bill." },
  { question: "Will the federal Schedule III reclassification affect Maine excise tax compliance?", answer: "No. The state excise tax is levied on the cultivation facility, not on the federal scheduling of the product. The April 28, 2026 DOJ Final Order that moved state-licensed medical cannabis to Schedule III has no effect on the adult-use excise tax base, rate, or payment schedule. The state excise tax, the state sales tax, the municipal opt-in transfer, and the Metrc contract pricing are all state-level instruments, unchanged by the federal action. The Schedule III move affects federal income tax deductibility for the medical side of the operation, not the cultivation excise tax." }
];

const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
});
