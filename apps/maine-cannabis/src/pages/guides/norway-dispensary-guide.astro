    { "@type": "Question", "name": "What is Norway Maine known for?", "acceptedAnswer": { "@type": "Answer", "text": "Norway is the Oxford County seat with ~4,200 residents — the largest town in the Norway-Paris area and commercial center for western Oxford County." }}
  ]
