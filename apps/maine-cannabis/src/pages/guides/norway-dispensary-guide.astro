const topics = ["city", "market"];

const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Are there any cannabis dispensaries in Norway, Maine?", "acceptedAnswer": { "@type": "Answer", "text": "No confirmed dispensaries operate within Norway town itself. The county seat has no cannabis storefronts, possibly because Norway has not formally opted in to recreational cannabis. Residents are served by West Paris Provisions in West Paris (~10 min, 207-674-0015) and The Hideaway in Oxford (~15 min)." }},
    { "@type": "Question", "name": "Does Norway allow cannabis dispensaries?", "acceptedAnswer": { "@type": "Answer", "text": "Norway is not documented as opted in on the MDG Opt-In Tracker or the OCP municipal authorization list as of April 2026. Verify directly with the Norway town office before assuming either direction." }},
