const faqPageJsonLd = JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are there cannabis dispensaries in Medway, Maine?","acceptedAnswer":{"@type":"Answer","text":"Yes. Medway has 1 licensed adult-use cannabis storefront, Budz Emporium, on Medway Rd, plus access to the broader Penobscot County retail network. The storefront is licensed for both recreational (21+) and medical sales."}},{"@type":"Question","name":"Can I buy recreational cannabis in Medway, Maine?","acceptedAnswer":{"@type":"Answer","text":"Yes. Medway permits adult-use cannabis retail and the storefront in town is licensed for both recreational (21+) and medical sales. Customers do not need a medical card to purchase."}},{"@type":"Question","name":"What should I expect to pay at a Medway dispensary?","acceptedAnswer":{"@type":"Answer","text":"Pricing in Medway is competitive for a remote Penobscot County market. As of 2026, an eighth of flower runs $30-50, an edible gummy pack (100mg THC) runs $20-35, and a 1g distillate cartridge runs $35-50. Adult-use customers pay Maine's 10% excise plus 5.5% sales tax on top of sticker; medical patients pay only the 5.5% state sales tax."}},{"@type":"Question","name":"What is Medway Maine known for?","acceptedAnswer":{"@type":"Answer","text":"Medway is a Penobscot County town of approximately 1,300 year-round residents along Interstate 95 in the Penobscot River valley, between Bangor and the Katahdin region. The town is a common gateway stop for outdoor recreation visitors heading to Baxter State Park and the North Maine Woods."}}]});
