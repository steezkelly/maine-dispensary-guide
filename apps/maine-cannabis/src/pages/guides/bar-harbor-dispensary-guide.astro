const faqPageJsonLd = JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are there cannabis dispensaries in Bar Harbor, Maine?","acceptedAnswer":{"@type":"Answer","text":"Yes. Bar Harbor — gateway to Acadia National Park on Mount Desert Island — has dispensaries including The Meristem and 420 Mules (224 Main St). Across the Trenton Bridge on the mainland, Snare Creek Farms also serves the Bar Harbor market."}},{"@type":"Question","name":"What is the closest dispensary to Acadia National Park?","acceptedAnswer":{"@type":"Answer","text":"The Meristem and 420 Mules (224 Main St) are both located on Mount Desert Island within minutes of Acadia NP's main entrance. Ellsworth dispensaries (Curaleaf, Maine Organic Therapy, Main Street Medical) are ~25 mi west on US-1, and Trenton-based Snare Creek Farms sits just across the mainland bridge from the island."}},{"@type":"Question","name":"Does Bar Harbor allow recreational cannabis?","acceptedAnswer":{"@type":"Answer","text":"Yes. Bar Harbor permits adult-use cannabis retail. Dispensaries in town serve both MMMP cardholders and 21+ recreational customers, and the high-summer-tourism window creates a compressed but very high-traffic seasonal cycle."}},{"@type":"Question","name":"What is Bar Harbor Maine known for?","acceptedAnswer":{"@type":"Answer","text":"Bar Harbor is a coastal Hancock County town of ~5,500 year-round residents on Mount Desert Island. It is the primary gateway community for Acadia National Park, which draws ~4 million visitors per year, making it Maine's most-visited tourism market."}}]});
