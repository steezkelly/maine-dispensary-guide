const faqPageJsonLd = JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are there cannabis dispensaries in Houlton, Maine?","acceptedAnswer":{"@type":"Answer","text":"Yes. Houlton has two medical dispensaries: Lifted Cannabis Maine (32 Access Rd) and Vargas Farm (28 Airport Dr). The town passed a new medical marijuana ordinance on September 24, 2024 to formalize its regulatory framework for cannabis operators, per The County."}},{"@type":"Question","name":"What is the closest dispensary to the New Brunswick border at Houlton?","acceptedAnswer":{"@type":"Answer","text":"Houlton is the closest Maine dispensary cluster to the New Brunswick border at Woodstock–Houlton. Lifted Cannabis Maine and Vargas Farm are both within the town and serve U.S. and Canadian cross-border visitors and the surrounding Aroostook County communities."}},{"@type":"Question","name":"Does Houlton allow recreational cannabis?","acceptedAnswer":{"@type":"Answer","text":"Houlton voters rejected recreational cannabis sales in 2017. The dispensaries currently operating in Houlton are medical-only per their operator sites (liftedmaine.com, Vargas Farm social listings). For full adult-use menus, Presque Isle is ~60 mi north on I-95."}},{"@type":"Question","name":"What is Houlton Maine known for?","acceptedAnswer":{"@type":"Answer","text":"Houlton is the seat of Aroostook County, the largest U.S. county east of the Mississippi. The town has about 6,000 residents and sits on the U.S.–Canada border opposite Woodstock, New Brunswick. Houlton is known for the annual Houlton Agricultural Fair, the New England Sky Blueberry Festival, its historic Market Square downtown, and as the last Maine stop on I-95 before the Canadian border."}}]});
