<article>
  <div class="article-header">
    <h1>Houlton Maine Dispensary Guide</h1>
    <p class="subtitle">Lifted Cannabis Maine, Vargas Farm & the Aroostook seat's medical market</p>
  </div>

  <section class="fact-box">
    <h2>Houlton Cannabis Quick Facts</h2>
    <table aria-label="Houlton cannabis market overview">
      <thead><tr><th scope="col">Fact</th><th scope="col">Details</th></tr></thead>
      <tbody>
        <tr><td><strong>Medical Legal</strong></td><td>Yes</td></tr>
