---
import Layout from '../../layouts/Layout.astro';
import Callout from '../../components/Callout.astro';
import Faq from '../../components/Faq.astro';
import AutoRelated from '../../components/AutoRelated.astro';

export const title = "Maine Cannabis Business Licensing: All License Types & Fees (2026)";

const article = {
  author: "Eliot Nash",
  authorTitle: "Editorial",
  authorId: "eliot-nash",
  reviewer: { name: "Margaret Finch", jobTitle: "Finance & Taxation Analyst", id: "margaret-finch" },
  publishDate: "2026-07-29",
  modifiedDate: "2026-07-29",
  section: "Business Essentials",
};

const topics = ["licensing", "business", "compliance"];

const faqItems = [
  { question: "What types of cannabis licenses does Maine issue?", answer: "Maine's Office of Cannabis Policy (OCP) issues adult-use licenses under 28-B M.R.S. Chapter 1 in these categories: Tier 1–4 Cultivation Facilities (tiered by canopy size), Nursery Cultivation Facility, Products Manufacturing Facility, Cannabis Store (adult-use retail), Testing Facility, and Sample Collector. Maine also runs a separate medical program with its own licensing. Most businesses hold one primary license and may add endorsements or additional licenses as they grow." },
  { question: "How much does a Maine cannabis license cost?", answer: "Fees are set by 28-B M.R.S. §207. Application fees range from $60 (nursery) to $500 (Tier 2–4 cultivation). Annual license fees range from $250 (sample collector) to $30,000 (Tier 4 indoor cultivation). A Cannabis Store (retail) pays a $250 application fee and up to $2,500 annually. A Products Manufacturing Facility pays $250 to apply and $2,500 annually. A Testing Facility pays $250 to apply and $1,000 annually. These are state fees only; municipalities may add local licensing fees." },
  { question: "Does Maine require residency to get a cannabis license?", answer: "No. Maine has no residency requirement for cannabis license applicants. Out-of-state individuals and entities may apply. However, the applicant must register a business entity with the Maine Secretary of State and maintain a registered agent in Maine. All principals with a sufficient ownership interest must pass OCP background checks regardless of state of residence." },
  { question: "How long does it take to get a Maine cannabis license?", answer: "For a complete application, OCP review typically runs 60–120 days. The end-to-end timeline — including municipal authorization, application preparation, OCP review, and pre-operation inspection — commonly runs 10–18 months for a retail store, largely because municipal approval timelines vary widely by town. Cultivation and manufacturing timelines follow a similar pattern but depend on facility build-out." },
  { question: "What is the difference between a conditional and an active license?", answer: "A conditional license is OCP's first approval, granted after your application passes initial review. It is valid for 12 months and is the only license you can hold before your facility is built and inspected. An active license is granted after your facility passes OCP's pre-operation inspection. You must hold an active license to legally operate. See the Maine Cannabis Conditional License guide for the full progression." },
  { question: "Can one business hold multiple Maine cannabis licenses?", answer: "Yes, Maine permits vertical integration and multiple license holdings subject to statutory limits and OCP rules. A single entity may, for example, hold both a cultivation and a manufacturing license, or a retail license with a medical endorsement. Ownership caps and control restrictions apply to certain license combinations; consult OCP rules and qualified counsel before structuring a multi-license operation." },
  { question: "Where do I apply for a Maine cannabis license?", answer: "Applications are submitted through the Office of Cannabis Policy (OCP) portal at maine.gov/dafs/ocp. OCP is a division of the Department of Administrative and Financial Services and administers both the adult-use and medical cannabis programs. You must secure municipal authorization for your proposed location before OCP will process your application." },
];
---

<Layout
  title="Maine Cannabis Business Licensing: All License Types & Fees (2026)"
  description="Complete reference to every Maine cannabis license type — cultivation (Tier 1–4), nursery, manufacturing, retail, testing, sample collector — with OCP application and annual fees from 28-B M.R.S. §207. Updated 2026-07-29."
  heroImage="/images/heroes/maine-compliance-hero.jpg"
  article={article}
  topics={topics}
>
<style>
  article { max-width: 720px; margin: 0 auto; }
  .article-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .subtitle { font-size: 1.25rem; color: var(--color-text-light); }
  section { margin-bottom: 2rem; }
  section h2 { margin-top: 0; padding-top: 1rem; }
  section h3 { margin-top: 1.5rem; margin-bottom: 0.75rem; }
  ul, ol { padding-left: 1.5rem; }
  li { margin-bottom: 0.5rem; }
  .disclaimer { background: var(--color-disclaimer-bg); border: 1px solid var(--color-disclaimer-border); padding: 1rem; border-radius: 0.5rem; font-size: 0.875rem; color: var(--color-disclaimer-text); }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { padding: 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  th { background: var(--color-background); }
  section.fact-box { background: linear-gradient(135deg, var(--color-background) 0%, #fff 100%); border-top: 3px solid var(--color-primary); padding: 1.5rem; border-radius: 0.5rem; margin: 1.5rem 0; }
