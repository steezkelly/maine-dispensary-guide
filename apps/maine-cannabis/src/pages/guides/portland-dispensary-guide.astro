 article { max-width: 720px; margin: 0 auto; }.article-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }.subtitle { font-size: 1.25rem; color: var(--color-text-light); } section { margin-bottom: 2rem; } section h2, section h3 { margin-top: 1.5rem; } section h2:first-child { margin-top: 0; }.fact-box { background: linear-gradient(135deg, color-mix(in oklab, var(--color-soft-green) 8%, transparent) 0%, color-mix(in oklab, var(--color-lichen) 6%, transparent) 100%); padding: 2rem; border-radius: 1rem; border: 1px solid var(--color-border); position: relative; overflow: hidden; }.fact-box::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, var(--color-primary), var(--color-accent)); }.fact-box-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; }.fact-box-icon { font-size: 1.25rem; color: var(--color-accent); }.fact-box h2 { margin-top: 0; font-size: 1.375rem; }.fact-box table { margin: 0; } ul { padding-left: 1.5rem; } li { margin-bottom: 0.5rem; }.disclaimer { background: var(--color-disclaimer-bg); border: 1px solid var(--color-disclaimer-border); padding: 1rem; border-radius: 0.5rem; font-size: 0.875rem; color: var(--color-disclaimer-text); }.further-reading { background: color-mix(in oklab, var(--color-soft-green) 5%, transparent); padding: 1.5rem; border-radius: 1rem; margin-top: 3rem; }.further-reading h2 { margin-top: 0; font-size: 1.25rem; }
