<article>
  <div class="article-header">
    <h1>Calais, ME Dispensary Guide</h1>
    <p class="subtitle">The Higher Class, Kannacopia, Smoke On The Water & the New Brunswick border market</p>
  </div>

  <section class="fact-box">
    <h2>Calais Cannabis Quick Facts</h2>
    <table aria-label="Calais cannabis market overview">
      <thead><tr><th scope="col">Fact</th><th scope="col">Details</th></tr></thead>
      <tbody>
        <tr><td><strong>Medical Legal</strong></td><td>Yes</td></tr>
