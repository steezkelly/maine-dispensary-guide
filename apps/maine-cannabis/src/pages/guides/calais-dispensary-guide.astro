const faqPageJsonLd = JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are there cannabis dispensaries in Calais, Maine?","acceptedAnswer":{"@type":"Answer","text":"Yes. Calais has multiple dispensaries including The Higher Class (medical), Kannacopia, Smoke On The Water / Mt. Tom Therapeutics, and Pine Island Cannabis. The town is one of the best-served dispensary markets in Washington County and sits on the U.S.–Canada (New Brunswick) border."}},{"@type":"Question","name":"Does Calais allow recreational cannabis?","acceptedAnswer":{"@type":"Answer","text":"Yes. Calais permits adult-use cannabis retail in addition to medical. The Higher Class serves medical cardholders, while Kannacopia, Smoke On The Water / Mt. Tom Therapeutics, and Pine Island Cannabis serve both medical and 21+ recreational customers."}},{"@type":"Question","name":"What is the closest dispensary to the New Brunswick border?","acceptedAnswer":{"@type":"Answer","text":"Calais is the closest dispensary cluster to the New Brunswick border — the international bridge at Calais–St. Stephen is just a few minutes from Main Street. The four dispensaries in town (The Higher Class, Kannacopia, Smoke On The Water / Mt. Tom Therapeutics, Pine Island Cannabis) serve both U.S. and Canadian visitors."}},{"@type":"Question","name":"What is Calais Maine known for?","acceptedAnswer":{"@type":"Answer","text":"Calais is a Washington County city of approximately 3,000 residents on the St. Croix River across from St. Stephen, New Brunswick, Canada. The town is one of the easternmost U.S. municipalities directly on an international border and is known for its historic downtown, the St. Croix Island International Historic Site, and its role as a regional hub for the rural Down East border region."}}]});
