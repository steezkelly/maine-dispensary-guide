        <tr><td><strong>Population</strong></td><td>~3,000 (2020 Census)</td></tr>
        <tr><td><strong>County</strong></td><td>Washington County</td></tr>
        <tr><td><strong>Position</strong></td><td>St. Croix River, opposite St. Stephen, New Brunswick, Canada</td></tr>
