--- import AutoRelated from '../../components/AutoRelated.astro'; import Layout from '../../layouts/Layout.astro'; import Callout from '../../components/Callout.astro'; import Faq from '../../components/Faq.astro'; export const title = "Maine Cannabis Taxes 2026"; const article = { author: "Margaret Finch", authorTitle: "Finance & Taxation Analyst", authorId: "margaret-finch", reviewer: { name: "Calvin Waters", jobTitle: "Licensing & Compliance Analyst", id: "calvin-waters" }, publishDate: "2026-01-19", modifiedDate: "2026-06-05", section: "Compliance & Legal" }; const topics = ["finance", "compliance", "business"]; const faqPageJsonLd = JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [ { "@type": "Question", "name": "What is the cannabis tax rate in Maine for 2026?", "acceptedAnswer": { "@type": "Answer", "text": "Starting January 1, 2026, Maine's retail cannabis tax increases from 10% to 14% on adult-use cannabis sales. the 5.5% state sales tax applies to all cannabis transactions, and edibles are subject to an 8% sales tax rate." } }, { "@type": "Question", "name": "What are the excise taxes on cannabis in Maine?", "acceptedAnswer": { "@type": "Answer", "text": "Maine imposes excise taxes on cultivation facility sales to other licensees: $335 per pound of cannabis flower and $94 per pound of cannabis trim. Starting January 1, 2026, these excise tax rates are being reduced as part of the state budget legislation." } }, { "@type": "Question", "name": "Can Maine cannabis businesses deduct business expenses?", "acceptedAnswer": { "@type": "Answer", "text": "At the federal level, IRC Section 280E prohibits cannabis businesses from deducting normal business expenses. However, Maine allows cannabis businesses to take normal business deductions on state tax returns, including rent, payroll, marketing, and operating expenses." } }, { "@type": "Question", "name": "Does Maine have a 280E workaround for cannabis businesses?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Maine allows an income subtraction modification for IRC 280E expenses. Medical cannabis businesses have had this since 2018, and in July 2023, Governor Janet Mills signed legislation extending it to adult-use cannabis businesses, allowing them to deduct 280E expenses on state returns." } }, { "@type": "Question", "name": "How much sales tax do I pay on cannabis in Maine?", "acceptedAnswer": { "@type": "Answer", "text": "Maine charges a 5.5% state sales tax on all cannabis transactions. Edibles are subject to an 8% sales tax rate. adult-use cannabis sales are subject to the 14% retail cannabis tax (effective January 1, 2026)." } }, { "@type": "Question", "name": "Are there local cannabis taxes in Maine municipalities?", "acceptedAnswer": { "@type": "Answer", "text": "Maine municipalities do not impose separate local cannabis taxes. However, municipalities that opt in to allow cannabis businesses receive reimbursement from the state for qualifying expenses up to $20,000 within three years of opting in." } }, { "@type": "Question", "name": "What tax forms do Maine cannabis businesses need to file?", "acceptedAnswer": { "@type": "Answer", "text": "Maine cannabis businesses must file standard business tax returns with Maine Revenue Services, collect and remit the 14% retail cannabis tax, pay excise taxes if operating as a cultivation facility, and file federal returns subject to IRC 280E restrictions." } }, { "@type": "Question", "name": "What deductions are available to Maine cannabis businesses?", "acceptedAnswer": { "@type": "Answer", "text": "At the federal level, only Cost of Goods Sold (COGS) is deductible under IRC 280E. On Maine state returns, cannabis businesses can deduct normal business expenses including rent, payroll, marketing, utilities, and operating costs through the state's 280E income subtraction modification." } } ] }); --- <Layout title="Maine Cannabis Taxes 2026: Complete Tax Guide for Operators" description="Complete guide to Maine cannabis taxes in 2026 — retail tax rates, excise taxes, sales tax, 280E deductions, and the new 14% retail tax effective January 1, 2026." heroImage="/images/heroes/maine-cannabis-taxes-2026.jpg" article={article} topics={topics} > <style> 
