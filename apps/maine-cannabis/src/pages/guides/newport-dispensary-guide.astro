const faqPageJsonLd = JSON.stringify({"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are there cannabis dispensaries in Newport, Maine?","acceptedAnswer":{"@type":"Answer","text":"Yes. Newport has multiple dispensaries including Gram's Five & Dime (recreational and medical), Karma Cannabis, and Brothers Cannabis. The town is one of the better-served small communities in interior Penobscot County."}},{"@type":"Question","name":"Does Newport Maine have recreational dispensaries?","acceptedAnswer":{"@type":"Answer","text":"Yes. Gram's Five & Dime serves both 21+ recreational customers and MMMP cardholders. Karma Cannabis and Brothers Cannabis round out Newport's dispensary cluster. The town's central location on ME-7 between Bangor and Waterville makes it a natural stop for both medical and adult-use shoppers."}},{"@type":"Question","name":"What is Newport Maine known for?","acceptedAnswer":{"@type":"Answer","text":"Newport is a Penobscot County town of approximately 3,200 residents in central Maine, situated on the Sebasticook River and the ME-7/ME-11 corridors. The town is known for its lake-region recreation (Newport is adjacent to Sebasticook Lake and Lake Sebasticook), its role as a service hub for the surrounding rural communities, and its position between Bangor (~25 min NE) and Waterville (~30 min SW)."}},{"@type":"Question","name":"What is the closest dispensary to Newport Maine?","acceptedAnswer":{"@type":"Answer","text":"Dispensaries in Newport include Gram's Five & Dime, Karma Cannabis, and Brothers Cannabis. For shoppers looking for a wider menu, Bangor is ~25 min northeast and Waterville is ~30 min southwest on the I-95 corridor."}}]});
