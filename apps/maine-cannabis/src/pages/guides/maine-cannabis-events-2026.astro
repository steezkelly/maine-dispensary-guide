---
import AutoRelated from '../../components/AutoRelated.astro';
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';

const article = { author: "Eliot Nash", authorId: "eliot-nash", authorTitle: "Market & Real Estate Analyst", publishDate: "2026-01-25", modifiedDate: "2026-07-09", section: "City Guides", reviewer: { id: "calvin-waters", name: "Calvin Waters" } };
const topics = ["compliance"];

// FAQPage JSON-LD — 9 questions covering operator + public event queries.
// Scope: searches for events by regulators (OCP), by industry groups (MCIA,
// MCCA, CAM), by training (METRC, budtender certification), by topic
// (caregiver trade shows under LD 1840), and by audience (consumer-facing
// vs license-only).
const eventFaqs = [
  { question: "When is the next OCP stakeholder meeting in 2026?", answer: "The Maine Office of Cannabis Policy (OCP) holds quarterly stakeholder meetings in Augusta. The 2026 schedule includes sessions in March, July, and October, with an annual industry summit in late October. Agendas are typically published two weeks ahead on maine.gov/dafs/ocp. Meetings are open to all licensees; many sessions include a virtual attendance option for licensees outside the Augusta area." },
  { question: "How do I find Maine cannabis operator events near me?", answer: "Three channels cover the majority of Maine cannabis operator gatherings in 2026: (1) the Maine Cannabis Industry Association (MCIA) holds monthly member meetings in Portland and Augusta, with open-house events for prospective members in February and September; (2) the Maine Craft Cannabis Association (MCCA) holds quarterly regional roundtables rotating between Portland, Bangor, Lewiston, and Biddeford; (3) the Cannabis Association of Maine (CAM) runs an annual operator summit each spring and quarterly advocacy days in Augusta. All three accept non-members at most events for an RSVP fee." },
  { question: "Are Maine cannabis events open to the public?", answer: "Yes and no. OCP stakeholder meetings, legislative hearings, and public comment periods are open to anyone — operators, applicants, advocates, residents, and tourists. Industry association events vary: MCIA and MCCA typically allow non-members to attend a first meeting for free, then ask for membership after the second visit. Trade shows and expos like the Maine Cannabis Expo and NECANN are ticketed but open to consumers aged 21 and up. Always check the event listing for credentials requirements before arriving." },
  { question: "What is the Maine Cannabis Expo?", answer: "The Maine Cannabis Expo is the largest annual consumer-facing cannabis trade show in the state, typically held at the Portland Expo Center over a weekend in late February or early March. The 2026 edition is expected to follow the same pattern with two days of exhibitors, educational seminars, and product showcases. Tickets run $20–40 for general admission, with VIP passes available that include budtender training and product sample bags. The Expo is 21+; valid photo ID is required at the door." },
  { question: "Can caregivers sell cannabis at Maine events in 2026?", answer: "Yes — LD 1840, effective July 29, 2026, expanded registered Maine caregivers' ability to sell and transfer medical cannabis at trade shows, industry events, and on caregiver-owned/leased premises under the amended 22 M.R.S. §2423-A(2)(O). Public consumption at events remains illegal regardless of caregiver license status. Caregivers selling at trade shows must follow trip-ticket rules, packaging requirements, and labeling as specified in the OCP caregiver trade show rule package. The full compliance guide for caregivers selling at 2026 events is published at /guides/maine-cannabis-caregiver-trade-show-sales." },
  { question: "Is there a Maine cannabis industry conference in 2026?", answer: "Yes — three. The OCP Annual Industry Summit in October in Augusta is the largest regulatory-focused event and draws operators, applicants, and advocates from across the state. The NECANN Maine Cannabis Convention (typically held in Portland or Lewiston) is the largest consumer-and-B2B trade show in Maine. The Maine Cannabis Expo in late winter is the strongest consumer-facing event. Smaller regional operator summits and craft cannabis roundtables run year-round through MCIA, MCCA, and CAM — see the calendar below." },
  { question: "How much does it cost to attend Maine cannabis events?", answer: "Pricing varies widely. Free: OCP quarterly stakeholder meetings, Legislative Cannabis Caucus sessions, and most public comment hearings. $0–$50: industry association open-house events and meetups (MCIA, MCCA, CAM often waive fees for first-time attendees). $50–$150: regional operator summits, compliance workshops, and association roundtables. $150–$500: trade shows and expos like the Maine Cannabis Expo and NECANN. Membership: annual MCIA membership ranges from $250 for sole proprietors to $2,500+ for tier-1 operators and is usually required for the better networking density." },
  { question: "Where can I network with other Maine cannabis operators?", answer: "The densest Maine cannabis operator networking happens at MCIA monthly Portland meetings, OCP quarterly stakeholder meetings in Augusta, the OCP Annual Industry Summit each October, and the spring/summer regional MCCA roundtables. For consumer-facing 420-curious networking, the Maine Cannabis Expo and NECANN draw the largest crowds. For adjacent industries (real estate, security, packaging, compliance consulting), the OCP compliance workshop each July in Portland draws the strongest B2B mix." },
  { question: "Can I attend cannabis events online in Maine?", answer: "Some — not all. OCP stakeholder meetings have offered virtual attendance since 2022; legislative hearings (cannabis caucus, public comment) are streamed live on the Maine Legislature's YouTube channel. Industry association events are mostly in-person. Trade shows and expos are in-person only due to product showcase requirements. Compliance seminars and METRC training are fully online with self-paced modules, and budtender certification programs run both online and in-person cohorts. For 2026, expect virtual attendance to remain standard for OCP public meetings and to expand selectively for MCIA events based on member demand." }
];

const faqPageJsonLd = JSON.stringify({
  "@context":"https://schema.org",
  "@type":"FAQPage",
  "mainEntity": eventFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/<[^>]+>/g, "") }
  }))
});
---

<script type="application/ld+json" set:html={faqPageJsonLd} />

<Layout title="Maine Cannabis Events 2026: OCP Calendar & Industry Meetups" description="Maine cannabis events 2026 — OCP stakeholder meetings, MCIA/MCCA gatherings, NECANN, cannabis expos, and LD 1840 caregiver trade shows. Dates, locations, registration." heroImage="/images/heroes/maine-cannabis-events-2026.jpg" article={article} topics={topics}>
  <style>
  article { max-width: 760px; margin: 0 auto; }
  .article-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .subtitle { font-size: 1.25rem; color: var(--color-text-light); }
  section { margin-bottom: 2.5rem; scroll-margin-top: 80px; }
  section h2 { margin-top: 0; }
  section h2:first-child { margin-top: 0; }
  section h3 { margin-top: 1.5rem; font-size: 1.125rem; color: var(--color-primary); font-family: var(--font-serif); }
  .events-list { margin: 1rem 0; }
  .event-item { margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .event-item:last-child { border-bottom: none; }
  .event-item h3 { margin-bottom: 0.25rem; color: var(--color-text); font-family: var(--font-body, sans-serif); font-size: 1.05rem; }
  .event-date { color: var(--color-primary); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .event-item p { margin: 0; line-height: 1.55; }
  ul { padding-left: 1.5rem; }
  li { margin-bottom: 0.5rem; }
  .further-reading { background: rgba(88, 129, 87, 0.05); padding: 1.5rem; border-radius: 1rem; margin-top: 3rem; }
  .further-reading h2 { margin-top: 0; font-size: 1.25rem; }
  .fact-box { background: rgba(88, 129, 87, 0.1); padding: 1.75rem; border-radius: 1rem; border-left: 4px solid var(--color-primary); }
  .fact-box h2 { margin-top: 0; font-size: 1.25rem; }
  .fact-box table { margin: 0; }
  .fact-box th { font-size: 0.85rem; }
  .month-header { background: rgba(88, 129, 87, 0.06); padding: 0.85rem 1.25rem; border-radius: 0.5rem; margin: 2rem 0 0.5rem; font-family: var(--font-serif); font-weight: 700; color: var(--color-primary); font-size: 1.25rem; }
  .month-section { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px dashed rgba(88, 129, 87, 0.2); }
  .month-section:last-child { border-bottom: none; }
  .ld1840-callout { background: linear-gradient(135deg, rgba(88, 129, 87, 0.10), rgba(88, 129, 87, 0.04)); border: 1px solid rgba(88, 129, 87, 0.35); padding: 1.25rem 1.5rem; border-radius: 0.75rem; margin: 1.25rem 0 2rem; font-size: 0.95rem; line-height: 1.55; }
  .ld1840-callout strong { color: var(--color-primary); }
  .toc { background: rgba(88, 129, 87, 0.04); border: 1px solid rgba(88, 129, 87, 0.18); padding: 1.25rem 1.5rem; border-radius: 0.75rem; margin: 1.5rem 0 2rem; font-size: 0.95rem; }
  .toc h2 { margin: 0 0 0.75rem; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-light); font-family: var(--font-body, sans-serif); }
  .toc ol { margin: 0; padding-left: 1.5rem; column-count: 2; column-gap: 2rem; }
  .toc li { margin-bottom: 0.35rem; break-inside: avoid; }
  .toc a { color: var(--color-primary); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  @media (max-width: 640px) { .toc ol { column-count: 1; } }
  .category-section { margin: 1.5rem 0; }
  .category-section h3 { margin-top: 0; }
  .citation { font-size: 0.85rem; color: var(--color-text-light); margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
</style>
<article>
    <div class="article-header">
      <h1>Maine Cannabis Events 2026: The Complete Operator &amp; Industry Calendar</h1>
      <p class="subtitle">OCP stakeholder meetings, industry conferences, craft festivals, caregiver trade shows, and networking across Maine — by month, by category, with dates and links</p>
    </div>

    <section>
      <p>Maine's cannabis event calendar in 2026 spans five distinct formats — Office of Cannabis Policy (OCP) regulatory meetings, Legislative Cannabis Caucus sessions, industry association gatherings (MCIA, MCCA, CAM, Mainely Cannabis Co-op), B2B trade shows (NECANN, Maine Cannabis Expo), and the new LD 1840 caregiver trade show sales that go into effect July 29. This page is the master reference: a month-by-month calendar of what is happening, where, who can attend, and how to register.</p>
      <p>The calendar is grouped three ways so you can find what you need fast: by month (the master chronological index below), by category (regulatory, industry, networking, training, consumer-facing), and by audience (operator-only, licensee, consumer 21+). All dates reflect the 2026 published schedule as of the last review date below. Where an event has not yet been officially scheduled for 2026, we indicate "TBA" and link to the hosting organization's event page so you can confirm.</p>
    </section>

    <aside class="ld1840-callout">
      <strong>New for 2026: Caregiver trade show sales (LD 1840, effective July 29, 2026).</strong> Registered Maine caregivers can now sell and transfer medical cannabis at trade shows, industry events, and on caregiver-owned/leased premises under the amended 22 M.R.S. §2423-A(2)(O). Public consumption at events remains illegal. See the full <a href="/guides/maine-cannabis-caregiver-trade-show-sales" style="color: var(--color-primary); text-decoration: underline; font-weight: 600;">LD 1840 caregiver trade show compliance guide</a> for packaging, labeling, and trip-ticket rules.
    </aside>

    <section class="fact-box" aria-label="Major Maine cannabis events at a glance">
      <h2>Maine Cannabis Events 2026 — At a Glance</h2>
      <table>
        <caption>Confirmed major 2026 cannabis events in Maine (full calendar below)</caption>
        <thead><tr><th>Month</th><th>Event</th><th>Format</th><th>Location</th></tr></thead>
        <tbody>
          <tr><td>Feb–Mar</td><td>Maine Cannabis Expo</td><td>Consumer trade show</td><td>Portland Expo Center</td></tr>
          <tr><td>March</td><td>OCP Q1 Stakeholder Meeting</td><td>Regulatory</td><td>Augusta + virtual</td></tr>
          <tr><td>March</td><td>Maine Cannabis Safety &amp; Compliance Seminar</td><td>Training</td><td>Lewiston</td></tr>
          <tr><td>April–May</td><td>Legislative Cannabis Caucus</td><td>Public</td><td>State House, Augusta</td></tr>
          <tr><td>April</td><td>OCP Public Comment Period (rule updates)</td><td>Regulatory</td><td>Augusta + virtual</td></tr>
          <tr><td>May</td><td>CAM Annual Operator Summit</td><td>Industry</td><td>Portland (TBA)</td></tr>
          <tr><td>July 29</td><td>LD 1840 caregiver trade show sales effective</td><td>Regulatory milestone</td><td>Statewide</td></tr>
          <tr><td>July</td><td>OCP Q2 Compliance Workshop</td><td>Training</td><td>Portland</td></tr>
          <tr><td>October</td><td>OCP Q3 Stakeholder Meeting + Annual Industry Summit</td><td>Regulatory</td><td>Augusta + virtual</td></tr>
          <tr><td>October</td><td>Maine Cannabis Safety &amp; Compliance Seminar (Fall)</td><td>Training</td><td>Lewiston</td></tr>
          <tr><td>TBA</td><td>MCIA / MCCA regional roundtables</td><td>Networking</td><td>Portland, Bangor, Biddeford, Lewiston</td></tr>
        </tbody>
      </table>
    </section>

    <nav class="toc" aria-label="Table of contents">
      <h2>On this page</h2>
      <ol>
        <li><a href="#by-month">Calendar by month</a></li>
        <li><a href="#by-category">Events by category</a></li>
        <li><a href="#ocp">OCP &amp; government events</a></li>
        <li><a href="#associations">Industry associations</a></li>
        <li><a href="#training">Training &amp; certification</a></li>
        <li><a href="#consumer">Consumer-facing events &amp; expos</a></li>
        <li><a href="#how-to-attend">How to attend effectively</a></li>
        <li><a href="#networking">Networking strategy</a></li>
        <li><a href="#sources">Primary sources &amp; how to stay informed</a></li>
        <li><a href="#faq">Frequently asked questions</a></li>
      </ol>
    </nav>

    <section id="by-month">
      <h2>2026 Cannabis Events Calendar — By Month</h2>
      <p>The master chronological index. Each entry links to the event host's registration page where one is available. Where dates are "TBA" the host has confirmed the event but not yet locked the day — check the linked source page before planning travel.</p>

      <div class="month-section">
        <div class="month-header">January 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>Legislative Session Convenes — Cannabis Caucus opens</h3>
            <p class="event-date">Week of January 7 · Augusta</p>
            <p>The 132nd Maine Legislature convenes and the cannabis caucus reactivates. Bills for the 2026 session are LRs (Legislative Requests) through January, public hearings start in February. Track new bill drafts on the Maine Legislature's <a href="https://legislature.maine.gov/" target="_blank" rel="noopener noreferrer">legislature.maine.gov</a> document search.</p>
          </div>
          <div class="event-item">
            <h3>Budtender Certification Program — Spring cohort opens</h3>
            <p class="event-date">Rolling enrollment · Online</p>
            <p>Online certification program for dispensary front-line staff. 4–6 hours of self-paced modules covering product knowledge, state regulations, responsible service, and customer interaction. Several Maine dispensaries require this certification for all new budtenders.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">February 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>Maine Cannabis Expo — Winter edition</h3>
            <p class="event-date">Late February 2026 · Portland Expo Center, Portland</p>
            <p>Largest annual consumer-facing cannabis trade show in Maine. 21+ only, valid photo ID required. Tickets $20–40 general, $75–150 VIP (includes budtender training and sample bags). Two days of exhibitors, seminars, and product showcases. <a href="https://mainecannabisexpo.com" target="_blank" rel="noopener noreferrer">mainecannabisexpo.com</a>.</p>
          </div>
          <div class="event-item">
            <h3>MCIA New Member Open House</h3>
            <p class="event-date">Mid-February 2026 · Portland</p>
            <p>Maine Cannabis Industry Association (MCIA) opens its winter member drive. Open houses let prospective members attend a single meeting for free, meet the board, and review the legislative agenda for the second half of the session. <a href="https://mainecannabisindustry.org" target="_blank" rel="noopener noreferrer">mainecannabisindustry.org</a>.</p>
          </div>
          <div class="event-item">
            <h3>Budtender Certification — February cohort starts</h3>
            <p class="event-date">Rolling enrollment · Online</p>
            <p>See January entry. February cohorts typically draw hires from dispensaries adding spring staff.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">March 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>OCP Q1 Stakeholder Meeting</h3>
            <p class="event-date">Mid-March 2026 · Augusta + virtual</p>
            <p>Quarterly update from OCP leadership. Topics typically include licensing throughput, compliance enforcement trends, and rule-package previews for the next quarter. Open to all licensees; virtual attendance available. Agenda published two weeks ahead on <a href="https://www.maine.gov/dafs/ocp" target="_blank" rel="noopener noreferrer">maine.gov/dafs/ocp</a>. The most important recurring regulatory event on the Maine cannabis calendar.</p>
          </div>
          <div class="event-item">
            <h3>Maine Cannabis Safety &amp; Compliance Seminar — Spring</h3>
            <p class="event-date">Mid-March 2026 · Lewiston</p>
            <p>Full-day seminar covering Maine-specific cannabis laws, OCP compliance requirements, and safety standards. Led by OCP staff and cannabis attorneys. Completing this seminar satisfies the annual compliance training requirement for Maine licensees. Registration typically opens 4–6 weeks ahead via MCCA.</p>
          </div>
          <div class="event-item">
            <h3>MCCA Spring Roundtable — Biddeford</h3>
            <p class="event-date">Late March 2026 · Biddeford</p>
            <p>Maine Craft Cannabis Association (MCCA) starts its spring regional roundtable rotation. The Biddeford stop focuses on scale-appropriate compliance for southern Maine craft operators. MCCA events are open to non-members with RSVP; member-attendees get a one-on-one legislative briefing.</p>
          </div>
          <div class="event-item">
            <h3>METRC Tracking System Training — March cohort</h3>
            <p class="event-date">Ongoing · Online</p>
            <p>Metrc — the state-certified seed-to-sale tracking system — runs rolling online training for licensees. Required for all licensees who will be entering inventory data. Modules cover package creation, transfer recording, and sales recording. 4–6 hours to complete. Enrollment open via the Metrc portal.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">April 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>OCP Public Comment Period — Rule updates</h3>
            <p class="event-date">April 2026 · Augusta + virtual</p>
            <p>Open comment period for proposed OCP rule amendments. This is the single most important window for operator influence on rule-making. Comments submitted during this window are part of the public record and are responded to in the final rule package. Notices posted on the OCP website with comment deadlines and submission instructions.</p>
          </div>
          <div class="event-item">
            <h3>Legislative Cannabis Caucus — Spring hearings</h3>
            <p class="event-date">April 2026 · State House, Augusta</p>
            <p>Public hearings on cannabis-related bills in the 132nd Legislature. Open to public observation and testimony. Legislative schedule and bill text at <a href="https://legislature.maine.gov/" target="_blank" rel="noopener noreferrer">legislature.maine.gov</a>. Bills typically expected: consumption lounges (re-introduced), expansion of medical reciprocity, child-resistant packaging revisions.</p>
          </div>
          <div class="event-item">
            <h3>MCIA Monthly Meeting — Portland</h3>
            <p class="event-date">Mid-April 2026 · Portland</p>
            <p>Recurring monthly meeting. Topics rotate: legislative update, member spotlight on a specific operator category, B2B vendor fair in alternating months. Open-house attendance for prospective members; full access for members.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">May 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>CAM Annual Operator Summit</h3>
            <p class="event-date">Early-to-mid May 2026 · Portland (location TBA)</p>
            <p>Cannabis Association of Maine's flagship annual gathering. Day-long program with legislative keynote, advocacy panels, and B2B exhibit floor. Registration typically opens in March via <a href="https://cannabisassociationofmaine.org" target="_blank" rel="noopener noreferrer">cannabisassociationofmaine.org</a>.</p>
          </div>
          <div class="event-item">
            <h3>Legislative Cannabis Caucus — May hearings</h3>
            <p class="event-date">May 2026 · State House, Augusta</p>
            <p>Continuation of the spring hearing cycle. Mark-up work sessions on cannabis bills typically begin mid-May. Track specific bill numbers on the Maine Legislature's document search.</p>
          </div>
          <div class="event-item">
            <h3>MCCA Spring Roundtable — Lewiston</h3>
            <p class="event-date">Mid-May 2026 · Lewiston</p>
            <p>Lewiston stop on the MCCA spring rotation. Focus on central-Maine craft cultivation, including caregiver-to-cultivator transition pathways under LD 1840's caregiver trade show framework.</p>
          </div>
          <div class="event-item">
            <h3>Budtender Certification — May cohort</h3>
            <p class="event-date">Rolling enrollment · Online</p>
            <p>Spring hire cohort. Several large multi-location operators batch budtender onboarding on a quarterly cadence tied to summer seasonal hiring.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">June 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>MCCA Spring Roundtable — Bangor</h3>
            <p class="event-date">Mid-June 2026 · Bangor</p>
            <p>Bangor stop on the MCCA spring rotation. Eastern-Maine focus: Down East craft cultivation, the Aroostook moratorium context, and Penobscot-region caregiver community.</p>
          </div>
          <div class="event-item">
            <h3>Legislative Session — Final action on cannabis bills</h3>
            <p class="event-date">Mid-June 2026 · State House, Augusta</p>
            <p>The 132nd Legislature's target adjournment is typically late June. Bills that have passed both chambers go to the Governor's desk; vetoes and bill signings are tracked on <a href="https://legislature.maine.gov/" target="_blank" rel="noopener noreferrer">legislature.maine.gov</a>. LD 1840 (caregiver trade shows) was signed in 2025 with a July 29, 2026 effective date.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">July 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3><strong>LD 1840 caregiver trade show sales — EFFECTIVE</strong></h3>
            <p class="event-date">July 29, 2026 · Statewide</p>
            <p>The amended 22 M.R.S. §2423-A(2)(O) goes into effect. Registered Maine caregivers can sell and transfer medical cannabis at trade shows, industry events, and on caregiver-owned/leased premises under the OCP caregiver trade show rule package. See the full <a href="/guides/maine-cannabis-caregiver-trade-show-sales">compliance guide</a> for packaging, labeling, and trip-ticket rules.</p>
          </div>
          <div class="event-item">
            <h3>OCP Q2 Compliance Workshop — Portland</h3>
            <p class="event-date">Mid-July 2026 · Portland</p>
            <p>Full-day OCP workshop covering compliance updates for the second half of 2026. Detailed walkthrough of new compliance requirements, METRC updates, and OCP enforcement priorities. Designed for licensees who have already received their license and want to stay current. Most attendees cite it as the most operationally useful OCP event of the year.</p>
          </div>
          <div class="event-item">
            <h3>MCIA Monthly Meeting — Portland</h3>
            <p class="event-date">Mid-July 2026 · Portland</p>
            <p>Mid-summer member meeting. The first major member gathering after LD 1840's effective date — expect focused programming on caregiver trade show strategy.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">August–September 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>OCP Q3 Stakeholder Meeting</h3>
            <p class="event-date">Late August or early September 2026 · Augusta + virtual</p>
            <p>Quarterly regulatory update. Agenda typically includes enforcement trends, licensing throughput, and rule-package previews. Last full regulatory check-in before the October Annual Industry Summit.</p>
          </div>
          <div class="event-item">
            <h3>MCIA Member Open House — September</h3>
            <p class="event-date">Mid-September 2026 · Portland</p>
            <p>Second MCIA open house of the year. Targets new operators entering the market during the spring license-application cycle. Reviews legislative outcomes from the session and the regulatory implications for the fall.</p>
          </div>
        </div>
      </div>

      <div class="month-section">
        <div class="month-header">October 2026</div>
        <div class="events-list">
          <div class="event-item">
            <h3>OCP Annual Industry Summit</h3>
            <p class="event-date">Mid-October 2026 · Augusta + virtual</p>
            <p>Largest regulatory-focused event of the year. Daylong program with OCP leadership presentations, panel discussions on rule changes from the past session, and B2B networking. Open to all licensees and applicants. Registration typically opens in August via <a href="https://www.maine.gov/dafs/ocp" target="_blank" rel="noopener noreferrer">maine.gov/dafs/ocp</a>.</p>
          </div>
          <div class="event-item">
            <h3>Maine Cannabis Safety &amp; Compliance Seminar — Fall</h3>
            <p class="event-date">Mid-October 2026 · Lewiston</p>
            <p>Fall edition of the OCP-supported compliance seminar. Covers updates from the legislative session, harvest-cycle compliance considerations, and the year's enforcement trendlines. Satisfies the annual compliance training requirement.</p>
          </div>
          <div class="event-item">
            <h3>MCIA Monthly Meeting — Annual Member Meeting</h3>
