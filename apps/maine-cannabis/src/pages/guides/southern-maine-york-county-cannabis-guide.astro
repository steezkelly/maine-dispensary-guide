---
import Layout from '../../layouts/Layout.astro';
import AutoRelated from '../../components/AutoRelated.astro';
import RegionHubShell from '../../components/RegionHubShell.astro';
import clusterRegions from '../../data/cluster-regions.json';

const cluster = clusterRegions.clusters.find((c) => c.slug === 'southern-maine-york-county-cannabis-guide');
if (!cluster) throw new Error('cluster-regions.json: missing slug "southern-maine-york-county-cannabis-guide"');
const siblingClusters = clusterRegions.clusters.filter((c) => c.slug !== cluster.slug);
const editorialStage = cluster.editorial_pilot ? 'Stage 2' : 'Stage 3';
const clusterLabel = cluster.editorial_pilot ? 'Pilot cluster' : 'Roll-out cluster';

const clusterFaqs = [
  { q: 'What counties does the ' + cluster.display_name + ' cannabis guide cover?', a: 'Primary counties: ' + cluster.counties.join(', ') + '. The hub links to every published Maine Dispensary Guide for towns in this cluster.' },
  { q: 'How many towns in the ' + cluster.display_name + ' cluster have a published Maine Dispensary Guide?', a: 'This cluster carries ' + cluster.guide_count + ' guide references (towns + operator profiles). The directory below is the canonical list, sourced from the same registry as /find-a-dispensary.' },
  { q: 'Is adult-use cannabis retail allowed in every town in the ' + cluster.display_name + ' cluster?', a: "No. Retail access depends on each town's opt-in vote under Maine's adult-use program. Some towns host active stores; others are opt-out or medical-only. See each town's guide for local status." },
  { q: 'Where can I find pricing and menus for dispensaries in this region?', a: "Use the map-search link on each town card for live location data, then verify hours and menus directly with the operator. Maine Dispensary Guide does not host live menus." },
  { q: 'When will this hub carry the full regional editorial body?', a: 'Stage 1 (this page) shipped the directory + canonical registry on 2026-07-08. Stage 2 fills in the 2,000+ word editorial body with primary-source regional data (OCP roster, ACS Census, opt-in voting records, drive-time matrices).' },
];

const article = { author: 'Eliot Nash', authorId: 'eliot-nash', publishDate: '2026-07-08', modifiedDate: '2026-07-08', section: 'Regional Guides' };
---
<Layout
  title={cluster.display_name + ' Cannabis Guide — Regional Hub (2026)'}
  description={cluster.lede + ' Stage 1 foundation: directory of ' + cluster.guide_count + ' town guides and operator profiles across ' + cluster.counties.join(', ') + '.'}
  heroImage="/images/heroes/maine-portland-harbor-hero.jpg"
  article={article}
  topics={['region', 'hub', 'market']}
  breadcrumbs={[{ label: 'Guides', href: '/guides' }, { label: cluster.display_name, href: Astro.url.pathname }]}
>
<article style="max-width: 760px; margin: 0 auto;">
  <RegionHubShell cluster={cluster} clusterFaqs={clusterFaqs}>
    <section style="margin-bottom: 2.5rem;">
      <h2>{editorialStage} editorial body placeholder</h2>
      <p>The 2,000+ word editorial body for the {cluster.display_name} cannabis guide cluster ships in {editorialStage} per <a href="/docs/STAGE_2_TOWN_CLUSTER_PILOT_BRIEF_2026-07-08.md">docs/STAGE_2_TOWN_CLUSTER_PILOT_BRIEF_2026-07-08.md</a>. {clusterLabel}. Author: {article.author}.</p>
    </section>
    {siblingClusters.map((sibling) => (
      <article class="hub-sibling" slot="siblings">
        <h3><a href={sibling.hub_href}>{sibling.display_name}</a></h3>
        <p>{sibling.guide_count} guides — {sibling.counties.join(', ')}</p>
      </article>
    ))}
    <AutoRelated slot="related" currentPath={'/guides/' + cluster.slug} currentTopics={['region', 'hub', 'market']} section="Regional Guides" limit={6} />
  </RegionHubShell>
</article>
</Layout>
