    { "@type": "Question", "name": "What are Just Baked's hours?", "acceptedAnswer": { "@type": "Answer", "text": "Per the operator's site, Just Baked is open Monday through Saturday 10am-6pm and Sunday 10am-4pm. Confirm by phone before visiting." }},
