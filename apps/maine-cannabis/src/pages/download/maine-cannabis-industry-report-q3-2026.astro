---
import AutoRelated from '../../components/AutoRelated.astro';
import LeadMailtoForm from '../../components/LeadMailtoForm.astro';
import Layout from '../../layouts/Layout.astro';
import PineTree from '@network/ui/PineTree';

const pdfDownloadUrl = '/downloads/maine-cannabis-industry-report-q3-2026.pdf';
const leadTo = 'leads@mainedispensaryguide.com';
const leadSubject = 'Maine Cannabis Industry Report — Q3 2026 request: {email}';
const leadBody =
  'Hi — please send me the Maine Cannabis Industry Report — Q3 2026 PDF.\n\n' +
  'Name: {name}\nEmail: {email}\nBusiness: {business}\nRole: {role}\n' +
  'Source page: /download/maine-cannabis-industry-report-q3-2026';

const pageTitle = 'Maine Cannabis Industry Report — Q3 2026 (Free PDF)';
const pageDescription =
  'Free 8-page professional industry report on the Maine cannabis market as of Q3 2026. Regulatory, market, industry, economic, and outlook coverage with verified figures and citations.';

const faqPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is included in the Maine Cannabis Industry Report — Q3 2026?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text':
          'The report covers eight sections: introduction and methodology, Maine market snapshot with verified transaction and patient counts, legal and regulatory news including 2026 session outcomes, industry and technology developments, economic performance with 280E impact analysis, a Q4 forecast, a conclusion, and a references and methodology section with citations. Each figure cites its source document.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Is the Maine Cannabis Industry Report current with Q3 2026 data?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text':
          'The report is published during Q3 2026 with a stated data cutoff. It does not present incomplete Q3 results as final quarter-end results. Where late-Q3 data is unavailable, the report marks the gap explicitly rather than extrapolating. Updated figures are versioned in the methodology section.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Who is the audience for this report?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text':
          'The report is written for current and prospective Maine cannabis operators, investors evaluating the Maine market, and analysts tracking regulated US cannabis markets. It is a boardroom-quality reference, not a marketing deck.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How is the report sourced?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text':
          'Each figure cites its source document. Primary sources include Maine OCP monthly reports, Maine Revenue Services tax filings, the Maine legislature bill tracker, and state and federal agency press releases. Charts and tables include a source-of-record note.',
      },
    },
  ],
});
---

<Layout
  title={pageTitle}
  description={pageDescription}
  noindex={false}
>
  <style>
    .download-page {
      max-width: 880px;
      margin: 0 auto;
      padding: 2rem 1.5rem 3rem;
    }
    .doc-header {
      text-align: center;
      padding: 3rem 1rem;
      background: var(--color-surface);
      border-radius: 1rem;
      margin-bottom: 2rem;
    }
    .doc-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 0.5rem;
    }
    .doc-brand {
      font-family: var(--font-serif);
      font-size: 0.875rem;
      letter-spacing: 0.05em;
      color: var(--color-text-light);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .doc-title {
      font-family: var(--font-serif);
      font-size: 2.5rem;
      line-height: 1.1;
      color: var(--color-text);
      margin: 0 0 0.5rem;
    }
    .doc-subtitle {
      font-size: 1.125rem;
      color: var(--color-text-light);
      margin: 0 0 1rem;
    }
    .doc-meta {
      font-size: 0.875rem;
      color: var(--color-text-light);
      margin-bottom: 1.5rem;
    }

    :global(.lead-mailto-form),
    :global(.lead-intake-form) {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 480px;
      margin: 1.5rem auto 0;
      text-align: left;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    .form-group label {
      color: var(--color-text);
      font-size: 0.875rem;
      font-weight: 600;
    }
    .optional {
      color: var(--color-text-light);
      font-weight: 400;
    }
    .form-group input,
    .form-group select {
      padding: 0.875rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: 0.75rem;
      background: var(--color-background);
      color: var(--color-text);
      font: inherit;
    }
    .cta-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 1rem 1.5rem;
      border: none;
      border-radius: 0.75rem;
      background: var(--color-primary);
      color: var(--color-on-primary);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }
    .success-card {
      max-width: 480px;
      margin: 1.5rem auto 0;
      padding: 1.5rem;
      border: 1px solid var(--color-primary);
      border-radius: 1rem;
      background: var(--color-background);
    }
    .success-card h2 {
      margin-top: 0;
    }
    .success-card a {
      color: var(--color-text);
      font-weight: 600;
    }
    .or-download {
      margin-top: 1.25rem;
      text-align: center;
    }
    .or-download a {
      color: var(--color-text-light);
      font-size: 0.875rem;
      text-decoration: underline;
    }

    .domain-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }
    .domain-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 1rem;
      padding: 1.5rem;
    }
    .domain-card h3 {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--color-text);
      margin: 0 0 0.5rem;
    }
    .check-count {
      font-size: 0.75rem;
      color: var(--color-text-light);
      font-weight: 400;
      margin-left: 0.5rem;
    }
    .domain-card p {
      font-size: 0.875rem;
      color: var(--color-text-light);
      margin: 0;
      line-height: 1.5;
    }

    section h2 {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      color: var(--color-text);
      margin-top: 2rem;
    }

    .data-cutoff-note {
      background: var(--color-surface);
      border-left: 4px solid var(--color-primary);
      padding: 1rem 1.25rem;
      border-radius: 0.5rem;
      margin: 2rem 0;
      font-size: 0.9375rem;
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .doc-title { font-size: 1.75rem; }
      .domain-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script type="application/ld+json" set:html={faqPageJsonLd}></script>

  <article class="download-page">
    <div class="doc-header">
      <div class="doc-logo">
        <PineTree size={48} color="var(--color-primary)" />
      </div>
      <div class="doc-brand">Maine Dispensary Guide</div>
      <h1 class="doc-title">Maine Cannabis<br />Industry Report</h1>
      <p class="doc-subtitle">Q3 2026 edition — the Maine market snapshot every operator and analyst should read</p>
      <div class="doc-meta">Version 2026.Q3 &bull; Published 23 July 2026 &bull; 8 pages &bull; Free download</div>

      <div class="success-card" id="maine-cannabis-industry-report-success" style="display: none;">
        <h2>Check your inbox — the Maine Cannabis Industry Report is on its way.</h2>
        <p>Or <a href={pdfDownloadUrl} download>download now without subscribing</a>.</p>
      </div>

      <LeadMailtoForm
        formId="maine-cannabis-industry-report-lead-form"
        leadTo={leadTo}
        leadSubject={leadSubject}
        leadBody={leadBody}
        formName="q3_2026_industry_report"
        successPath="/download/maine-cannabis-industry-report-q3-2026?success=true"
        trackFields={['role', 'business']}
      >
        <div class="form-group">
          <label for="q3-name">Your Name</label>
          <input type="text" id="q3-name" name="name" required placeholder="Jane Smith" autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="q3-email">Email Address</label>
          <input type="email" id="q3-email" name="email" required placeholder="jane@example.com" autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="q3-business">Business or Affiliation <span class="optional">(optional)</span></label>
          <input type="text" id="q3-business" name="business" placeholder="Pine Tree Cannabis LLC" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label for="q3-role">Your Role</label>
          <select id="q3-role" name="role" required>
            <option value="">Select one...</option>
            <option value="operator">Dispensary Operator</option>
            <option value="applicant">License Applicant</option>
            <option value="investor">Investor / Analyst</option>
            <option value="service">Service Provider (legal / accounting / consulting)</option>
            <option value="curious">Just Curious</option>
          </select>
        </div>
        <!-- analytics:cta-injected id=cta-inline-download--maine-cannabis-industry-report-q3-2026-01 -->
        <button type="submit" class="cta-button" data-cta-id="cta-inline-download--maine-cannabis-industry-report-q3-2026-01">
          Download Free — Enter Your Email
        </button>
      </LeadMailtoForm>

      <div class="or-download">
        <a href={pdfDownloadUrl} download>Or download now without subscribing</a>
      </div>
    </div>

    <div class="data-cutoff-note">
      <strong>Data cutoff:</strong> figures and charts reflect data available as of <strong>23 July 2026</strong>.
      Late-Q3 data and 2026 session outcomes posted after the cutoff are not in this edition.
      See Section 8 (References &amp; Methodology) for the per-figure source list.
    </div>

    <section>
      <h2>What This Report Covers</h2>
      <p>
        Eight sections, verified figures throughout, and a methodology appendix that names every primary source.
        The full edition is an 8-page PDF plus supporting research linked inline. This landing page is a
        free entry point — fill out the form above for the full PDF delivered to your inbox, or skip the
        form and download immediately below the lead form.
      </p>

      <div class="domain-grid">
        <div class="domain-card">
          <h3>1. Introduction &amp; Methodology <span class="check-count">scope + cutoff</span></h3>
          <p>Scope statement, data cutoff, source taxonomy, and the difference between verified figures and projection.</p>
        </div>
        <div class="domain-card">
          <h3>2. Maine Market Snapshot <span class="check-count">8 figures</span></h3>
          <p>Transaction counts, patient counts, registered operator and caregiver counts, regional distribution, and year-over-year deltas.</p>
        </div>
        <div class="domain-card">
          <h3>3. Legal &amp; Regulatory News <span class="check-count">2026 session</span></h3>
          <p>2026 Maine legislative outcomes relevant to cannabis operators, plus federal scheduling and rescheduling context.</p>
        </div>
        <div class="domain-card">
          <h3>4. Industry, Tech &amp; Business <span class="check-count">operational</span></h3>
          <p>Inventory-tech adoption, METRC workflow updates, payment-processing constraints, and retail-format shifts.</p>
        </div>
        <div class="domain-card">
          <h3>5. Economic Performance <span class="check-count">280E + tax</span></h3>
          <p>280E impact analysis, estimated annual licensing cost range, and the effective-tax stacking the report warns against.</p>
        </div>
        <div class="domain-card">
          <h3>6. Forecast <span class="check-count">Q4 outlook</span></h3>
          <p>Q4 2026 directional expectations, with the caveat that any projection cites its reference scenario explicitly.</p>
        </div>
        <div class="domain-card">
          <h3>7. Conclusion <span class="check-count">operator lens</span></h3>
          <p>Synthesis for operators and analysts — what the Q3 2026 data is and is not saying.</p>
        </div>
        <div class="domain-card">
          <h3>8. References &amp; Methodology <span class="check-count">per-figure cites</span></h3>
          <p>Primary-source document list for every figure, table, and chart, plus known gaps and the update cadence.</p>
        </div>
      </div>
    </section>

    <section>
      <h2>How to Read This Report</h2>
      <p>
        Section 2 is where you'll spend the most time if you're an operator — it carries the Maine market
        baseline. Section 5 is the highest-signal section if you're tracking the economics side of the
        business, including the 280E stacking trap the report calls out. Section 8 is the audit trail:
        the methodology appendix names every primary source so each figure can be traced back to a specific
        document version.
      </p>
      <p>
        The report is published during Q3 2026 with a stated data cutoff rather than after the quarter closes.
        Where late-Q3 data is unavailable, the gap is marked explicitly. Updated figures are versioned in
        the methodology section so future editions can be diffed against this one.
      </p>
    </section>

    <AutoRelated currentPath="/download/maine-cannabis-industry-report-q3-2026" currentTopics={['q3-2026', 'industry-report', 'maine-cannabis', 'regulation', 'market-data']} limit={6} />
  </article>
</Layout>

<script is:inline>
  // success state is handled client-side (static build can't read query params)
  if (window.location.search.includes('success=true')) {
    var el = document.getElementById('maine-cannabis-industry-report-success');
    if (el) el.style.display = 'block';
  }
</script>
