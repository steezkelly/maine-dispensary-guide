---
import Layout from '../../layouts/Layout.astro';
import LeadMailtoForm from '../../components/LeadMailtoForm.astro';
import MetaPixel from '../../components/MetaPixel.astro';
import PineTree from '@network/ui/PineTree';
import { funnelConfig } from '../../data/funnelConfig';

const leadTo = "leads@mainedispensaryguide.com";
const leadSubject = "Q3 2026 Report (free sample) request: {email}";
const leadBody = "Hi — please send me the free Q3 2026 Maine Cannabis Industry Report sample.\n\nName: {name}\nEmail: {email}\nBusiness: {business}\nStage: {stage}\nSource page: /report/q3-2026";
---

<Layout
  title="Maine Cannabis Industry Report — Q3 2026"
  description="The Q3 2026 Maine cannabis market, interpreted for decisions. What $6.10/g flower means for your margins, where the market is saturated, and what Schedule III does to your tax exposure. Primary-source data from OCP and MRS."
  noindex={false}
>
  <MetaPixel pixelId={funnelConfig.metaPixelId} />

  <style>
    .funnel { max-width: 760px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
    .hero {
      text-align: center; padding: 3rem 2rem; background: var(--color-surface);
      border-radius: 2rem; border: 1px solid var(--color-border); margin-bottom: 2.5rem;
    }
    .brand {
      font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.15em; color: var(--color-soft-green); margin: 1rem 0;
    }
    h1 { font-family: var(--font-serif); font-size: 2.25rem; line-height: 1.2; margin: 0.5rem 0; }
    .subtitle { font-size: 1.125rem; color: var(--color-text-light); margin: 0.75rem 0 1.5rem; }
    .kpi-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
    .kpi { text-align: center; padding: 1rem; background: var(--color-background); border: 1px solid var(--color-border); border-radius: 0.75rem; }
    .kpi .value { font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-primary); font-weight: 700; }
    .kpi .label { font-size: 0.75rem; color: var(--color-text-light); margin-top: 0.25rem; }
    .free-note {
      display: inline-block; margin-top: 1rem; padding: 0.5rem 1rem;
      background: rgba(31,61,46,0.08); border-radius: 999px;
      font-size: 0.875rem; font-weight: 600; color: var(--color-primary);
    }
    :global(.lead-mailto-form) { display: flex; flex-direction: column; gap: 1rem; max-width: 480px; margin: 1.5rem auto 0; text-align: left; }
    .form-group { display: flex; flex-direction: column; gap: 0.375rem; }
    .form-group label { font-size: 0.875rem; font-weight: 600; }
    .optional { color: var(--color-text-light); font-weight: 400; }
    .form-group input, .form-group select {
      padding: 0.875rem 1rem; border: 1px solid var(--color-border);
      border-radius: 0.75rem; background: var(--color-background); color: var(--color-text); font: inherit;
    }
    .cta-button {
      padding: 1rem 1.5rem; border: none; border-radius: 0.75rem;
      background: var(--color-primary); color: var(--color-on-primary);
      font: inherit; font-weight: 700; cursor: pointer;
    }
    .success-card {
      max-width: 480px; margin: 1.5rem auto 0; padding: 1.5rem;
      border: 1px solid var(--color-primary); border-radius: 1rem; background: var(--color-background);
    }
    .bridge {
      margin-top: 3rem; padding: 2.5rem; text-align: left;
      background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 1.5rem;
    }
    .bridge h2 { font-family: var(--font-serif); margin-top: 0; text-align: center; }
    .bridge p { color: var(--color-text-light); }
    .decision-list { list-style: none; padding: 0; margin: 1.5rem 0; }
    .decision-list li {
      padding: 0.75rem 0; border-bottom: 1px solid var(--color-border);
      font-size: 1rem; color: var(--color-text);
    }
    .decision-list li:last-child { border-bottom: none; }
    .decision-list .free-tag {
      display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: var(--color-primary); background: rgba(31,61,46,0.08);
      padding: 0.15rem 0.5rem; border-radius: 4px; margin-left: 0.5rem; vertical-align: middle;
    }
    .decision-list .locked { color: var(--color-text-light); }
    .bridge .cta-button { display: block; text-align: center; text-decoration: none; margin-top: 1.5rem; }
    .methodology {
      margin-top: 2rem; padding: 1.5rem; font-size: 0.875rem;
      color: var(--color-text-light); border: 1px solid var(--color-border);
      border-radius: 1rem; background: var(--color-background);
    }
    .methodology strong { color: var(--color-text); }
    @media (max-width: 768px) { h1 { font-size: 1.75rem; } }
  </style>

  <article class="funnel">
    <div class="hero">
      <PineTree size={48} color="var(--color-primary)" />
      <div class="brand">Maine Dispensary Guide Research</div>
      <h1>The Maine Cannabis Market,<br/>Interpreted for Decisions</h1>
      <p class="subtitle">Not another data dump. The Q3 2026 numbers from OCP and MRS, translated into what they mean for the next move you make.</p>

      <div class="kpi-strip">
        <div class="kpi"><div class="value">$6.10/g</div><div class="label">Flower price, YTD 2026</div></div>
        <div class="kpi"><div class="value">346</div><div class="label">Active adult-use licenses</div></div>
        <div class="kpi"><div class="value">$20.7M</div><div class="label">June 2026 adult-use sales</div></div>
      </div>

      <span class="free-note">The numbers below are free. What to do about them is the product.</span>

      <div class="success-card" id="report-success" style="display: none;">
        <h2>Check your inbox — the free sample decision is on its way.</h2>
        <p>Ready for the full playbook? <a href="/report/q3-2026-offer">See all 8 decisions →</a></p>
      </div>

      <LeadMailtoForm
        formId="q3-2026-funnel-lead-form"
        leadTo={leadTo}
        leadSubject={leadSubject}
        leadBody={leadBody}
        formName="q3_2026_report_funnel"
        successPath="/report/q3-2026?success=true"
        trackFields={['stage']}
      >
        <div class="form-group">
          <label for="fn-name">Your Name</label>
          <input type="text" id="fn-name" name="name" required placeholder="Jane Smith" autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="fn-email">Email Address</label>
          <input type="email" id="fn-email" name="email" required placeholder="jane@example.com" autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="fn-business">Business Name <span class="optional">(optional)</span></label>
          <input type="text" id="fn-business" name="business" placeholder="Pine Tree Cannabis LLC" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label for="fn-stage">What stage are you at?</label>
          <select id="fn-stage" name="stage" required>
            <option value="">Select one...</option>
            <option value="researching">Researching — just exploring</option>
            <option value="applying">Applying — have my LLC, working on license</option>
            <option value="operating">Already Operating — looking to grow</option>
          </select>
        </div>
        <button type="submit" class="cta-button" data-cta-id="cta-funnel-free-sample-01">
          Send Me the Free Decision
        </button>
      </LeadMailtoForm>
    </div>

    <section class="bridge">
      <h2>Numbers aren't decisions.</h2>
      <p>Anyone can pull the OCP dashboard. The question isn't "what's the flower price?" — it's "what do I <em>do</em> about a $6.10/g market?" The Q3 2026 report answers eight of those questions, each grounded in primary-source data with every figure traced to its origin.</p>

      <ul class="decision-list">
        <li><strong>1. The margin math on $6.10/g flower</strong> — whether your store survives the compression, and which categories still hold margin <span class="free-tag">Free sample</span></li>
        <li class="locked"><strong>2. The saturation map</strong> — which municipalities are over-licensed and which are still open before you sign a lease</li>
        <li class="locked"><strong>3. Schedule III tax exposure</strong> — what the April 2026 effective date does to your 280E burden, modeled</li>
        <li class="locked"><strong>4. License-tier selection</strong> — which tier fits your capital and canopy, with fee math</li>
        <li class="locked"><strong>5. The hiring cost model</strong> — what a compliant team actually costs in your region</li>
        <li class="locked"><strong>6. Category mix under compression</strong> — where margin is migrating as flower falls</li>
        <li class="locked"><strong>7. The municipal landscape</strong> — opt-in status and what it means for siting</li>
        <li class="locked"><strong>8. Exit and valuation timing</strong> — where the market is heading and what it means for your position</li>
      </ul>

      <a href="/report/q3-2026-offer" class="cta-button" data-cta-id="cta-funnel-to-offer-01">Get the Full Playbook — from $29</a>
    </section>

    <div class="methodology">
      <strong>How we work.</strong> Every figure in this report traces to a primary source — Maine Office of Cannabis Policy operational dashboards, Maine Revenue Services tax-filer data, and federal regulatory filings — with a retrieval date and a status label (preliminary, unaudited, filing-period-based, revisable). We don't aggregate other people's summaries. We go to the source, and we show you where. Data cutoff: July 22, 2026. This is an in-quarter edition — the best picture available <em>now</em>, for decisions you're making <em>now</em>.
    </div>
  </article>

  <script is:inline>
    if (new URLSearchParams(window.location.search).get('success') === 'true') {
      var el = document.getElementById('report-success');
      if (el) { el.style.display = 'block'; }
      if (window.fbq) { window.fbq('track', 'Lead'); }
    }
  </script>
</Layout>
