---
import Layout from '../../layouts/Layout.astro';
import LeadMailtoForm from '../../components/LeadMailtoForm.astro';
import MetaPixel from '../../components/MetaPixel.astro';
import PineTree from '@network/ui/PineTree';
import { funnelConfig } from '../../data/funnelConfig';

const leadTo = "leads@mainedispensaryguide.com";
const leadSubject = "Q3 2026 Report (free sample) request: {email}";
const leadBody = "Hi — please send me the free Q3 2026 Maine Cannabis Industry Report sample.\n\nName: {name}\nEmail: {email}\nBusiness: {business}\nStage: {stage}\nSource page: /report/q3-2026";
---

<Layout
  title="Maine Cannabis Industry Report — Q3 2026 (Free Sample)"
  description="Get the free Q3 2026 Maine cannabis market snapshot: adult-use sales, license counts, flower prices, and tax revenue from OCP and MRS primary data. Upgrade to the full report for $1."
  noindex={false}
>
  <MetaPixel pixelId={funnelConfig.metaPixelId} />

  <style>
    .funnel { max-width: 760px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
    .hero {
      text-align: center; padding: 3rem 2rem; background: var(--color-surface);
      border-radius: 2rem; border: 1px solid var(--color-border); margin-bottom: 2.5rem;
    }
    .brand {
      font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.15em; color: var(--color-soft-green); margin: 1rem 0;
    }
    h1 { font-family: var(--font-serif); font-size: 2.25rem; line-height: 1.2; margin: 0.5rem 0; }
    .subtitle { font-size: 1.125rem; color: var(--color-text-light); margin: 0.75rem 0 1.5rem; }
    .kpi-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
    .kpi { text-align: center; padding: 1rem; background: var(--color-background); border: 1px solid var(--color-border); border-radius: 0.75rem; }
    .kpi .value { font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-primary); font-weight: 700; }
    .kpi .label { font-size: 0.75rem; color: var(--color-text-light); margin-top: 0.25rem; }
    .free-note {
      display: inline-block; margin-top: 1rem; padding: 0.5rem 1rem;
      background: rgba(31,61,46,0.08); border-radius: 999px;
      font-size: 0.875rem; font-weight: 600; color: var(--color-primary);
    }
    :global(.lead-mailto-form) { display: flex; flex-direction: column; gap: 1rem; max-width: 480px; margin: 1.5rem auto 0; text-align: left; }
    .form-group { display: flex; flex-direction: column; gap: 0.375rem; }
    .form-group label { font-size: 0.875rem; font-weight: 600; }
    .optional { color: var(--color-text-light); font-weight: 400; }
    .form-group input, .form-group select {
      padding: 0.875rem 1rem; border: 1px solid var(--color-border);
      border-radius: 0.75rem; background: var(--color-background); color: var(--color-text); font: inherit;
    }
    .cta-button {
      padding: 1rem 1.5rem; border: none; border-radius: 0.75rem;
      background: var(--color-primary); color: var(--color-on-primary);
      font: inherit; font-weight: 700; cursor: pointer;
    }
    .success-card {
      max-width: 480px; margin: 1.5rem auto 0; padding: 1.5rem;
      border: 1px solid var(--color-primary); border-radius: 1rem; background: var(--color-background);
    }
    .bridge {
      margin-top: 3rem; padding: 2rem; text-align: center;
      background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 1.5rem;
    }
    .bridge h2 { font-family: var(--font-serif); margin-top: 0; }
    .bridge .cta-button { display: inline-block; text-decoration: none; margin-top: 1rem; }
    @media (max-width: 768px) { h1 { font-size: 1.75rem; } }
  </style>

  <article class="funnel">
    <div class="hero">
      <PineTree size={48} color="var(--color-primary)" />
      <div class="brand">Maine Dispensary Guide</div>
      <h1>Maine Cannabis Industry Report — Q3 2026</h1>
      <p class="subtitle">The free market snapshot operators, advisors, and municipalities use to understand where Maine cannabis stands right now.</p>

      <div class="kpi-strip">
        <div class="kpi"><div class="value">$20.7M</div><div class="label">June 2026 adult-use sales</div></div>
        <div class="kpi"><div class="value">346</div><div class="label">Active adult-use licenses</div></div>
        <div class="kpi"><div class="value">$6.10</div><div class="label">YTD avg flower price/g</div></div>
      </div>

      <span class="free-note">Free sample — no payment needed to get this</span>

      <div class="success-card" id="report-success" style="display: none;">
        <h2>Check your inbox — the free sample is on its way.</h2>
        <p>Want the full 14-page report with every table and source? <a href="/report/q3-2026-offer">Get the complete edition from $1 →</a></p>
      </div>

      <LeadMailtoForm
        formId="q3-2026-funnel-lead-form"
        leadTo={leadTo}
        leadSubject={leadSubject}
        leadBody={leadBody}
        formName="q3_2026_report_funnel"
        successPath="/report/q3-2026?success=true"
        trackFields={['stage']}
      >
        <div class="form-group">
          <label for="fn-name">Your Name</label>
          <input type="text" id="fn-name" name="name" required placeholder="Jane Smith" autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="fn-email">Email Address</label>
          <input type="email" id="fn-email" name="email" required placeholder="jane@example.com" autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="fn-business">Business Name <span class="optional">(optional)</span></label>
          <input type="text" id="fn-business" name="business" placeholder="Pine Tree Cannabis LLC" autocomplete="organization" />
        </div>
        <div class="form-group">
          <label for="fn-stage">What stage are you at?</label>
          <select id="fn-stage" name="stage" required>
            <option value="">Select one...</option>
            <option value="researching">Researching — just exploring</option>
            <option value="applying">Applying — have my LLC, working on license</option>
            <option value="operating">Already Operating — looking to grow</option>
          </select>
        </div>
        <button type="submit" class="cta-button" data-cta-id="cta-funnel-free-sample-01">
          Send Me the Free Sample
        </button>
      </LeadMailtoForm>
    </div>

    <section class="bridge">
      <h2>Ready for the full picture?</h2>
      <p>The free sample gives you the headline numbers. The complete Q3 2026 report adds all eight sections — every sales table, the full license roster, tax-revenue breakdowns, price-compression trend lines, and the methodology with source URLs for every figure.</p>
      <a href="/report/q3-2026-offer" class="cta-button" data-cta-id="cta-funnel-to-offer-01">See the Full Report — from $1</a>
    </section>
  </article>

  <script is:inline>
    if (new URLSearchParams(window.location.search).get('success') === 'true') {
      var el = document.getElementById('report-success');
      if (el) { el.style.display = 'block'; }
      // A lead just landed — fire the Meta Lead event if the pixel is present.
      if (window.fbq) { window.fbq('track', 'Lead'); }
    }
  </script>
</Layout>
