---
import Layout from '../../layouts/Layout.astro';
import MetaPixel from '../../components/MetaPixel.astro';
import Faq from '../../components/Faq.astro';
import PineTree from '@network/ui/PineTree';
import { funnelConfig } from '../../data/funnelConfig';

const { basic, pro } = funnelConfig.pricing;
const hasBasic = funnelConfig.stripe.basicPaymentLink.length > 0;
const hasPro = funnelConfig.stripe.proPaymentLink.length > 0;

const faqItems = [
  {
    question: "What's the difference between Basic and Pro?",
    answer: "Basic ($1) is the full 14-page Q3 2026 report PDF — every section, table, and source. Pro ($29) adds the raw data tables as downloadable CSV/Excel, the full source matrix with retrieval dates, and priority access to the Q4 2026 edition when it publishes."
  },
  {
    question: "Is this a subscription?",
    answer: "No. Both are one-time purchases. You pay once, you own the files forever. No recurring charges, no account required."
  },
  {
    question: "Why is the Basic report only $1?",
    answer: "We want every operator, advisor, and municipal stakeholder in Maine to have access to primary-source market data. The $1 price covers distribution costs and helps us measure demand. The Pro tier funds deeper data work."
  },
  {
    question: "Can I share the report?",
    answer: "The report is licensed CC BY 4.0 — you can share it freely with attribution to Maine Dispensary Guide. The Pro data tables are licensed for internal use by the purchasing organization."
  },
  {
    question: "How current is the data?",
    answer: "Data cutoff is July 22, 2026. OCP operational dashboards through June 2026 (preliminary, unaudited). MRS tax-filer data through May 2026 (filing-period-based, revisable). This is an in-quarter edition, not a final annual report."
  },
];
---

<Layout
  title="Get the Full Q3 2026 Maine Cannabis Industry Report — from $1"
  description="One-time purchase. Basic report $1 (was $19.99). Pro report with raw data tables $29 (was $49). No subscription, no account. Instant delivery."
  noindex={false}
>
  <MetaPixel pixelId={funnelConfig.metaPixelId} />

  <style>
    .offer-page { max-width: 820px; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
    .offer-header { text-align: center; margin-bottom: 3rem; }
    .brand {
      font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.15em; color: var(--color-soft-green); margin: 1rem 0;
    }
    h1 { font-family: var(--font-serif); font-size: 2rem; line-height: 1.25; margin: 0.5rem 0; }
    .offer-subtitle { font-size: 1.125rem; color: var(--color-text-light); margin: 0.75rem 0; }
    .urgency {
      display: inline-block; padding: 0.5rem 1.25rem; border-radius: 999px;
      background: rgba(176,130,90,0.12); color: var(--color-accent, #8C5A3A);
      font-size: 0.875rem; font-weight: 700; margin-top: 0.75rem;
    }
    .tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin: 2.5rem 0; }
    .tier {
      position: relative; padding: 2rem; border-radius: 1.5rem;
      border: 2px solid var(--color-border); background: var(--color-surface);
      display: flex; flex-direction: column;
    }
    .tier.featured { border-color: var(--color-primary); box-shadow: 0 8px 32px rgba(31,61,46,0.10); }
    .tier-badge {
      position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
      padding: 0.25rem 1rem; border-radius: 999px; background: var(--color-primary);
      color: var(--color-on-primary); font-size: 0.75rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap;
    }
    .tier h2 { font-family: var(--font-serif); font-size: 1.35rem; margin: 0.5rem 0; }
    .price-row { display: flex; align-items: baseline; gap: 0.75rem; margin: 0.75rem 0; }
    .price-anchor { font-size: 1.1rem; color: var(--color-text-light); text-decoration: line-through; }
    .price-offer { font-family: var(--font-serif); font-size: 2.5rem; font-weight: 700; color: var(--color-primary); }
    .price-note { font-size: 0.8125rem; color: var(--color-text-light); }
    .tier ul { list-style: none; padding: 0; margin: 1rem 0 1.5rem; flex: 1; }
    .tier li { padding: 0.4rem 0; font-size: 0.9375rem; color: var(--color-text); }
    .tier li::before { content: "✓ "; color: var(--color-primary); font-weight: 700; }
    .buy-button {
      display: block; text-align: center; padding: 1rem 1.5rem; border-radius: 0.75rem;
      background: var(--color-primary); color: var(--color-on-primary);
      font-weight: 700; font-size: 1rem; text-decoration: none; border: none; cursor: pointer;
    }
    .buy-button:hover { opacity: 0.92; }
    .buy-button.disabled {
      background: var(--color-border); color: var(--color-text-light);
      pointer-events: none; cursor: default;
    }
    .coming-soon { font-size: 0.8125rem; color: var(--color-text-light); text-align: center; margin-top: 0.5rem; }
    .guarantee {
      text-align: center; margin: 2rem 0; padding: 1.5rem;
      border: 1px solid var(--color-border); border-radius: 1rem;
      font-size: 0.9375rem; color: var(--color-text-light);
    }
    @media (max-width: 768px) { h1 { font-size: 1.5rem; } .tiers { grid-template-columns: 1fr; } }
  </style>

  <article class="offer-page">
    <div class="offer-header">
      <PineTree size={40} color="var(--color-primary)" />
      <div class="brand">Maine Dispensary Guide</div>
      <h1>Get the Complete Q3 2026<br/>Maine Cannabis Industry Report</h1>
      <p class="offer-subtitle">Every table. Every source. One-time purchase. Instant delivery.</p>
      <span class="urgency">One-time offer — pricing goes up after Q3 closes</span>
    </div>

    <div class="tiers">
      <!-- BASIC TIER -->
      <div class="tier">
        <h2>{basic.label}</h2>
        <div class="price-row">
          <span class="price-anchor">{basic.anchor}</span>
          <span class="price-offer">{basic.offer}</span>
        </div>
        <span class="price-note">One-time purchase &bull; Instant PDF delivery</span>
        <ul>
          <li>Full 14-page Q3 2026 report (PDF)</li>
          <li>All 8 sections: market snapshot, licensing, tax, pricing, federal updates</li>
          <li>Every figure with source URL + retrieval date</li>
          <li>CC BY 4.0 — share freely with attribution</li>
          <li>Methodology &amp; data-status labels throughout</li>
        </ul>
        {hasBasic ? (
          <a
            href={funnelConfig.stripe.basicPaymentLink}
            class="buy-button"
            data-cta-id="cta-buy-basic-q3-2026"
            target="_blank"
            rel="noopener"
          >
            Get the Basic Report — {basic.offer}
          </a>
        ) : (
          <span class="buy-button disabled">Checkout Coming Soon</span>
        )}
        {!hasBasic && <p class="coming-soon">Stripe checkout is being set up. Check back shortly.</p>}
      </div>

      <!-- PRO TIER -->
      <div class="tier featured">
        <span class="tier-badge">Best Value</span>
        <h2>{pro.label}</h2>
        <div class="price-row">
          <span class="price-anchor">{pro.anchor}</span>
          <span class="price-offer">{pro.offer}</span>
        </div>
        <span class="price-note">One-time purchase &bull; Instant delivery</span>
        <ul>
          <li>Everything in Basic</li>
          <li>Raw data tables as CSV/Excel (sales, licenses, tax, pricing)</li>
          <li>Full source matrix with retrieval dates + status labels</li>
          <li>Priority access to Q4 2026 edition at publication</li>
          <li>Internal-use license for your organization</li>
        </ul>
        {hasPro ? (
          <a
            href={funnelConfig.stripe.proPaymentLink}
            class="buy-button"
            data-cta-id="cta-buy-pro-q3-2026"
            target="_blank"
            rel="noopener"
          >
            Get the Pro Report — {pro.offer}
          </a>
        ) : (
          <span class="buy-button disabled">Checkout Coming Soon</span>
        )}
        {!hasPro && <p class="coming-soon">Stripe checkout is being set up. Check back shortly.</p>}
      </div>
    </div>

    <div class="guarantee">
      <strong>30-day guarantee.</strong> If the report doesn't give you actionable Maine market data, email us and we'll refund you. No questions, no forms.
    </div>

    <Faq items={faqItems} />
  </article>

  <script is:inline>
    // Fire Meta Pixel events on buy-button clicks (if pixel is loaded).
    document.querySelectorAll('[data-cta-id^="cta-buy-"]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!window.fbq) return;
        var tier = btn.getAttribute('data-cta-id').indexOf('pro') !== -1 ? 'pro' : 'basic';
        var val = tier === 'pro' ? 29.0 : 1.0;
        window.fbq('track', 'InitiateCheckout', { content_name: 'q3_2026_' + tier, value: val, currency: 'USD' });
      });
    });
  </script>
</Layout>
