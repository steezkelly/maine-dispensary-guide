            <td><strong>{r.year}</strong></td>
            <td class="num-col">{r.sales?.toFixed(1) ?? '—'}{r.sales != null ? 'M' : ''}</td>
            <td class="num-col">
              {r.year === '2025' ? '+1.0%' :
               r.year === 'H1 2026' ? 'n/a (YTD)' :
