  { state: "Maine (per OCP CY2025, weighted all-pkg)", pricePerGram: "$6.62",   source: "OCP 2025 Annual Report" },
  { state: "Ohio (most expensive tracked eighth)", pricePerGram: "n/a (8th = $31.11)", source: "Headset June 2026" },
