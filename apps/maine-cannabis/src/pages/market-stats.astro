import { getSiteStats } from '../lib/site-stats';
const siteStats = getSiteStats();
// site-stats.json guarantees currentOcpLicenseeRoster when activeAdultUseRetailStores is set;
// assert for the type-narrower.
const liveOcp = siteStats.currentOcpLicenseeRoster!;

// ---------------------------------------------------------------------------
// Headline numbers — anchored to the most recent authoritative OCP releases.
// All raw figures cite-in-the-table; the methodology block at the bottom of
// the page explains source precedence and refresh cadence.
// ---------------------------------------------------------------------------

// Multi-year AU retail-sales series — mainecannabis.org monthly aggregate of
// MRS-adult-use-cannabis-taxable filings, reconciled to OCP annual totals.
const auSalesHistory = [
