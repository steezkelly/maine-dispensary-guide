        <p class="sub">All license types combined</p>
      </div>
      <div class="headline-card">
        <p class="label">Medical Dispensaries</p>
        <p class="num">90</p>
        <p class="sub">+28.5% YoY (MMCP 2025)</p>
      </div>
      <div class="headline-card">
        <p class="label">Medical Dispensary Retail</p>
        <p class="num">62</p>
        <p class="sub">+34.7% YoY</p>
      </div>
      <div class="headline-card">
        <p class="label">Medical Patient Certifications</p>
        <p class="num">112,547</p>
        <p class="sub">+1.8% YoY (2025)</p>
      </div>
      <div class="headline-card">
        <p class="label">Active Medical Providers</p>
        <p class="num">808</p>
