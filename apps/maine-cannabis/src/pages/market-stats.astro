---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
import Faq from '../components/Faq.astro';
import { getSiteStats } from '../lib/site-stats';
const siteStats = getSiteStats();
// site-stats.json guarantees currentOcpLicenseeRoster when activeAdultUseRetailStores is set;
// assert for the type-narrower.
const liveOcp = siteStats.currentOcpLicenseeRoster!;

// ---------------------------------------------------------------------------
// Headline numbers — anchored to the most recent authoritative OCP releases.
// All raw figures cite-in-the-table; the methodology block at the bottom of
// the page explains source precedence and refresh cadence.
// ---------------------------------------------------------------------------

// Multi-year AU retail-sales series — mainecannabis.org monthly aggregate of
// MRS-adult-use-cannabis-taxable filings, reconciled to OCP annual totals.
const auSalesHistory = [
  { year: "2020*",   sales: 4.35,      transactions: null,   avgPrice: null,  notes: "Partial year — adult-use retail launched Oct 2020" },
  { year: "2021",    sales: 82.0,      transactions: "1.85M", avgPrice: "$11.85", notes: "First full year" },
  { year: "2022",    sales: 158.9,     transactions: "3.05M", avgPrice: "$9.10",  notes: "+93.8% YoY" },
  { year: "2023",    sales: 216.9,     transactions: "4.10M", avgPrice: "$8.05",  notes: "+36.5% YoY; OCP adult-use annual report" },
  { year: "2024",    sales: 243.9,     transactions: "4.62M", avgPrice: "$7.25",  notes: "+12.4% YoY; OCP adult-use annual report (28-B M.R.S. §113)" },
  { year: "2025",    sales: 246.4,     transactions: "4.84M", avgPrice: "$6.62",  notes: "+1.0% YoY; market plateau, OCP data release Jan 2026" },
  { year: "H1 2026", sales: 119.95,    transactions: "2.44M", avgPrice: "$6.10",  notes: "On pace for $244–248M annualized (Jan–Jun 2026)" }
];

// Multi-year medical program series — OCP MMCP Annual Reports, 22 M.R.S. §2430-N
const medicalHistory = [
  { year: 2021, certifications: 105143, providers: 611,  caregivers: 3257, dispensaries: null,  employees: null,    notes: "Provider count first published at year-end 2020 baseline" },
  { year: 2022, certifications: 106164, providers: 649,  caregivers: 2276, dispensaries: 35,    employees: null,    notes: "Dispensary cap expired January 2021; first registration reports" },
  { year: 2023, certifications: 109001, providers: 722,  caregivers: 1763, dispensaries: 60,    employees: null,    notes: "Caregiver exodus continues; PL 2023 c. 365 caregiver framework" },
  { year: 2024, certifications: 110484, providers: 752,  caregivers: 1677, dispensaries: 70,    employees: 4358,   notes: "RIC system two-year cycle begins (July 1, 2024)" },
  { year: 2025, certifications: 112547, providers: 777,  caregivers: 1539, dispensaries: 90,    employees: 5291,   notes: "Dispensaries +28.5%; employees +21.4%; providers +8.3%" }
];

// Multi-year tax revenue — AUCP cumulative fund receipts (from mainecannabis.org
// table reconciled to OCP annual reports) + medical sales tax to General Fund.
const taxHistory = [
  { year: 2020, auFundRevenue: 1.55,    medSalesTaxGF: null,  notes: "Partial year — adult-use launched Oct 9, 2020" },
  { year: 2021, auFundRevenue: 13.47,   medSalesTaxGF: null,  notes: "First full adult-use program year" },
  { year: 2022, auFundRevenue: 28.75,   medSalesTaxGF: null,  notes: "+113% YoY — adult-use ramp" },
  { year: 2023, auFundRevenue: 35.18,   medSalesTaxGF: null,  notes: "+22.4% YoY" },
  { year: 2024, auFundRevenue: 40.73,   medSalesTaxGF: 15.06, notes: "+15.8% YoY (AU); medical sales tax = $15.06M (FY2024)" },
  { year: 2025, auFundRevenue: 43.72,   medSalesTaxGF: 14.28, notes: "+7.3% YoY (AU); medical sales tax = $14.28M (FY2025)" }
];

// County-level active AU retailer distribution (OCP 2025 Annual Report snapshots).
// Cumberland + York = ~60% of AU retail sales per OCP analytics director Eric Miller
// at the program's 5th anniversary briefing (Oct 10, 2025; Maine Public / Press Herald).
const countyShare = [
  { county: "York",        pctSales: 31,   licensedRetailers: 38,  notes: "Includes Sanford, Kittery, Wells, Biddeford; ~$76M" },
  { county: "Cumberland",  pctSales: 28,   licensedRetailers: 57,  notes: "Portland 12+, Brunswick, Scarborough, Windham; ~$69M" },
  { county: "Penobscot",   pctSales: 9,    licensedRetailers: 14,  notes: "Bangor metro; ~$22M" },
  { county: "Androscoggin",pctSales: 7,    licensedRetailers: 16,  notes: "Lewiston + Auburn; ~$17M" },
  { county: "Kennebec",    pctSales: 5,    licensedRetailers: 18,  notes: "Augusta + Waterville; ~$12M" },
  { county: "Sagadahoc",   pctSales: 3,    licensedRetailers: 5,   notes: "Bath, Topsham; ~$7M" },
  { county: "Oxford",      pctSales: 3,    licensedRetailers: 7,   notes: "Rumford, Norway; ~$7M" },
  { county: "Other 9 cos", pctSales: 14,   licensedRetailers: 32,  notes: "Combined Hancock through Washington; ~$36M" }
];

// Establishments breakdown — OCP 2025 Annual Report (Dec 31, 2025 snapshot)
const estabTypes: Array<{type: string; count: number; growth: string; notes?: string}> = [
  { type: "Cannabis Retail Stores (Tier 1)",   count: 187, growth: "+9 net (2024→25)", notes: "Largest single tier; covers adult-use dispensaries" },
  { type: "Cultivation Facilities (Tier 2)",   count: 78,  growth: "−2 net (2024→25)", notes: "Net consolidation since 2023 high" },
  { type: "Products Manufacturing (Tier 3)",   count: 81,  growth: "+6 net (2024→25)", notes: "Edibles + concentrates growth" },
  { type: "Testing Facilities (Tier 4)",       count: 4,   growth: "Flat", notes: "Four licensed certified testing facilities" },
  { type: "Total Active Adult-Use Establishments", count: 343, growth: "+11% (300 → 343 across 2023→2025)", notes: "All license types" }
];

// Product mix snapshot — Dec 2025 OCP release
const productMix = [
  { category: "Usable cannabis (flower, pre-rolls, trim)", sharePct: 52.0, dec2025Sales: 10.7, notes: "Largest segment; flower alone at ~$6.30/g in Dec 2025" },
  { category: "Concentrates (vapes, wax, resin, dabs)",   sharePct: 30.7, dec2025Sales: 6.25, notes: "Second-largest; premium tier driving growth" },
  { category: "Infused products (edibles, beverages, topicals)", sharePct: 17.3, dec2025Sales: 3.10, notes: "Beverages +15% YoY nationally (BDSA, Q1 2026); outpacing pre-rolls in new launches" }
];

// Tax-regime change effective Jan 1, 2026 (P.L. 2025, ch. 388 — biennial budget)
const taxDelta = [
  { item: "Retail sales tax on adult-use cannabis",   before: "10.0%",  after: "14.0%",  delta: "+4.0 pp",          source: "Maine Morning Star (Dec 2025); biennial budget" },
  { item: "Excise tax — flower (per lb)",              before: "$335",   after: "$223",   delta: "−$112 (−33.4%)",    source: "Maine Morning Star; MRS" },
  { item: "Excise tax — trim (per lb)",                before: "$94",    after: "$63",    delta: "−$31 (−33.0%)",     source: "Maine Morning Star; MRS" },
  { item: "Excise tax — mature plants (each)",         before: "$35",    after: "$23",    delta: "−$12 (−34.3%)",     source: "Maine Morning Star; MRS" },
  { item: "Excise tax — immature plants (each)",       before: "$1.50",  after: "$1.00",  delta: "−$0.50 (−33.3%)",   source: "Maine Morning Star; MRS" },
  { item: "Excise tax — seeds (each)",                 before: "$0.35",  after: "$0.20",  delta: "−$0.15 (−42.9%)",   source: "Maine Morning Star; MRS" },
  { item: "Medical patients (sales tax only, no excise)", before: "5.5%",   after: "5.5%",   delta: "No change",        source: "22 M.R.S. §2430-N" }
];

const faqItems = [
  { question: "How big is Maine's adult-use cannabis market right now?", answer: `Maine's adult-use (recreational) cannabis market generated $246.4 million in retail sales across 4,835,678 individual transactions during calendar year 2025 — a 1.0% increase over the $243.9M sold in 2024 (Office of Cannabis Policy, Adult Use Cannabis Program 2025 Annual Report). As of Dec 31, 2025 the OCP counted ${siteStats.activeAdultUseRetailStores} active licensed cannabis retail stores and ${siteStats.activeAdultUseMunicipalities} host municipalities. The live OCP licensee-search roster shows ${liveOcp.auRetailStores} active retail stores in ${liveOcp.auMunicipalities} municipalities as of ${liveOcp.asOf}, reflecting normal license turnover. The market's first half of 2026 (Jan–Jun) totaled $119.95M in retail sales across 2,439,812 transactions at a year-to-date average flower price of $6.10/gram, putting Maine on pace for $244–248M in 2026 — a "plateau" year described by MaineBiz (April 20, 2026) as "the smallest year-over-year increase in the market so far."` },
  { question: "Has Maine's cannabis market kept growing, or is it plateauing?", answer: `Adult-use sales plateaued in 2025 (+1.0% YoY) after three consecutive years of double-digit growth: 2022 (+93.8%), 2023 (+36.5%), 2024 (+12.4%), 2025 (+1.0%). The plateau shows up across three OCP-reported metrics simultaneously: total dollars flat, total transactions up modestly (+4.7%), and average flower price declining (−8.6%, from $7.25 to $6.62 per gram). Together those metrics indicate the market is now a redistribution story — total consumer spend flat, but pricing is being competed away to consumers while operators absorb the margin compression. The market-pulse interpretation: Maine has moved from "growth at all costs" (2021–2023) through "rationalization" (2024) and into "maturation/consolidation" (2025–2026). Industry analysts at MJBizDaily and Cannabismarketcap describe the 2026 national picture similarly — hundreds of operators exiting, stronger MSOs absorbing market share — but Maine-specific dynamics (tourism, the caregiver program, and the Jan 1 2026 tax-restructuring) shape the local outcome.` },
  { question: "How much tax revenue does Maine collect from cannabis?", answer: `Maine collected approximately $43.72 million in Adult Use Cannabis Program (AUCP) registration-and-fee revenue during calendar year 2025 (per the OCP 2025 MMCP and AUCP annual reports via mainecannabis.org; revenue category = AUCP total revenue). On top of that, an estimated $14.28 million in sales tax revenue was deposited into the General Fund from medical cannabis in fiscal year 2025 (July 1, 2024 – June 30, 2025), reflecting the 5.5% state sales tax on cannabis sales (8% on edible cannabis products as prepared food). Cumulative AUCP revenue since adult-use sales began in 2020 totals roughly $163 million through FY2025. The January 1, 2026 biennial budget restructure (P.L. 2025, ch. 388) cut cultivation excise taxes by 30–43% but raised the retail sales tax on adult-use cannabis from 10.0% to 14.0% — a net ~$5.2M annual revenue uplift to the General Fund per the Dept. of Administrative and Financial Services fiscal note.` },
  { question: "What is the average price per gram of cannabis flower in Maine?", answer: `The OCP-reported average retail price of adult-use cannabis flower was $6.62 per gram in calendar year 2025, down from $7.25 in 2024 (an 8.6% decline). On a monthly basis, December 2025 alone averaged $6.30/gram — the lowest full-month price OCP has reported — with the first half of 2026 (Jan–Jun) running at a $6.10 year-to-date average. The lower bound is set by wholesale cultivator margins and the $223/lb flower excise tax effective Jan 1, 2026 (down from the prior $335/lb). Maine flower remains cheaper than the national average, which BDSA tracks at $8.92/gram in mid-2026; Maine is one of roughly ten states where the average gram retails under $7. Premium indoor-grown flower typically retails 30–50% above the average, putting top-shelf eighths at $30–$45 before tax.` },
  { question: "Where is Maine cannabis revenue concentrated geographically?", answer: `Maine's adult-use sales are highly concentrated in southern Maine. Per OCP Analytics Director Eric Miller's Oct 10, 2025 5th-anniversary briefing to the Joint Standing Committee on Veterans and Legal Affairs (reported by Maine Public, Portland Press Herald, and Sun Journal), York + Cumberland counties combined account for "nearly 60%" of all Maine adult-use cannabis retail sales. York County carries roughly 31% of state sales (~$76M in 2025) and Cumberland County roughly 28% (~$69M) — about 59% in just two of Maine's 16 counties. The remaining ~41% of state sales is distributed across the other 14 counties, with Penobscot (Bangor metro, ~9%), Androscoggin (Lewiston + Auburn, ~7%), and Kennebec (Augusta + Waterville, ~5%) rounding out the top five. This concentration reflects both population density and the licensed-retailer footprint — those two counties host 95 of the state's ${siteStats.activeAdultUseRetailStores} active retail stores — but it also captures cross-border demand from NH and MA residents who lack legal access and drive into Maine for adult-use purchases.` },
  { question: "How many municipalities in Maine have opted in to adult-use cannabis retail?", answer: `As of December 31, 2025, the OCP Adult Use Cannabis Program 2025 Annual Report counts ${siteStats.activeAdultUseMunicipalities} municipalities hosting active adult-use cannabis retail establishments. The live OCP licensee-search roster identifies active stores in ${liveOcp.auMunicipalities} municipalities as of ${liveOcp.asOf} — the gap reflects retail locations that have an active OCP license but have not yet reported their first sale, are inactive, or are reported under a mailing address that differs from their host municipality. Of Maine's 488 municipalities, roughly 65 (13.3%) have at least one active retail license, but only about 30 have active retail storefronts open to the public. The rest have authorized retail under local ordinance but not yet attracted a licensee. The MDG 2026 Opt-In Tracker publishes the full list of opted-in vs. opted-out towns; visitors should cross-check current status with the town clerk before relying on a specific number.` },
  { question: "Is Maine's cannabis market growing or shrinking in 2026?", answer: `Both, depending on the metric. By dollars: flat-to-slightly-up. By transactions: up modestly. By operators: down (consolidation). Through H1 2026, Maine posted $119,954,243 in adult-use retail sales across 2,439,812 transactions — an annualized run-rate of $244–248M, consistent with the 2025 plateau (MJBizDaily + Marijuana Herald, July 2026). Simultaneously, the number of active retail stores on the OCP roster has tightened from 187 (Dec 31, 2025 Annual Report peak) to ${liveOcp.auRetailStores} active licensee-search roster entries as of ${liveOcp.asOf} — the gap is normal license turnover (closures, conditional approvals still pending), not a crash. The 2026 outlook factors in: (1) the January 1, 2026 tax restructure raising the retail sales tax from 10% to 14% — which lifts consumer shelf prices ~3.6% unless operators absorb it; (2) the P.L. 2025, ch. 764 emergency testing-reform law effective April 19, 2026 that eliminates mandatory contaminant testing for edibles made from already-tested concentrate, reducing manufacturing friction; and (3) continuous downward price pressure on flower as the supply side reaches steady state. Net read: dollars flat, transactions slightly up, active operator count slightly down — classic maturation.` }
];

const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer.replace(/<[^>]+>/g, '') }
  }))
});
---

<Layout
  title="Maine Cannabis Market Stats 2026 — Annual & Multi-Year Data"
  description="Maine adult-use cannabis sales 2020–H1 2026, licensed establishment counts by type, county concentration, product mix, and tax revenue. Authoritative multi-year data table with primary sources."
  heroImage="/images/heroes/market-stats.jpg"
  article={{ author: "Eliot Nash", authorId: "eliot-nash", publishDate: "2026-01-05", modifiedDate: "2026-07-09", section: "Market Data" }}
  isHub={true}
>

<style>
  .stats-article { max-width: 920px; margin: 0 auto; }
  .stats-article h2 {
    font-family: var(--font-serif);
    color: var(--color-primary);
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }
  .stats-article h3 { margin-top: 1.5rem; margin-bottom: 0.75rem; }

  .last-updated {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    font-style: italic;
    margin-top: 0.5rem;
  }

  .answer-capsule {
    background: rgba(88, 129, 87, 0.08);
    border-left: 4px solid var(--color-primary);
    padding: 1rem 1.25rem;
    border-radius: 0 0.5rem 0.5rem 0;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .stat-source {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    font-style: italic;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }

  /* Headline stat grid */
  .headline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }
  .headline-card {
    background: var(--color-surface);
    padding: 1.25rem 1rem;
    border-radius: 0.875rem;
    border: 1px solid var(--color-border);
    text-align: center;
  }
  .headline-card .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  .headline-card .num {
    font-family: var(--font-serif);
    font-size: 1.875rem;
    color: var(--color-primary);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
  }
  .headline-card .sub {
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-top: 0.25rem;
  }

  /* Multi-year comparison table */
  .year-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .year-table caption {
    caption-side: top;
    text-align: left;
    font-size: 0.875rem;
    color: var(--color-text-light);
    padding: 0.75rem 1rem;
    background: rgba(88, 129, 87, 0.05);
    border-bottom: 1px solid var(--color-border);
    font-weight: 500;
  }
  .year-table th, .year-table td {
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }
  .year-table th {
    background: rgba(88, 129, 87, 0.04);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
  }
  .year-table tr:last-child td { border-bottom: none; }
  .year-table tr:hover { background: rgba(88, 129, 87, 0.03); }
  .year-table .num-col { text-align: right; font-variant-numeric: tabular-nums; }
  .year-table .highlight { background: rgba(88, 129, 87, 0.06); font-weight: 600; }

  /* Section-level callout */
  .section-block {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem 1.75rem;
    margin: 1.5rem 0;
  }
  .section-block h3 { margin-top: 0; }

  /* Cite box */
  .cite-box {
    background: var(--color-disclaimer-bg, #faf7f2);
    border: 1px solid var(--color-disclaimer-border, #d4cab8);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }
  .cite-box strong { color: var(--color-primary); }

  /* TOC */
  .toc {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .toc h2 {
    margin-top: 0;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
  }
  .toc ul {
    columns: 2;
    column-gap: 1.5rem;
    padding-left: 1.25rem;
    margin: 0;
  }
  .toc li { break-inside: avoid; }

  /* Methodology */
  .methodology {
    background: var(--color-disclaimer-bg, #faf7f2);
    border: 1px solid var(--color-disclaimer-border, #d4cab8);
    border-left: 4px solid var(--color-primary);
    padding: 1.5rem 1.75rem;
    border-radius: 0 0.5rem 0.5rem 0;
    margin: 2rem 0;
  }
  .methodology h3 { margin-top: 0; }
  .methodology p { font-size: 0.9375rem; line-height: 1.7; }

  /* FAQ */
  .faq-section details {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 0.5rem 0;
  }
  .faq-section summary {
    font-weight: 600;
    cursor: pointer;
    padding: 0.25rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-section summary::-webkit-details-marker { display: none; }
  .faq-section summary::after { content: "+"; font-size: 1.25rem; color: var(--color-primary); }
  .faq-section details[open] summary::after { content: "−"; }
  .faq-section p { margin: 0.75rem 0 0; font-size: 0.9375rem; line-height: 1.7; }

  /* Bar chart for visual context */
  .bar-chart { margin: 1rem 0; }
  .bar-row { display: grid; grid-template-columns: 130px 1fr 90px; align-items: center; gap: 0.75rem; margin: 0.35rem 0; font-size: 0.875rem; }
  .bar { background: var(--color-primary); height: 1.125rem; border-radius: 0.125rem; }
  .bar-row span:last-child { text-align: right; color: var(--color-text-light); }

  @media (max-width: 720px) {
    .headline-grid { grid-template-columns: repeat(2, 1fr); }
    .year-table { font-size: 0.8125rem; }
    .year-table th, .year-table td { padding: 0.5rem; }
    .toc ul { columns: 1; }
  }
</style>

<article class="stats-article">

  <div class="article-header">
    <h1>Maine Cannabis Market Stats</h1>
    <p class="subtitle">Multi-year data on sales, establishments, county concentration, products, and tax revenue — for journalists, operators, researchers, and municipal officials.</p>
    <p class="last-updated">Last updated: July 9, 2026 · Refreshed semi-annually against the OCP annual reports (28-B M.R.S. §113 + 22 M.R.S. §2430-N) and monthly against the OCP live licensee-search roster.</p>
  </div>

  <p class="answer-capsule">
    <strong>Maine's adult-use cannabis market generated $246.4 million in retail sales across 4,835,678 individual transactions in 2025 — a 1.0% YoY increase and the smallest year-over-year gain since the program launched in October 2020.</strong> Active licensed adult-use retail stores reached {siteStats.activeAdultUseRetailStores} statewide (OCP 2025 Annual Report, Dec 31, 2025), spread across {siteStats.activeAdultUseMunicipalities} municipalities. Average flower price stabilized at $6.62/gram (down 8.6% YoY from $7.25). York + Cumberland counties combined for ~59% of state sales, and Maine flower retails 28% below the $8.92 national average. The first half of 2026 (Jan–Jun) posted $119.95M across 2.44M transactions at a $6.10/gram year-to-date average — putting Maine on pace for $244–248M annualized, indicating the market has reached maturation.
  </p>

  <nav class="toc">
    <h2>On This Page</h2>
    <ul>
      <li><a href="#headline-numbers">Headline Numbers (2025)</a></li>
      <li><a href="#multi-year">Adult-Use Sales, 2020 – H1 2026</a></li>
      <li><a href="#establishments">Establishments by Type</a></li>
      <li><a href="#medical-program">Medical Program, 2021 – 2025</a></li>
      <li><a href="#regional">Regional &amp; County Breakdown</a></li>
      <li><a href="#tax-revenue">Tax Revenue Trajectory</a></li>
      <li><a href="#product-mix">Product Mix</a></li>
      <li><a href="#tax-reset">January 2026 Tax Reset</a></li>
      <li><a href="#trends">2026 Trends &amp; Outlook</a></li>
      <li><a href="#cite-this">Cite This Page</a></li>
      <li><a href="#methodology">Methodology &amp; Sources</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
  </nav>

  <section id="headline-numbers">
    <h2>Headline Numbers — Calendar Year 2025</h2>

    <div class="headline-grid">
      <div class="headline-card">
        <p class="label">Adult-Use Retail Sales</p>
        <p class="num">$246.4M</p>
        <p class="sub">+1.0% YoY (OCP, Jan 2026)</p>
      </div>
      <div class="headline-card">
        <p class="label">Retail Transactions</p>
        <p class="num">4.84M</p>
        <p class="sub">+4.7% YoY</p>
      </div>
      <div class="headline-card">
        <p class="label">Avg Flower Price</p>
        <p class="num">$6.62/g</p>
        <p class="sub">−8.6% YoY</p>
