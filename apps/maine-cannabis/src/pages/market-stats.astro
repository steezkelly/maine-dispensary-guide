  { metric: "Cannabis-supported FTE jobs (2025, Vangst)",  value: "425,002 (−3.4% YoY)", source: "Vangst 2025 Jobs Report (per Flowhub)" },
  { metric: "Cannabis-supported FTE jobs (2025, Leafly+Whitney)", value: "445,800 (+1.2% YoY)", source: "Leafly 2026 Jobs Report (cited via cannabispromotions.com)" },
  { metric: "Federal tax burden from 280E (2025 alone)",   value: "$2.24B excess", source: "Whitney Economics, April 9, 2026" },
  { metric: "Cumulative federal taxes paid since 2018",    value: "$27B",      source: "Whitney Economics, April 9, 2026" },
  { metric: "Cumulative excess 280E taxes since 2018",     value: "$15B",      source: "Whitney Economics, April 9, 2026" },
  { metric: "Projected industry FTE jobs by 2029",         value: "~800,000",  source: "Cannabiz Team projection (per Flowhub)" }
];

// Pricing — national context for Maine $6.62/g vs US retail benchmarks
