];

// Federal regulatory status — three-tier current as of 2026-07-09
const federalStatus = [
  { item: "FDA-approved marijuana products (e.g., Marinol, Epidiolex analogues)", status: "Schedule III (effective Apr 22, 2026)",  source: "DEA marijuana rescheduling page; 91 FR doc 2026-08176" },
  { item: "State-licensed medical cannabis (incl. Maine MMCP)", status: "Schedule III (effective Apr 22, 2026)",  source: "DEA; DOJ OPA media 1437441" },
  { item: "Adult-use (recreational) cannabis — all 24 legal states", status: "Schedule I (unchanged at federal level)",  source: "21 U.S.C. §812; 21 CFR §1308.11" },
  { item: "Hemp / CBD / delta-8 THC products", status: "Federally legal under 0.3% delta-9 THC — changing Nov 12, 2026 to total-THC standard + 0.4 mg/container cap", source: "2018 Farm Bill §10113; 2026 Appropriations §781" },
  { item: "Broader Schedule I → III rescheduling NPRM (covers all marijuana)", status: "PENDING — DEA ALJ hearing Jun 29 – Jul 15, 2026",  source: "DEA Hearing Facility; 91 FR 22777" }
];

// Criminal-justice context — federal marijuana arrest trend
const federalArrests = [
  { year: 2007, arrests: "870,000+", pctOfAllDrugArrests: "~48%", notes: "All-time peak (NORML/FBI UCR)" },
  { year: 2022, arrests: "227,108", pctOfAllDrugArrests: "~25%", notes: "17% of agencies failed to report (under-count)" },
  { year: 2023, arrests: "217,150", pctOfAllDrugArrests: "25%", notes: "84% possession-only (200,306 of 217,150); floor not ceiling" }
];

