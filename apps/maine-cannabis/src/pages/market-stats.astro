const stateContext = [
  { state: "Maine",        adultsUse: "Yes (Oct 2020)", taxRate: "14.0% retail + excise", estPrice: "$6.62/g (OCP 2025)", notes: "186K transactions per store per year" },
  { state: "Massachusetts", adultsUse: "Yes (Nov 2018)", taxRate: "10.75% retail + excise", estPrice: "n/a", notes: "Mature, plateaued; adult-use 2024 ~$1.5B" },
