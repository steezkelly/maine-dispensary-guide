  { metric: "U.S. cannabis market (2030 projected)",    value: "$55.4B",    source: "Statista, 2026 — 3.36% CAGR (cited via Flowhub)" },
  { metric: "U.S. cannabis market (2024 actual)",       value: "$30.1B",    source: "Whitney Economics + BDSA consensus 2024 actual" },
  { metric: "U.S. cannabis market (2025 BDSA actual)",  value: "$31.5B",    source: "BDSA 2025 — $23.9B adult-use + $7.6B medical (per Flowhub)" },
  { metric: "U.S. cannabis market (2025 Whitney revised forecast)", value: "$29.1–29.6B", source: "Whitney Economics Dec 2025 downward revision" },
  { metric: "Total U.S. economic contribution (2025)",  value: "$149B",     source: "Flowhub citing aggregated economic-impact studies" },
  { metric: "U.S. legal-cannabis states (adult-use)",   value: "24 states + DC + 3 territories", source: "NCSL (June 26, 2025); NORML cross-check" },
  { metric: "U.S. legal-cannabis states (medical, comprehensive)", value: "41 states + DC + 3 territories", source: "NCSL (June 26, 2025)" },
  { metric: "U.S. past-month cannabis users (age 12+, 2024)", value: "44.3M (15.4%)", source: "SAMHSA NSDUH 2024 (HHS Pub PEP25-07-007)" },
  { metric: "U.S. past-year cannabis users (age 12+, 2024)", value: "64.2M (22.3%)", source: "SAMHSA NSDUH 2024 (via Flowhub)" }
];

// Jobs + tax burden — national cannabis industry
