  { state: "Oregon (lowest tracked eighth avg)", pricePerGram: "n/a (8th = $11.55)", source: "Headset June 2026" },
  { state: "U.S. national avg (single-gram package, June 2026)", pricePerGram: "$8.94", source: "Headset June 2026 retail POS data" },
  { state: "U.S. national avg (all package sizes, June 2026)", pricePerGram: "$3.62 equivalized", source: "Headset June 2026 retail POS data" },
