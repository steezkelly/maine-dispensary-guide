---
/**
 * /cite/[...rest] — DOI-style permalinks for citable pages.
 *
 * Renders a focused citation landing for each registered citable page.
 * Both the bare `/cite/<slug>` form AND the short-hash form
 * `/cite/<slug>-<6-char-hash>` resolve to the same content (the
 * short-hash form is what citations.json documents as the canonical
 * permalink_format, so journalists can paste it anywhere and have it
 * work even if the page slug ever changes).
 *
 *   /cite/roi-calculator                       → Finch & Nash (2026), ROI benchmarks
 *   /cite/roi-calculator-22b398                → same page, full DOI-style hash form
 *   /cite/roi-calculator#startup-costs         → same page, specific section
 *   /cite/market-stats                         → Nash & Finch (2026), multi-year stats
 *   /cite/market-stats-46c93f                  → same page, full DOI-style hash form
 *
 * The rest-parameter route shape accepts both forms because Astro
 * matches `[...rest]` against any number of trailing segments.
 * `/cite/<single-segment>` → rest = `<single-segment>`
 * `/cite/<a>-<b>`            → rest = `<a>-<b>`
 *
 * The short-hash suffix is sha256(pageUrl + "|" + publish_date) truncated
 * to 6 chars (lowercase hex). If the suffix is present, we verify it;
 * a mismatched hash returns a 404 (we do NOT silently render — that
 * would let anyone invent `/cite/foo-deadbeef` and get our cite page
 * back, which breaks the integrity of the DOI-style permalink).
 *
 * Adding a new citable page = 1 entry in `src/data/citations.json`.
 * No code change.
 */

import Layout from '../../layouts/Layout.astro';
import citationsData from '../../data/citations.json';
import { createHash } from 'node:crypto';

interface SectionLink {
  label: string;
  anchor: string;
}

interface AuthorEntry {
  surname: string;
  initials: string;
  full: string;
}

interface CitationPage {
  slug: string;
  page_url: string;
  title: string;
  authors: AuthorEntry[];
  authors_apa: string;
  authors_plain: string;
  authors_bib: string;
  authors_label: string;
  publish_date: string;
  reviewed_by: string;
  section: string;
  short_citation: string;
  sections: SectionLink[];
}

const registry = citationsData as { pages: CitationPage[] };

/**
 * Parse a rest-segment into either:
 *   - `<slug>` (bare form)
 *   - `<slug>-<6-char-hash>` (DOI-style hash form)
 *
 * Returns null if the rest is empty. Hash verification happens in
 * getStaticPaths — that emits a route only when the hash matches the
 * canonical computation, so malformed URLs (e.g. `/cite/foo-deadbeef`
 * where the hash was invented) get a clean 404 instead of returning
 * our cite page. We keep splitRest as documentation of the wire format
 * but the build branch is parameterized inside getStaticPaths.
 */
// (intentionally unused — wire-format reference kept inline for clarity)

export function getStaticPaths() {
  // Re-import inside the function — Astro's getStaticPaths runs in a separate
  // module-evaluation context and cannot see top-level frontmatter bindings.
  // (See https://docs.astro.build/en/reference/routing-reference/#getstaticpaths)
  const data = citationsData as { pages: CitationPage[] };

  const routes: Array<{ params: { rest: string }; props: { page: typeof data.pages[0] } }> = [];

  for (const p of data.pages) {
    // 1) Bare form: /cite/<slug>
    routes.push({ params: { rest: p.slug }, props: { page: p } });

    // 2) Hash form: /cite/<slug>-<hash>. Compute hash from canonical inputs.
    const hashInput = `${p.page_url}|${p.publish_date}`;
    const shortHash = createHash('sha256').update(hashInput).digest('hex').slice(0, 6);
    routes.push({ params: { rest: `${p.slug}-${shortHash}` }, props: { page: p } });
  }

  return routes;
}

const { page } = Astro.props as { page: CitationPage };

// short-hash suffix — sha256(page_url + publish_date) truncated to 6.
// Astro runs on Node so crypto is available.
const hashInput = `${page.page_url}|${page.publish_date}`;
const sha = createHash('sha256').update(hashInput).digest('hex');
const shortHash = sha.slice(0, 6);

// Year + month-short + day for BibTeX
const [year, month, day] = page.publish_date.split('-');
const monthShort = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'][parseInt(month, 10) - 1];
const bibKey = `${page.authors[0].surname.toLowerCase()}${year}${page.slug.replace(/-/g, '')}`;
const citeUrl = `https://mainedispensaryguide.com/cite/${page.slug}-${shortHash}`;
const canonicalCiteUrl = `https://mainedispensaryguide.com/cite/${page.slug}`;

// JSON-LD: ScholarlyArticle for the citable page
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: page.title,
  url: citeUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': citeUrl,
  },
  isBasedOn: page.page_url,
  datePublished: page.publish_date,
  dateModified: page.publish_date,
  inLanguage: 'en',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  publisher: {
    '@type': 'Organization',
    name: 'Maine Dispensary Guide',
    url: 'https://mainedispensaryguide.com',
  },
  author: page.authors.map(a => ({
    '@type': 'Person',
    name: a.full,
    jobTitle: 'Author',
    affiliation: { '@type': 'Organization', name: 'Maine Dispensary Guide' },
  })),
};

// BibTeX block
const bibtex = `@misc{${bibKey},
  author  = {${page.authors_bib}},
  title   = {${page.title}},
  year    = {${year}},
  month   = ${monthShort},
  day     = ${parseInt(day, 10)},
  url     = {${page.page_url}},
  urldate = {[YYYY-MM-DD]},
  note    = {Maine Dispensary Guide. Reviewed ${page.publish_date} by ${page.reviewed_by}. Permanent DOI-style permalink: ${citeUrl}}
}`;
---

<Layout
  title={`Cite: ${page.title} | Maine Dispensary Guide`}
  description={`DOI-style permalink and full citation for "${page.title}" — Maine Dispensary Guide, ${page.publish_date}. CC BY 4.0.`}
  heroImage="/images/heroes/ocp-license-map.jpg"
  article={{
    author: page.authors[0].full,
    authorId: 'editorial-pool',
    publishDate: page.publish_date,
    modifiedDate: page.publish_date,
    section: page.section,
  }}
  isHub={false}
>
  <article class="cite-page">
    <header class="cite-header">
      <p class="eyebrow">Citation Permalink · DOI-style · CC BY 4.0</p>
      <h1>Cite: <span class="src-title">{page.title}</span></h1>
      <p class="cite-meta">
        <strong>Source page:</strong>
        <a href={page.page_url}>{page.page_url}</a><br />
        <strong>By:</strong> {page.authors_label} ·
        <strong>Published:</strong> {page.publish_date} ·
        <strong>Reviewed by:</strong> {page.reviewed_by}<br />
        <strong>Permanent DOI-style permalink:</strong>
        <code class="doi">{citeUrl}</code>
      </p>
    </header>

    <section class="cite-formats">
      <h2>Copy a citation</h2>

      <h3>APA / Chicago (long form)</h3>
      <div class="cite-box">
        <p style="margin:0;">
          {page.authors_apa} ({year}, {page.publish_date}). <em>{page.title}.</em>
          Maine Dispensary Guide. <a href={page.page_url}>{page.page_url}</a>
        </p>
        <!-- analytics:cta-injected id=cta-inline-cite--[...rest]-01 -->
<button class="copy-btn" data-copy={`${page.authors_apa} (${year}, ${page.publish_date}). ${page.title}. Maine Dispensary Guide. ${page.page_url}`} data-cta-id="cta-inline-cite--[...rest]-01">Copy</button>
      </div>

      <h3>Short-form (for journalists)</h3>
      <div class="cite-box cite-box-quote">
        <p style="margin:0;">&ldquo;{page.short_citation}&rdquo;</p>
        <!-- analytics:cta-injected id=cta-inline-cite--[...rest]-02 -->
<button class="copy-btn" data-copy={page.short_citation} data-cta-id="cta-inline-cite--[...rest]-02">Copy</button>
      </div>

      <h3>Plain-text</h3>
      <div class="cite-box">
        <p style="margin:0;">
          {page.authors_plain}. {page.title}. Maine Dispensary Guide. Published {page.publish_date}.
          Accessed [date]. {page.page_url}
        </p>
        <!-- analytics:cta-injected id=cta-inline-cite--[...rest]-03 -->
<button class="copy-btn" data-copy={`${page.authors_plain}. ${page.title}. Maine Dispensary Guide. Published ${page.publish_date}. Accessed [date]. ${page.page_url}`} data-cta-id="cta-inline-cite--[...rest]-03">Copy</button>
      </div>

      <h3>BibTeX</h3>
      <div class="cite-box">
        <pre style="margin:0; white-space: pre-wrap;"><code>{bibtex}</code></pre>
        <!-- analytics:cta-injected id=cta-inline-cite--[...rest]-04 -->
<button class="copy-btn" data-copy={bibtex} data-cta-id="cta-inline-cite--[...rest]-04">Copy</button>
      </div>
    </section>

    {page.sections.length > 0 && (
      <section class="cite-sections">
        <h2>Cite a specific section</h2>
        <p>
          Each section on the source page has a stable anchor. Cite a section
          specifically when the data point comes from a single table —
          append <code>#{`{anchor}`}</code> to the source-page URL.
          For DOI-style permalinks per section, prefix with <code>/cite/{page.slug}-section-</code>
          (the section-anchor variant of this permalink system ships when the
          editor pair approves the schema; the bare <code>/cite/{page.slug}</code>
          form is canonical for now).
        </p>
        <ul class="section-list">
          {page.sections.map(s => (
            <li>
              <strong>{s.label}</strong> —
              <a href={`${page.page_url}#${s.anchor}`}>{page.page_url}#{s.anchor}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="cite-permalink-info">
      <h2>About this permalink</h2>
      <p>
        This page is the canonical citation landing for
        <a href={page.page_url}>{page.page_url}</a>. The URL
        <code>{citeUrl}</code> is a DOI-style permalink — short, stable,
        and content-addressable. The shorter form
        <code>{canonicalCiteUrl}</code> resolves to the same content.
      </p>
      <p>
        <strong>Hash derivation:</strong> first 6 hex characters of
        <code>sha256(page_url + &quot;|&quot; + publish_date)</code>. The hash
        changes whenever the source page URL or its publication date changes,
        so old URLs stay stable when only the body text is updated.
      </p>
      <p>
        <strong>License:</strong> All data and prose on the source page are
        released under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
        Attribution to the named author(s) and a link back to
        <a href={page.page_url}>{page.page_url}</a> is the only requirement.
      </p>
      <p>
        <strong>Reviewed:</strong> {page.publish_date} by {page.reviewed_by}.
        Editor-pair review on file; methodology and reviewer bios at
        <a href="/about/corrections">/about/corrections</a> and
        <a href="/about/authors">/about/authors</a>.
      </p>
    </section>
  </article>

  <style>
    .cite-page { max-width: 820px; margin: 0 auto; }
    .cite-header { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
    .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-light); margin-bottom: 0.5rem; }
    .src-title { font-style: italic; }
    .cite-meta { font-size: 0.9375rem; line-height: 1.7; color: var(--color-text-light); }
    .cite-meta .doi { background: color-mix(in oklab, var(--color-soft-green) 8%, transparent); padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; }

    .cite-box {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      padding: 1rem 1.25rem;
      margin: 1rem 0;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.875rem;
      position: relative;
    }
    .cite-box-quote { background: var(--color-disclaimer-bg, #faf7f2); border-color: var(--color-disclaimer-border, #d4cab8); font-family: Georgia, 'Times New Roman', serif; font-size: 0.9375rem; }

    .copy-btn {
      position: absolute; top: 0.5rem; right: 0.5rem;
      background: #143027; color: white;
      border: 0; border-radius: 0.375rem;
      padding: 0.25rem 0.625rem; font-size: 0.75rem;
      cursor: pointer; font-weight: 600;
      transition: background 120ms;
    }
    .copy-btn:hover { background: var(--color-primary-dark, #2d5f3f); }
    .copy-btn.copied { background: #2d5f3f; }

    h2 { font-family: var(--font-serif); color: var(--color-text); margin-top: 2rem; }
    h3 { margin-top: 1.25rem; margin-bottom: 0.5rem; }
    .section-list { list-style: none; padding: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.875rem; line-height: 1.8; }
    .section-list li { padding: 0.25rem 0; }
    .cite-permalink-info p { line-height: 1.7; }
    code { background: color-mix(in oklab, var(--color-soft-green) 8%, transparent); padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875rem; }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.copy-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(text);
            const orig = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 1400);
          } catch (e) {
            // Fallback for older browsers / iframe contexts: select + execCommand
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (_) {}
            document.body.removeChild(ta);
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = 'Copy'; }, 1400);
          }
        });
      });
    });
  </script>
</Layout>