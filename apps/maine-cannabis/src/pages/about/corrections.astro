const today = "2026-07-16";
const latestCorrectionDate = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(`${corrections[0].date}T00:00:00Z`));
---

<Layout
  title="Editorial Corrections Log — Maine Dispensary Guide"
  description="Public corrections log for Maine Dispensary Guide. Every material correction to a guide, blog post, or compliance citation is documented here with date, what was wrong, what is correct, and the source that confirms the fix."
  breadcrumbs={breadcrumbs}
>
<style>
  .corrections-hero {
    background: linear-gradient(135deg, rgba(13, 78, 80, 0.06) 0%, rgba(88, 129, 87, 0.1) 100%);
    padding: 3rem 0;
    margin-bottom: 3rem;
    border-radius: 1rem;
  }
  .corrections-hero h1 {
    font-family: var(--font-serif);
    margin-bottom: 1rem;
  }
  .corrections-hero .lead {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 750px;
    line-height: 1.7;
  }
  .correction-summary {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }
  .summary-item {
    flex: 1 0 auto;
    min-width: 140px;
  }
  .summary-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    font-family: var(--font-serif);
    line-height: 1.2;
  }
  .summary-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    font-weight: 600;
    margin-top: 0.25rem;
  }
  .corrections-section {
    margin-bottom: 3rem;
  }
  .corrections-section h2 {
    font-family: var(--font-serif);
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .correction-entry {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .correction-meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.8125rem;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .correction-date {
    font-weight: 700;
  }
  .correction-title {
    margin: 0 0 1rem 0;
    font-size: 1.125rem;
    color: var(--color-text);
    font-family: var(--font-serif);
  }
  .correction-section-label {
    font-weight: 600;
    color: var(--color-accent);
    margin: 0.5rem 0 0.25rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .correction-section-label.error-label { color: #c0392b; }
  .correction-section-label.right-label { color: #2c8a3f; }
  .correction-section-label.source-label { color: var(--color-text); }
  .correction-text {
    line-height: 1.65;
    color: var(--color-text);
    margin: 0 0 1rem 0;
  }
  .correction-related {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .correction-related ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .correction-related li {
    margin: 0 0 0.375rem;
  }
  .correction-related a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .correction-related a:hover {
    text-decoration: underline;
  }
  .methodology {
    background: var(--color-surface);
    border-radius: 1rem;
    padding: 2rem;
    margin: 3rem 0;
    border: 1px solid var(--color-border);
  }
  .methodology h2 {
    font-family: var(--font-serif);
    margin-top: 0;
  }
  .methodology p, .methodology li {
    line-height: 1.7;
    color: var(--color-text);
  }
  .methodology ul {
    padding-left: 1.25rem;
  }
</style>

<article>
  <section class="corrections-hero">
    <h1>Editorial Corrections Log</h1>
    <p class="lead">Every material correction to a Maine Dispensary Guide guide, blog post, or compliance citation is documented here, reverse-chronologically, with the date, what was wrong, what is correct, and the primary source that confirms the fix. We publish this log publicly because transparent self-correction is the strongest signal of editorial trustworthiness an E-E-A-T site can offer.</p>
    <div class="correction-summary">
      <div class="summary-item">
        <div class="summary-value">{corrections.length}</div>
        <div class="summary-label">Corrections in last 30 days</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">100%</div>
        <div class="summary-label">Citation-backed</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">YMYL</div>
        <div class="summary-label">All entries are operator-facing content</div>
      </div>
    </div>
  </section>

  <Callout title="How to use this page" type="info">
    If you used one of our guides before {latestCorrectionDate} and want to know whether anything you read has since been corrected, search the descriptions below for keywords from the article you read (operator name, address, statute citation, dollar figure). When in doubt about operator data — addresses, hours, license types — verify directly with the operator before making business decisions.
  </Callout>

  <section class="corrections-section">
    <h2>Recent corrections (most recent first)</h2>
