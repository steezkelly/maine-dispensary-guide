---
import Layout from '../../layouts/Layout.astro';
import Callout from '../../components/Callout.astro';
import { CORRECTIONS as corrections, type Correction } from '../../data/corrections-log';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Corrections', href: '/about/corrections' }
];

const article = {
  publishDate: "2026-07-04",
  modifiedDate: "2026-07-26",
  section: "Editorial Standards"
};

// ---------------------------------------------------------------------------
// Derived summary stats for the hero strip.
// ---------------------------------------------------------------------------
const today = "2026-07-26";
const totalCorrections = corrections.length;
const counts = corrections.reduce(
  (acc, c) => {
    acc.severity[c.severity]++;
    acc.category[c.category]++;
    return acc;
  },
  { severity: { critical: 0, material: 0, minor: 0 }, category: { regulation: 0, compliance: 0, 'city-guide': 0, 'operator-data': 0, 'cross-reference': 0 } }
);

// Auto-derive reader cutoff from newest entry (test invariant preserved).
const latestCorrectionDate = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(`${corrections[0].date}T00:00:00Z`));

// ---------------------------------------------------------------------------
// Severity + category display metadata.
// ---------------------------------------------------------------------------
const severityMeta: Record<Correction['severity'], { label: string; tone: string; description: string }> = {
  critical: {
    label: 'Critical',
    tone: 'severity-critical',
    description: 'A material fact was wrong in a way that could mislead a reader acting on the page. YMYL impact.'
  },
  material: {
    label: 'Material',
    tone: 'severity-material',
    description: 'A fact was wrong but unlikely to drive an irreversible reader decision.'
  },
  minor: {
    label: 'Minor',
    tone: 'severity-minor',
    description: 'A navigational, formatting, or cross-reference issue. No fact in the body text was wrong.'
  }
};

const categoryMeta: Record<Correction['category'], { label: string; tone: string }> = {
  regulation: { label: 'Regulation / Statute', tone: 'cat-regulation' },
  compliance: { label: 'Compliance Guide', tone: 'cat-compliance' },
  'city-guide': { label: 'City Guide', tone: 'cat-city' },
  'operator-data': { label: 'Operator Data', tone: 'cat-operator' },
  'cross-reference': { label: 'Cross-reference', tone: 'cat-xref' }
};

// JSON-LD: one ItemList of CorrectionComment nodes, one per entry. Injected
// via the Layout head slot. This is a semantic-graph signal for crawlers and
// LLMs (schema.org/correction — no Google rich result, but improves entity
// linking for the corrected article URLs).
const correctionListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Maine Dispensary Guide — Editorial Corrections Log",
  "url": "https://mainedispensaryguide.com/about/corrections",
  "dateModified": today,
  "numberOfItems": corrections.length,
  "itemListElement": corrections.map((c, idx) => ({
    "@type": "CorrectionComment",
    "position": idx + 1,
    "datePublished": c.date,
    "url": `https://mainedispensaryguide.com/about/corrections#${c.slug}`,
    "text": `${c.title} — What was wrong: ${c.what_was_wrong} What is correct: ${c.what_is_correct}`,
    "about": c.published_in.map((p) => ({
      "@type": "WebPage",
      "name": p.name,
      "url": `https://mainedispensaryguide.com${p.href}`
    }))
  }))
};
---

<Layout
  title="Editorial Corrections Log — Maine Dispensary Guide"
  description="Public corrections log for Maine Dispensary Guide. Every material correction to a guide, blog post, or compliance citation is documented here with date, severity, category, what was wrong, what is correct, and the primary sources that confirm the fix."
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(correctionListJsonLd)} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Editorial Corrections Log (RSS)"
      href="/about/corrections/feed.xml"
    />
  </Fragment>

<style>
  .corrections-hero {
    background: linear-gradient(135deg, color-mix(in oklab, var(--color-primary) 6%, transparent) 0%, color-mix(in oklab, var(--color-soft-green) 10%, transparent) 100%);
    padding: 3rem 0;
    margin-bottom: 3rem;
    border-radius: 1rem;
  }
  .corrections-hero h1 {
    font-family: var(--font-serif);
    margin-bottom: 1rem;
  }
  .corrections-hero .lead {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 750px;
    line-height: 1.7;
  }
  .correction-summary {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }
  .summary-item {
    flex: 1 0 auto;
    min-width: 140px;
  }
  .summary-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    font-family: var(--font-serif);
    line-height: 1.2;
  }
  .summary-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    font-weight: 600;
    margin-top: 0.25rem;
  }
  .corrections-section {
    margin-bottom: 3rem;
  }
  .corrections-section h2 {
    font-family: var(--font-serif);
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  /* ---- Severity + category chips --------------------------------------- */
  .correction-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .correction-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    line-height: 1.2;
  }
  .correction-tag::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.85;
  }
  .severity-critical {
    background: #fdecec;
    color: #9c1b1b;
    border-color: #f3b8b8;
  }
  .severity-material {
    background: #fff4e0;
    color: #8a4b00;
    border-color: #f3d49a;
  }
  .severity-minor {
    background: #ecf3fd;
    color: #1c4f8a;
    border-color: #b9d1f3;
  }
  .cat-regulation,
  .cat-compliance,
  .cat-city,
  .cat-operator,
  .cat-xref {
    background: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border);
  }
  /* Dark-mode overrides — chips must stay readable on dark surface */
  :global([data-theme="dark"]) .severity-critical {
    background: #3d1414;
    color: #f5b8b8;
    border-color: #6b2424;
  }
  :global([data-theme="dark"]) .severity-material {
    background: #3d2810;
    color: #f3cf90;
    border-color: #6b4a1c;
  }
  :global([data-theme="dark"]) .severity-minor {
    background: #14253d;
    color: #b9d1f3;
    border-color: #24406b;
  }

  /* ---- Entry card ------------------------------------------------------ */
  .correction-entry {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
    scroll-margin-top: 6rem; /* anchor jumps land below sticky header */
  }
  .correction-meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.8125rem;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }
  .correction-date {
    font-weight: 700;
  }
  .correction-title {
    margin: 0 0 1rem 0;
    font-size: 1.125rem;
    color: var(--color-text);
    font-family: var(--font-serif);
  }
  .correction-section-label {
    font-weight: 600;
    color: var(--color-accent);
    margin: 0.5rem 0 0.25rem;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .correction-section-label.error-label { color: #c0392b; }
  .correction-section-label.right-label { color: #2c8a3f; }
  .correction-section-label.source-label { color: var(--color-text); }
  .correction-text {
    line-height: 1.65;
    color: var(--color-text);
    margin: 0 0 1rem 0;
  }

  /* ---- Footnotes ------------------------------------------------------- */
  /* The list of sources is rendered as an ordered list. Numbering is
     controlled by `start` (set per-entry) and accessibility is provided
     by aria-describedby + a visually-hidden label + role="note". The
     numbered inline references throughout each entry point to these
     anchors; back-links let keyboard and screen-reader users return. */
  .correction-footnotes-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .correction-footnotes {
    margin: 0.5rem 0 1rem 0;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--color-surface) 80%, var(--color-bg) 20%);
    border: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .correction-footnotes ol {
    padding-left: 1.5rem;
    margin: 0;
  }
  .correction-footnotes li {
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  .correction-footnotes li:last-child {
    margin-bottom: 0;
  }
  .correction-footnotes .fn-note {
    display: block;
    color: var(--color-text-light);
    font-size: 0.8125rem;
    margin-top: 0.15rem;
  }
  .correction-footnotes a {
    color: var(--color-accent);
    word-break: break-word;
  }
  .fn-backref {
    display: inline-block;
    margin-left: 0.25rem;
    text-decoration: none;
    color: var(--color-text-light);
  }
  .fn-backref:hover,
  .fn-backref:focus {
    color: var(--color-accent);
    text-decoration: underline;
  }
  /* Visually-hidden superscript reference label for screen readers */
  .fn-ref-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .fn-ref {
    text-decoration: none;
    font-size: 0.75em;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0.1em;
    vertical-align: super;
    line-height: 0;
  }
  .fn-ref:hover,
  .fn-ref:focus {
    text-decoration: underline;
  }
  .correction-text .fn-ref + .fn-ref {
    margin-left: 0;
  }

  .correction-related {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .correction-related ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  .correction-related li {
    margin: 0 0 0.375rem;
  }
  .correction-related a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }
  .correction-related a:hover {
    text-decoration: underline;
  }

  .methodology {
    background: var(--color-surface);
    border-radius: 1rem;
    padding: 2rem;
    margin: 3rem 0;
    border: 1px solid var(--color-border);
  }
  .methodology h2 {
    font-family: var(--font-serif);
    margin-top: 0;
  }
  .methodology p, .methodology li {
    line-height: 1.7;
    color: var(--color-text);
  }
  .methodology ul {
    padding-left: 1.25rem;
  }

  /* Severity rubric — collapsed by default. The <summary> is the visible
     label; the table + paragraphs render only when the reader opts in. */
  .methodology-details {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: color-mix(in oklab, var(--color-surface) 92%, var(--color-bg) 8%);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }
  .methodology-details > summary {
    cursor: pointer;
    list-style: none;
    color: var(--color-accent);
    font-size: 0.9375rem;
  }
  .methodology-details > summary::-webkit-details-marker {
    display: none;
  }
  .methodology-details > summary::before {
    content: '+';
    display: inline-block;
    width: 1.25rem;
    margin-right: 0.5rem;
    color: var(--color-text-light);
    font-weight: 700;
  }
  .methodology-details[open] > summary::before {
    content: '−';
  }
  .methodology-details > summary:hover {
    text-decoration: underline;
  }
  .methodology-details > summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .methodology-details[open] > summary {
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .rubric-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 0.5rem 0 1rem 0;
  }
  .rubric-table th,
  .rubric-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    line-height: 1.5;
  }
  .rubric-table th[scope="col"] {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    font-weight: 600;
    background: color-mix(in oklab, var(--color-surface) 70%, var(--color-bg) 30%);
  }
  .rubric-table th[scope="row"] {
    white-space: nowrap;
    font-weight: 600;
    width: 9rem;
  }
  .rubric-table td a {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Filter toolbar — clickable buttons that filter the entries list via
     inline <script> below. Each chip's count comes from the same
     counts.* data, and the chip's pressed state is toggled by the
     script. */
  .correction-filters {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1rem 0 1.5rem 0;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
  }
  .correction-filters strong {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
    margin-right: 0.25rem;
    align-self: center;
  }
  .filter-group {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .filter-group-label {
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-right: 0.15rem;
  }
  /* Filter chips are real <button>s. Visual rest state matches the v1
     chip so it doesn't feel like a regression for keyboard-less readers;
     pressed state adds the accent fill; both states are keyboard-focusable. */
  .filter-chip {
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-light);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    line-height: 1.2;
    transition: background-color 120ms, color 120ms, border-color 120ms;
  }
  .filter-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
  .filter-chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .filter-chip[aria-pressed="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }
  .filter-chip[aria-pressed="true"]:hover {
    /* stay pressed on hover — otherwise the hover rule undoes the selection */
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .filter-chip .chip-count {
    font-size: 0.6875rem;
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  /* Empty-state row that the inline script reveals when no entries match
     the active filter combination. */
  .corrections-empty {
    padding: 2rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: 0.75rem;
    color: var(--color-text-light);
    font-size: 0.9375rem;
  }
  .corrections-empty[hidden] { display: none; }
</style>

<article>
  <section class="corrections-hero">
    <h1>Editorial Corrections Log</h1>
    <p class="lead">Every material correction to a Maine Dispensary Guide guide, blog post, or compliance citation is documented here, reverse-chronologically, with the date, what was wrong, what is correct, and the primary sources that confirm the fix. We publish this log publicly because transparent self-correction is the strongest signal of editorial trustworthiness an E-E-A-T site can offer.</p>
    <div class="correction-summary" aria-label="Summary of corrections published">
      <div class="summary-item">
        <div class="summary-value">{totalCorrections}</div>
        <div class="summary-label">Corrections in last 30 days</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">{counts.severity.critical}</div>
        <div class="summary-label">Critical severity</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">{counts.severity.material}</div>
        <div class="summary-label">Material severity</div>
      </div>
      <div class="summary-item">
        <div class="summary-value">100%</div>
        <div class="summary-label">Primary-source backed</div>
      </div>
    </div>
    <div
      class="correction-filters"
      role="group"
      aria-label="Filter corrections by severity or topic"
      data-corrections-filter-root
    >
      <strong>Severity:</strong>
      <div class="filter-group" data-filter-group="severity">
        <button
          type="button"
          class="filter-chip"
          data-filter-severity=""
          aria-pressed="true"
        >All<span class="chip-count">{totalCorrections}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-severity="critical"
          aria-pressed="false"
        >Critical<span class="chip-count">{counts.severity.critical}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-severity="material"
          aria-pressed="false"
        >Material<span class="chip-count">{counts.severity.material}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-severity="minor"
          aria-pressed="false"
        >Minor<span class="chip-count">{counts.severity.minor}</span></button>
      </div>
      <strong>Topic:</strong>
      <div class="filter-group" data-filter-group="category">
        <button
          type="button"
          class="filter-chip"
          data-filter-category=""
          aria-pressed="true"
        >All<span class="chip-count">{totalCorrections}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-category="regulation"
          aria-pressed="false"
        >Regulation<span class="chip-count">{counts.category.regulation}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-category="compliance"
          aria-pressed="false"
        >Compliance<span class="chip-count">{counts.category.compliance}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-category="city-guide"
          aria-pressed="false"
        >City Guide<span class="chip-count">{counts.category['city-guide']}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-category="operator-data"
          aria-pressed="false"
        >Operator Data<span class="chip-count">{counts.category['operator-data']}</span></button>
        <button
          type="button"
          class="filter-chip"
          data-filter-category="cross-reference"
          aria-pressed="false"
        >Cross-reference<span class="chip-count">{counts.category['cross-reference']}</span></button>
      </div>
    </div>
    <p
      class="corrections-empty"
      role="status"
      aria-live="polite"
      data-corrections-empty
      hidden
    >No corrections match this combination. <button type="button" class="filter-chip" data-corrections-reset>Clear filters</button></p>
  </section>

  <Callout title="How to use this page" type="info">
    If you used one of our guides before {latestCorrectionDate} and want to know whether anything you read has since been corrected, search the descriptions below for keywords from the article you read (operator name, address, statute citation, dollar figure). When in doubt about operator data — addresses, hours, license types — verify directly with the operator before making business decisions.
  </Callout>

  <section class="corrections-section" aria-labelledby="recent-corrections-heading">
    <h2 id="recent-corrections-heading">Recent corrections (most recent first)</h2>
    {corrections.map((c) => {
      const sev = severityMeta[c.severity];
      const cat = categoryMeta[c.category];
      return (
        <article
          class="correction-entry"
          id={c.slug}
          data-severity={c.severity}
          data-category={c.category}
        >
          <div class="correction-tags">
            <span class={`correction-tag ${sev.tone}`} title={sev.description}>{sev.label}</span>
            <span class={`correction-tag ${cat.tone}`}>{cat.label}</span>
          </div>
          <div class="correction-meta">
            <span class="correction-date">{c.date}</span>
            <span aria-hidden="true">·</span>
            <span>slug: <code>{c.slug}</code></span>
          </div>
          <h3 class="correction-title">{c.title}</h3>

          <p class="correction-section-label error-label">What was wrong</p>
          <p class="correction-text">{c.what_was_wrong}</p>

          <p class="correction-section-label right-label">What is correct</p>
          <p class="correction-text">{c.what_is_correct}</p>

          <p class="correction-section-label source-label" id={`sources-${c.slug}`}>Primary sources</p>
          <ol
            class="correction-footnotes"
            role="note"
            aria-labelledby={`sources-${c.slug}`}
            start={1}
          >
            {c.verified_via.map((src, i) => {
              const n = i + 1;
              const id = `${c.slug}-fn-${n}`;
              return (
                <li id={id} value={n}>
                  <a href={src.url} rel="noopener noreferrer">{src.label}</a>
                  {src.note && <span class="fn-note">{src.note}</span>}
                  {' '}
                  <a
                    class="fn-backref"
                    href={`#${c.slug}-ref-${n}`}
                    aria-label={`Back to reference ${n} in entry ${c.slug}`}
                  >↩</a>
                </li>
              );
            })}
          </ol>

          {/* Plain-prose fallback for operators/regulators scanning for keywords */}
          <p class="correction-text" style="font-size: 0.875rem; color: var(--color-text-light); margin-top: 0.5rem;">
            Verified via: {c.verified_via.map((src, i) => (
              <span>
                {i > 0 && '; '}
                <a href={src.url} rel="noopener noreferrer">{src.label}</a>
              </span>
            ))}
          </p>

          {c.published_in && c.published_in.length > 0 && (
            <div class="correction-related">
              <strong>Updated article{c.published_in.length > 1 ? 's' : ''}:</strong>
              <ul>
                {c.published_in.map((p) => (
                  <li>→ <a href={p.href}>{p.name}</a></li>
                ))}
              </ul>
            </div>
          )}
        </article>
      );
    })}

    </section>

  <section class="methodology">
    <h2>How we handle corrections</h2>
    <p>Editorial corrections are a leading indicator of editorial integrity. Here is how our process works:</p>
    <ul>
      <li><strong>Detection.</strong> Corrections come from primary-source research, internal re-audits, operator feedback, and reader reports. AI-assisted spotting is used as a starting point but every entry on this page is reviewed by a human editor before publication.</li>
      <li><strong>Severity.</strong> Every claim touching YMYL (regulatory, financial, operator data) is checked against statute, the operator's own current site, the relevant municipal office, and primary news sources. Material errors are corrected, not papered over. <strong>Critical</strong> = a YMYL-impacting factual error (statute cap, vote outcome, fabricated citation). <strong>Material</strong> = wrong but non-irreversible (drift in operator data, missing primary-source hyperlink, regulator-vs-regulator conflation). <strong>Minor</strong> = navigational or formatting drift; no body-text fact was wrong.</li>
      <li><strong>Action.</strong> Each correction updates the affected guide with a primary-source citation, modifies the article date, and pushes an entry into this log on the same commit.</li>
      <li><strong>Re-review.</strong> After a correction, we add a quarterly reviewer spot-check on the topic to catch any reintroduced error.</li>
      <li><strong>No fabrication.</strong> When a house number is unknown or a statute citation is unverified, we say so explicitly in the article — we do not invent a plausible-looking value.</li>
      <li><strong>Reader reports.</strong> Spot an error? Email <a href="mailto:corrections@mainedispensaryguide.com">corrections@mainedispensaryguide.com</a>. Confirmed reports are corrected within five business days; nothing about the reporter is published without consent.</li>
    </ul>

    <details class="methodology-details">
      <summary><strong>How we classify correction severity — full rubric</strong></summary>
      <p>The severity tag on each entry is assigned by the editor who files the correction, with peer review by a second editor for Critical entries. The decision is binary: <em>could a reader act on the wrong number?</em> If yes, escalate to Critical. If the wrong value is visible only in a footnote or a link target, it stays Minor.</p>

      <table class="rubric-table" aria-label="Severity rubric">
        <thead>
          <tr>
            <th scope="col">Severity</th>
            <th scope="col">Reader-impact test</th>
            <th scope="col">Worked example from this log</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><span class="correction-tag severity-critical">Critical</span></th>
            <td>A reader could make an irreversible decision on the wrong number (legal limit, statute attribution, vote outcome, fabricated citation). YMYL impact.</td>
            <td>
              <a href="#maine-edible-dose-cap">Dose cap 5/100 → 10/200</a> (wrong legal limit a consumer would rely on),
              <a href="#wells-dispensary-guide">Wells opt-in status</a> (wrong vote outcome),
              <a href="#maine-cannabis-gray-market-ocp-enforcement-2026">fabricated LD 1995 citation</a> (cited a bill that did not exist).
            </td>
          </tr>
          <tr>
            <th scope="row"><span class="correction-tag severity-material">Material</span></th>
            <td>The wrong value is visible to the reader but unlikely to drive an irreversible decision on its own (operator address drift, wrong statute session year, missing primary-source hyperlink on a factually correct claim).</td>
            <td>
              <a href="#houlton-dispensary-guide">Houlton operator addresses</a> (wrong street, wrong phone),
              <a href="#maine-metrc-compliance-guide">Metrc LD 1847 session year</a> (131st vs. '2026'),
              <a href="#maine-cannabis-business-insurance">insurance vs surety bond conflation</a>.
            </td>
          </tr>
          <tr>
            <th scope="row"><span class="correction-tag severity-minor">Minor</span></th>
            <td>A navigational, formatting, or cross-reference drift. No body-text fact was wrong; readers who followed links got there eventually.</td>
            <td>
              <a href="#bridgton denmark limerick dispensary guides">Bridgton/Denmark/Limerick missing citations</a> (claims correct, links absent),
              <a href="#milo-dispensary-guide dexter-dispensary-guide">Milo/Dexter stale cross-reference</a> (linked to a retracted claim in another guide).
            </td>
          </tr>
        </tbody>
      </table>

      <p>When two severity definitions could plausibly apply, the more severe wins. The error log is not the place to be generous to ourselves.</p>
    </details>

    <p style="margin-top: 1rem; font-size: 0.9375rem; color: var(--color-text-light);">Last updated: {today}. This page is the canonical source for corrections published on mainedispensaryguide.com. <a href="/about/corrections/feed.xml" rel="alternate" type="application/rss+xml">Subscribe via RSS</a>.</p>
  </section>
</article>

<script>
  // Corrections-log filter: two-axis (severity x category) interactive
  // filter. No framework, no build. State is two strings — current
  // severity + current category — kept on the root element as
  // data-active-* so URLs can be deep-linked and the DOM stays the
  // source of truth. Entries are hidden via the standard `hidden`
  // attribute so they remain in the DOM (and screen-reader-accessible
  // when re-shown) without layout flicker.

  type FilterState = { severity: string; category: string };

  function readState(root: HTMLElement): FilterState {
    return {
      severity: root.dataset.activeSeverity ?? '',
      category: root.dataset.activeCategory ?? '',
    };
  }

  function applyFilter(root: HTMLElement): void {
    const state = readState(root);
    const entries = root.querySelectorAll<HTMLElement>('.correction-entry');
    let visible = 0;
    entries.forEach((entry) => {
      const matchSeverity = !state.severity || entry.dataset.severity === state.severity;
      const matchCategory = !state.category || entry.dataset.category === state.category;
      const show = matchSeverity && matchCategory;
      entry.hidden = !show;
      if (show) visible++;
    });

    const empty = document.querySelector<HTMLElement>('[data-corrections-empty]');
    if (empty) empty.hidden = visible !== 0;

    // Reflect pressed state on every chip so keyboard focus + visual
    // state are in sync.
    root.querySelectorAll<HTMLButtonElement>('[data-filter-severity]').forEach((btn) => {
      const v = btn.dataset.filterSeverity ?? '';
      btn.setAttribute('aria-pressed', String(v === state.severity));
    });
    root.querySelectorAll<HTMLButtonElement>('[data-filter-category]').forEach((btn) => {
      const v = btn.dataset.filterCategory ?? '';
      btn.setAttribute('aria-pressed', String(v === state.category));
    });

    // Announce the resulting view count for screen-reader users. The
    // empty-state <p> already has aria-live=polite and is toggled via
    // the [hidden] attribute above, so when no entries match the
    // announcement is automatic.
    if (visible > 0) {
      const activeSeverity = state.severity ? `severity=${state.severity}` : 'all severities';
      const activeCategory = state.category ? `topic=${state.category}` : 'all topics';
      // Set a status message that screen readers will announce on the
      // next focus, without polluting the visible DOM.
      let status = document.getElementById('corrections-filter-status');
      if (!status) {
        status = document.createElement('p');
        status.id = 'corrections-filter-status';
        status.setAttribute('role', 'status');
        status.setAttribute('aria-live', 'polite');
        status.className = 'corrections-sr-only';
        document.body.appendChild(status);
      }
      status.textContent = `Showing ${visible} of ${entries.length} corrections (${activeSeverity}, ${activeCategory}).`;
    }
  }

  function init(): void {
    const root = document.querySelector<HTMLElement>('[data-corrections-filter-root]');
    if (!root) return;

    // Initialize active state from pressed-default chips (the "All"
    // chips are pressed in markup).
    const allSevBtn = root.querySelector<HTMLButtonElement>('[data-filter-severity][aria-pressed="true"]');
    const allCatBtn = root.querySelector<HTMLButtonElement>('[data-filter-category][aria-pressed="true"]');
    root.dataset.activeSeverity = allSevBtn?.dataset.filterSeverity ?? '';
    root.dataset.activeCategory = allCatBtn?.dataset.filterCategory ?? '';
    applyFilter(root);

    root.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('button');
      if (!target) return;

      // Severity chip
      if (target.hasAttribute('data-filter-severity')) {
        root.dataset.activeSeverity = target.dataset.filterSeverity ?? '';
        applyFilter(root);
        return;
      }
      // Category chip
      if (target.hasAttribute('data-filter-category')) {
        root.dataset.activeCategory = target.dataset.filterCategory ?? '';
        applyFilter(root);
        return;
      }
      // Reset (in the empty-state row)
      if (target.hasAttribute('data-corrections-reset')) {
        root.dataset.activeSeverity = '';
        root.dataset.activeCategory = '';
        applyFilter(root);
        return;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style is:global>
  /* Visually-hidden status line for the live filter announcement. The
     script writes to #corrections-filter-status; the rule keeps it out
     of the visual layout but readable by AT. */
  .corrections-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
</Layout>