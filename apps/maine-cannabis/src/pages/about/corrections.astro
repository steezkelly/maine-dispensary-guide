// ---------------------------------------------------------------------------
// Severity taxonomy (matches our internal editorial-grade definitions):
//   - critical: A material fact was wrong in a way that could mislead a reader
//     acting on the page (legal limits, statute attributions, vote outcomes,
//     operator license categories, fabricated citations). YMYL impact.
//   - material: A fact was wrong but unlikely to drive an irreversible reader
//     decision (wrong phone number, wrong statute year, missing primary-source
//     hyperlink on a factually correct claim, regulator-vs-regulator framing
//     conflation).
//   - minor: A navigational, formatting, or cross-reference issue. No fact
//     in the body text was wrong; readers who followed links got there
//     eventually.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Topic taxonomy:
//   - regulation:  State statute, OCP rule, or legislative session-law
//                  attribution. (YMYL sensitive.)
//   - compliance:  Operator-facing compliance guide (insurance, testing,
//                  tracking, Metrc). (YMYL sensitive.)
//   - city-guide:  City or town guide (operator directory, opt-in status,
//                  municipal vote outcome).
//   - operator-data: Specific operator address, phone, hours, license type.
//   - cross-reference: A link or reference drift between two pages.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Material corrections log. Each entry documents what was wrong, what is
// correct, and a numbered set of primary sources. The ledger is
// reverse-chronological. Adding an entry requires publishing an updated
// article AND the on-page counter (handled elsewhere).
//
// verified_via: structured array of {label, url, note} pairs rendered as
//   numbered footnotes below each entry. Numbering restarts per entry. The
//   raw prose paragraph is preserved below the footnote list so an operator
//   or regulator scanning for keywords still sees every source inline.
// ---------------------------------------------------------------------------
type VerifiedSource = {
  label: string;
  url: string;
  note?: string;
};

type Correction = {
  date: string;
  slug: string;
  title: string;
  severity: 'critical' | 'material' | 'minor';
  category: 'regulation' | 'compliance' | 'city-guide' | 'operator-data' | 'cross-reference';
  what_was_wrong: string;
  what_is_correct: string;
  verified_via: VerifiedSource[];
  published_in: { name: string; href: string }[];
};

