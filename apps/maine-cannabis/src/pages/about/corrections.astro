      <article class="correction-entry">
        <div class="correction-meta">
          <span class="correction-date">{c.date}</span>
          <span aria-hidden="true">·</span>
          <span>slug: <code>{c.slug}</code></span>
        </div>
        <h3 class="correction-title">{c.title}</h3>

        <p class="correction-section-label error-label">What was wrong</p>
