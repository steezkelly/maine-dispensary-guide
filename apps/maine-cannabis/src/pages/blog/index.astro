---
import Layout from '../../layouts/Layout.astro';
import blogCrosslinks from '../../data/blog-crosslinks.json';
import blogIndex from '../../data/blog-index.json';

// Single source of truth: the build-generated blog index (53 posts).
// Never hardcode posts here — the index regenerates from the pages themselves.
const posts = blogIndex.items.map((item) => ({
  url: item.href,
  title: item.title,
  date: item.date,
  section: item.section,
  hero: item.heroImage ?? '/images/heroes/maine-compliance-hero.jpg',
}));

// Companion entries that live outside /blog/ but belong on this page for
// internal-link equity (previously hardcoded; kept deliberately).
const pinnedCompanions = [
  { url: '/guides/maine-dispensary-license', title: 'How to Open a Maine Dispensary in 2026', date: '2026-07-21', section: 'Business Operations', hero: '/images/heroes/maine-dispensary-license-open-2026.jpg' },
];

const allEntries = [...posts, ...pinnedCompanions];

// Card images use the 640w variant of each post's hero.
function hero640(hero: string): string {
  return hero.replace(/\.jpg$/, '-640w.jpg');
}

// Four topics — each groups related sections under one accent color so
// readers can tell at a glance which shelf a story sits on.
const topics = [
  {
    id: 'grow',
    klass: 'desk-grow',
    name: 'Growing Cannabis',
    hint: 'Guides for people who grow or want to grow cannabis — plants, soil, training, pests, drying, and the science behind it.',
    sections: ['Home Cultivation', 'Cannabis Science', 'Cultivation & Products'],
  },
  {
    id: 'buyer',
    klass: 'desk-buyer',
    name: 'Buying & Visiting',
    hint: 'Guides for shoppers and visitors — what to buy, what it costs, travel, and gifting in Maine.',
    sections: ['Consumer Guide', 'Market Analysis', 'Lifestyle & Travel'],
  },
  {
    id: 'patient',
    klass: 'desk-patient',
    name: 'Medical & Patients',
    hint: 'Guides for medical cannabis patients — cards, caregiver delivery rights, and patient-focused products.',
    sections: ['Medical & Wellness', 'Medical Cannabis'],
  },
  {
    id: 'operator',
    klass: 'desk-operator',
    name: 'Business & Policy',
    hint: 'Guides for operators and professionals — licensing, enforcement, careers, finance, and Maine cannabis law.',
    sections: ['Careers', 'Policy & Legislation', 'Policy & Enforcement', 'Business & Operations', 'Business Operations', 'Finance', 'Finance & Investment', 'Licensing', 'Compliance', 'Market Data', 'Patient Safety', 'Municipal Regulations', 'Learn', 'Transactions'],
  },
];

const topicBySection = new Map<string, string>();
for (const topic of topics) for (const s of topic.sections) topicBySection.set(s, topic.klass);

// Featured story: the gray-market enforcement analysis, pinned deliberately.
const featuredUrl = '/blog/maine-cannabis-gray-market-ocp-enforcement-2026';
const featured = allEntries.find((p) => p.url === featuredUrl) ?? allEntries[0];

// Latest: the six newest blog posts that aren't the featured story.
const latest = [...posts]
  .filter((p) => p.url !== featured.url)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);

const topicPostCount = (topic: typeof topics[number]) =>
  allEntries.filter((p) => topic.sections.includes(p.section)).length;

const postCount = allEntries.length;
const newest = posts.reduce((m, p) => (p.date > m ? p.date : m), posts[0].date);
const newestLabel = new Date(newest + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

function formatPostDate(iso: string): string {
  return new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

// "Start here" pathways keep the corrected-delivery SEO contracts.
const pathways = [
  { href: '/blog/buying-cannabis-by-effect-2026', slug: 'buying-cannabis-by-effect-2026', desk: 'desk-buyer', label: 'Consumer Guide', note: 'Match Maine menu terms to the outcome you want before you choose a strain, edible, or concentrate.' },
  { href: '/blog/maine-dispensary-gift-cards', slug: 'maine-dispensary-gift-cards', desk: 'desk-buyer', label: 'Consumer Guide', note: 'Check which gift-card options work for Maine stores and which purchase rules matter at checkout.' },
  { href: '/blog/maine-cannabis-budtender-careers', slug: 'maine-cannabis-budtender-careers', desk: 'desk-operator', label: 'Careers', note: 'Review pay bands, OCP worker requirements, interview signals, and retail cannabis career paths.' },
  { href: '/blog/maine-cannabis-delivery-business-guide-2026', slug: 'maine-cannabis-delivery-business-guide-2026', desk: 'desk-operator', label: 'Business Operations', note: 'Run lawful adult-use delivery as an existing licensee — §504(9) authority, vehicle controls, manifests, ID checks, and records. No standalone courier license exists.' },
  { href: '/blog/maine-medical-patient-delivery-services-2026', slug: 'maine-medical-patient-delivery-services-2026', desk: 'desk-patient', label: 'Medical Cannabis', note: 'How Maine medical cannabis patients lawfully access delivery through the responsible caregiver or registered dispensary — Title 22 rules and what is not permitted.' },
  { href: '/blog/portland-maine-cannabis-rules-2026', slug: 'portland-maine-cannabis-rules-2026', desk: 'desk-operator', label: 'Compliance', note: 'Verify local zoning, municipal approval, and operating constraints before planning in Portland.' },
  { href: '/blog/maine-cannabis-social-equity-program-2026', slug: 'maine-cannabis-social-equity-program-2026', desk: 'desk-operator', label: 'Policy & Legislation', note: 'Understand eligibility, fee reductions, priority licensing, and support programs for applicants.' },
  { href: '/blog/maine-cannabis-gray-market-ocp-enforcement-2026', slug: 'maine-cannabis-gray-market-ocp-enforcement-2026', desk: 'desk-operator', label: 'Policy & Legislation', note: 'Read the enforcement analysis behind caregiver leakage, out-of-state delivery, and OCP capacity limits.' },
  { href: '/blog/maine-psilocybin-2026-guide', slug: 'maine-psilocybin-2026-guide', desk: 'desk-operator', label: 'Policy & Legislation', note: 'Track LD 1034, the state commission, federal research signals, and operational implications.' },
  { href: '/blog/ibogaine-federal-executive-order-maine-2026', slug: 'ibogaine-federal-executive-order-maine-2026', desk: 'desk-operator', label: 'Policy & Legislation', note: 'Separate ibogaine policy signals from Maine\'s psilocybin debate and cannabis operator strategy.' },
];
---

<Layout
  title="Maine Cannabis Blog — Industry News, Guides & Analysis"
  description="Cannabis business guides, policy analysis, and industry news for Maine operators and investors. Cultivation licenses, dispensary operations, ROI, and psilocybin legislation."
  isHub={true}
>
<style>
  /* ============================================================
     THE MAINE DESK — editorial magazine treatment for /blog
     Topic accent colors carry both themes via var() + color-mix.
     ============================================================ */
  .blog-masthead {
    position: relative;
    padding: clamp(2rem, 5vw, 3.25rem) 0 clamp(1.25rem, 3vw, 2rem);
    border-bottom: 3px double var(--color-rule, rgba(16, 24, 32, 0.25));
    margin-bottom: 1.75rem;
    text-align: center;
  }
  .masthead-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .masthead-eyebrow::before,
  .masthead-eyebrow::after {
    content: "";
    display: inline-block;
    width: 2.25rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .blog-masthead h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.08;
    margin: 0.75rem auto 0.9rem;
    max-width: 22ch;
    color: var(--color-text);
  }
  .masthead-dek {
    font-size: var(--text-lg);
    color: var(--color-text-light-strong, var(--color-text-light));
    max-width: 62ch;
    margin: 0 auto 1.25rem;
    line-height: 1.6;
  }
  .masthead-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    font-size: var(--text-sm);
    color: var(--color-text-light-strong, var(--color-text-light));
  }
  .masthead-stats strong {
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  /* Small ⓘ affordance that explains editorial terms on hover/focus. */
  .term-tip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    cursor: help;
    border-bottom: 1px dotted color-mix(in oklab, currentColor 60%, transparent);
  }
  .term-tip .tip-bubble {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    width: min(30ch, 80vw);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(16, 24, 32, 0.16);
    padding: 0.6rem 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-interface) ease;
    z-index: 30;
    pointer-events: none;
  }
  .term-tip:hover .tip-bubble,
  .term-tip:focus .tip-bubble,
  .term-tip:focus-within .tip-bubble {
    opacity: 1;
    visibility: visible;
  }

  /* Topic palette — mid-tone accents tuned for both themes. */
  .desk-grow { --desk: #4e7042; --desk-deep: #38522f; }
  .desk-buyer { --desk: #a06b28; --desk-deep: #7c521e; }
  .desk-patient { --desk: #9b5a68; --desk-deep: #77404e; }
  .desk-operator { --desk: #2f6b6e; --desk-deep: #205052; }
  :global(html[data-theme="dark"]) .desk-grow { --desk: #8fb37c; --desk-deep: #a9cb97; }
  :global(html[data-theme="dark"]) .desk-buyer { --desk: #d3a45e; --desk-deep: #e2bd83; }
  :global(html[data-theme="dark"]) .desk-patient { --desk: #d494a3; --desk-deep: #e3b2bd; }
  :global(html[data-theme="dark"]) .desk-operator { --desk: #7db8ba; --desk-deep: #9dcecf; }

  /* The theme defines --color-text-light-strong for light mode only; pin a
     readable dark-mode value so meta/dek text never drops to dark-on-dark. */
  :global(html[data-theme="dark"]) { --color-text-light-strong: #c8d6c2; }

  /* Sticky topic navigator */
  .desk-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    margin: 0 -1rem 2rem;
    padding: 0.6rem 1rem;
    background: color-mix(in oklab, var(--color-background) 92%, transparent);
    backdrop-filter: blur(8px);
    border-block: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .desk-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 44px;
    padding: 0.55rem 1.25rem;
    border-radius: 999px;
    border: 1.5px solid color-mix(in oklab, var(--desk) 55%, var(--color-border));
    background: color-mix(in oklab, var(--desk) 10%, var(--color-surface));
    color: var(--desk-deep);
    font-weight: 700;
    font-size: var(--text-base);
    text-decoration: none;
    transition: transform var(--duration-interface) ease, background var(--duration-interface) ease;
  }
  .desk-nav a::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--desk);
  }
  .desk-nav a:hover {
    background: color-mix(in oklab, var(--desk) 20%, var(--color-surface));
    transform: translateY(-1px);
    text-decoration: none;
  }
  .desk-nav a:focus-visible {
    outline: 2px solid var(--desk);
    outline-offset: 2px;
  }

  /* Featured story */
  .featured-story {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 2.5rem;
    box-shadow: var(--elev-2, 0 6px 24px rgba(16, 24, 32, 0.06));
  }
  .featured-story .featured-media {
    position: relative;
    min-height: 280px;
  }
  .featured-story .featured-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured-story .featured-body {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .featured-kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-error, #8b3a3a);
  }
  .featured-body h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.15;
    margin: 0.75rem 0 0.9rem;
  }
  .featured-body h2 a { color: var(--color-text); text-decoration: none; }
  .featured-body h2 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .featured-body p { color: var(--color-text-light-strong, var(--color-text-light)); line-height: 1.65; margin: 0 0 1.25rem; }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding: 0.5rem 1.25rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-editorial-md);
    font-weight: 600;
    text-decoration: none;
    align-self: flex-start;
  }
  .featured-cta:hover { background: var(--color-primary-dark); color: var(--color-on-primary); text-decoration: none; }
  /* Dark mode: --color-primary flips to pale sage, and the theme's broad
     `html[data-theme] section a` rule would repaint this link. Pin the CTA
     to the constant cream-ink chip pattern (both tokens stay fixed across
     themes) at a specificity above the theme override. */
  :global(html[data-theme]) .featured-story .featured-cta,
  :global(html[data-theme]) .featured-story .featured-cta:hover {
    background: var(--color-cream-ink);
    color: var(--color-on-secondary);
    text-decoration: none;
  }

  /* Latest strip — horizontal image cards */
  .latest-strip { margin-bottom: 2.75rem; }
  .strip-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .strip-head h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    margin: 0;
  }
  .strip-head .rule { flex: 1; height: 1px; background: var(--color-rule, var(--color-border)); }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .latest-item {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--desk, var(--color-primary));
    border-radius: var(--radius-editorial-md);
    background: var(--color-surface);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-interface) ease, box-shadow var(--duration-interface) ease;
  }
  .latest-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(16, 24, 32, 0.09);
    text-decoration: none;
  }
  .latest-item .latest-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in oklab, var(--desk) 14%, var(--color-surface));
  }
  .latest-item .latest-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .latest-item .latest-body { padding: 0.9rem 1rem 1rem; }
  .latest-item .item-meta {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--desk-deep, var(--color-text-light));
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .latest-item h3 {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.3;
    margin: 0;
    color: var(--color-text);
  }

  /* Start-here pathway chips */
  .pathways { margin-bottom: 3rem; }
  .pathways h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    margin-bottom: 0.4rem;
  }
  .pathways > p {
    color: var(--color-text-light-strong, var(--color-text-light));
    margin-bottom: 1.25rem;
    max-width: 70ch;
  }
  .pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.9rem;
  }
  .pathway-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--desk, var(--color-primary));
    border-radius: var(--radius-editorial-md);
    text-decoration: none;
    transition: transform var(--duration-interface) ease, box-shadow var(--duration-interface) ease;
  }
  .pathway-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(16, 24, 32, 0.09);
    text-decoration: none;
  }
  .pathway-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--desk-deep, var(--color-accent));
  }
  .pathway-card h3 {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    margin: 0;
    color: var(--color-text);
    line-height: 1.3;
  }
  .pathway-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-light-strong, var(--color-text-light));
    line-height: 1.55;
  }

  /* Topic sections */
  .desk-section {
    margin-bottom: 3.25rem;
    scroll-margin-top: 5.5rem;
  }
  .desk-band {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 1rem 1.5rem;
    margin-bottom: 1.4rem;
    border-radius: var(--radius-editorial-md);
    background: color-mix(in oklab, var(--desk) 18%, var(--color-surface));
    border-left: 6px solid var(--desk);
    border-bottom: 1px solid color-mix(in oklab, var(--desk) 35%, var(--color-border));
  }
  .desk-band h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    margin: 0;
    color: var(--color-text);
  }
  .desk-band .desk-count {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--desk-deep);
    border: 1px solid color-mix(in oklab, var(--desk) 50%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
    background: color-mix(in oklab, var(--desk) 8%, transparent);
  }
  .desk-band .desk-tagline {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-text-light-strong, var(--color-text-light));
    font-size: var(--text-sm);
  }
  .desk-subhead {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--desk-deep, var(--color-accent));
    margin: 1.75rem 0 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .desk-subhead::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-rule, var(--color-border));
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .story-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-interface) ease, box-shadow var(--duration-interface) ease, border-color var(--duration-interface) ease;
  }
  .story-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(16, 24, 32, 0.11);
    border-color: color-mix(in oklab, var(--desk) 55%, var(--color-border));
    text-decoration: none;
  }
  .story-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in oklab, var(--desk) 14%, var(--color-surface));
  }
  .story-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .story-card:hover .story-media img { transform: scale(1.035); }
  .story-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .story-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--desk-deep, var(--color-accent));
  }
  .story-body h3 {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.3;
    margin: 0.45rem 0 0.55rem;
    color: var(--color-text);
  }
  .story-meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    color: var(--color-text-light-strong, var(--color-text-light));
  }
  .story-meta .read-on {
    font-weight: 700;
    color: var(--desk-deep, var(--color-accent));
    letter-spacing: 0.04em;
  }

  @media (max-width: 860px) {
    .featured-story { grid-template-columns: 1fr; }
    .featured-story .featured-media { min-height: 220px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .story-card, .latest-item, .pathway-card, .desk-nav a { transition: none; }
    .story-card:hover .story-media img { transform: none; }
  }
</style>

<header class="blog-masthead">
  <p class="masthead-eyebrow">The Maine Desk</p>
  <h1>Maine Cannabis Blog</h1>
  <p class="masthead-dek">Industry news, operational guides, and policy analysis for Maine cannabis professionals — reported against OCP records, state statute, and operator interviews.</p>
  <p class="masthead-stats">
    <span>
      <span class="term-tip" tabindex="0">
        <strong>{postCount}</strong> guides &amp; articles
        <span class="tip-bubble" role="tooltip">Every entry below is a standalone guide or news article we wrote and maintain for Maine readers.</span>
      </span>
    </span>
    <span>
      <span class="term-tip" tabindex="0">
        <strong>{topics.length}</strong> topics
        <span class="tip-bubble" role="tooltip">We group articles into four topics — Growing, Buying &amp; Visiting, Medical, and Business &amp; Policy — so you can jump straight to what you need.</span>
      </span>
    </span>
    <span>
      <span class="term-tip" tabindex="0">
        Latest article published <strong>{newestLabel}</strong>
        <span class="tip-bubble" role="tooltip">The publish date of our most recent article. New guides and updates land here as we write them.</span>
      </span>
    </span>
  </p>
</header>

<nav class="desk-nav" aria-label="Blog topics">
  {topics.map((topic) => (
    <a href={`#topic-${topic.id}`} class={topic.klass}>{topic.name}</a>
  ))}
</nav>

<section class="featured-story desk-operator" aria-label="Featured story">
  <div class="featured-media">
    <img src={featured.hero} alt="Maine Office of Cannabis Policy license map graphic" width="640" height="360" loading="eager" fetchpriority="high" />
  </div>
  <div class="featured-body">
    <p class="featured-kicker">Featured story · Business &amp; Policy</p>
    <h2><a href={featured.url}>{featured.title}</a></h2>
    <p>Maine's Office of Cannabis Policy regulates a sprawling industry with fewer than 40 compliance staff. The result: a 1,500-caregiver gray market, a thriving out-of-state delivery trade, and a patient base that is increasingly buying outside the legal system.</p>
    <a class="featured-cta" href={featured.url}>Read the analysis →</a>
  </div>
</section>

<section class="latest-strip" aria-label="Latest articles">
  <div class="strip-head">
    <h2>Latest articles</h2>
    <span class="rule" aria-hidden="true"></span>
  </div>
  <div class="latest-grid">
    {latest.map((post) => (
      <a href={post.url} class={`latest-item ${topicBySection.get(post.section) ?? ''}`}>
        <div class="latest-media">
          <img src={hero640(post.hero)} alt="" width="640" height="360" loading="lazy" decoding="async" />
        </div>
        <div class="latest-body">
          <span class="item-meta">{post.section} · {formatPostDate(post.date)}</span>
          <h3>{post.title}</h3>
        </div>
      </a>
    ))}
  </div>
</section>

<section class="pathways" aria-label="Start here">
  <h2>Need a specific Maine cannabis path?</h2>
  <p>Use these topic pathways when you are comparing policy, operator, career, and consumer decisions across the Maine cannabis market.</p>
  <div class="pathway-grid">
    {pathways.map((pw) => (
      <a href={pw.href} class={`pathway-card ${pw.desk}`}>
        <span class="pathway-label">{pw.label}</span>
        <h3>{blogCrosslinks[pw.slug as keyof typeof blogCrosslinks] ?? pw.slug}</h3>
        <p>{pw.note}</p>
      </a>
    ))}
  </div>
</section>

{topics.map((topic) => {
  const topicPosts = allEntries.filter(p => topic.sections.includes(p.section));
  const subSections = topic.sections.filter(s => topicPosts.some(p => p.section === s));
  return (
    <section id={`topic-${topic.id}`} class={`desk-section ${topic.klass}`} aria-label={topic.name}>
      <div class="desk-band">
        <h2>{topic.name}</h2>
        <span class="desk-count">{topicPostCount(topic)} articles</span>
        <p class="desk-tagline">{topic.hint}</p>
      </div>
      {subSections.map((sub) => (
        <Fragment>
          <h3 class="desk-subhead">{sub}</h3>
          <div class="story-grid">
            {topicPosts.filter(p => p.section === sub).map((post) => (
              <a href={post.url} class="story-card">
                <div class="story-media">
                  <img src={hero640(post.hero)} alt="" width="640" height="360" loading="lazy" decoding="async" />
                </div>
                <div class="story-body">
                  <span class="story-eyebrow">{post.section}</span>
                  <h3>{post.title}</h3>
                  <span class="story-meta">
                    <time datetime={post.date}>{formatPostDate(post.date)}</time>
                    <span class="read-on">Read →</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </Fragment>
      ))}
    </section>
  );
})}
</Layout>
