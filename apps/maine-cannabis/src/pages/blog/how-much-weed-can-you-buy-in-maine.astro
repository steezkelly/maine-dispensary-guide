const faqItems = [
  { question: 'Is the Maine cannabis limit per day or per transaction?', answer: 'The store limit applies to each transaction, while the possession limit applies to the cannabis you possess. A second purchase does not permit you to possess more than the legal total.' },
  { question: 'How much concentrate can I buy in Maine?', answer: 'No more than 10 grams of concentrate may be included within the combined 2.5-ounce adult-use transaction limit.' },
  { question: 'Do edibles have a separate purchase allowance?', answer: 'No. Edibles and other products count toward the same combined limit through Maine product-equivalency rules.' },
