const article = {
  publishDate: '2026-06-05',
  modifiedDate: '2026-07-22',
  section: 'Medical & Wellness',
};
const topics = ['medical', 'patient-guide', 'certification'];

const faqItems = [
  {
    question: 'How do I become a medical cannabis patient in Maine?',
    answer: 'Schedule an assessment with a Maine-licensed physician, nurse practitioner, or physician assistant. After a full medical-history assessment in a bona fide provider-patient relationship, the provider may issue and provide a written certification if the provider believes medical cannabis may provide therapeutic or palliative benefit.',
  },
  {
    question: 'Does Maine issue a medical marijuana card to ordinary patients?',
    answer: 'Maine qualifying patients generally use the written certification issued by their medical provider with government-issued photo identification. The Office of Cannabis Policy says it does not maintain a patient registry. An Individual Identification Card, or IIC, is an adult-use program worker credential and is not the ordinary patient credential.',
  },
  {
    question: 'Does Maine have a fixed list of qualifying conditions?',
    answer: 'Maine law focuses on the medical provider’s professional judgment. A provider may certify a patient when, after the required assessment, the provider believes the patient may receive therapeutic or palliative benefit for a medical diagnosis. The provider may decline to certify and is responsible for meeting the applicable standard of care.',
  },
  {
    question: 'Can a medical cannabis certification be issued through telehealth?',
    answer: 'Maine law allows telehealth subject to specific conditions. The provider must use a synchronous encounter before issuing or renewing a certification and must follow the standards of the provider’s licensing board. If the certifying provider is not the patient’s primary care provider and the patient does not provide the primary provider’s contact information, Maine law requires an in-person consultation before certification.',
  },
  {
    question: 'How long is a Maine written certification valid?',
    answer: 'A written certification is valid for the term specified by the medical provider, up to one year. The provider may issue a digital image only when it is identical to the tamper-resistant paper certification and remains legible.',
  },
  {
    question: 'Can an out-of-state medical cannabis patient buy in Maine?',
    answer: 'Some visiting patients can. The visitor must be a resident of an OCP-approved jurisdiction, possess the patient credential issued under that jurisdiction’s law, and present photo identification or a driver’s license from the same jurisdiction. Check OCP’s current visiting-patient list before traveling because approval can change.',
  },
];
---

<Layout
  title="How to Get a Maine Medical Cannabis Card in 2026"
