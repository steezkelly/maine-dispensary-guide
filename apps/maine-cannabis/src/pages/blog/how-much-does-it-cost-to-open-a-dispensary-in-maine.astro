import authors from '../../data/authors.json';
const financeReviewer = authors.find(a => a.id === 'calvin-waters');
const article = {
  author: "Margaret Finch",
  authorId: "margaret-finch",
  authorTitle: "Finance & Taxation Analyst",
  publishDate: "2026-07-21",
  modifiedDate: "2026-07-21",
  section: "Business Essentials"
};
const topics = ["finance", "licensing", "business"];

const faqItems = [
  { question: "How much does it cost to open a dispensary in Maine?", answer: "Total startup investment to open a dispensary in Maine ranges from about $360,000 to $1,000,000 for most operators. That combines facility build-out ($100K-$300K), initial inventory ($50K-$150K), security systems ($25K-$75K), POS and technology ($10K-$30K), roughly six months of working capital ($100K-$250K), and licensing fees ($3K-$10K). Rural Maine locations land on the low end; Portland-area locations with larger build-outs land on the high end." },
  { question: "What is the OCP application fee for a Maine dispensary?", answer: "Under 28-B M.R.S. §207, the Maine OCP adult-use cannabis store (dispensary) application fee is $250, with an annual license fee of up to $2,500. Municipal licensing fees vary by town — Portland charges $5,000 annually, Lewiston $2,500, while smaller towns may charge less. Budget roughly $3,000-$12,000 annually for combined state and local licensing. Each principal and employee also needs a $50 Individual Identification Card." },
  { question: "How much money do you need to start a dispensary including working capital?", answer: "Plan for at least $360,000 in total capital, and more if you are in a high-rent market. The most commonly underestimated line is working capital: holding six months of operating expenses in reserve is the difference between surviving the first slow quarter and shuttering. Staffing is the single largest ongoing cost, at roughly $216K-$384K annually for 4-6 employees." },
  { question: "How long before a Maine dispensary becomes profitable?", answer: "Most Maine operators report 18-36 months to break-even. Portland-area dispensaries often take 24-36 months due to competitive saturation, while underserved rural markets or growth corridors like York County may break even in 12-24 months. Operators with prior cannabis retail experience and lower build-out costs reach break-even faster." },
  { question: "How much does a Maine dispensary make per year?", answer: "First-year revenue for a Maine dispensary typically ranges from $600K to $1.4M depending on location. Portland dispensaries average higher per-store revenue ($1.5M-$2.5M) but with thinner margins, while rural and suburban dispensaries average $600K-$1.2M with higher margin percentages. Net margins typically run 15-25% after COGS and operating expenses." },
  { question: "What are the hidden costs of opening a dispensary in Maine?", answer: "The most commonly underestimated costs are: security monitoring ($400-$700/mo ongoing), METRC setup and subscription ($5K-$8K setup plus $300-$500/mo), insurance ($8K-$20K annually for general plus cannabis-specific product liability), legal and compliance counsel ($6K-$12K/year ongoing), cash-handling infrastructure (armored car, secure storage, vault), and municipal impact fees." },
  { question: "Is Maine cheaper than Massachusetts to open a dispensary?", answer: "Yes. Maine is consistently 10-20% cheaper than Massachusetts for the same product tier, and Maine's 14% adult-use retail sales tax (effective January 1, 2026) is below Massachusetts' 17-20% effective rate. The trade-off: Massachusetts has roughly four times Maine's adult-use population, so per-store revenue opportunity is higher there. Maine favors operators prioritizing margin and cost predictability." },
  { question: "Can I open a dispensary in any Maine town?", answer: "No. You can only open a dispensary in a municipality that has authorized retail cannabis. As of OCP opt-in data refreshed 2026-07-17, 78 of Maine's 485 municipalities have recorded retail authorization; the remaining 407 have no recorded retail authorization. Confirm local authorization before committing to a lease or purchase." }
];
---

