import authors from '../../data/authors.json';
const editorialAuthor = authors.find(a => a.id === 'margaret-finch');
const complianceReviewer = authors.find(a => a.id === 'eliot-nash');
const article = {
  author: "Margaret Finch",
  authorId: "margaret-finch",
  authorTitle: "Finance & Taxation Analyst",
  publishDate: "2026-06-05",
  modifiedDate: "2026-06-05",
  section: "Market Analysis"
};
const topics = ["pricing", "best-deals", "consumer-guide"];

const faqItems = [
  { question: "Where is the cheapest dispensary in Maine?", answer: "By per-gram flower price, Full Bloom in Presque Isle, Royal Leaf in Houlton, and HighNorth in Aroostook consistently post the lowest numbers in the state — typically $7-9 per gram on house flower and $80-100 ounces during their weekly specials. Cannabis Haven (Auburn) and Cannabis Cured (Bangor) are the cheapest operators in central and eastern Maine at the metro scale. The cheapest dispensary for any given buyer depends on drive time, taxes, and whether you can stack a first-time-patient discount on top of the rotation. Use the comparison table in this guide to model the actual cost at each store." },
  { question: "How much is a gram of weed in Maine in 2026?", answer: "A gram of quality indoor flower in Maine in 2026 runs $12-18 before tax at most licensed dispensaries. Value-tier grams on house strains or rotation specials run $8-12. Premium top-shelf grams reach $20-25. Pre-tax retail prices in Maine are roughly 10-20% above mature West Coast markets due to vertical-integration requirements, 280E federal tax pressure, and lower wholesale volume. After Maine's 10% adult-use excise tax and 5.5% state sales tax, expect to add 15.5% to the menu price at the register." },
  { question: "How much is an ounce in Maine in 2026?", answer: "An ounce of cannabis in Maine in 2026 runs $80-200 before tax, with most licensed dispensaries pricing mid-quality flower around $120-160 per ounce. Value ounces on rotating house strains are $80-110 at HighNorth, Full Bloom, Cannabis Haven, and Cannabis Cured. Premium ounces from top-tier cultivators (Theory Wellness, HIGHLY Cannaco, select Caregiver Reserve batches) reach $180-220. With Maine's 10% adult-use excise plus 5.5% sales tax, a $120 ounce rings up at roughly $139. Medical patients avoid the 10% excise and pay only the 5.5% sales tax." },
  { question: "Why are Maine dispensary prices so high?", answer: "Three structural factors keep Maine prices above mature West Coast markets. First, Maine's vertical-integration mandate requires every operator to cultivate, process, and retail their own product — that eliminates wholesale markets and the price compression that comes with them. Second, federal Section 280E prevents cannabis operators from deducting normal business expenses, which inflates effective tax rates by 30-50% and gets passed to consumers. Third, smaller production volumes than mature markets like Colorado or Oregon keep per-unit costs higher. The result: Maine is not the cheapest legal state, but it is cheaper than Massachusetts, Connecticut, and most of New York." },
  { question: "Does Maine tax cannabis?", answer: "Yes. Adult-use cannabis in Maine is taxed at three levels: a 10% retail excise tax on the gross retail price (set by the state), a 5.5% state sales tax, and any applicable local sales tax (most municipalities do not add a local option tax on cannabis, but a handful do). Medical cannabis is taxed at 5.5% state sales tax only — there is no 10% retail excise on MMMP transactions. Combined tax burden on adult-use is roughly 15.5%. A $50 eighth at a Portland dispensary rings up at about $58 after tax. The tax structure and what it means for operators is covered in detail in our <a href=\"/guides/maine-cannabis-taxes-2026\">Maine cannabis taxes 2026 guide</a>." },
  { question: "How do I find the best dispensary deals in Maine?", answer: "Four strategies work consistently. First, follow the store's Instagram — Maine dispensaries post weekly deal rotations on social media before they hit the website. Second, sign up for the store's text or email list; first-time-patient discounts (typically 15-20% off) are usually the deepest single discount available. Third, ask about veteran, senior, and MMMP discounts at the register — most operators stack these on top of rotation specials. Fourth, check the deal rotation before driving more than 20 minutes; the cheapest store in your region rotates specials weekly, and a $25 eighth one week may be $40 the next." }
];

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer.replace(/<[^>]+>/g, "")
    }
  }))
};
