import authors from '../../data/authors.json';
const complianceReviewer = authors.find(a => a.id === 'margaret-finch');
const article = {
  author: "Calvin Waters",
  authorId: "calvin-waters",
  authorTitle: "Licensing & Compliance Analyst",
  publishDate: "2026-07-21",
  modifiedDate: "2026-07-21",
  section: "Policy & Legislation"
};
const topics = ["policy", "legislation", "consumer-guide"];

const faqItems = [
  { question: "Is weed legal in Maine?", answer: "Yes. Recreational (adult-use) cannabis is legal in Maine for adults 21 and older. Maine voters legalized it in 2016, and licensed retail sales began in 2020. You can legally buy, possess, and consume cannabis within the limits set by Title 28-B of the Maine Revised Statutes, regulated by the Maine Office of Cannabis Policy (OCP)." },
  { question: "How much cannabis can I legally possess in Maine?", answer: "Adults 21+ may possess up to 2.5 ounces (about 70 grams) of cannabis, or a combination of cannabis and concentrate that includes no more than 10 grams of concentrate, per 28-B M.R.S. §1501. The 10-gram concentrate cap was raised from 5 grams in 2023 under P.L. 2023, ch. 396. On private property you may keep the cannabis produced by your own home plants. Always keep cannabis in sealed, child-resistant packaging and out of reach of children." },
  { question: "Can I grow cannabis at home in Maine?", answer: "Yes. Adults 21+ may grow up to 6 mature flowering plants, 12 immature plants, and unlimited seedlings per person for personal use under 28-B M.R.S. §1502. The mature-plant limit was raised from 3 to 6 in 2023 under P.L. 2023, ch. 220. Plants must be tagged and grown in a secure space not visible from a public way. Medical patients and caregivers have separate, higher plant limits under the medical program." },
  { question: "Can I smoke weed in public in Maine?", answer: "No. Maine law prohibits consuming cannabis in public places. Consumption is allowed only on private property with the owner's consent. Cannabis is also illegal on all federal land, including Acadia National Park and national forests, regardless of Maine state law." },
  { question: "Is cannabis legal on federal land in Maine?", answer: "No. Cannabis remains a Schedule I controlled substance under federal law. Possessing or consuming it on federal land — including Acadia National Park, the Appalachian Trail, national wildlife refuges, and federal buildings — is a federal offense even though it is legal under Maine state law." },
  { question: "Can I drive after using cannabis in Maine?", answer: "No. Operating a vehicle under the influence of cannabis is illegal in Maine and carries OUI penalties. Cannabis impairs reaction time and judgment, and edibles' delayed onset makes timing especially dangerous. Arrange a sober ride before consuming." },
  { question: "Do I need a medical card to buy cannabis in Maine?", answer: "No. Adults 21+ can buy adult-use cannabis at a licensed dispensary with just a valid government-issued photo ID. A Maine medical cannabis card (or a valid reciprocity-state card) is optional and provides access to medical dispensaries, higher-dose products, and tax savings." },
  { question: "Can I take cannabis across state lines from Maine?", answer: "No. Transporting cannabis across state lines is a federal offense, even between two states where it is legal. You must consume or dispose of any cannabis before leaving Maine. The same applies to air travel — cannabis is illegal in airports and on aircraft under federal law." }
];
---

<Layout
  title="Is Weed Legal in Maine? Yes — 2026 Laws, Possession Limits & Home Grow Rules"
