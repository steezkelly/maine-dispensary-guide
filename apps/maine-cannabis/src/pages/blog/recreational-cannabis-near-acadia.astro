import authors from '../../data/authors.json';
const editorialAuthor = authors.find(a => a.id === 'eliot-nash');
const complianceReviewer = authors.find(a => a.id === 'margaret-finch');
const article = {
  author: "Eliot Nash",
  authorId: "eliot-nash",
  authorTitle: "Market & Real Estate Analyst",
  publishDate: "2026-06-05",
  modifiedDate: "2026-07-08",
  section: "Consumer Guide"
};
const topics = ["acadia", "tourism", "bar-harbor"];

// FAQPage JSON-LD: Acadia-specific, intentionally non-overlapping with the
// general cannabis-friendly-maine-travel page. The travel page owns the
// "can I bring cannabis on a plane / into a hotel" questions; this page
// owns the federal-vs-state land questions and the immediate MDI /
// Trenton / Ellsworth operator landscape. Together the two pages cover
// the cannabis-tourist query set without cannibalizing each other.
const faqItems = [
  { question: "Is cannabis allowed inside Acadia National Park?", answer: "No. Acadia is a National Park Service unit, and federal law prohibits cannabis possession on NPS property regardless of Maine state law. That includes the Park Loop Road, Sand Beach, Jordan Pond, Cadillac Mountain, every trailhead, parking lot, and campground. NPS rangers enforce this; a citation is a federal-misdemeanor-level violation, not a state citation. The Hulls Cove visitor center, Blackwoods Campground, and Seawall Campground are all federal land under the same prohibition." },
  { question: "What dispensaries are on Mount Desert Island?", answer: "Two adult-use dispensaries operate on MDI as of 2026: 420 Mules (224 Main St, Bar Harbor) and The Meristem (33 Main St, Bar Harbor). Both are within a 10-minute drive of the Hulls Cove visitor center and walking distance of most Bar Harbor hotels. The Meristem is medical-friendly with a consultative sales floor and a focus on tinctures, topicals, and capsules; 420 Mules has the broader menu, longer hours (9am-9pm daily in summer), and a stronger first-time-visitor staff." },
  { question: "Where is the closest dispensary to Acadia off the island?", answer: "Snare Creek Farms (599 Bar Harbor Rd, Trenton) is the closest mainland dispensary, about 15 minutes from Hulls Cove across the Trenton Bridge. It is a vertically integrated cultivator-retailer and the only farm-direct option serving the immediate Acadia market. Curaleaf Ellsworth (180 High St) is the next-closest, about 25 minutes west on US-1, with a 100+ SKU menu and pricing typically 10-15% below the Bar Harbor stores." },
  { question: "Can I keep cannabis in my car while driving through Acadia?", answer: "Maine state law allows cannabis in a sealed container in the trunk or a locked cargo area, and that is fine on the mainland. Inside the park, federal NPS rules apply: any cannabis in a vehicle on a road, parking lot, or trailhead is possession on federal land and a federal violation. The safe practice is to leave cannabis at your rental or hotel before entering the park, even for a drive-through. The Park Loop Road is patrolled and the Hulls Cove parking lot is within sight of the visitor center." },
  { question: "Where can I legally consume cannabis near Acadia?", answer: "On private property with the property owner's consent, outside the park boundary. Maine has no licensed consumption lounges, and federal land (every road, trail, beach, and parking lot in Acadia) is closed. Most Bar Harbor and Trenton short-term rentals permit indoor or outdoor cannabis use unless the host has posted a no-smoking rule; confirm the policy in writing before booking. For a cannabis-friendly dedicated rental, High'D Away in Trenton and Camp Laughing Grass in Harrison (about 2.5 hours west) are the two Maine properties that market specifically to cannabis travelers." },
  { question: "Can I take the Bar Harbor ferry to Nova Scotia with cannabis?", answer: "No. The CAT ferry from Bar Harbor to Yarmouth, Nova Scotia is federal maritime jurisdiction for the entire crossing. U.S. Customs and Border Protection boards on the U.S. side and the Canada Border Services Agency boards on the Canadian side. Cannabis in any form — purchased legally in Maine or otherwise — is prohibited on the vessel, and a border violation can result in seizure, federal citation, and a long-term entry ban. Leave cannabis at your accommodation before boarding." }
];

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer.replace(/<[^>]+>/g, "")
    }
  }))
};
