          <tr>
            <th>Tent size</th>
            <th>Floor area</th>
            <th>Plant capacity (3-5 gal pots)</th>
            <th>Use case</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>2×2 ft</td><td>4 sq ft</td><td>1-2</td><td>Closet / starter / single-plant trial</td></tr>
          <tr><td>2×4 ft</td><td>8 sq ft</td><td>2-3</td><td>Home grow starter, space-constrained</td></tr>
          <tr><td><strong>4×4 ft</strong></td><td>16 sq ft</td><td><strong>4-6</strong></td><td>Standard home-grow default</td></tr>
          <tr><td>4×8 ft</td><td>32 sq ft</td><td>6-10</td><td>Intermediate / small commercial</td></tr>
          <tr><td>5×9 ft</td><td>45 sq ft</td><td>8-12</td><td>Advanced / commercial</td></tr>
        </tbody>
      </table>
