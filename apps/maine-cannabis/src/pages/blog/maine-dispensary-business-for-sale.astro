--- import Layout from '../../layouts/Layout.astro'; import AutoRelated from '../../components/AutoRelated.astro'; import Callout from '../../components/Callout.astro'; import Faq from '../../components/Faq.astro'; import authors from '../../data/authors.json'; import siteStats from '../../data/site-stats.json'; const editorialAuthor = authors.find(a => a.id === 'calvin-waters'); const complianceReviewer = authors.find(a => a.id === 'compliance-reviewer'); const article = { author: editorialAuthor?.name || "Calvin Waters", authorId: editorialAuthor?.id || "calvin-waters", authorTitle: editorialAuthor?.role || "Licensing & Compliance Analyst", publishDate: "2026-07-06", modifiedDate: "2026-07-06", section: "Transactions" }; const topics = ["transactions", "compliance", "licensing", "market"]; const faqItems = [ { question: "How do I find a Maine dispensary for sale?", answer: "Three primary channels list Maine cannabis businesses for sale: 420property.com (cannabis-specialized MLS), BizQuest, and BizBuySell. The Maine Office of Cannabis Policy does not maintain a public list of licensees for sale — listings live on these third-party platforms and through cannabis-specialized business brokers. Most Maine dispensary transactions are listed on 420property.com because of the platform's cannabis-specific broker network." }, { question: "How much does a Maine dispensary sell for?", answer: "Maine dispensary sale prices typically range from 1x to 3x annual gross revenue depending on license type, location, and operational standing. A well-run $1M-revenue retail dispensary in an underserved Maine market may list for $1.5M-$2.5M; a $2M-revenue Portland-area dispensary with strong Metrc compliance history may command $3M-$5M. Medical dispensaries and caregiver storefronts often sell for less than adult-use retail because of the lower revenue ceiling per license type." }, { question: "Do I need an OCP license to buy a Maine dispensary?", answer: "Yes. You must file a Post Active License Changes Application with the OCP before the transfer of ownership can be completed. The new owners must pass the same eligibility checks as a new license applicant: 21+ age, Maine business entity (LLC or corporation), beneficial ownership disclosure, criminal history background checks, and source of funds documentation. The OCP must approve the transfer before the new owner can take operational control. Operating before OCP approval is a state-law violation." }, { question: "What is the OCP change of ownership application fee?", answer: "The Post Active License Changes Application fee is $500. This is in addition to the cost of acquiring the business itself. The application also requires legal review of the purchase agreement, updated operating documents, new background checks for all incoming beneficial owners, and updated source of funds documentation. Most buyers retain a cannabis attorney for the OCP application — expect another $2,000-$5,000 in legal fees on top of the $500 OCP fee." }, { question: "Should I buy an existing Maine dispensary or start from scratch?", answer: "Buying makes sense when you find a well-run operator with strong Metrc compliance history, established customer base, and a location in a market that fits your strategy. Starting from scratch makes sense when you have a specific location in mind (especially in an underserved market) that no current operator has secured, or when the acquisition cost exceeds the cost of building your own license and operation. Acquisition typically costs more than startup in absolute dollars, but saves 6-12 months of licensing timeline." }, { question: "What are the risks of buying a Maine dispensary?", answer: "The biggest risks are: (1) inherited compliance violations — the OCP can hold the new owner responsible for unreported issues from prior operation; (2) inherited Metrc discrepancies that don't reconcile; (3) expiring municipal authorization at the location; (4) undisclosed municipal complaints or pending citations; (5) supplier contracts that don't transfer; (6) customer base that leaves with the prior operator's brand. Diligence must cover compliance history, municipal standing, and brand transferability before you close." }, { question: "Can a non-Maine resident buy a Maine dispensary?", answer: "Yes. Maine's 2022 First Circuit Court ruling (Northeast Patients Group v. United Cannabis Patients and Caregivers of Maine) struck down the residency requirement. Out-of-state buyers must still form a Maine-registered business entity (LLC or corporation), pass background checks, and meet all other OCP requirements, but they do not need to be Maine residents. The Maine business entity requirement remains — you can't hold a Maine cannabis license through a Delaware LLC alone." }, { question: "What is the difference between an asset sale and a stock sale in Maine cannabis transactions?", answer: "An asset sale transfers the business assets (inventory, equipment, customer relationships, brand, lease assignment) to the new owner, with the seller retaining the license entity which they then wind down. A stock sale transfers ownership of the entire license-holding entity to the new owner. Asset sales are more common in Maine cannabis because the OCP's Post Active License Changes Application is designed for ownership transfers of the license entity; asset sales with license re-issuance are more complex and may require separate OCP engagement. Most Maine transactions are structured as asset sales where the new owner forms a new LLC and the OCP processes a license transfer/change of ownership." } ];

