  "mainEntity": [
    {
      "@type": "Question",
      "name": "What should I expect on my first visit to a Maine dispensary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bring a valid government-issued ID showing you are 21 or older. Adult-use dispensaries do not require a medical card. You will enter a secure reception area, show your ID, and then browse a retail floor. Budtenders can guide you through the menu. Payment is cash or debit — most dispensaries do not accept credit cards. Your purchase is bagged in opaque, child-resistant packaging before you leave."
      }
    },
    {
      "@type": "Question",
      "name": "How do I read THC labels on Maine cannabis products?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maine requires every product to carry a label showing total THC content. For flower, the label shows THC percentage — most Maine flower ranges from 18% to 28%. For edibles, the label shows milligrams of THC per serving and per package. A single serving in Maine is capped at 10mg THC. Packages may contain up to 100mg total (10 servings). Always check the serving size before consuming."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between indica and sativa?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Indica strains are traditionally associated with relaxing, body-focused effects, while sativas are linked to more uplifting, energetic effects. Many modern products are hybrids. Research suggests terpene profiles — not just indica/sativa labels — actually determine effects. Maine dispensaries list both THC percentage and dominant terpenes on their menus. Try a small amount of any new strain first to see how it affects you."
      }
    },
    {
      "@type": "Question",
      "name": "How much cannabis can I possess in Maine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Adults 21 and older may possess up to 2.5 ounces of cannabis flower in public. At home, you may store up to 5 ounces. You may also possess up to 10 grams of cannabis concentrate, included within the 2.5-ounce public total. Medical patients with a valid MMMP card may possess larger amounts as authorized by their provider."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I legally consume cannabis in Maine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You may legally consume cannabis on private property with the property owner's permission. Public consumption is illegal in all Maine municipalities, including sidewalks, parks, parking lots, and state parks. There are no licensed consumption lounges in Maine as of 2026. If you are visiting, confirm with your hotel, inn, or rental host that cannabis consumption is permitted on the premises before using any product."
      }
    },
    {
      "@type": "Question",
      "name": "How does cannabis delivery work in Maine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Maine licensed dispensaries and registered caregivers may deliver cannabis to customers within the state. Delivery is available in most municipalities that have opted into adult-use or medical cannabis. You must show ID at delivery and the driver cannot leave packages unattended. Delivery hours are generally 8 AM to 9 PM. Some rural areas have limited delivery coverage. If you cannot find delivery in your area, check for nearby caregivers who serve your town."
      }
    }
  ]
});
