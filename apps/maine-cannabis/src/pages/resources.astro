---
import Layout from '../layouts/Layout.astro';
import Callout from '../components/Callout.astro';
import LeadFormTracker from '../components/LeadFormTracker.astro';

const vendorCategories = [
  {
    name: "Legal & Licensing",
    description: "Expert cannabis attorneys to guide your state and local applications.",
    vendors: [
      { name: "Tammie Snow, Esq.", specialty: "Licensing & Regulatory", location: "Portland" },
      { name: "Bernstein Shur", specialty: "Corporate & Zoning", location: "Portland/Augusta" }
    ]
  },
  {
    name: "Accounting & 280E Tax",
    description: "CPAs specializing in IRC 280E compliance and dispensary bookkeeping.",
    vendors: [
      { name: "BerryDunn", specialty: "Tax & Audit", location: "Portland" },
      { name: "Macpage", specialty: "Financial Strategy", location: "South Portland" }
    ]
  }
];

function resourcesVendorActionId(name: string): string {
  return `cta-inline-resources-vendor-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
}
---

<Layout 
  title="Maine Cannabis Resources" 
  description="Connect with verified Maine cannabis lawyers, accountants, and consultants. Request a professional introduction to start your project." 
  heroImage="/images/heroes/resources.jpg"
  article={{ author: "Eliot Nash", authorId: "eliot-nash", publishDate: "2026-01-05", modifiedDate: "2026-06-07", section: "Resources" }}
  isHub={true}
>
  
  <script is:inline>
    // DEFINE GLOBAL HANDLERS IN HEAD
    window.openTheatre = function(name) {
      const wrapper = document.getElementById('page-theatre-wrapper');
      const input = document.getElementById('target-vendor-input');
      const area = document.getElementById('message-text-area');
      
      if (input) input.value = name;
      if (area) area.placeholder = "I would like an introduction to " + name + "...";
      if (wrapper) wrapper.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    };

    window.closeTheatre = function() {
      const wrapper = document.getElementById('page-theatre-wrapper');
      if (wrapper) wrapper.classList.remove('is-active');
      document.body.style.overflow = '';
    };
  </script>

  <div id="page-theatre-wrapper">
    <div id="theatre-dimmer" class="theatre-overlay" onclick="window.closeTheatre()"></div>

    <section class="resources-header">
      <div class="hero-badge">Verified Expert Network</div>
      <h1>Professional Vendor Directory</h1>
      <p class="lead">Building a dispensary means building a team. We've put together a directory of Maine professionals who know cannabis.</p>
    </section>

    <section class="expert-importance">
      <h2>The Importance of Specialized Cannabis Experts</h2>
      <p>Operating a cannabis business in Maine has quirks that regular professionals often haven't encountered. Because cannabis is still federally illegal, dispensaries deal with IRS Section 280E, which limits business deductions. You need a CPA who's done this before, as we explain in our <a href="/guides/maine-cannabis-taxes-2026">280E Taxation Guide</a>.</p>
      <p>Similarly, securing compliant real estate is a labyrinth. Maine operates on an "Opt-In" municipal framework, meaning a town must explicitly vote to allow adult-use cannabis operations. Our featured legal experts understand the nuances of local zoning boards and state-level Office of Cannabis Policy (OCP) applications. They can help you navigate the complexities discussed in our <a href="/guides/maine-cannabis-real-estate">Real Estate & Zoning Guide</a>. If you have a highly specific need not covered by our directory, please <a href="/contact">contact us</a> directly for a custom referral.</p>
    </section>

    <div class="directory-container">
      <div class="vendor-list">
        {vendorCategories.map(category => (
          <div class="category-block">
            <h2>{category.name}</h2>
            <p class="cat-desc">{category.description}</p>
            <div class="vendor-grid">
              {category.vendors.map(vendor => (
                <div class="vendor-card">
                  <h3>{vendor.name}</h3>
                  <p><strong>Specialty:</strong> {vendor.specialty}</p>
                  <p><strong>Location:</strong> {vendor.location}</p>
                  <!-- analytics:cta-injected vendor-specific action ID -->
<button type="button" 
                    class="btn-theatre-trigger" 
                    onclick={`window.openTheatre('${vendor.name}')`} data-cta-id={resourcesVendorActionId(vendor.name)}>
                    Request Intro &rarr;
                  </button>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <aside class="referral-sidebar">
        <div id="referral-form-box" class="referral-box">
          <!-- analytics:cta-injected id=cta-inline-resources-02 -->
<button type="button" class="btn-close-theatre" onclick="window.closeTheatre()" aria-label="&times; Close form" data-cta-id="cta-inline-resources-02">&times;</button>
          <h3>Need a Referral?</h3>
          <p>Tell us about your project, and we will connect you with the right professional.</p>
          
          <form class="referral-form" action="https://formspree.io/f/xvgzlowz" method="POST" aria-labelledby="referral-form-box">
            <label for="lead-name" class="sr-only">Full Name</label>
            <input type="text" id="lead-name" name="name" placeholder="Full Name" required aria-required="true" />
            
            <label for="lead-email" class="sr-only">Business Email</label>
            <input type="email" id="lead-email" name="email" placeholder="Business Email" required aria-required="true" />
            
            <label for="stage-select" class="sr-only">Your Stage</label>
            <select name="stage" id="stage-select" required aria-required="true">
              <option value="" disabled selected>Your stage...</option>
              <option value="startup">Starting a dispensary</option>
              <option value="operating">Already operating</option>
              <option value="researching">Just researching</option>
            </select>
            
            <input type="hidden" id="target-vendor-input" name="requested_professional" value="General Referral" />
            
            <label for="service-select" class="sr-only">Select Service Needed</label>
            <select name="service" id="service-select" required aria-required="true">
              <option value="">Select Service Needed...</option>
              <option value="legal">Legal & Licensing</option>
              <option value="accounting">Tax & 280E</option>
              <option value="security">Security & Hardware</option>
              <option value="real-estate">Real Estate / Zoning</option>
            </select>
            
            <label for="message-text-area" class="sr-only">Describe your goals</label>
            <textarea id="message-text-area" name="message" placeholder="Briefly describe your goals..."></textarea>
            
            <!-- analytics:cta-injected id=cta-inline-resources-03 -->
<button type="submit" class="btn-main" data-cta-id="cta-inline-resources-03">Request Introduction</button>
          </form>
        </div>
      </aside>
    </div>

    <Callout title="Are you a Maine Professional?" type="passion">
      Want to be featured in our directory? We are looking for high-authority lawyers, accountants, and security firms. <a href="mailto:admin@mainedispensaryguide.com">Contact our partnership team</a>.
    </Callout>
  </div>

  <section class="downloadable-resources">
    <h2>Free Compliance Downloads</h2>
    <p class="resource-intro">These tools are used by licensed Maine operators to maintain OCP compliance and prepare for inspections.</p>
    <div class="resource-grid">
      <div class="resource-card">
        <h3>Compliance Self-Assessment</h3>
        <p>8-domain checklist covering security, METRC, licensing, employee records, financial reporting, product testing, marketing, and municipal authorization. 88 checklist items + 3 SOP templates.</p>
        <a href="/download/compliance-self-assessment" class="resource-link">Get the assessment →</a>
      </div>
      <div class="resource-card">
        <h3>METRC Reconciliation Checklist</h3>
        <p>Daily, weekly, and monthly METRC tracking templates with variance thresholds, escalation procedures, and OCP-ready reconciliation reports. 24 checklist items + log sheets.</p>
        <a href="/download/metrc-reconciliation-checklist" class="resource-link">Get the checklist &rarr;</a>
      </div>
      <div class="resource-card">
        <h3>Launch Checklist</h3>
        <p>Step-by-step weekly milestone tracker from LLC formation through OCP inspection. Covers hiring, banking, METRC setup, and pre-opening compliance review.</p>
        <a href="/launch-checklist" class="resource-link">View the checklist →</a>
      </div>
      <div class="resource-card">
        <h3>Founder's Bible</h3>
        <p>The foundational 10-page guide covering everything from entity formation through first sale. Includes budget benchmarks, municipal strategy, and OCP timeline.</p>
        <a href="/download/founders-bible" class="resource-link">Download the Bible →</a>
      </div>
      <div class="resource-card">
        <h3>2026 Business Roadmap</h3>
        <p>Month-by-month operating timeline with METRC reporting deadlines, OCP renewal dates, and tax filing reminders for active dispensaries.</p>
        <a href="/download/roadmap" class="resource-link">Download roadmap →</a>
      </div>
    </div>
  </section>

  <section class="tools-calculators">
    <h2>Maine Cannabis Calculators &amp; Tools</h2>
    <p class="resource-intro">Decision-support tools for operators and prospective owners. Built from primary-source data refreshed against OCP roster changes.</p>
    <div class="resource-grid">
      <div class="resource-card">
        <h3>Maine 280E Tax Calculator</h3>
        <p>Estimate your Maine cannabis effective tax rate under Section 280E with the state's unique 8.93% gross-expense tax. Inputs include gross revenue, COGS, and operator tier. Useful for both new operators modeling startup scenarios and active operators sanity-checking quarterly projections.</p>
        <a href="/maine-cannabis-tax-calculator" class="resource-link">Open the calculator →</a>
      </div>
      <div class="resource-card">
        <h3>Maine Cannabis Market Pulse 2026</h3>
        <p>Snapshots of the Maine licensed dispensary market across municipal opt-in levels, license-type mix, and accessibility. Used by operators evaluating new markets, investors screening regional opportunities, and journalists citing primary-source numbers.</p>
        <a href="/market-pulse-2026" class="resource-link">View the Market Pulse →</a>
      </div>
    </div>
  </section>

  <style is:global>
    .downloadable-resources {
      max-width: var(--max-width);
      margin: 4rem auto;
      padding: 0 1.5rem;
    }
    .downloadable-resources h2 {
      font-family: var(--font-serif);
      font-size: 2rem;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      text-align: center;
    }
    .resource-intro {
      text-align: center;
      color: var(--color-text-light);
      margin-bottom: 2rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    .resource-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }
    .resource-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 1.5rem;
      padding: 1.5rem;
    }
    .resource-card h3 {
      font-family: var(--font-serif);
      font-size: 1.125rem;
      color: var(--color-text);
      margin: 0 0 0.5rem;
    }
    .resource-card p {
      font-size: 0.9375rem;
      color: var(--color-text-light);
      line-height: 1.6;
      margin-bottom: 1rem;
    }
    .resource-link {
      color: var(--color-text);
      font-weight: 600;
      text-decoration: none;
    }
    .resource-link:hover {
      text-decoration: underline;
    }
  </style>

  <style is:global>
    #page-theatre-wrapper { position: relative; width: 100%; }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    .theatre-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(10px);
      z-index: 8000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    #page-theatre-wrapper.is-active .theatre-overlay {
      opacity: 1;
      pointer-events: auto;
    }

    .referral-box {
      background: var(--color-surface);
      padding: 3rem;
      border-radius: 2rem;
      border: 2px solid var(--color-primary);
      position: sticky;
      top: 120px;
      z-index: 100;
      transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    #page-theatre-wrapper.is-active .referral-box {
      position: fixed !important;
      top: 50% !important;
      left: 50% !important;
      transform: translate(-50%, -50%) scale(1.1) !important;
      z-index: 9000 !important;
      width: 90% !important;
      max-width: 500px !important;
      box-shadow: 0 50px 100px rgba(0,0,0,0.6) !important;
    }

    .btn-theatre-trigger {
      margin-top: 1.5rem;
      background: var(--color-background);
      color: var(--color-text);
      border: none;
      padding: 1rem;
      border-radius: 1rem;
      font-weight: 800;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s;
    }

    .btn-theatre-trigger:hover { background: var(--color-primary); color: var(--color-on-primary); }

    .btn-close-theatre {
      position: absolute;
      top: 1rem;
      right: 1.5rem;
      background: none;
      border: none;
      font-size: 2.5rem;
      cursor: pointer;
      display: none;
      color: var(--color-text-light);
      line-height: 1;
    }

    #page-theatre-wrapper.is-active .btn-close-theatre { display: block; }

    .directory-container { display: grid; grid-template-columns: 1fr 350px; gap: 4rem; margin-bottom: 6rem; }
    .category-block { margin-bottom: 4rem; }
    .vendor-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
    .vendor-card { background: var(--color-surface); padding: 2rem; border-radius: 1.5rem; border: 1px solid var(--color-border); }
    .referral-form { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem; }
    .referral-form input, .referral-form select, .referral-form textarea { padding: 1rem; border-radius: 1rem; border: 1px solid var(--color-border); font-family: inherit; }
    
    @media (max-width: 1000px) {
      .directory-container { grid-template-columns: 1fr; }
      .referral-sidebar { order: -1; }
    }

    [data-theme="dark"] .vendor-card {
      background: var(--color-surface);
    }

    [data-theme="dark"] .referral-box {
      background: var(--color-surface);
    }
</style>

  <LeadFormTracker formSelector=".referral-form" formName="referral_request" />
</Layout>
