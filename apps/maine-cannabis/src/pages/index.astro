<style is:global>
  /* Global dark-mode card surface overrides.
     Loaded as is:global because Astro's per-component CSS scoping rewrites
     `[data-theme="dark"] .hub-card` to
     `[data-astro-cid-XXX][data-theme=dark] .hub-card[data-astro-cid-XXX]`,
     which fails to match — the card's ancestor html carries data-theme but
     NOT the data-astro-cid attribute, so the rewritten selector never
     matches any element and the cascade falls back to the light-mode base
     rule. Using `html[data-theme="dark"]` at global scope works because
     html really does carry data-theme.

     Same global-is:global pattern as theme-2026.css. */
  html[data-theme="dark"] .hub-card,
  html[data-theme="dark"] .new-card,
  html[data-theme="dark"] .journey-step,
  html[data-theme="dark"] .resource-link {
    background: rgba(10, 40, 41, 0.85);
    border-color: rgba(61, 159, 151, 0.4);
  }
  html[data-theme="dark"] .hub-card:hover,
  html[data-theme="dark"] .journey-step:hover,
  html[data-theme="dark"] .resource-link:hover {
    background: rgba(10, 40, 41, 0.95);
    border-color: rgba(61, 159, 151, 0.6);
  }
  html[data-theme="dark"] .market-intel {
    background: var(--color-surface);
    border-color: var(--color-border);
  }
  html[data-theme="dark"] .mission-lead {
    color: var(--color-text);
  }
  html[data-theme="dark"] .ops-topics .topic-tag {
    background: var(--color-surface);
  }
  html[data-theme="dark"] .ops-closing {
    border-color: var(--color-border);
  }
  /* Old per-mode !important overrides for hero-manifesto buttons removed
     2026-07-13: the bone-chip + dark-spruce text pattern now uses
     scoped rules (html .hero-manifesto .btn-primary etc.) at the
     source, not !important at the bottom of the file. */
  /* Full-page aurora: pinned to viewport, behind all content, with the
     component-rendered blobs slowly drifting. pointer-events: none so it
     never intercepts clicks; z-index: -1 so it sits behind everything. */
  html .mdg-page-aurora {
    position: fixed !important;
    inset: 0 !important;
    height: 100vh !important;
    z-index: -1 !important;
    pointer-events: none !important;
  }

  /* Sprint 81 (2026-07-11) PSI mobile round 3: defer the AnimatedBackdrop
     paint until after LCP. The backdrop contains 6 animated blurred blobs
     (filter: blur(40px)) + 56 fireflies (box-shadow blur) — each pinned as
     a permanent GPU layer via will-change. With both the page-wide subtle
     aurora AND the hero backdrop active on first paint, the compositor is
     committing ~60 layers before the LCP element can render — which is
     most of the 2,400ms "element render delay" in the PSI report.

     visibility:hidden (not display:none) keeps the layer allocation but
     skips paint + compositing. After requestIdleCallback fires (handled in
     the inline script at the bottom of this page), the html element gets
     .decorations-loaded and the backdrops fade in over 400ms — visible to
     the user within ~500ms of first paint, after LCP has already landed.

     The fade-in opacity transition replaces the hard cut; without it the
     backdrops pop in abruptly. Reduced-motion users skip the transition
     via prefers-reduced-motion below. */
  .mdg-anim-backdrop {
    visibility: hidden;
    opacity: 0;
    transition: opacity 400ms ease-out;
  }
  html.decorations-loaded .mdg-anim-backdrop {
    visibility: visible;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .mdg-anim-backdrop, html.decorations-loaded .mdg-anim-backdrop {
      transition: none;
    }
  }
</style>

