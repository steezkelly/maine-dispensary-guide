---
import Layout from '../layouts/Layout.astro';
import PineTree from '@network/ui/PineTree';
import Leaf from '@network/ui/Leaf';
import AnimatedBackdrop from '@network/ui/AnimatedBackdrop';
import Faq from '../components/Faq.astro';
import Callout from '../components/Callout.astro';
import LeadFormTracker from '../components/LeadFormTracker.astro';
import SiteHealthStrip from '../components/SiteHealthStrip.astro';
import siteConfig from '../data/site-config.json';
import authors from '../data/authors.json';
import { getSiteStats } from '../lib/site-stats';
import { getPageStats } from '../lib/page-stats';
const siteStats = getSiteStats();

// Editorial-transparency numbers for the SiteHealthStrip — computed once from
// the source tree (same helper /site-health uses) so the homepage strip and
// the full dashboard never drift.
const pageStats = getPageStats();
const siteHealthStats = {
  totalPages: pageStats.totalPages,
  contentPages: pageStats.contentPages,
  totalWords: pageStats.totalWords,
  heroImages: pageStats.heroImages,
  bylineAuthors: authors.length,
  avgWordsPerPage: pageStats.totalWords / Math.max(pageStats.contentPages, 1),
};

const homepageFaqs = [
  { question: "How long does it take to get a Maine cannabis dispensary license?", answer: "Plan for 5-7 months under normal processing conditions. Municipal endorsement alone takes 6-12 weeks. OCP requests for additional information can add another 4-8 weeks. See the full licensing guide: /guides/maine-dispensary-license/" },
  { question: "How much does it cost to open a Maine dispensary?", answer: "Most Maine dispensaries need $360K-$1M to open. This includes licensing fees ($3,000-$10,000), buildout ($150K-$500K), initial inventory ($50K-$100K), and working capital ($50K-$100K). See detailed breakdown: /guides/maine-dispensary-costs/" },
  { question: "Which Maine towns allow cannabis dispensaries?", answer: `As of mid-2026, ${siteStats.activeAdultUseMunicipalities} Maine cities and towns host at least one active OCP-licensed adult-use dispensary, and we publish consumer guides for all of them plus surrounding catchment markets — 109 city guides total. See the full opt-in list: /guides/maine-cannabis-opt-in-tracker/ and browse all guides: /guides/` },
  { question: "What are the school buffer requirements for Maine dispensaries?", answer: "The state default is 1,000 feet, measured property line to property line. However, municipalities may reduce this to 500 feet through local ordinance. Portland and Bangor have adopted the 500 ft buffer. Check your specific municipality: /guides/maine-cannabis-school-buffer/" },
  { question: "How many city guides does Maine Dispensary Guide have?", answer: "We publish 109 city guides covering every active OCP-licensed retail market in Maine, from Portland and Bangor down to single-storefront towns like Solon and Stratton. Each guide lists every licensed storefront, addresses, 2026 pricing, and tax info. Browse the full index: /guides/" },
  { question: "Do I need a medical card to buy cannabis in Maine?", answer: "No. Any adult 21+ with a valid government-issued photo ID can buy recreational (adult-use) cannabis at any Maine dispensary. Medical patients get a 10% excise-tax discount, access to higher-dose products, and a few other perks — see the Maine taxes guide: /guides/maine-cannabis-taxes-2026/" }
];
const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.siteName,
  "url": siteConfig.siteUrl,
  "description": "Your complete guide to opening and operating a cannabis dispensary in Maine.",
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.siteName,
    "url": siteConfig.siteUrl,
    "sameAs": siteConfig.socialLinks
  }
});
const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
});

const stats = [
  { label: "Annual Sales", value: siteStats.totalMarketValueAdultUse },
  { label: "Active Stores", value: String(siteStats.activeAdultUseRetailStores) },
  { label: "Price/Gram", value: "$6.62" }
];

const cityLinks = [
  { name: "Portland", href: "/guides/portland-dispensary-guide" },
  { name: "Lewiston", href: "/guides/lewiston-dispensary-guide" },
  { name: "Bangor", href: "/guides/bangor-dispensary-guide" },
  { name: "Augusta", href: "/guides/augusta-dispensary-guide" },
  { name: "South Portland", href: "/guides/south-portland-dispensary-guide" },
  { name: "Biddeford", href: "/guides/biddeford-dispensary-guide" },
  { name: "Auburn", href: "/guides/auburn-dispensary-guide" },
];

const recentGuides = [
  { title: "Maine Cannabis Market Stats 2026", href: "/market-stats", date: "July 9, 2026", badge: "Updated" },
  { title: "ROI Calculator: Maine + National Benchmarks", href: "/roi-calculator", date: "July 9, 2026", badge: "New" },
  { title: "Maine Cannabis Market Pulse 2026", href: "/market-pulse-2026", date: "July 7, 2026", badge: "Updated" },
  { title: "2026 Startup Costs Breakdown", href: "/guides/maine-dispensary-costs", date: "July 6, 2026", badge: "Updated" },
  { title: "Maine Cannabis Market Overview", href: "/guides/maine-cannabis-market", date: "June 7, 2026", badge: "Updated" },
];

// Recent blog posts — newest first by actual modifiedDate (July 2026 batch).
// Linked from the homepage to give these posts >1 incoming internal link.
// Includes the 2026-07-08 editorial refresh (Acadia federal-land + Maine travel
// guide), the 2026-07-06 buyer/operator pair (dispensary-for-sale + ROI), and a
// mix of 2026-06 consumer/operator guides.
const recentPosts = [
  { title: "Recreational Cannabis Near Acadia: 2026 Federal Land & Gateway Guide", href: "/blog/recreational-cannabis-near-acadia", date: "July 8, 2026", badge: "Consumer" },
  { title: "Cannabis-Friendly Maine: 2026 Travel Guide for the 420-Curious", href: "/blog/cannabis-friendly-maine-travel", date: "July 8, 2026", badge: "Travel" },
  { title: "Maine Dispensary for Sale: How to Find, Buy, and Close a Cannabis Business (2026)", href: "/blog/maine-dispensary-business-for-sale", date: "July 6, 2026", badge: "Operator" },
  { title: "Maine Dispensary ROI: 2026 Investment Expectations", href: "/blog/maine-dispensary-roi-what-to-expect-2026", date: "July 6, 2026", badge: "Finance" },
  { title: "Maine's Cannabis 'Gray Market' Is Growing Because the Regulators Can't Keep Up", href: "/blog/maine-cannabis-gray-market-ocp-enforcement-2026", date: "June 6, 2026", badge: "Policy" },
  { title: "Maine Issues First-Ever Medical Cannabis Patient Advisory After Unsafe Pesticide Levels Found in Concentrates", href: "/blog/maine-medical-cannabis-pesticide-advisory-2026", date: "June 7, 2026", badge: "Medical" },
  { title: "How to Get a Budtender Job in Maine: 2026 Career Guide", href: "/blog/maine-cannabis-budtender-careers", date: "June 5, 2026", badge: "Careers" },
  { title: "Maine Psilocybin Legality 2026 — Decriminalization Status & What Operators Must Know", href: "/blog/maine-psilocybin-2026-guide", date: "June 7, 2026", badge: "Policy" },
];


const tourSlides = [
  {
    title: "Find every Maine dispensary market",
    href: "/guides",
    eyebrow: "City guide index",
    description: `Browse ${siteStats.activeAdultUseRetailStores} active adult-use storefronts across ${siteStats.activeAdultUseMunicipalities} Maine municipalities, with local pricing, tax, and operator notes.`
  },
  {
    title: "Run startup numbers",
    href: "/roi-calculator",
    eyebrow: "ROI calculator",
    description: "Model startup capital, monthly customers, operating expenses, and payback timing before signing a lease or filing with OCP."
  },
  {
    title: "Track market stats",
    href: "/market-stats",
    eyebrow: "Market dashboard",
    description: `Follow Maine's ${siteStats.totalMarketValueAdultUse} adult-use market with live-style benchmarks for sales, stores, and price compression.`
  },
  {
    title: "Check opt-in towns",
    href: "/guides/maine-cannabis-opt-in-tracker",
    eyebrow: "Municipal tracker",
    description: "Confirm which towns allow adult-use cannabis, which remain medical-only, and where local ordinance review should start."
  },
  {
    title: "Plan licensing",
    href: "/guides/maine-dispensary-license",
    eyebrow: "License roadmap",
    description: "Sequence OCP application steps, municipal endorsement, background checks, fees, and inspection milestones without missing a gate."
  },
];

const journeySteps = [
  { num: "01", title: "Get the Launch Checklist", desc: "Download the step-by-step checklist used by Portland and Bangor applicants — covers OCP forms, municipal filings, and lease contingencies.", href: "/launch-checklist" },
  { num: "02", title: "Understand Licensing", desc: `Maine requires OCP Adult-Use Retail License + town opt-in. Lewiston, Augusta, and ${siteStats.activeAdultUseMunicipalities - 2} other opt-in towns have different timelines — know yours.`, href: "/guides/maine-dispensary-license" },
  { num: "03", title: "Run the Numbers", desc: `Most Maine dispensaries need $360K–$1M to open. Model your startup costs against the state's ${siteStats.totalMarketValueAdultUse} adult-use market.`, href: "/roi-calculator" },
  { num: "04", title: "Find Your Location", desc: "Zoning rules, 500-ft school buffers, commercial lease negotiation in Portland, Bangor, or a smaller opt-in town like Waterville.", href: "/guides/maine-cannabis-real-estate" },
];
---

<Layout
  title="How to Open a Maine Dispensary in 2026 — Step-by-Step Guide"
  description="Everything you need to open a Maine cannabis dispensary: licensing timeline, startup costs ($360K–$1M), location zoning, and OCP application steps. Start here."
  heroImage="/images/heroes/maine-cannabis-granite-hero.jpg"
  article={{ author: "Eliot Nash", authorTitle: "Editorial", authorId: "eliot-nash", publishDate: "2026-01-01", modifiedDate: "2026-06-07", section: "Home" }}
  isHub={true}
>
  <!-- Full-page aurora wash — pinned to the viewport so the slow drift
       stays visible while scrolling. Sits behind all content (z-index: -1)
       and uses low intensity (0.18) so it tints the page background
       without competing with the hero's stronger aurora. Steve's
       "should be lightly overlaid the whole background" ask. -->
  <AnimatedBackdrop variant="subtle" intensity={0.18} class="mdg-page-aurora" />

  <style>

  /* ─────────────────────────────────────────────────────────────────
     HERITAGE AUTHORITY — CSS Custom Properties
  ───────────────────────────────────────────────────────────────── */
  :root {
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 2rem;
    --space-lg: 4rem;
    --space-xl: 6rem;
    --space-2xl: 8rem;

    --text-xs: 0.75rem;
    --text-sm: 0.875rem;
    --text-base: 1rem;
    --text-lg: 1.125rem;
    --text-xl: 1.25rem;
    --text-2xl: 1.5rem;
    --text-3xl: 2rem;
    --text-4xl: 2.75rem;
    --text-5xl: 3.5rem;

    --ease-out: cubic-bezier(0.2, 1, 0.2, 1);
    --ease-spring: cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* ─────────────────────────────────────────────────────────────────
     SECTION EYEBROW — Shared label style
  ───────────────────────────────────────────────────────────────── */
  .section-eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  /* ─────────────────────────────────────────────────────────────────
     HERO SECTION — Manifesto Style
  ───────────────────────────────────────────────────────────────── */
  .hero-manifesto {
    position: relative;
    background:
      radial-gradient(
        ellipse 80% 50% at 20% 80%,
        rgba(88, 129, 87, 0.18) 0%,
        transparent 50%
      ),
      radial-gradient(
        ellipse 60% 40% at 80% 20%,
        rgba(13, 78, 80, 0.25) 0%,
        transparent 50%
      ),
      linear-gradient(
        180deg,
        var(--color-primary) 0%,
        var(--color-primary-dark) 100%
      );
    color: var(--color-background);
    padding: var(--space-xl) 0 var(--space-lg);
    margin-bottom: var(--space-lg);
    overflow: hidden;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
  }

  .topo-bg {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    pointer-events: none;
  }

  .topo-bg svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-lg);
    align-items: center;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .edition-mark {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: var(--space-md);
  }

  .edition-divider {
    font-size: 0.4rem;
    color: var(--color-accent);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-4xl), 6vw, var(--text-5xl));
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-background);
    margin-bottom: var(--space-md);
  }

  .hero-title-accent {
    font-style: italic;
    color: var(--color-soft-green);
  }

  .hero-descriptor {
    font-size: var(--text-lg);
    line-height: 1.7;
    opacity: 0.9;
    max-width: 520px;
    margin-bottom: var(--space-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Hero CTA buttons — bone chip with dark-spruce text in BOTH modes.
     This is intentional contrast inversion: the hero gradient flips from
     dark-green in light mode to bright sage in dark mode, so a chip
     that contrasts with BOTH backgrounds is needed. Bone (var(--color-background))
     works in light (against dark hero) and in dark (against pale hero) with
     dark-spruce text holding the contrast. The dark-spruce literal is used
     directly because Astro's CSS pipeline strips per-component custom
     property declarations from scoped blocks. */
  html .hero-manifesto .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--color-background);
    color: #0E1A14;
    padding: 1rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  html .hero-manifesto .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  html .hero-manifesto .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    color: #0E1A14;
    background: var(--color-background);
    padding: 1rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  html .hero-manifesto .btn-ghost:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    background: #FFFFFF;
  }

  html .hero-manifesto .hero-secondary-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #F4F1E4;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: rgba(244, 241, 228, 0.5);
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  html .hero-manifesto .hero-secondary-cta:hover {
    color: #FFFFFF;
    text-decoration-color: #FFFFFF;
  }

  /* Dark mode: hero gradient flips to pale sage. The bone secondary-cta
     becomes invisible against pale green, so swap to dark-spruce with
     dark-spruce underline. The html[data-theme=dark] prefix wins over
     the lighter rule above. */
  html[data-theme="dark"] .hero-manifesto .hero-secondary-cta {
    color: #0E1A14;
    text-decoration-color: rgba(14, 26, 20, 0.5);
  }
  html[data-theme="dark"] .hero-manifesto .hero-secondary-cta:hover {
    color: #000000;
    text-decoration-color: #000000;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .visual-anchor {
    position: relative;
    width: 320px;
    height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .anchor-ring {
    position: absolute;
    border: 1px solid var(--color-background);
    border-radius: 50%;
    opacity: 0.1;
  }

  .ring-1 { width: 100%; height: 100%; }
  .ring-2 { width: 75%; height: 75%; animation: rotate 20s linear infinite; }
  .ring-3 { width: 50%; height: 50%; animation: rotate 15s linear infinite reverse; }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-2, .ring-3 { animation: none; }
  }

  .botanical-cluster {
    position: relative;
    z-index: 1;
  }

  .cluster-pine {
    filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1));
  }

  .cluster-leaf {
    position: absolute;
  }

  .cluster-leaf-1 {
    top: -20px;
    right: -40px;
    transform: rotate(25deg);
  }

  .cluster-leaf-2 {
    bottom: 20px;
    left: -50px;
    transform: rotate(-35deg);
  }

  /* Live data panel — replaces the old "MAINE DISPENSARY GUIDE /
     Editorial Resource" caption (which Steve flagged as feeling out of
     place). Anchors to the bottom-right of the visual anchor so the
     rings + pine/leaf logo stays the primary visual focus, while the
     panel adds real editorial transparency: live stats from the OCP
     roster (same numbers as the rest of the site) and a sparkline of
     opt-in town growth. */
  .live-panel {
    position: absolute;
    right: -40px;
    bottom: -60px;
    width: 240px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.1rem 0.9rem;
    box-shadow: var(--elev-2-shadow);
    text-align: left;
    font-size: var(--text-xs);
    z-index: 4;
  }
  .live-panel-eyebrow {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-light);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .live-panel-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 1rem;
    margin-bottom: 0.7rem;
  }
  .live-panel-stat-num {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }
  .live-panel-stat-label {
    display: block;
    color: var(--color-text-light);
    font-size: 0.7rem;
    margin-top: 0.2rem;
  }
  .live-panel-spark {
    display: block;
    width: 100%;
    height: 38px;
    color: var(--color-accent);
  }
  .live-panel-spark .area {
    fill: color-mix(in oklab, var(--color-accent) 24%, transparent);
  }
  .live-panel-spark .line {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    fill: none;
  }
  .live-panel-spark .dot {
    fill: var(--color-primary);
  }
  .live-panel-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    color: var(--color-text-light);
    font-size: 0.65rem;
  }
  .live-panel-foot a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }
  .live-panel-foot a:hover {
    color: var(--color-text);
  }
  @media (max-width: 1100px) {
    .live-panel { width: 200px; right: 0; }
  }
  @media (max-width: 880px) {
    .live-panel { right: 20px; bottom: -50px; }
  }

  .hero-flourish {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .hero-flourish svg {
    width: 100%;
    height: 40px;
  }

  /* =============================================================
     TOUR CAROUSEL — static-first homepage resource tour
     Theme-pinned dark panel (same in both modes) so the section reads
     as an editorial break. Without the pin, --color-primary-dark
     flips from #143027 (light) to #DDE9C8 (dark) and the cream text
     becomes invisible. */
  .tour-carousel {
    background: var(--color-secondary);
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
  }
  .tour-carousel-frame {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
    min-height: clamp(360px, 46vw, 620px);
    background:
      radial-gradient(circle at 18% 20%, rgba(95, 126, 80, 0.42), transparent 28%),
      radial-gradient(circle at 82% 18%, rgba(244, 241, 228, 0.12), transparent 24%),
      linear-gradient(135deg, var(--color-secondary) 0%, var(--color-primary-dark, #143027) 56%, var(--color-secondary) 100%);
    overflow: hidden;
  }
  .tour-slides {
    display: flex;
    min-height: inherit;
    transform: translateX(calc(var(--tour-index, 0) * -100%));
    transition: transform 520ms var(--ease-out);
  }
  .tour-slide {
    position: relative;
    flex: 0 0 100%;
    min-height: inherit;
    display: grid;
    align-items: end;
    padding: clamp(2rem, 5vw, 5rem);
    color: var(--color-on-secondary);
  }
  .tour-slide::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(14, 26, 20, 0.86) 100%);
    pointer-events: none;
  }
  .tour-slide-content {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }
  .tour-slide-label {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-family: var(--font-serif, 'Fraunces', serif);
    font-size: 0.95rem;
    font-style: italic;
    letter-spacing: 0.04em;
    opacity: 0.9;
  }
  .tour-slide h2 {
    margin: 0 0 0.75rem;
    color: inherit;
    font-size: clamp(2rem, 5vw, 4.25rem);
    line-height: 0.96;
  }
  .tour-slide p {
    max-width: 620px;
    margin: 0 0 1.5rem;
    color: var(--color-on-secondary);
    opacity: 0.92;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.7;
  }
  .tour-slide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--color-background);
    color: var(--color-cream-ink);
    text-decoration: none;
    border-radius: 0.5rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .tour-slide-cta:hover,
  .tour-slide-cta:focus-visible {
    background: var(--color-on-primary-dark);
    color: var(--color-secondary);
    transform: translateY(-1px);
  }
  .tour-controls {
    position: absolute;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .tour-control {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-on-secondary);
    border-radius: 999px;
    background: rgba(14, 26, 20, 0.5);
    color: var(--color-on-secondary);
    cursor: pointer;
    font: inherit;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .tour-control:hover,
  .tour-control:focus-visible {
    background: var(--color-on-secondary);
    color: var(--color-secondary);
    border-color: var(--color-on-secondary);
  }
  .tour-dots {
    position: absolute;
    left: clamp(2rem, 5vw, 5rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 2;
    display: flex;
    gap: 0.6rem;
  }
  .tour-dot {
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--color-on-secondary);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    padding: 0;
    opacity: 0.55;
  }
  .tour-dot[aria-current="true"] {
    background: var(--color-on-secondary);
    border-color: var(--color-on-secondary);
    opacity: 1;
  }
  @media (max-width: 720px) {
    .tour-slide { padding: 2rem 1.25rem 5.5rem; }
    .tour-dots { left: 1.25rem; }
    .tour-controls { right: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tour-slides,
    .tour-slide-cta,
    .tour-control {
      transition: none;
    }
  }

  /* ─────────────────────────────────────────────────────────────────
     MARKET INTEL — Stats Strip
  ───────────────────────────────────────────────────────────────── */
  .market-intel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-xl);
    overflow: hidden;
  }

  .intel-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
  }

  .intel-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .intel-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .intel-stat .stat-value {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .intel-stat .stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
  }

  .stat-separator {
    color: var(--color-border);
    font-size: var(--text-lg);
  }

  .intel-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s var(--ease-out);
  }

  .intel-link:hover {
    gap: var(--space-sm);
  }

  /* ─────────────────────────────────────────────────────────────────
     MISSION MANIFESTO — Editorial Layout
  ───────────────────────────────────────────────────────────────── */
  .mission-manifesto {
    position: relative;
    padding: var(--space-2xl) 0;
    margin-bottom: var(--space-2xl);
    overflow: hidden;
  }

  .mission-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    position: relative;
    z-index: 1;
  }

  .mission-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .mission-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    color: var(--color-text);
    margin: 0;
  }

  .mission-title::before {
    display: none;
  }

  .mission-text {
    max-width: 700px;
    margin: 0 auto;
  }

  .mission-lead {
    font-size: var(--text-xl);
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .mission-body {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .mission-body p {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-light);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    transition: gap 0.2s var(--ease-out);
  }

  .read-more:hover {
    gap: var(--space-sm);
  }

  .mission-botanical {
    position: absolute;
    right: -50px;
    top: 50%;
    transform: translateY(-50%);
    width: 200px;
    height: 400px;
    pointer-events: none;
    opacity: 0.5;
  }

  /* ─────────────────────────────────────────────────────────────────
     MARKET OVERVIEW — Asymmetric Grid
  ───────────────────────────────────────────────────────────────── */
  .market-overview {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: var(--space-xl) var(--space-lg);
    margin-bottom: var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .market-overview::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  }

  .overview-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .overview-header {
    margin-bottom: var(--space-lg);
  }

  .overview-header h2 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    margin: 0;
  }

  .overview-header h2::before {
    display: none;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .overview-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .overview-main p {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-light);
  }

  .overview-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .aside-card {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .aside-card.highlight {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-background);
  }

  .aside-stat {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
  }

  .aside-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-light);
  }

  .aside-card.highlight .aside-label {
    color: rgba(242,242,226,0.8);
  }

  .aside-note {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-light);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  /* ─────────────────────────────────────────────────────────────────
     OPERATIONS EXCELLENCE — Painterly bg + 3 overlay module cards
  ───────────────────────────────────────────────────────────────── */
  .operations-excellence {
    position: relative;
    padding: var(--space-3xl) 0;
    margin-bottom: var(--space-2xl);
    overflow: hidden;
    isolation: isolate;
  }

  /* Painterly background image — text-free by design (current image
     generators can't render dense text reliably). The image is the
     visual hook; HTML cards overlay it for the data. */
  .ops-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .ops-bg picture,
  .ops-bg img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 20%;
    opacity: 0.55;
  }
  [data-theme="dark"] .ops-bg img {
    opacity: 0.35;
  }
  /* Soft top/bottom gradient so the painterly image fades into the
     section's background color and never reads as a hard rectangle. */
  .ops-bg::before,
  .ops-bg::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 25%;
    pointer-events: none;
  }
  .ops-bg::before {
    top: 0;
    background: linear-gradient(to bottom, var(--color-background, #faf7f2) 5%, transparent 100%);
  }
  .ops-bg::after {
    bottom: 0;
    background: linear-gradient(to top, var(--color-background, #faf7f2) 5%, transparent 100%);
  }
  [data-theme="dark"] .ops-bg::before {
    background: linear-gradient(to bottom, var(--color-background, #0f1411) 5%, transparent 100%);
  }
  [data-theme="dark"] .ops-bg::after {
    background: linear-gradient(to top, var(--color-background, #0f1411) 5%, transparent 100%);
  }

  .ops-inner {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    position: relative;
  }

  .ops-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .ops-eyebrow {
    color: var(--color-text);
  }

  .ops-header h2 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    margin: 0 0 var(--space-md) 0;
  }

  .ops-header h2::before {
    display: none;
  }

  .ops-lede {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-light);
    max-width: 640px;
    margin: 0 auto;
  }

  /* 3 stacked module cards — the data is in HTML, the image is just bg */
  .ops-modules {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .ops-module {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 0.75rem;
    padding: var(--space-lg);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), border-left-color 0.2s var(--ease-out);
  }
  [data-theme="dark"] .ops-module {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
  }
  .ops-module:hover {
    transform: translateX(4px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
    border-left-color: var(--color-accent);
  }
  [data-theme="dark"] .ops-module:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.4);
  }

  .ops-module[data-module="01"] { border-left-color: var(--color-primary); }
  .ops-module[data-module="02"] { border-left-color: var(--color-accent); }
  .ops-module[data-module="03"] { border-left-color: #d4a85f; } /* warm yellow-highlight to match the painterly bg swipes */

  .ops-module-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .mod-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.625rem;
    background: var(--color-primary);
    color: var(--color-background);
    border-radius: 0.375rem;
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
  }
  .ops-module[data-module="02"] .mod-num { background: var(--color-accent); }
  .ops-module[data-module="03"] .mod-num { background: #d4a85f; }

  .mod-head {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    font-family: var(--font-serif);
    color: var(--color-foreground);
    line-height: 1.3;
  }

  .mod-cost {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
  }
  .mod-cost em {
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-light);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.125rem;
  }

  .mod-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin: 0 0 var(--space-md) 0;
  }
  .mod-body a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mod-body a:hover {
    color: var(--color-accent);
  }

  .mod-cta {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s var(--ease-out);
  }
  .mod-cta:hover {
    border-bottom-color: var(--color-primary);
  }

  /* Hero stat callout below the 3 modules — a single large number */
  .ops-footer {
    margin-top: var(--space-2xl);
  }

  .ops-hero-stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    margin-bottom: var(--space-md);
  }
  .ops-hero-stat-num {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }
  .ops-hero-stat-label {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-light);
  }

  .ops-closing {
    font-weight: 500;
    color: var(--color-text) !important;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin: 0 0 var(--space-md) 0;
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .ops-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .topic-tag {
    display: inline-block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s var(--ease-out);
  }
  .topic-tag:hover {
    background: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
  }

  @media (max-width: 720px) {
    .operations-excellence {
      padding: var(--space-2xl) 0;
    }
    .ops-module {
      padding: var(--space-md);
    }
    .ops-module-header {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }
    .mod-cost {
      grid-column: 2;
      align-items: flex-start;
      flex-direction: row;
      gap: 0.375rem;
      align-items: baseline;
    }
    .mod-cost em {
      margin-top: 0;
    }
    .ops-hero-stat {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }
  }

  /* ─────────────────────────────────────────────────────────────────
     CORE HUBS — Editorial Card Grid
  ───────────────────────────────────────────────────────────────── */
  .core-hubs {
    padding: var(--space-2xl) 0;
    margin-bottom: var(--space-2xl);
    background: var(--color-background);
  }

  .hubs-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .hubs-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .hubs-header h2 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    margin: 0;
  }

  .hubs-header h2::before {
    display: none;
  }

  .hubs-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-light);
    margin-top: var(--space-xs);
  }

  .hubs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-md);
  }

  .hub-card {
    position: relative;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(209, 209, 193, 1);
    border-radius: 1rem;
    padding: var(--space-lg) var(--space-md);
    text-decoration: none;
    box-shadow: var(--elev-1-shadow);
    transition: all 0.35s cubic-bezier(0.2, 1, 0.2, 1);
    overflow: hidden;
  }

  .hub-card:hover {
    transform: translateY(-6px);
    border-color: rgba(13, 78, 80, 0.3);
    box-shadow: var(--elev-2-shadow);
    background: rgba(255, 255, 255, 0.98);
  }

  .hub-card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hub-icon {
    margin-bottom: var(--space-sm);
    transition: transform 0.3s var(--ease-spring);
  }

  .hub-icon svg {
    width: 48px;
    height: 48px;
    color: var(--color-accent);
    transition: color 0.2s;
  }

  .hub-card:hover .hub-icon {
    transform: scale(1.05);
  }

  .hub-card:hover .hub-icon svg {
    color: var(--color-text);
  }

  .hub-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text);
    margin: 0 0 var(--space-xs);
  }

  .hub-card p {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .hub-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-sm);
    transition: gap 0.2s var(--ease-out);
  }

  .hub-card:hover .hub-cta {
    gap: 0.5rem;
  }

  .hub-bg {
    position: absolute;
    bottom: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 50% 120%, var(--color-accent) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .hub-card:hover .hub-bg {
    opacity: 0.08;
  }

  [data-theme="dark"] .hub-card:hover .hub-bg {
    opacity: 0.12;
  }

  /* ─────────────────────────────────────────────────────────────────
     GEO EXPLORER — Map + City Chips
  ───────────────────────────────────────────────────────────────── */
  .geo-explorer {
    padding: var(--space-xl) var(--space-md);
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .geo-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .geo-header {
    margin-bottom: var(--space-lg);
  }

  .geo-header h2 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    margin: 0;
  }

  .geo-header h2::before {
    display: none;
  }

  .geo-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-light);
    max-width: 600px;
    margin: var(--space-xs) auto 0;
    line-height: 1.7;
  }

  .geo-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .geo-map {
    width: 100%;
    max-width: 720px;
    opacity: 1;
  }

  .geo-map svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Clickable city markers inside the SVG */
  .geo-city-anchor {
    cursor: pointer;
  }
  .geo-city-anchor circle:first-child {
    transition: r 0.2s var(--ease-out, ease-out), filter 0.2s var(--ease-out, ease-out);
  }
  .geo-city-anchor:hover circle:first-child,
  .geo-city-anchor:focus-visible circle:first-child {
    r: 11;
    filter: drop-shadow(0 0 4px var(--color-accent));
  }
  .geo-city-anchor:focus {
    outline: none;
  }
  .geo-city-anchor text {
    pointer-events: none;
  }

  /* City label + reference-marker label theming for dark mode.
     The SVG <text> elements have inline fill="var(--color-foreground)"
     (city labels) or fill="var(--color-text-light)" (ref labels).
     On dark backgrounds, --color-foreground is light and
     --color-text-light is a faded gray-green that vanishes.
     We add a small text-shadow halo so the labels read on both
     the painterly map fill and on dark backgrounds. */
  .geo-map text {
    paint-order: stroke;
    stroke: var(--color-background, #faf7f2);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  [data-theme="dark"] .geo-map text {
    stroke: var(--color-background, #0f1411);
    stroke-width: 4;
  }
  [data-theme="dark"] .geo-cities-svg text {
    fill: #F4F1E4 !important;
  }
  [data-theme="dark"] .geo-ref text {
    fill: #C8D4C4 !important;
    fill-opacity: 1 !important;
  }

  .geo-cities {
