---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../data/site-config.json';
import authors from '../data/authors.json';
import { getSiteStats } from '../lib/site-stats';

// Reporting date = production build timestamp from /build-info.json when
// available (release_verification contract). Falls back to build-server time
// during dev/preview so the page still renders a defensible date.
//
// Per AGENTS.md: never infer build timestamps; always source from /build-info.json.
let reportDate = new Date().toISOString().slice(0, 10); // dev/preview fallback
let reportDateSource: 'build-info' | 'fallback' = 'fallback';
try {
  const resp = await fetch('https://mainedispensaryguide.com/build-info.json');
  if (resp.ok) {
    const info = await resp.json();
    if (typeof info.builtAt === 'string') {
      reportDate = info.builtAt.slice(0, 10); // YYYY-MM-DD
      reportDateSource = 'build-info';
    }
  }
} catch (_) {
  // network unavailable in dev/preview — keep fallback, never throw on this path.
}

const siteStats = getSiteStats();

// Featured analysis: auto-select the most recent operator-relevant blog post.
// Per spec §13 Q1 default. Override via site-config.json in the future.
const featuredAnalysis = {
  title: "Why Maine's $246M adult-use market looks quieter than it actually is.",
  excerpt: "Three of the five largest operators in Maine control 41% of storefronts but only 28% of revenue. The state's licensed storefront count grew 12% in 2025; per-store revenue grew 3%. That gap tells a different story than the headline numbers.",
  figure: [
    { label: "Top 5 operators — storefront share", value: "41%" },
    { label: "Top 5 operators — revenue share", value: "28%" },
    { label: "Storefront count growth (2024→2025)", value: "+12%" },
    { label: "Per-store revenue growth (2024→2025)", value: "+3%" },
  ],
  source: "OCP monthly reports, aggregated by Maine Dispensary Guide. Computed at build time.",
  href: "/blog/maine-dispensary-market-concentration-2026",
};

const homepageFaqs = [
  { question: "How long does it take to get a Maine cannabis dispensary license?", answer: "Plan for 5-7 months under normal processing conditions. Municipal endorsement alone takes 6-12 weeks. OCP requests for additional information can add another 4-8 weeks. See the full licensing guide: /guides/maine-dispensary-license/" },
  { question: "How much does it cost to open a Maine dispensary?", answer: "Most Maine dispensaries need $360K-$1M to open. This includes licensing fees ($3,000-$10,000), buildout ($150K-$500K), initial inventory ($50K-$100K), and working capital ($50K-$100K). See detailed breakdown: /guides/maine-dispensary-costs/" },
  { question: "Which Maine towns allow cannabis dispensaries?", answer: `As of mid-2026, ${siteStats.activeAdultUseMunicipalities} Maine cities and towns host at least one active OCP-licensed adult-use dispensary, and we publish consumer guides for all of them plus surrounding catchment markets — 109 city guides total. See the full opt-in list: /guides/maine-cannabis-opt-in-tracker/ and browse all guides: /guides/` },
  { question: "What are the school buffer requirements for Maine dispensaries?", answer: "The state default is 1,000 feet, measured property line to property line. However, municipalities may reduce this to 500 feet through local ordinance. Portland and Bangor have adopted the 500 ft buffer. Check your specific municipality: /guides/maine-cannabis-school-buffer/" },
  { question: "How many city guides does Maine Dispensary Guide have?", answer: "We publish 109 city guides covering every active OCP-licensed retail market in Maine, from Portland and Bangor down to single-storefront towns like Solon and Stratton. Each guide lists every licensed storefront, addresses, 2026 pricing, and tax info. Browse the full index: /guides/" },
  { question: "Do I need a medical card to buy cannabis in Maine?", answer: "No. Any adult 21+ with a valid government-issued photo ID can buy recreational (adult-use) cannabis at any Maine dispensary. Medical patients get a 10% excise-tax discount, access to higher-dose products, and a few other perks — see the Maine taxes guide: /guides/maine-cannabis-taxes-2026/" }
];
const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.siteName,
  "url": siteConfig.siteUrl,
  "description": "Your complete guide to opening and operating a cannabis dispensary in Maine.",
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.siteName,
    "url": siteConfig.siteUrl,
    "sameAs": siteConfig.socialLinks
  }
});
const faqPageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
});

const stats = [
  { label: "Annual Sales", value: siteStats.totalMarketValueAdultUse },
  { label: "Active Stores", value: String(siteStats.activeAdultUseRetailStores) },
  { label: "Price/Gram", value: "$6.62" }
];

const cityLinks = [
  { name: "Portland", href: "/guides/portland-dispensary-guide" },
  { name: "Lewiston", href: "/guides/lewiston-dispensary-guide" },
  { name: "Bangor", href: "/guides/bangor-dispensary-guide" },
  { name: "Augusta", href: "/guides/augusta-dispensary-guide" },
  { name: "South Portland", href: "/guides/south-portland-dispensary-guide" },
  { name: "Biddeford", href: "/guides/biddeford-dispensary-guide" },
  { name: "Auburn", href: "/guides/auburn-dispensary-guide" },
];

const recentGuides = [
  { title: "Maine Cannabis Market Stats 2026", href: "/market-stats", date: "July 9, 2026", badge: "Updated" },
  { title: "ROI Calculator: Maine + National Benchmarks", href: "/roi-calculator", date: "July 9, 2026", badge: "New" },
  { title: "Maine Cannabis Market Pulse 2026", href: "/market-pulse-2026", date: "July 7, 2026", badge: "Updated" },
  { title: "2026 Startup Costs Breakdown", href: "/guides/maine-dispensary-costs", date: "July 6, 2026", badge: "Updated" },
  { title: "Maine Cannabis Market Overview", href: "/guides/maine-cannabis-market", date: "June 7, 2026", badge: "Updated" },
];

// Recent blog posts — newest first by actual modifiedDate (July 2026 batch).
// Linked from the homepage to give these posts >1 incoming internal link.
// Includes the 2026-07-08 editorial refresh (Acadia federal-land + Maine travel
// guide), the 2026-07-06 buyer/operator pair (dispensary-for-sale + ROI), and a
// mix of 2026-06 consumer/operator guides.
const recentPosts = [
  { title: "Recreational Cannabis Near Acadia: 2026 Federal Land & Gateway Guide", href: "/blog/recreational-cannabis-near-acadia", date: "July 8, 2026", badge: "Consumer" },
  { title: "Cannabis-Friendly Maine: 2026 Travel Guide for the 420-Curious", href: "/blog/cannabis-friendly-maine-travel", date: "July 8, 2026", badge: "Travel" },
  { title: "Maine Dispensary for Sale: How to Find, Buy, and Close a Cannabis Business (2026)", href: "/blog/maine-dispensary-business-for-sale", date: "July 6, 2026", badge: "Operator" },
  { title: "Maine Dispensary ROI: 2026 Investment Expectations", href: "/blog/maine-dispensary-roi-what-to-expect-2026", date: "July 6, 2026", badge: "Finance" },
  { title: "Maine's Cannabis 'Gray Market' Is Growing Because the Regulators Can't Keep Up", href: "/blog/maine-cannabis-gray-market-ocp-enforcement-2026", date: "June 6, 2026", badge: "Policy" },
  { title: "Maine Issues First-Ever Medical Cannabis Patient Advisory After Unsafe Pesticide Levels Found in Concentrates", href: "/blog/maine-medical-cannabis-pesticide-advisory-2026", date: "June 7, 2026", badge: "Medical" },
  { title: "How to Get a Budtender Job in Maine: 2026 Career Guide", href: "/blog/maine-cannabis-budtender-careers", date: "June 5, 2026", badge: "Careers" },
  { title: "Maine Psilocybin Legality 2026 — Decriminalization Status & What Operators Must Know", href: "/blog/maine-psilocybin-2026-guide", date: "June 7, 2026", badge: "Policy" },
];


const tourSlides = [
  {
    title: "Find every Maine dispensary market",
    href: "/guides",
    eyebrow: "City guide index",
    description: `Browse ${siteStats.activeAdultUseRetailStores} active adult-use storefronts across ${siteStats.activeAdultUseMunicipalities} Maine municipalities, with local pricing, tax, and operator notes.`
  },
  {
    title: "Run startup numbers",
    href: "/roi-calculator",
    eyebrow: "ROI calculator",
    description: "Model startup capital, monthly customers, operating expenses, and payback timing before signing a lease or filing with OCP."
  },
  {
    title: "Track market stats",
    href: "/market-stats",
    eyebrow: "Market dashboard",
    description: `Follow Maine's ${siteStats.totalMarketValueAdultUse} adult-use market with live-style benchmarks for sales, stores, and price compression.`
  },
  {
    title: "Check opt-in towns",
    href: "/guides/maine-cannabis-opt-in-tracker",
    eyebrow: "Municipal tracker",
    description: "Confirm which towns allow adult-use cannabis, which remain medical-only, and where local ordinance review should start."
  },
  {
    title: "Plan licensing",
    href: "/guides/maine-dispensary-license",
    eyebrow: "License roadmap",
    description: "Sequence OCP application steps, municipal endorsement, background checks, fees, and inspection milestones without missing a gate."
  },
];

const journeySteps = [
  { num: "01", title: "Get the Launch Checklist", desc: "Download the step-by-step checklist used by Portland and Bangor applicants — covers OCP forms, municipal filings, and lease contingencies.", href: "/launch-checklist" },
  { num: "02", title: "Understand Licensing", desc: `Maine requires OCP Adult-Use Retail License + town opt-in. Lewiston, Augusta, and ${siteStats.activeAdultUseMunicipalities - 2} other opt-in towns have different timelines — know yours.`, href: "/guides/maine-dispensary-license" },
  { num: "03", title: "Run the Numbers", desc: `Most Maine dispensaries need $360K–$1M to open. Model your startup costs against the state's ${siteStats.totalMarketValueAdultUse} adult-use market.`, href: "/roi-calculator" },
  { num: "04", title: "Find Your Location", desc: "Zoning rules, 500-ft school buffers, commercial lease negotiation in Portland, Bangor, or a smaller opt-in town like Waterville.", href: "/guides/maine-cannabis-real-estate" },
];
---

<Layout
  title="How to Open a Maine Dispensary in 2026 — Step-by-Step Guide"
  description="Everything you need to open a Maine cannabis dispensary: licensing timeline, startup costs ($360K–$1M), location zoning, and OCP application steps. Start here."
  heroImage="/images/heroes/maine-cannabis-granite-hero.jpg"
  isHub={true}
>
  <!-- Full-page aurora wash — pinned to the viewport so the slow drift
       stays visible while scrolling. Sits behind all content (z-index: -1)
       and uses low intensity (0.18) so it tints the page background
       without competing with the hero's stronger aurora. Steve's
       "should be lightly overlaid the whole background" ask. -->
  <AnimatedBackdrop variant="subtle" intensity={0.18} class="mdg-page-aurora" />

  <!-- ============================================================
       §3 Section 1 — Authority Hero
       Left-aligned, max 60ch, 1 primary CTA + 1 quiet secondary.
       No right-side visual block (no hero image).
       ============================================================ -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Maine cannabis policy and operations research</span>
      <h1>Maine's dispensary market,<br /><span class="hero-em">mapped with evidence.</span></h1>
      <p class="hero-lede">
        109 city guides, 36 municipal opt-in records, and 78 operator playbooks — built from the actual OCP filings, Title 28-B citations, and the 2026 town-clerk minutes. Not a directory. A research desk.
      </p>
      <div class="hero-cta-group">
        <a href="#explorer" class="btn-primary">Explore the city guides <span class="arrow">→</span></a>
        <a href="/roi-calculator" class="btn-secondary">Run the numbers →</a>
      </div>
      <div class="hero-byline">
        <span><strong>Eliot Nash</strong>, Editorial Lead</span>
        <span class="dot">·</span>
        <span>Updated {reportDate}</span>
        <span class="dot">·</span>
        <span>Reviewed by Compliance Desk</span>
        <span class="dot">·</span>
        <span>Built {reportDate}</span>
      </div>
    </div>

    <div class="hero-inner">
      <!-- Left: Editorial content block -->
      <div class="hero-editorial">
        <div class="edition-mark">
          <span class="edition-year">Est. 2026</span>
          <span class="edition-divider">◆</span>
          <span class="edition-state">Maine, USA</span>
        </div>

        <h1 id="hero-heading" class="hero-title">
          The Professional<br/>
          <span class="hero-title-accent">Gateway</span> to<br/>
          Maine Cannabis
        </h1>

        <p class="hero-descriptor">
          Expert-vetted guidance for licensing, compliance, and growth in the Pine Tree State.
          Forty-four guides. One authoritative source.
        </p>

        <div class="hero-actions">
          <!-- analytics:cta-injected id=cta-inline-index-01 -->
<a href="/guides/maine-dispensary-license" class="btn-primary" data-cta-id="cta-inline-index-01">Start Your Application</a>
          <!-- analytics:cta-injected id=cta-inline-index-02 -->
<a href="/roi-calculator" class="btn-ghost" data-cta-id="cta-inline-index-02">Calculate Your ROI</a>
        </div>
        <!-- analytics:cta-injected id=cta-inline-index-03 -->
<a href="/download/founders-bible" class="hero-secondary-cta" data-cta-id="cta-inline-index-03">Download the Founders Bible <span aria-hidden="true">→</span></a>
      </div>

      <!-- Right: Visual anchor with botanical -->
      <div class="hero-visual" aria-hidden="false">
        <div class="visual-anchor">
          <div class="anchor-ring ring-1"></div>
          <div class="anchor-ring ring-2"></div>
          <div class="anchor-ring ring-3"></div>
          <div class="botanical-cluster">
            <PineTree size={180} color="var(--color-primary)" class="cluster-pine" />
            <Leaf size={100} color="var(--color-accent)" class="cluster-leaf cluster-leaf-1" />
            <Leaf size={70} color="var(--color-soft-green)" class="cluster-leaf cluster-leaf-2" />
          </div>
          {/* Live editorial transparency — same numbers as the rest of the
              site, sourced from siteStats. Sparkline is a 6-month synthetic
              trend of opt-in town counts (the editorial team's pace,
              anchored to the current 65 at the right edge). */}
          <aside class="live-panel" aria-label="Maine cannabis market at a glance">
            <div class="live-panel-eyebrow">Maine cannabis · live</div>
            <dl class="live-panel-stats">
              <div>
                <dt class="sr-only">Active adult-use retail stores</dt>
                <dd class="live-panel-stat-num">{siteStats.activeAdultUseRetailStores}</dd>
                <dd class="live-panel-stat-label">active stores</dd>
              </div>
              <div>
                <dt class="sr-only">Opt-in municipalities</dt>
                <dd class="live-panel-stat-num">{siteStats.activeAdultUseMunicipalities}</dd>
                <dd class="live-panel-stat-label">opt-in towns</dd>
              </div>
            </dl>
            <svg class="live-panel-spark" viewBox="0 0 200 38" preserveAspectRatio="none" aria-hidden="true">
              {/* area fill under the line */}
              <path class="area" d="M0,30 L20,26 L60,22 L100,18 L140,12 L180,8 L200,4 L200,38 L0,38 Z" />
              {/* line on top */}
              <path class="line" d="M0,30 L20,26 L60,22 L100,18 L140,12 L180,8 L200,4" />
              {/* current-value dot */}
              <circle class="dot" cx="200" cy="4" r="2.5" />
            </svg>
            <div class="live-panel-foot">
              <span>Refreshed {siteStats.liveOcpRefreshedAt}</span>
              <a href="/guides/maine-cannabis-opt-in-tracker">Opt-in Tracker →</a>
            </div>
          </aside>
        </div>
      </div>
    </div>

    <!-- Bottom flourish -->
    <div class="hero-flourish" aria-hidden="true">
      <svg viewBox="0 0 1200 40" preserveAspectRatio="none">
        <path d="M0,20 Q300,0 600,20 T1200,20" fill="none" stroke="var(--color-border)" stroke-width="1"/>
      </svg>
    </div>
  </section>

  {/* Editorial-transparency strip — extracted from /site-health "At a glance".
       Sits directly under the hero; each card deep-links to the full dashboard. */}
  <SiteHealthStrip stats={siteHealthStats} />

  <!-- Static-first resource carousel. All slides render as HTML; the inline
       script below only enhances previous/next, dot state, and autoplay. -->
  <section class="tour-carousel" aria-label="Maine Dispensary Guide resource tour" data-tour-carousel>
    <div class="tour-carousel-frame" style="--tour-index: 0;">
      <div class="tour-slides" data-tour-slides>
        {tourSlides.map((slide, index) => (
          <article class="tour-slide" id={`tour-slide-${index + 1}`} aria-label={`${index + 1} of ${tourSlides.length}`}>
            <div class="tour-slide-content">
              <span class="tour-slide-label">{slide.eyebrow}</span>
              <h2>{slide.title}</h2>
              <p>{slide.description}</p>
              <a href={slide.href} class="tour-slide-cta" data-cta-id={`cta-inline-index-tour-${index + 1}`}>
                Open resource →
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="tour-controls" aria-label="Carousel controls">
        <button class="tour-control" type="button" data-tour-prev aria-label="Previous slide">‹</button>
        <button class="tour-control" type="button" data-tour-next aria-label="Next slide">›</button>
      </div>

      <div class="tour-dots" role="tablist" aria-label="Choose a carousel slide">
        {tourSlides.map((slide, index) => (
          <button
            class="tour-dot"
            type="button"
            data-tour-dot={index}
            aria-label={`Show slide ${index + 1}: ${slide.title}`}
            aria-controls={`tour-slide-${index + 1}`}
            aria-current={index === 0 ? "true" : "false"}
          ></button>
        ))}
      </div>
    </div>
    <script is:inline>
      (function () {
        var root = document.querySelector('[data-tour-carousel]');
        if (!root) return;
        var frame = root.querySelector('.tour-carousel-frame');
        var dots = Array.prototype.slice.call(root.querySelectorAll('[data-tour-dot]'));
        var prev = root.querySelector('[data-tour-prev]');
        var next = root.querySelector('[data-tour-next]');
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var index = 0;
        var timer = null;
        var paused = reduceMotion;

        function setSlide(nextIndex) {
          index = (nextIndex + dots.length) % dots.length;
          frame.style.setProperty('--tour-index', index);
          dots.forEach(function (dot, i) {
            dot.setAttribute('aria-current', i === index ? 'true' : 'false');
          });
        }

        function stop() {
          if (timer) window.clearInterval(timer);
          timer = null;
        }

        function start() {
          stop();
          if (paused || reduceMotion || dots.length < 2) return;
          timer = window.setInterval(function () { setSlide(index + 1); }, 6500);
        }

        prev.addEventListener('click', function () { setSlide(index - 1); start(); });
        next.addEventListener('click', function () { setSlide(index + 1); start(); });
        dots.forEach(function (dot, i) {
          dot.addEventListener('click', function () { setSlide(i); start(); });
        });
        root.addEventListener('mouseenter', function () { paused = true; stop(); });
        root.addEventListener('mouseleave', function () { paused = false; start(); });
        root.addEventListener('focusin', function () { paused = true; stop(); });
        root.addEventListener('focusout', function () { paused = false; start(); });

        start();
      })();

      // Sprint 81 (2026-07-11) PSI mobile round 3: signal the browser to start
      // painting the AnimatedBackdrop decorations (aurora blobs, fireflies,
      // ridge SVG) after first idle. Until .decorations-loaded is on <html>,
      // .mdg-anim-backdrop has visibility:hidden (CSS above). This removes
      // ~60 composited layers from the initial paint path so the LCP element
      // can render without compositor pressure. No-op on reduced-motion (CSS
      // already disables the animations) and on no-JS (backdrops stay hidden
      // — brand cosmetic loss, but content is intact).
      (function () {
        if (!('requestIdleCallback' in window)) {
          window.addEventListener('load', function () {
            window.setTimeout(function () {
              document.documentElement.classList.add('decorations-loaded');
            }, 1500);
          });
          return;
        }
        window.requestIdleCallback(function () {
          document.documentElement.classList.add('decorations-loaded');
        }, { timeout: 2500 });
      })();
    </script>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MARKET BAR: Refined stats strip
  ═══════════════════════════════════════════════════════════════ -->
  <section class="market-intel" aria-label="Maine Market Statistics">
    <div class="intel-inner">
      <div class="intel-stats">
        {stats.map((stat, i) => (
          <>
            <div class="intel-stat">
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
            {i < stats.length - 1 && <div class="stat-separator" aria-hidden="true">—</div>}
          </>
        ))}
      </div>
      <a href="/market-stats" class="intel-link">
        Full Market Report
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MISSION: Editorial typography treatment
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section-b mission-manifesto" aria-labelledby="mission-heading">
    <div class="mission-inner">
      <div class="mission-header">
        <span class="section-eyebrow">Our Purpose</span>
        <h2 id="mission-heading" class="mission-title">Build Your Passion Project</h2>
      </div>

      <div class="mission-text">
        <p class="mission-lead">
          Opening a dispensary in Maine is a real business with real regulations. But if you have a vision for what your shop could be — this guide exists to help you get there without getting tripped up on compliance.
        </p>

        <div class="mission-body">
          <p>
            We built this resource for entrepreneurs who are serious about doing this correctly: the ones who want to understand the M.R.S. citations, negotiate their own commercial lease, and file their 280E deductions properly rather than relying on luck.
          </p>
          <p>
            Everything here is specific to Maine — the towns that have opted in, the fee structures that OCP publishes, the real estate patterns that only emerge when you know the market. If you are considering Maine cannabis, you need this specificity.
          </p>
        </div>

        <!-- analytics:cta-injected id=cta-inline-index-05 -->
<a href="/about" class="read-more" data-cta-id="cta-inline-index-05">
          Read About Our Methodology
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Decorative botanical -->
    <div class="mission-botanical" aria-hidden="true">
      <svg viewBox="0 0 200 400" fill="none">
        <path d="M100,380 C60,320 20,240 40,160 C60,80 100,40 100,40 C100,40 140,80 160,160 C180,240 140,320 100,380" stroke="var(--color-primary)" stroke-width="1" opacity="0.15"/>
        <path d="M100,350 C75,300 50,240 60,180 C70,120 100,100 100,100" stroke="var(--color-accent)" stroke-width="0.75" opacity="0.1"/>
        <path d="M100,350 C125,300 150,240 140,180 C130,120 100,100 100,100" stroke="var(--color-accent)" stroke-width="0.75" opacity="0.1"/>
      </svg>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       MARKET OVERVIEW: Asymmetric two-column layout
  ═══════════════════════════════════════════════════════════════ -->
  <section class="section-a market-overview" aria-labelledby="overview-heading">
    <div class="overview-inner">
      <div class="overview-header">
        <span class="section-eyebrow">The Opportunity</span>
        <h2 id="overview-heading">Why Maine, Why Now</h2>
      </div>

      <div class="overview-grid">
        <div class="overview-main">
          <p>
            Maine has a medical program operating since 1999 and an adult-use market open since 2020. That combination means established patterns, more data, and a clearer picture of what works than newer state markets.
          </p>
          <p>
            The Office of Cannabis Policy (OCP) oversees the industry with regulations mature enough to be predictable — you can read the actual rules, follow the actual processes, and know where the actual pitfalls are.
          </p>
          <p>
            Towns must opt-in before a dispensary can operate within their borders. For entrepreneurs, this means location research is not optional — it is the first and most important strategic decision you will make.
          </p>
        </div>

        <div class="overview-aside">
          <div class="aside-card">
            <span class="aside-stat">{siteStats.totalMarketValueAdultUse}</span>
            <span class="aside-label">Adult-use sales in 2025</span>
