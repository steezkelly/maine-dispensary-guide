---
import Layout from '../layouts/Layout.astro';
import AuthorityHero from '../components/homepage/AuthorityHero.astro';
import EvidenceStrip from '../components/homepage/EvidenceStrip.astro';
import OperatorPathways from '../components/homepage/OperatorPathways.astro';
import SiteTour from '../components/SiteTour.astro';
import FeaturedAnalysis from '../components/homepage/FeaturedAnalysis.astro';
import MunicipalityExplorer from '../components/homepage/MunicipalityExplorer.astro';
import MaineMapReference from '../components/homepage/MaineMapReference.astro';
import LatestIntelligence from '../components/homepage/LatestIntelligence.astro';
import NewsletterInvitation from '../components/homepage/NewsletterInvitation.astro';
import TrustLayer from '../components/homepage/TrustLayer.astro';
import CrossLinkFromGuide from '../components/signal/CrossLinkFromGuide.astro';
import { getSiteStats } from '../lib/site-stats';
import {
  buildLatestIntelligence,
  buildMunicipalityRows,
  selectFeaturedAnalysis,
} from '../lib/homepage-editorial-data';
import municipalAuthorization from '../data/maine-municipal-authorization.json';
import directory from '../data/generated/mdg-data/current/products/dispensary-directory.json';
import blogIndex from '../data/blog-index.json';

const siteStats = getSiteStats();
const currentRoster = siteStats.currentOcpLicenseeRoster;
if (!currentRoster) {
  throw new Error('Homepage evidence requires the current OCP licensee roster.');
}
const evidence = [
  { label: 'Adult-use market', value: siteStats.totalMarketValueAdultUse, source: 'Maine Office of Cannabis Policy annual reporting', href: '/market-stats' },
  { label: 'Licensed stores', value: String(currentRoster.auRetailStores), source: `OCP adult-use establishment roster, ${currentRoster.asOf}`, href: '/guides' },
  { label: 'Host municipalities', value: String(currentRoster.auMunicipalities), source: `OCP adult-use establishment roster, ${currentRoster.asOf}`, href: '/guides/maine-cannabis-opt-in-tracker' },
  { label: 'Published city guides', value: '111', source: 'Maine Dispensary Guide editorial index', href: '/guides' },
];
const pathways = [
  { number: '01', title: 'Understand your local market', description: 'Start with a municipal guide: licensing rules, local conditions, and nearby competition.', href: '/guides', cta: 'Browse municipal guides', ctaId: 'cta-inline-index-09' },
  { number: '02', title: 'Map the regulatory work', description: 'Use the licensing roadmap before committing to a site, a lease, or application timing.', href: '/guides/maine-dispensary-license', cta: 'Read the licensing roadmap', ctaId: 'cta-inline-index-01' },
  { number: '03', title: 'Stress-test the operating model', description: 'Model capital, customer volume, expenses, and payback against Maine-specific assumptions.', href: '/roi-calculator', cta: 'Calculate your ROI', ctaId: 'cta-inline-index-02' },
  { number: '04', title: 'Choose the right research tool', description: 'Compare the existing market, authorization, license-context, local-guide, and operating-model tools by the question they can answer.', href: '/maine-cannabis-tools', cta: 'Browse decision tools', ctaId: 'cta-inline-index-11' },
];
const guideRoutes = Object.keys(import.meta.glob('./guides/*-dispensary-guide.astro'))
  .map((path) => {
    const slug = path.split('/').pop()?.replace(/-dispensary-guide\.astro$/, '') ?? '';
    return {
      name: slug.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' '),
      href: `/guides/${slug}-dispensary-guide`,
    };
  });
const municipalities = buildMunicipalityRows({
  guideRoutes,
  authorization: municipalAuthorization,
  directory,
});
// Featured story: choose from the live blog index; the page owns prose/title
// beyond what the data boundary can derive. `homepageFeaturedPath` pins the
// override so the editorial choice is intentional, not "most recent".
const featuredPost = selectFeaturedAnalysis(blogIndex.items, '/blog/cannabis-friendly-maine-travel');
const featuredStory = {
  title: featuredPost.title,
  href: featuredPost.href,
  date: featuredPost.date,
  image: {
    src: featuredPost.heroImage || '/images/heroes/maine-cannabis-granite-hero.jpg',
    alt: featuredPost.title,
  },
  paragraphs: [
    'Yes — adults 21+ can legally buy cannabis in Maine, and tourists are included. This guide covers purchase limits, where consumption is actually legal, and how to plan lodging, camping, and a fall foliage trip without surprises.',
    'State rules meet local geography: Acadia is federal land, state parks say no, and private-permission lodging takes planning. Everything is cited to the statutes so you can book with confidence.',
  ],
  figure: {
    label: 'Modified',
    value: featuredPost.modifiedDate,
    source: 'MDG editorial desk',
    sourceHref: featuredPost.href,
  },
};
// Latest intelligence: derive from the live blog index, dated-descending,
// capped at 8 entries.
const intelligence = buildLatestIntelligence(blogIndex.items, 8).map((post) => ({
  title: post.title,
  href: post.href,
  date: post.date,
  label: post.section || 'Editorial',
}));
---

<Layout
  title="Maine Cannabis Market Intelligence & Municipal Guides"
  description="Source-led Maine cannabis licensing, market, and municipal guidance for operators, investors, and responsible consumers."
  heroImage="/images/heroes/maine-cannabis-granite-hero.jpg"
  article={{ author: 'Eliot Nash', authorTitle: 'Editorial', authorId: 'eliot-nash', publishDate: '2026-01-01', modifiedDate: '2026-07-18', section: 'Home' }}
  isHub={true}
>
  <div class="homepage-editorial">
    <section id="authority-hero" class="homepage-editorial__section homepage-editorial__section--hero">
      <h1>Maine cannabis intelligence for decisions that need evidence.</h1>
      <AuthorityHero eyebrow="Maine Dispensary Guide" title="Maine cannabis intelligence for decisions that need evidence." lede="Licensing, local market, and operating research organized around the questions operators must answer before they commit capital." primaryCtaId="cta-inline-index-04" secondaryCtaId="cta-inline-index-02" renderTitle={false} sectionId="authority-hero-content" />
    </section>
    <section id="signal-cta" class="homepage-editorial__section">
      <div class="signal-cross-link-wrap">
        <CrossLinkFromGuide slug="portland" city="Portland" nofollow={false} />
        <p class="signal-cross-link-note">MDG Signal is a read-only research workspace drawing from the current MDG-DATA release. Use it to compare municipalities, inspect source evidence, and preview the planned change-alert surface before you commit to a paid tier.</p>
      </div>
    </section>
    <section id="evidence-strip" class="homepage-editorial__section"><EvidenceStrip items={evidence} /></section>
    <section id="operator-pathways" class="homepage-editorial__section"><OperatorPathways pathways={pathways} /></section>
    <section id="site-tour" class="homepage-editorial__section"><SiteTour /></section>
    <section id="featured-analysis" class="homepage-editorial__section"><FeaturedAnalysis story={featuredStory} /></section>
    <section id="municipality-explorer" class="homepage-editorial__section"><MunicipalityExplorer rows={municipalities} /><MaineMapReference /></section>
    <section id="latest-intelligence" class="homepage-editorial__section"><LatestIntelligence items={intelligence} /></section>
    <section id="newsletter-invitation" class="homepage-editorial__section"><NewsletterInvitation submitCtaId="cta-inline-index-10" /></section>
    <section id="trust-layer" class="homepage-editorial__section"><TrustLayer sourceLinks={[{ label: 'Methodology and corrections', href: '/about/corrections' }, { label: 'Editorial review process', href: '/about/editorial-policy' }, { label: 'Meet the editorial team', href: '/about/our-team' }]} /></section>
  </div>
</Layout>

<style>
  .homepage-editorial { overflow: clip; }
  .homepage-editorial__section { padding-inline: clamp(1rem, 4vw, 3rem); }
  .homepage-editorial__section > :global(.editorial-section), .homepage-editorial__section > :global(.maine-map-reference) { max-inline-size: 76rem; margin-inline: auto; }
  .signal-cross-link-wrap > :global(.signal-cross-link) { max-inline-size: 76rem; margin-inline: auto; }
  .signal-cross-link-wrap .signal-cross-link-note {
    max-inline-size: 76rem;
    margin: 10px auto 0;
    color: var(--color-text-muted, #555);
    font-size: 13px;
    line-height: 1.55;
  }
  .homepage-editorial__section--hero > h1 { max-inline-size: 76rem; margin: 0 auto; padding-top: clamp(1.5rem, 4vw, 3rem); font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: 0.96; letter-spacing: -0.04em; }
  .homepage-editorial__section--hero :global(.authority-hero) { padding-top: 0.75rem; }
  @media (max-width: 640px) { .homepage-editorial__section { padding-inline: 1rem; } }
</style>
