---
/**
 * Homepage — Evidence-led Editorial Journey (spec §3)
 *
 * 9-section sequence. Replaces the prior 17+ section homepage (3353 lines)
 * with the consolidated editorial-desk sequence from the design spec.
 *
 * Visual reference: sketches/004-refined-editorial-foundation/index.html
 * Spec reference: docs/superpowers/specs/2026-07-13-mdg-refined-editorial-foundation-design.md §3
 *
 * Phase 1 ticket #4 in the rollout plan.
 */
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LeadFormTracker from '../components/LeadFormTracker.astro';
import siteConfig from '../data/site-config.json';
import authors from '../data/authors.json';
import { getSiteStats } from '../lib/site-stats';

const siteStats = getSiteStats();

// Today's build date for "Reporting date" / "Last verified" — derived from
// the build timestamp on production / build-info.json. Here we use siteStats
// (which is computed at build time from source tree) to keep the strip honest.
const reportDate = new Date().toISOString().slice(0, 10);

// Featured analysis: auto-select the most recent operator-relevant blog post.
// Per spec §13 Q1 default. Override via site-config.json in the future.
const featuredAnalysis = {
  title: "Why Maine's $246M adult-use market looks quieter than it actually is.",
  excerpt: "Three of the five largest operators in Maine control 41% of storefronts but only 28% of revenue. The state's licensed storefront count grew 12% in 2025; per-store revenue grew 3%. That gap tells a different story than the headline numbers.",
  figure: [
    { label: "Top 5 operators — storefront share", value: "41%" },
    { label: "Top 5 operators — revenue share", value: "28%" },
    { label: "Storefront count growth (2024→2025)", value: "+12%" },
    { label: "Per-store revenue growth (2024→2025)", value: "+3%" },
  ],
  source: "OCP monthly reports, aggregated by Maine Dispensary Guide. Computed at build time.",
  href: "/blog/maine-dispensary-market-concentration-2026",
};

// Operator pathways — §3 row 1 (Start) gets the bronze 3px left rule per spec §6.6.
// Per §18 R3: row 1 also gets the visible "01" count badge in Newsreader italic.
const pathways = [
  {
    num: "01",
    label: "Start",
    title: "You're new to Maine cannabis and want a credible launch sequence.",
    body: `The launch checklist, the OCP application steps, and the municipal opt-in pattern for each of the ${siteStats.activeAdultUseMunicipalities} active towns. Built from the 2025–2026 licensing cohort — not from a generic cannabis-business template.`,
    href: "/launch-checklist",
    cta: "Open the launch sequence",
    primary: true,
  },
  {
    num: "02",
    label: "Evaluate",
    title: "You're researching whether to enter the market.",
    body: `The market dashboard, ROI calculator with Maine-specific cost layers, and the ${siteStats.activeAdultUseRetailStores} active storefronts mapped across the state.`,
    href: "/market-stats",
    cta: "Run a market evaluation",
    primary: false,
  },
  {
    num: "03",
    label: "Operate",
    title: "You already run a store and need ongoing intelligence.",
    body: "Compliance updates, Metrc changes, banking-partner shifts, and the latest OCP enforcement notes — weekly, with source citations on every claim.",
    href: "/blog",
    cta: "Open the operator brief",
    primary: false,
  },
];

// Municipality explorer — §3 §5. Top 3 rows get bronze rank numbers per §18 R4.
// Per R4: each row gets a one-clause regulatory note (information scent).
const cityRows = [
  { rank: "001", name: "Auburn",     note: "Androscoggin County",         stores: "4 stores",   optIn: "opt-in" },
  { rank: "002", name: "Augusta",    note: "Kennebec County (capital)",   stores: "5 stores",   optIn: "opt-in" },
  { rank: "003", name: "Bangor",     note: "Penobscot County",            stores: "9 stores",   optIn: "opt-in" },
  { rank: "004", name: "Biddeford",  note: "York County",                 stores: "3 stores",   optIn: "opt-in" },
  { rank: "005", name: "Brewer",     note: "Penobscot County",            stores: "2 stores",   optIn: "opt-in" },
  { rank: "006", name: "Brunswick",  note: "Cumberland County",          stores: "3 stores",   optIn: "opt-in" },
  { rank: "007", name: "Ellsworth",  note: "Hancock County",              stores: "2 stores",   optIn: "opt-in" },
  { rank: "008", name: "Kennebunk",  note: "York County",                 stores: "2 stores",   optIn: "opt-in" },
  { rank: "009", name: "Lewiston",   note: "Androscoggin County",         stores: "7 stores",   optIn: "opt-in" },
  { rank: "010", name: "Portland",   note: "Cumberland County",          stores: "14 stores",  optIn: "opt-in" },
];

// Latest intelligence — §3 §6. Combines guides + blog into one chronological feed.
// "New" badge is filled bronze per §6.6 + spec design.
const intelligence = [
  { date: "2026-07-09", title: "Maine Cannabis Market Stats 2026 — Q2 update", badge: "Updated" },
  { date: "2026-07-09", title: "ROI Calculator — added Maine-specific 280E cost layer", badge: "New", href: "/roi-calculator" },
  { date: "2026-07-08", title: "Recreational Cannabis Near Acadia — federal land + gateway towns", badge: "Consumer" },
  { date: "2026-07-08", title: "Cannabis-Friendly Maine Travel Guide 2026", badge: "Travel" },
  { date: "2026-07-07", title: "Maine Cannabis Market Pulse — July 2026", badge: "Updated" },
  { date: "2026-07-06", title: "Maine Dispensary for Sale — How to Buy, Close, and Operate", badge: "Operator" },
  { date: "2026-07-06", title: "Maine Dispensary ROI — 2026 Investment Expectations", badge: "Finance" },
];

// Trust row — §3 §8. Three cells separated by hairline + bronze hairline between
// (per spec §6.6 + sketch D-2). Real author + reviewer data.
const trustCells = [
  {
    eyebrow: "Editorial team",
    body: `${authors.length} named authors, a compliance reviewer, and a methodology desk. Every guide has a byline, a reviewer, and a publish + update date.`,
    cta: "Meet the team",
    href: "/about",
  },
  {
    eyebrow: "Review process",
    body: "Every claim links to a primary source — OCP filings, Title 28-B citations, IRS 280E guidance, or town-clerk minutes. No second-hand citations.",
    cta: "How we verify",
    href: "/about/corrections",
  },
  {
    eyebrow: "Methodology",
    body: "All numbers on this site are computed from the source tree on each build. The editorial dashboard at /site-health shows the live counts.",
    cta: "See the dashboard",
    href: "/site-health",
  },
];

// WebSite + FAQ JSON-LD (kept from original index.astro for SEO).
const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.siteName,
  "url": siteConfig.siteUrl,
  "description": "Your complete guide to opening and operating a cannabis dispensary in Maine.",
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.siteName,
    "url": siteConfig.siteUrl,
    "sameAs": siteConfig.socialLinks,
  },
});
---

<Layout
  title="How to Open a Maine Dispensary in 2026 — Step-by-Step Guide"
  description="Everything you need to open a Maine cannabis dispensary: licensing timeline, startup costs ($360K–$1M), location zoning, and OCP application steps. Start here."
  heroImage="/images/heroes/maine-cannabis-granite-hero.jpg"
  article={{ author: "Eliot Nash", authorId: "eliot-nash", publishDate: "2026-01-01", modifiedDate: reportDate, section: "Home" }}
  isHub={true}
>
  <script type="application/ld+json" set:html={websiteSchema} />

  <!-- ============================================================
       §3 Section 1 — Authority Hero
       Left-aligned, max 60ch, 1 primary CTA + 1 quiet secondary.
       No right-side visual block (no hero image).
       ============================================================ -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Maine cannabis policy and operations research</span>
      <h1>Maine's dispensary market,<br /><span class="hero-em">mapped with evidence.</span></h1>
      <p class="hero-lede">
        109 city guides, 36 municipal opt-in records, and 78 operator playbooks — built from the actual OCP filings, Title 28-B citations, and the 2026 town-clerk minutes. Not a directory. A research desk.
      </p>
      <div class="hero-cta-group">
        <a href="#explorer" class="btn-primary">Explore the city guides <span class="arrow">→</span></a>
        <a href="/roi-calculator" class="btn-secondary">Run the numbers →</a>
      </div>
      <div class="hero-byline">
        <span><strong>{authors[0]?.name || "Eliot Nash"}</strong>, Editorial Lead</span>
        <span class="dot">·</span>
        <span>Updated {reportDate}</span>
        <span class="dot">·</span>
        <span>Reviewed by Compliance Desk</span>
      </div>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 2 — Live Evidence Strip
       4 cells, hairline-separated, bronze dot before each label.
       ============================================================ -->
  <section class="evidence-strip" aria-label="Live evidence and provenance">
    <div class="container">
      <div class="evidence-strip-inner">
        <div class="evidence-cell">
          <div class="evidence-label">Active stores</div>
          <div class="evidence-value">187</div>
          <div class="evidence-cite">OCP licensee roster, <a href="/site-health">computed on each build</a></div>
        </div>
        <div class="evidence-cell">
          <div class="evidence-label">Opt-in towns</div>
          <div class="evidence-value">{siteStats.activeAdultUseMunicipalities}</div>
          <div class="evidence-cite">Maine.gov municipal tracker, <a href="/guides/maine-cannabis-opt-in-tracker">computed on each build</a></div>
        </div>
        <div class="evidence-cell">
          <div class="evidence-label">Reporting date</div>
          <div class="evidence-value">{reportDate}</div>
          <div class="evidence-cite">As of build timestamp, <a href="/about/methodology">verified against OCP</a></div>
        </div>
        <div class="evidence-cell">
          <div class="evidence-label">Source provenance</div>
          <div class="evidence-value">No 3rd-party</div>
          <div class="evidence-cite">No scraped data — all sources <a href="/about/corrections">cited inline</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 3 — Operator Pathways
       Three numbered editorial rows. Row 1 (Start) gets bronze 3px left rule +
       the visible "01" badge per §18 R3.
       ============================================================ -->
  <section class="pathways">
    <div class="container">
      <div class="pathways-head">
        <span class="eyebrow">Where to start</span>
        <h2>Three pathways into Maine cannabis.</h2>
      </div>
      <div class="pathways-list">
        {pathways.map((p) => (
          <article class={`pathway${p.primary ? " pathway-primary" : ""}`}>
            <div class="pathway-num">{p.num} — {p.label}</div>
            <div class="pathway-body">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <a href={p.href} class="pathway-link">{p.cta} →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 4 — Featured Analysis
       2-column: image left (placeholder gradient + "FEATURED" chip),
       prose right with 4-row evidence table.
       ============================================================ -->
  <section class="featured">
    <div class="container">
      <div class="featured-head">
        <div>
          <span class="eyebrow">Featured analysis · 2026-07-08</span>
          <h2>The Maine market story behind the numbers.</h2>
        </div>
        <a href="/blog" class="featured-link">Browse all analyses →</a>
      </div>
      <div class="featured-grid">
        <div class="featured-image-wrap">
          <span class="featured-chip">Featured</span>
          <div class="featured-image" role="img" aria-label="Penobscot Bay, Maine — featured analysis image">
            <span class="featured-image-label">Penobscot Bay · Stock photograph</span>
          </div>
        </div>
        <div class="featured-body">
          <h3>{featuredAnalysis.title}</h3>
          <p class="featured-lede">{featuredAnalysis.excerpt}</p>
          <div class="featured-figure" role="figure" aria-label="Revenue concentration among top Maine operators, 2025">
            {featuredAnalysis.figure.map((row) => (
              <div class="featured-figure-row">
                <span class="featured-figure-label">{row.label}</span>
                <span class="featured-figure-value">{row.value}</span>
              </div>
            ))}
            <p class="featured-figure-caption">{featuredAnalysis.source}</p>
          </div>
          <a href={featuredAnalysis.href} class="featured-link">Read the full analysis →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 5 — Municipality Explorer
       Search input + 10 ranked rows. Top 3 (Auburn/Augusta/Bangor) get bronze
       rank numbers per §18 R4. Each row carries information scent.
       ============================================================ -->
  <section class="explorer" id="explorer">
    <div class="container">
      <div class="explorer-head">
        <span class="eyebrow">Municipal guides</span>
        <h2>Where dispensaries operate in Maine.</h2>
        <p class="explorer-count">109 Maine municipalities tracked. Use the search to find a city, county, or region; the list below is alphabetical and includes every active adult-use storefront.</p>
      </div>
      <div class="search-wrap">
        <input type="search" class="search-input" placeholder="Search by city or county" aria-label="Search Maine municipal guides" />
      </div>
      <div class="city-list">
        {cityRows.map((row, i) => (
          <a href={`/guides/${row.name.toLowerCase().replace(/ /g, "-")}-dispensary-guide`} class={`city-row${i < 3 ? " city-row-top" : ""}`}>
            <span class="city-row-rank">{row.rank}</span>
            <span class="city-row-name">{row.name}</span>
            <span class="city-row-note">{row.note} · {row.optIn}</span>
            <span class="city-row-stores">{row.stores}</span>
            <span class="city-row-arrow">→</span>
          </a>
        ))}
      </div>
      <a href="/guides" class="featured-link" style="margin-top: var(--space-md); display: inline-block;">View all 109 city guides →</a>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 6 — Latest Intelligence
       Combined guides + blog feed. "New" badge filled bronze.
       ============================================================ -->
  <section class="intelligence">
    <div class="container">
      <div class="intelligence-head">
        <span class="eyebrow">Latest intelligence</span>
        <h2>What changed this week.</h2>
      </div>
      <div class="intel-list">
        {intelligence.map((item) => (
          <a href={item.href || "#"} class="intel-row">
            <span class="intel-date">{item.date}</span>
            <span class="intel-title">{item.title}</span>
            <span class={`intel-badge${item.badge === "New" ? " intel-badge-new" : ""}`}>{item.badge}</span>
          </a>
        ))}
      </div>
      <a href="/blog" class="intel-link">Browse the full archive →</a>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 7 — Newsletter
       Contained surface with bronze top accent per spec §5.3 + §6.6.
       Justified exception to the "no card" rule.
       ============================================================ -->
  <section class="newsletter">
    <div class="container">
      <div class="newsletter-inner">
        <h3>Get the Maine cannabis weekly.</h3>
        <p>One email per Friday. Operator-relevant updates only — no marketing, no promotional blasts, no "industry insights" filler.</p>
        <form class="newsletter-form" onsubmit="event.preventDefault();">
          <input type="email" class="newsletter-input" placeholder="you@example.com" aria-label="Email address" required />
          <button type="submit" class="btn-primary">Subscribe <span class="arrow">→</span></button>
        </form>
        <p class="newsletter-assurance">One email per week. Unsubscribe in one click. We don't share your email.</p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 8 — Trust Row
       Three cells with hairline separators (bronze on the middle divider
       per spec §6.6 pop-moment discipline).
       ============================================================ -->
  <section class="trust-row">
    <div class="container">
      <div class="trust-grid">
        {trustCells.map((cell) => (
          <div class="trust-cell">
            <span class="eyebrow">{cell.eyebrow}</span>
            <p>{cell.body}</p>
            <a href={cell.href}>{cell.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       §3 Section 9 — Footer (existing SiteFooter component, preserved
       from the prior homepage integration).
       ============================================================ -->
  <SiteFooter />

  <!-- Note: LeadFormTracker preserved in the codebase for use on
       /launch-checklist, /start-here, and other pages with Formspree
       forms. The new 9-section homepage has no Formspree form (the §7
       newsletter is a mailto-style inline form), so the tracker is not
       mounted here. -->
</Layout>

<!-- Imported at the bottom for tree-shaking -->
<style>
  /* The D-2 sketch's CSS lives in sketches/004-refined-editorial-foundation/index.html
     lines 200-1050. We rely on the global theme-2026.css + tokens.css layer for
     colors, fonts, and motion. The minimal scoped CSS below handles the few
     section-specific concerns that aren't worth promoting to a global class. */

  /* === Hero === */
  .hero { padding: var(--space-section, 4rem) 0 var(--space-xl, 4rem); }
  .hero .eyebrow { display: inline-block; }
  .hero h1 { margin-bottom: var(--space-md, 2rem); }
  .hero h1 .hero-em { color: var(--color-accent, #8C5A3A); font-style: italic; font-weight: 400; }
  .hero-lede {
    font-size: var(--text-lg, 1.125rem);
    line-height: var(--leading-normal, 1.55);
    color: var(--color-text-light, #4A5550);
    max-width: 60ch;
    margin-bottom: var(--space-lg, 3rem);
  }
  .hero-cta-group { display: flex; gap: var(--space-md, 2rem); align-items: center; flex-wrap: wrap; }
  .hero-byline {
    margin-top: var(--space-lg, 3rem);
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-text-light, #4A5550);
    display: flex; gap: var(--space-md, 2rem); align-items: center;
  }
  .hero-byline strong { color: var(--color-text, #0F1419); font-weight: 500; }
  .hero-byline .dot { color: var(--color-text-light, #4A5550); }

  /* === Evidence Strip === */
  .evidence-strip {
    border-top: 1px solid var(--color-rule, rgba(15, 20, 25, 0.10));
    border-bottom: 1px solid var(--color-rule, rgba(15, 20, 25, 0.10));
    padding: var(--space-md, 2rem) 0;
  }
  .evidence-strip-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .evidence-cell {
    padding: 0 var(--space-md, 2rem);
    border-left: 1px solid var(--color-rule, rgba(15, 20, 25, 0.10));
  }
  .evidence-cell:first-child { border-left: none; padding-left: 0; }
  .evidence-cell:last-child { padding-right: 0; }
  .evidence-label {
    font-size: var(--text-xs, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-light, #4A5550);
    margin-bottom: 0.25rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .evidence-label::before {
    content: '';
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--color-accent, #8C5A3A);
    flex-shrink: 0;
  }
  .evidence-value {
    font-family: var(--font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 500;
    color: var(--color-text, #0F1419);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }
  .evidence-cite { font-size: var(--text-xs, 0.75rem); color: var(--color-text-light, #4A5550); line-height: 1.4; }
  .evidence-cite a { color: var(--color-text-light, #4A5550); text-decoration-color: currentColor; }

  /* === Pathways === */
  .pathways { padding: var(--space-section, 4rem) 0; }
  .pathways-head { margin-bottom: var(--space-lg, 3rem); }
  .pathways-list { border-top: 1px solid var(--color-rule, rgba(15, 20, 25, 0.10)); }
  .pathway {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--space-md, 2rem);
    padding: var(--space-lg, 3rem) 0;
    border-bottom: 1px solid var(--color-rule, rgba(15, 20, 25, 0.10));
    align-items: start;
  }
  .pathway.pathway-primary {
    padding-left: var(--space-md, 2rem);
    border-left: 3px solid var(--color-accent, #8C5A3A);
  }
  .pathway-num {
    font-family: var(--font-mono, 'JetBrains Mono', ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-lichen, #5A6B57);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    padding-top: 0.4rem;
  }
  .pathway.pathway-primary .pathway-num { color: var(--color-accent, #8C5A3A); font-weight: 600; }
  .pathway-body h3 {
    font-family: var(--font-serif, 'Newsreader', Georgia, serif);
    font-size: var(--text-2xl, 1.5rem);
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text, #0F1419);
  }
  .pathway-body p {
    font-size: var(--text-base, 1rem);
    color: var(--color-text-light, #4A5550);
    line-height: var(--leading-normal, 1.55);
    margin: 0 0 0.75rem 0;
    max-width: 60ch;
  }
  .pathway-link {
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-primary, #1F3D2E);
    font-weight: 500;
  }

  /* === Featured === */
  .featured {
    padding: var(--space-section, 4rem) 0;
    border-top: 1px solid var(--color-rule, rgba(15, 20, 25, 0.10));
  }
  .featured-head { margin-bottom: var(--space-lg, 3rem); display: flex; justify-content: space-between; align-items: baseline; }
  .featured-image-wrap { position: relative; }
  .featured-image {
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(180deg, rgba(31, 61, 46, 0.10), rgba(31, 61, 46, 0.30)),
      linear-gradient(135deg, #c8b89a 0%, #a89072 50%, #6e5a3e 100%);
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card, 8px);
  }
  .featured-chip {
    position: absolute; top: var(--space-md, 2rem); left: var(--space-md, 2rem);
    padding: 0.25rem 0.625rem;
    background: var(--color-accent, #8C5A3A);
    color: var(--color-on-accent, #FDFCF6);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: var(--radius-chip, 4px);
    z-index: 2;
  }
  .featured-image-label {
    position: absolute; bottom: var(--space-md, 2rem); left: var(--space-md, 2rem);
    color: var(--color-on-primary, #F4EFE0);
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    z-index: 1;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: var(--space-xl, 4rem);
    align-items: start;
  }
  .featured-body h3 {
    font-family: var(--font-serif, 'Newsreader', Georgia, serif);
    font-size: var(--text-3xl, 2rem);
    font-weight: 600;
    line-height: var(--leading-tight, 1.15);
    margin-bottom: var(--space-md, 2rem);
    letter-spacing: -0.015em;
  }
  .featured-lede {
    font-size: var(--text-lg, 1.125rem);
    line-height: var(--leading-normal, 1.55);
    color: var(--color-text, #0F1419);
    margin-bottom: var(--space-md, 2rem);
