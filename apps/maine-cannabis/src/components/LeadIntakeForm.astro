---
/**
 * LeadIntakeForm.astro
 *
 * Server-side-aware lead-capture form. Replaces the pure-mailto path of
 * LeadMailtoForm.astro with a controlled server-side intake. The
 * `data-endpoint` attribute (Cloudflare Worker URL) is opt-in: if not
 * set, the form falls back to the same mailto: behavior as
 * LeadMailtoForm.astro. This means existing call sites keep working
 * unchanged and the new path can be enabled per-page.
 *
 * Architecture (cycle 15 Stage 2):
 *   Browser POSTs JSON to a Cloudflare Worker (data-endpoint).
 *   The Worker validates Turnstile + email + honeypot, then HMAC-signs
 *   the payload and forwards to a private n8n webhook (W13 Lead Intake,
 *   out of scope of this component).
 *   The n8n webhook writes to mdg_leads and may send an autoresponder via
 *   Purelymail SMTP.
 *   The browser falls back to mailto: on any non-2xx, network error, or
 *   when data-endpoint is empty.
 *
 * Props:
 *   formId         REQUIRED. The `<form id>` and JS lookup key.
 *   leadTo         REQUIRED. The mailto: recipient address. Used by the
 *                  mailto: fallback path.
 *   leadSubject    REQUIRED. mailto: subject template. Same placeholder
 *                  convention as LeadMailtoForm (e.g. "{email}").
 *   leadBody       REQUIRED. mailto: body template. Same convention.
 *   formName       REQUIRED. snake_case event label. Emitted as
 *                  lead_capture.form_name in GA4. Keep stable.
 *   successPath    REQUIRED. Path to redirect to on success (both paths).
 *   endpoint       OPTIONAL. The server-side intake URL. Empty string
 *                  (default) forces the mailto: path.
 *   trackFields    OPTIONAL. Field names included in the GA4 event.
 *                  Defaults to ['stage', 'interest', 'service'].
 *   consentText    OPTIONAL. Privacy-policy acceptance text shown next
 *                  to the consent checkbox. Default is the standard
 *                  MDG "I agree to receive an email reply..." copy.
 *
 * New behavior vs. LeadMailtoForm:
 *   1. POST to data-endpoint with JSON body. Server replies with a
 *      redirect URL (data-redirect) on success; we navigate to it
 *      (or fall back to successPath). On non-2xx or network error, the
 *      mailto: path runs.
 *   2. Hidden attribution fields (page_path, utm_*, referrer) are read
 *      from window.location and document.referrer at submit time and
 *      included in the POST body.
 *   3. An explicit consent checkbox gates submit.
 *   4. The `lead_capture` GA4 event is emitted only after a validated server
 *      success response. Mailto paths emit `lead_mailto_open`, which measures
 *      a client launch but never claims delivery or receipt.
 *
 * The component name `LeadIntakeForm` is the canonical name for new
 * call sites. The legacy `LeadMailtoForm.astro` is kept as a thin
 * compatibility wrapper that renders `LeadIntakeForm` with endpoint=''.
 */

interface Props {
  formId: string;
  leadTo: string;
  leadSubject: string;
  leadBody: string;
  formName: string;
  successPath: string;
  endpoint?: string;
  trackFields?: string[];
  consentText?: string;
}

const {
  formId,
  leadTo,
  leadSubject,
  leadBody,
  formName,
  successPath,
  endpoint = '',
  trackFields = ['stage', 'interest', 'service'],
  consentText = 'I agree to receive an email reply with the requested PDF and acknowledge the Privacy Policy.',
} = Astro.props;
---

<form
  id={formId}
  class="lead-intake-form"
  data-endpoint={endpoint}
  data-lead-to={leadTo}
  data-lead-subject={leadSubject}
  data-lead-body={leadBody}
  data-form-name={formName}
  data-success-path={successPath}
  data-track-fields={trackFields.join(',')}
>
  <!-- Honeypot: invisible to humans, bots fill it. If populated, submission is silently dropped. -->
  <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;height:0;width:0;overflow:hidden;">
    <label for={`${formId}-website`}>Website</label>
    <input type="text" id={`${formId}-website`} name="website" tabindex="-1" autocomplete="off" />
  </div>
  <slot />
  <div class="form-group lead-intake-consent">
    <label for={`${formId}-consent`}>
      <input type="checkbox" id={`${formId}-consent`} name="consent" required value="1" />
      <span>{consentText}</span>
    </label>
  </div>
</form>

<script is:inline define:vars={{ formId }}>
  // LeadIntakeForm inline IIFE. Same pattern as LeadMailtoForm: read all
  // named fields, intercept submit, dispatch to either the server endpoint
  // or the mailto fallback. `lead_capture` fires only after the server
  // validates a success response; mailto navigation emits `lead_mailto_open`
  // because it cannot prove a message was sent or received.
  (function () {
    var form = document.getElementById(formId);
    if (!form) return;

    function escape(value) {
      if (value == null) return '';
      return String(value);
    }

    function readAttribution() {
      try {
        var url = new URL(window.location.href);
        return {
          page_path: window.location.pathname,
          referrer: document.referrer || '',
          utm_source: url.searchParams.get('utm_source') || '',
          utm_medium: url.searchParams.get('utm_medium') || '',
          utm_campaign: url.searchParams.get('utm_campaign') || '',
        };
      } catch (_) {
        return {
          page_path: window.location.pathname,
          referrer: document.referrer || '',
          utm_source: '',
          utm_medium: '',
          utm_campaign: '',
        };
      }
    }

    function fireGA4(form, formName, trackFields, eventName, transport) {
      try {
        if (typeof window.gtag !== 'function') return;
        // `lead_capture` is reserved for a validated server-side success.
        // Mailto and form-start paths use distinct event names and retain a
        // path label in the bounded `transport` parameter.
        var payload = Object.assign(
          { form_name: formName, page_path: window.location.pathname, transport: transport, transport_type: 'beacon' },
          readAttribution(),
        );
        trackFields.forEach(function (name) {
          try {
            var el = form.elements.namedItem(name);
            if (el && 'value' in el && el.value) {
              payload[name] = el.value;
            }
          } catch (_) {}
        });
        window.gtag('event', eventName, payload);
      } catch (_) {
        // Tracking must never break the actual form submit.
      }
    }

    function buildMailto(to, subjectTpl, bodyTpl, values) {
      function interpolate(s) {
        return s.replace(/\{([a-zA-Z0-9_-]+)\}/g, function (_m, key) {
          return values[key] != null ? values[key] : '';
        });
      }
      return 'mailto:' + encodeURIComponent(to)
        + '?subject=' + encodeURIComponent(interpolate(subjectTpl))
        + '&body=' + encodeURIComponent(interpolate(bodyTpl));
    }

    function readFields() {
      var values = {};
      try {
        var elements = form.elements;
        for (var i = 0; i < elements.length; i++) {
          var el = elements[i];
          if (!el.name) continue;
          values[el.name] = escape(el.value);
        }
      } catch (_) {}
      return values;
    }

    // Generate a fresh, random request_id (UUID v4) for ONE deliberate
    // submission. It is the server-side idempotency key: an exact transport
    // replay reuses the same request_id (and deduplicates), while a new
    // deliberate submission generates a new one. It is NOT derived from email,
    // page path, name, timestamp, IP, or user agent, and it is NOT persisted to
    // browser storage or used to track the user across page views.
    function newRequestId() {
      try {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') {
          return window.crypto.randomUUID();
        }
      } catch (_) {}
      // Secure fallback: build an RFC-4122 v4 UUID from crypto.getRandomValues.
      try {
        var bytes = new Uint8Array(16);
        window.crypto.getRandomValues(bytes);
        bytes[6] = (bytes[6] & 0x0f) | 0x40; // version 4
        bytes[8] = (bytes[8] & 0x3f) | 0x80; // variant 10
        var hex = [];
        for (var i = 0; i < 16; i++) {
          hex.push(('0' + bytes[i].toString(16)).slice(-2));
        }
        return hex[0] + hex[1] + hex[2] + hex[3] + '-' + hex[4] + hex[5] + '-' +
          hex[6] + hex[7] + '-' + hex[8] + hex[9] + '-' +
          hex[10] + hex[11] + hex[12] + hex[13] + hex[14] + hex[15];
      } catch (_) {
        return '';
      }
    }

    function navigateToSuccess() {
      var successPath = form.getAttribute('data-success-path') || '';
      if (successPath) {
        // 200ms delay so a server response (if any) can be read by GA4 first.
        setTimeout(function () { window.location.href = successPath; }, 200);
      }
    }

    // W13 incident containment: validate the server success contract. A
    // submission is successful ONLY when: data.ok === true, data.id is a
    // positive integer, and data.redirect (when supplied) is a safe
    // same-site path beginning with '/'. Anything else is an invalid 2xx.
    function isValidSuccessResponse(data) {
      if (!data || typeof data !== 'object') return false;
      if (data.ok !== true) return false;
      if (typeof data.id !== 'number' || !Number.isInteger(data.id) || data.id <= 0) return false;
      if (data.redirect !== undefined && data.redirect !== null) {
        if (typeof data.redirect !== 'string' || data.redirect.length === 0) return false;
        if (data.redirect.charAt(0) !== '/') return false;
        if (data.redirect.indexOf('//') === 0) return false;
        if (data.redirect.indexOf('://') !== -1) return false;
        // WHATWG URL treats /\ as protocol-relative; browsers strip leading
        // control chars (tab, newline). Reject backslashes and control chars.
        if (data.redirect.indexOf('\\') !== -1) return false;
        if (/[\x00-\x1f\x7f]/.test(data.redirect)) return false;
      }
      return true;
    }

    // W13 incident containment: show an accessible inline temporary-failure
    // message. Does NOT fire analytics, does NOT redirect, does NOT open
    // mailto. Form values are preserved (never cleared) and the submit
    // button remains enabled (never disabled), so the user can retry.
    function showTemporaryFailure() {
      var msgId = form.id + '-submit-error';
      var existing = document.getElementById(msgId);
      if (existing) {
        existing.hidden = false;
        return;
      }
      var msg = document.createElement('div');
      msg.id = msgId;
      msg.setAttribute('role', 'alert');
      msg.setAttribute('aria-live', 'polite');
      msg.className = 'lead-intake-error';
      msg.textContent = 'We couldn\u2019t confirm that your request was received. Please try again later or contact Maine Dispensary Guide directly.';
      form.appendChild(msg);
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      var endpoint = form.getAttribute('data-endpoint') || '';
      var to = form.getAttribute('data-lead-to') || '';
      var subjectTpl = form.getAttribute('data-lead-subject') || '';
      var bodyTpl = form.getAttribute('data-lead-body') || '';
      var formName = form.getAttribute('data-form-name') || '';
      var successPath = form.getAttribute('data-success-path') || '';
      var trackFields = (form.getAttribute('data-track-fields') || '').split(',').filter(Boolean);

      var values = readFields();

      // Require at least the email field — same as LeadMailtoForm.
      if (!values.email) {
        return;
      }
      // Require consent checkbox — must be checked.
      if (values.consent !== '1') {
        return;
      }
      // Honeypot: silently drop.
      if (values.website) {
        navigateToSuccess();
        return;
      }

      // Path 1: server-side intake.
      if (endpoint && endpoint.length > 0) {
        // #188: lead_form_start on intent; lead_capture already fires inside
        // the .then() after 2xx (see #197). Both use beacon transport.
        fireGA4(form, formName, trackFields, 'lead_form_start', 'server');
        // One fresh request_id per deliberate submission attempt. It travels in
        // the JSON body as the server-side idempotency key. A transport-level
        // retry of THIS fetch reuses the same payload (same request_id) so it
        // deduplicates; the next deliberate submit generates a new request_id.
        var requestId = newRequestId();
        var payload = Object.assign({}, values, readAttribution(), {
          request_id: requestId,
          ts: new Date().toISOString(),
        });
        try {
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }).then(function (response) {
            if (!response.ok) {
              throw new Error('non-2xx');
            }
            // Parse the body as JSON. An empty or malformed body is NOT a
            // success — it resolves to null so the contract check below fails.
            return response.json().catch(function () { return null; });
          }).then(function (data) {
            // W13 incident containment: only a fully validated contract is a
            // success. Invalid 2xx (empty body, malformed JSON, {}, ok:false,
            // missing/invalid id, unsafe redirect) shows a temporary-failure
            // message — no analytics, no redirect, no mailto.
            if (isValidSuccessResponse(data)) {
              // GA4 lead_capture fires AFTER the server confirms success with a
              // valid contract — attribution reflects actual conversions.
              fireGA4(form, formName, trackFields, 'lead_capture', 'server');
              if (typeof data.redirect === 'string' && data.redirect.length > 0) {
                window.location.href = data.redirect;
              } else {
                navigateToSuccess();
              }
            } else {
              showTemporaryFailure();
            }
          }).catch(function () {
            // Network error or non-2xx: fall back to mailto:.
            // DOCUMENTED BEHAVIOR (W13 incident): this path is unchanged.
            // A non-2xx response or network failure opens the user's mail
            // client with a pre-filled message, then redirects to successPath
            // after 800ms. This is the pre-existing fallback and is NOT the
            // same as the invalid-2xx containment above (which stays on page).
            // record mailto-client intent without treating it as a received lead.
            fireGA4(form, formName, trackFields, 'lead_mailto_open', 'mailto_fallback');
            window.location.href = buildMailto(to, subjectTpl, bodyTpl, values);
            setTimeout(function () {
              if (successPath) { window.location.href = successPath; }
            }, 800);
          });
          return;
        } catch (_) {
          // Synchronous fetch failure (rare): fall through to mailto:.
        }
      }

      // Path 2: mailto fallback. Opening a mail client is measurable intent,
      // not proof that the user sent or that MDG received a lead.
      fireGA4(form, formName, trackFields, 'lead_form_start', 'mailto');
      fireGA4(form, formName, trackFields, 'lead_mailto_open', 'mailto');
      setTimeout(function () {
        window.location.href = buildMailto(to, subjectTpl, bodyTpl, values);
        setTimeout(function () {
          if (successPath) { window.location.href = successPath; }
        }, 800);
      }, 150);
    });
  })();
</script>
