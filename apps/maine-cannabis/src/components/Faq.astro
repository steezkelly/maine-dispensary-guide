---
import UiFaq from '@network/ui/Faq';

interface FAQItem {
  question: string;
  answer: string;
}

interface ShortFAQItem {
  q: string;
  a: string;
}

interface Props {
  faqs?: FAQItem[];
  items?: FAQItem[];
  questions?: ShortFAQItem[];
  children?: any;
  // Sprint 78ab: when `true`, suppress the package's auto-emitted FAQPage
  // JSON-LD. Use this when the calling page composes its own
  // `<script type="application/ld+json">` block to avoid duplicate schema.
  withoutSchema?: boolean;
  citationLinks?: boolean;
  citationSourceIds?: number[];
}

const { faqs, items, questions, withoutSchema, citationLinks = false, citationSourceIds = [] } = Astro.props;
const normalizedFaqs = faqs ?? items ?? questions?.map(({ q, a }) => ({ question: q, answer: a }));
---

{normalizedFaqs ? (
  <UiFaq faqs={normalizedFaqs} withoutSchema={withoutSchema} citationLinks={citationLinks} citationSourceIds={citationSourceIds}>
    <slot />
  </UiFaq>
) : (
  <div class="faq-schema-wrapper">
    <slot />
  </div>
)}

<style>
  .faq-schema-wrapper {
    display: contents;
  }
</style>
