---
import { getEditorialNextStep } from '../../data/continuation/editorial-next-steps';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const rule = getEditorialNextStep(currentPath);
---

{rule && (
  <aside
    class="editorial-next-step"
    aria-labelledby={`next-step-${rule.id}`}
    data-continuation-id={rule.id}
    data-continuation-slot="editorial"
    data-continuation-relationship={rule.relationship}
  >
    <p class="editorial-next-step__eyebrow">{rule.eyebrow}</p>
    <h2 id={`next-step-${rule.id}`}>{rule.title}</h2>
    <p class="editorial-next-step__reason">{rule.reason}</p>
    <a
      class="editorial-next-step__link"
      href={rule.destinationPath}
      data-cta-id={`editorial-next-${rule.id}`}
    >
      Continue to the next step <span aria-hidden="true">→</span>
    </a>
  </aside>
)}

<style>
  .editorial-next-step {
    margin-block: var(--space-2xl) 0;
    padding: var(--space-lg) var(--space-md) var(--space-lg) var(--space-xl);
    border-left: 4px solid var(--color-primary);
  }

  .editorial-next-step__eyebrow {
    margin: 0 0 var(--space-xs);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: var(--leading-snug);
    text-transform: uppercase;
  }

  .editorial-next-step h2 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .editorial-next-step__reason {
    max-width: 68ch;
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-text-light);
    font-size: var(--text-base);
    line-height: var(--leading-loose);
  }

  .editorial-next-step__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-xs);
    color: var(--color-text);
    font-weight: 800;
    text-decoration-line: underline;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .editorial-next-step__link:hover {
    color: var(--color-primary);
  }

  .editorial-next-step__link:focus-visible {
    border-radius: 0.2rem;
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-next-step__link,
    .editorial-next-step__link::after {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .editorial-next-step {
      padding: var(--space-md) 0 var(--space-md) var(--space-md);
    }
  }
</style>
