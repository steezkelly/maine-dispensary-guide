---
/**
 * SiteHeader.astro — Top header + main navigation + theme toggle + search
 *
 * Extracted from Layout.astro (Sprint 73d refactor). Owns:
 *  - The 12 fixed botanical ornaments (PineTree + Leaf SVGs)
 *  - The reading progress bar
 *  - The desktop nav (logo, search, theme toggle, mobile menu trigger)
 *  - The 5-column "Browse by Topic" mega-menu (city, regional, business
 *    essentials, compliance, operations, tools, stay connected)
 *  - The "Business Tools" dropdown
 *  - Theme toggle (calls window.toggleTheme() — defined in inline script below)
 *  - Dropdown click/keyboard handling (inline script — must run early)
 *
 * Mobile menu state is driven by a hidden checkbox + label hack (no JS
 * for show/hide — pure CSS, works with prefers-reduced-motion). Closing
 * the menu and Escape-key handling is also inline below.
 */

import PineTree from '@network/ui/PineTree';
import Leaf from '@network/ui/Leaf';
import AnimatedBackdrop from '@network/ui/AnimatedBackdrop';
import Search from '@network/ui/Search';
import siteConfig from '../data/site-config.json';

const siteName = siteConfig.siteName;
---

<header id="site-header" role="banner">
  <div id="progress-container"><div id="progress-bar"></div></div>
  <!-- Animated aurora layer (subtle, behind nav) -->
  <AnimatedBackdrop variant="subtle" intensity={0.35} class="site-header-backdrop" />
  <nav id="site-nav" aria-label="Main Navigation">
    <a href="/" class="logo" aria-label={`${siteName} Home`}>
      <div class="logo-icons">
        <PineTree size={24} color="var(--color-primary)" class="logo-pine" />
        <Leaf size={20} color="var(--color-accent)" class="logo-leaf" />
      </div>
      <span>{siteName}</span>
    </a>

    <div class="nav-search-desktop"><Search /></div>

    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode" onclick="window.toggleTheme()">
        <div class="toggle-track">
          <div class="toggle-thumb">
            <span class="sun" aria-hidden="true">✦</span>
            <span class="moon" aria-hidden="true">◆</span>
          </div>
        </div>
      </button>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle mobile menu" />
      <label for="nav-toggle" class="nav-toggle-label" aria-hidden="true" id="mobile-menu-trigger"><span></span></label>
    </div>

    <div class="nav-links" id="navigation-menu" role="navigation">
      <button class="mobile-close-btn" aria-label="Close menu" id="mobile-close-btn"></button>
      <script is:inline>
        document.getElementById('mobile-close-btn').addEventListener('click', () => {
          document.getElementById('nav-toggle').checked = false;
        });
        document.getElementById('mobile-close-btn').addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            document.getElementById('nav-toggle').checked = false;
          }
        });
      </script>
      <div class="nav-search-mobile"><Search withData={false} /></div>
      <div class="nav-dropdown">
        <button class="dropbtn" aria-haspopup="true" aria-expanded="false" aria-label="Browse by Topic ▾">Browse by Topic ▾</button>
        <div class="dropdown-content multi-column">
          <div class="topic-group">
