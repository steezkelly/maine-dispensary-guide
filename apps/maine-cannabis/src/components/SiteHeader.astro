      </div>
      <div class="nav-dropdown">
        <button class="dropbtn" aria-haspopup="true" aria-expanded="false" aria-label="Business Tools ▾">Business Tools ▾</button>
        <div class="dropdown-content">
          <a href="/roi-calculator"><span aria-hidden="true">◆</span> ROI Calculator</a>
