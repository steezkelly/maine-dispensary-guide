      <a href="/resources">Vendor Directory</a>
      <a href="/learn">Consumer Guide</a>
      <a href="/about">About</a>
    </div>
  </nav>
</header>

<script is:inline>
  // Dropdown click + keyboard handling for the mega-menu.
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownBtns = document.querySelectorAll('.nav-dropdown .dropbtn');

    function closeAllDropdowns() {
      document.querySelectorAll('.nav-dropdown .dropdown-content.shown').forEach(c => c.classList.remove('shown'));
      document.querySelectorAll('.nav-dropdown .dropbtn[aria-expanded="true"]').forEach(b => b.setAttribute('aria-expanded', 'false'));
    }

    function toggleDropdown(btn) {
      const content = btn.nextElementSibling;
      const isShown = content.classList.contains('shown');
      closeAllDropdowns();
      // Open this one if it wasn't open
      if (!isShown) {
        content.classList.add('shown');
        btn.setAttribute('aria-expanded', 'true');
      }
    }

    dropdownBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown(btn);
      });
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleDropdown(btn);
        }
        if (e.key === 'Escape') {
          closeAllDropdowns();
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    });

    // Click outside closes dropdowns
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav-dropdown')) {
        closeAllDropdowns();
      }
    });

    // Escape key closes mobile menu
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const navToggle = document.getElementById('nav-toggle');
        if (navToggle && navToggle.checked) {
          navToggle.checked = false;
        }
      }
    });
  });
</script>

<style>
  /* Header backdrop — pinned to the header's box, behind the nav. */
  #site-header {
    position: sticky; /* matches Layout's #site-header */
    overflow: hidden;
  }
  /* The :global pseudo-selector is needed because the AnimatedBackdrop emits
     its own root class. Override position to fill the header instead of
     stretching from the parent section. */
  #site-header :global(.mdg-anim-backdrop--subtle) {
    position: absolute !important;
    inset: 0 !important;
    height: 100% !important;
    z-index: 0 !important;
    /* Aurora intensity already multiplied by 0.35 via intensity prop;
       we add another 0.8 layer to keep header readable. */
    opacity: 0.8;
  }
  /* Make sure the nav stays above the backdrop. */
  #site-nav { position: relative; z-index: 2; }
  #progress-container { position: relative; z-index: 3; }
</style>
