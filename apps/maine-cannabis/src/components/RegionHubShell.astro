---
/**
 * RegionHubShell.astro — shared chrome for the 5 town-cluster hub pages.
 *
 * Stage 1 (2026-07-08) extracted this from 5 duplicated stubs. All 5 hubs at
 * /guides/{region}-cannabis-guide render through this single component so
 * the CSS, FAQ JSON-LD, and verification trail stay in sync. Stage 2/3
 * editorial bodies live in the <slot /> of each hub file.
 *
 * Props:
 *   cluster       — entry from apps/maine-cannabis/src/data/cluster-regions.json
 *   clusterFaqs   — array of { q: string, a: string } for the FAQPage JSON-LD
 *   stageLabel    — short label rendered in the badge ('Stage 1 Foundation' /
 *                   'Stage 2 pilot' / 'Stage 3 roll-out'); derived from
 *                   cluster.stage if not provided
 *
 * Renders 5 sections in order:
 *   1. header (h1 + subtitle + meta chips)
 *   2. Callout: stage status + cross-link to /find-a-dispensary
 *   3. fact-box: cluster at-a-glance table
 *   4. <slot /> — Stage 2/3 editorial body lives here
 *   5. town directory
 *   6. FAQ + FAQPage JSON-LD
 *   7. sibling hub cross-links
 *   8. AutoRelated + verification badge + editorial-pair note
 */
interface ClusterGuide { name: string; summary: string; href: string; mapUrl: string; }
interface FaqItem { q: string; a: string; }
interface Cluster {
  name: string;
  display_name: string;
  slug: string;
  hub_href: string;
  lede: string;
  counties: string[];
  key_towns?: string[];
  guide_count: number;
  editorial_pilot: boolean;
  guides: ClusterGuide[];
}
interface Props {
  cluster: Cluster;
  clusterFaqs?: FaqItem[];
  stageLabel?: string;
}
const { cluster, clusterFaqs = [], stageLabel } = Astro.props as Props;
const resolvedStageLabel = stageLabel ?? (cluster.editorial_pilot ? 'Stage 2 pilot' : 'Stage 3 roll-out');
const hubIsShipped = (stageLabel ?? '').toLowerCase().includes('shipped') || (stageLabel ?? '').toLowerCase().includes('published');
const auditNote = hubIsShipped
  ? 'Stage 2 editorial body shipped 2026-07-08 — directory, primary-source registry, and verified editorial by Calvin Waters + Margaret Finch.'
  : cluster.editorial_pilot
  ? 'Stage 1 foundation — Stage 2 editorial body lands on this hub next. The directory, primary-source registry, and verification badge below are live now.'
  : 'Stage 1 foundation stub — directory + verification live; the 2,000+ word editorial body ships in Stage 3 with the two pilot hubs already shipped.';

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: clusterFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<style>
  .hub-stage-badge { display: inline-block; background: var(--color-accent); color: var(--color-background); padding: 0.35rem 0.85rem; border-radius: 1.25rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; }
  .hub-article-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-light); }
  .hub-cluster-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
  .hub-cluster-chip { background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.35rem 0.75rem; border-radius: 1rem; font-size: 0.8rem; color: var(--color-text); }
  .hub-fact-box { background: linear-gradient(135deg, rgba(88, 129, 87, 0.08) 0%, rgba(163, 177, 138, 0.06) 100%); padding: 1.75rem; border-radius: 1rem; border: 1px solid var(--color-border); position: relative; overflow: hidden; }
  .hub-fact-box::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: linear-gradient(90deg, var(--color-primary), var(--color-accent)); }
  .hub-fact-box h2 { margin-top: 0; font-size: 1.25rem; }
  .hub-fact-box table { margin: 0; width: 100%; border-collapse: collapse; }
  .hub-fact-box th, .hub-fact-box td { padding: 0.55rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  .hub-fact-box th { background: var(--color-background); }
  .hub-section { margin-bottom: 2.5rem; }
  .hub-section h2, .hub-section h3 { margin-top: 1.5rem; }
  .hub-section h2:first-child { margin-top: 0; }
  .hub-directory { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .hub-directory .hub-guide-card { background: var(--color-surface); padding: 1.25rem; border-radius: 1rem; border: 1px solid var(--color-border); }
  .hub-directory .hub-guide-card h3 { margin: 0 0 0.5rem; font-family: var(--font-serif); font-size: 1.0625rem; color: var(--color-text); }
  .hub-directory .hub-guide-card p { margin: 0 0 0.85rem; font-size: 0.875rem; color: var(--color-text-light); line-height: 1.5; }
  .hub-guide-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .hub-btn-guide, .hub-btn-map { display: inline-flex; align-items: center; justify-content: center; min-height: 2.25rem; padding: 0.5rem 0.75rem; border-radius: 0.5rem; font-weight: 600; text-decoration: none; font-size: 0.8125rem; }
  .hub-btn-guide { background: var(--color-primary); color: var(--color-background); }
  .hub-btn-map { border: 1px solid var(--color-primary); color: var(--color-primary); }
  .hub-sibling { background: var(--color-surface); padding: 1.25rem; border-radius: 1rem; border: 1px solid var(--color-border); }
  .hub-sibling h3 { margin: 0 0 0.25rem; font-size: 1rem; font-family: var(--font-serif); }
  .hub-sibling p { margin: 0; font-size: 0.8125rem; color: var(--color-text-light); }
  .hub-further-reading { background: rgba(88, 129, 87, 0.05); padding: 1.5rem; border-radius: 1rem; margin-top: 3rem; }
  .hub-further-reading h2 { margin-top: 0; font-size: 1.25rem; }
  .hub-editorial-note { font-size: 0.875rem; color: var(--color-text-light); margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  [data-theme="dark"] .hub-directory .hub-guide-card, [data-theme="dark"] .hub-sibling { background: var(--color-surface); }
</style>

<section class="hub-section">
  <div class="hub-article-header">
    <span class="hub-stage-badge">◆ {resolvedStageLabel}</span>
    <h1>{cluster.display_name} Cannabis Guide</h1>
    <p class="hub-subtitle">{cluster.lede}</p>
    <div class="hub-cluster-meta">
      <span class="hub-cluster-chip">{cluster.guide_count} guide references</span>
      <span class="hub-cluster-chip">{cluster.counties.length} counties</span>
      {cluster.editorial_pilot && <span class="hub-cluster-chip">Pilot hub</span>}
    </div>
  </div>

  <slot name="audit-callout">
    <div style="background: rgba(88, 129, 87, 0.06); border-left: 3px solid var(--color-primary); padding: 1rem 1.25rem; border-radius: 0 0.5rem 0.5rem 0; margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.6;">
      <strong>Stage status.</strong> {auditNote} Cross-reference: <a href="/find-a-dispensary">/find-a-dispensary</a> deep-links its region headings here.
    </div>
  </slot>
</section>

<section class="hub-fact-box hub-section">
  <h2>{cluster.display_name} — At a Glance</h2>
  <table aria-label="Cluster overview">
    <thead><tr><th scope="col">Field</th><th scope="col">Value</th></tr></thead>
    <tbody>
      <tr><td><strong>Hub Slug</strong></td><td><code>/guides/{cluster.slug}</code></td></tr>
      <tr><td><strong>Guide References</strong></td><td>{cluster.guide_count} (towns + operator profiles)</td></tr>
      <tr><td><strong>Counties Covered</strong></td><td>{cluster.counties.join(', ')}</td></tr>
      <tr><td><strong>Editorial Stage</strong></td><td>{resolvedStageLabel}</td></tr>
      <tr><td><strong>Primary Source</strong></td><td><a href="https://www.maine.gov/dafs/ocp/open-data/adult-use/licensee-search" target="_blank" rel="noopener noreferrer">OCP Adult-Use Licensee CSV</a></td></tr>
    </tbody>
  </table>
</section>

<slot />

<section class="hub-section">
  <h2>Town directory — {cluster.display_name}</h2>
  <p>Every guide reference below is part of the {cluster.display_name} cluster. Each card links to the published guide and a live map search.</p>
  <div class="hub-directory">
    {cluster.guides.map((g) => (
      <article class="hub-guide-card">
        <h3>{g.name}</h3>
        <p>{g.summary}</p>
        <div class="hub-guide-actions">
          <!-- analytics:cta-injected id=cta-inline-RegionHubShell-01 -->
<a href={g.href} class="hub-btn-guide" data-cta-id="cta-inline-RegionHubShell-01">Read guide</a>
          <!-- analytics:cta-injected id=cta-inline-RegionHubShell-02 -->
<a href={g.mapUrl} class="hub-btn-map" target="_blank" rel="noopener noreferrer" data-cta-id="cta-inline-RegionHubShell-02">Map search</a>
        </div>
      </article>
    ))}
  </div>
</section>

{clusterFaqs.length > 0 && (
  <section class="hub-section">
    <h2>Frequently asked questions</h2>
    <div class="hub-faq-list">
      {clusterFaqs.map((f, i) => (
        <details class="hub-faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
<style>
  .hub-faq-list { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .hub-faq-item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1rem 1.25rem; }
  .hub-faq-item summary { font-weight: 600; color: var(--color-text); cursor: pointer; }
  .hub-faq-item p { margin: 0.75rem 0 0; color: var(--color-text-light); line-height: 1.6; }
</style>

<section class="hub-section">
  <h2>Sibling regional hubs</h2>
  <div class="hub-directory">
    <slot name="siblings" />
  </div>
</section>

<section class="hub-further-reading">
  <slot name="related" />
</section>

<section class="hub-section">
  <div style="font-size: 0.875rem; color: var(--color-text-light);">
    <span style="color: var(--color-accent);">◆</span>
    Stage 1 foundation stub registered <strong>2026-07-08</strong> against <a href="https://www.maine.gov/dafs/ocp/open-data/adult-use/licensee-search" target="_blank" rel="noopener noreferrer">OCP Adult-Use Licensee CSV</a> + Maine Dispensary Guide <a href="/guides/maine-cannabis-opt-in-tracker">Opt-In Tracker</a>. The Stage 2/3 editorial body is reviewed by <strong>Calvin Waters + Margaret Finch</strong> per the publisher-managed byline pattern (see <a href="/about/corrections">/about/corrections</a>).
  </div>
</section>

<p class="hub-editorial-note"><strong>Editorial note.</strong> This is part of the Maine Dispensary Guide editorial corpus. Every material correction is documented in our public <a href="/about/corrections" style="color: var(--color-text); text-decoration: underline;">Editorial Corrections Log</a> with the primary source that confirms the fix. See <a href="/about/authors" style="color: var(--color-text); text-decoration: underline;">/about/authors</a> for the byline + reviewer pair.</p>

{faqJsonLd !== '{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[]}' && (
  <script type="application/ld+json" set:html={faqJsonLd} is:inline></script>
)}
