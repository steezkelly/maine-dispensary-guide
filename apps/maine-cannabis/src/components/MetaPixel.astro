---
/**
 * MetaPixel.astro — conditional Meta Pixel loader + event helper.
 *
 * Renders nothing (and loads no third-party script) unless a pixel ID is
 * passed. This keeps the funnel page clean before the pixel exists and
 * avoids any tracker on pages that don't need it.
 *
 * Usage:
 *   <MetaPixel pixelId={funnelConfig.metaPixelId} />
 *
 * Then fire events from page scripts via the global `fbq` (guarded):
 *   window.fbq?.('track', 'Lead');
 *   window.fbq?.('track', 'Purchase', { value: 1.0, currency: 'USD' });
 */
interface Props {
  pixelId: string;
}
const { pixelId } = Astro.props;
const enabled = typeof pixelId === 'string' && pixelId.trim().length > 0;
---

{enabled && (
  <script is:inline define:vars={{ pid: pixelId }}>
    // Meta Pixel base code (standard, unmodified).
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', pid);
    fbq('track', 'PageView');
  </script>
)}
{enabled && (
  <noscript>
    <img
      height="1"
      width="1"
      style="display:none"
      alt=""
      src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
    />
  </noscript>
)}
