---
// SiteHealthStrip.astro
//
// Compact, homepage-facing version of the /site-health "At a glance" dashboard.
// Renders a horizontal strip of 6 stat cards, each anchor-linking to the full
// editorial dashboard at /site-health. The numbers are computed once (via
// lib/page-stats.ts + authors.json + the heroes dir) by the consuming page and
// passed in as a single `stats` prop, so this component does NO filesystem
// traversal itself and every consumer stays a single source of truth.
//
// Values are formatted here to match the /site-health dashboard exactly:
//   - Words published:  Math.round(totalWords / 1000) + "K"
//   - Avg words/page:   Math.round(avgWordsPerPage).toLocaleString()
// so the strip and the dashboard never drift.

export interface SiteHealthStats {
  totalPages: number;
  contentPages: number;
  totalWords: number;
  heroImages: number;
  bylineAuthors: number;
  avgWordsPerPage: number;
}

interface Props {
  stats: SiteHealthStats;
}

const { stats } = Astro.props;

const cards = [
  {
    num: stats.totalPages.toLocaleString(),
    label: 'Total pages',
    sub: 'indexable + utility',
    anchor: 'content-breakdown',
  },
  {
    num: stats.contentPages.toLocaleString(),
    label: 'Content pages',
    sub: 'guides, posts, founders, downloads',
    anchor: 'content-breakdown',
  },
  {
    num: `${Math.round(stats.totalWords / 1000)}K`,
    label: 'Words published',
    sub: 'across the whole site',
    anchor: 'content-breakdown',
  },
  {
    num: stats.heroImages.toLocaleString(),
    label: 'Hero images',
    sub: 'photography, art, illustrations',
    anchor: 'at-a-glance',
  },
  {
    num: stats.bylineAuthors.toLocaleString(),
    label: 'Byline authors',
    sub: 'named editorial contributors',
    anchor: 'editorial-team',
  },
  {
    num: Math.round(stats.avgWordsPerPage).toLocaleString(),
    label: 'Avg words / page',
    sub: 'content pages only',
    anchor: 'content-breakdown',
  },
];
---

<section class="site-health-strip" aria-labelledby="site-health-strip-heading">
  <div class="shs-inner">
    <div class="shs-head">
      <p class="shs-eyebrow" id="site-health-strip-heading">Editorial transparency</p>
      <p class="shs-intro">
        Every number below is computed from the source tree on each build — no spin, no stale spreadsheet.
        <a href="/site-health" class="shs-more">See the full editorial dashboard →</a>
      </p>
    </div>
    <div class="shs-grid">
      {cards.map(c => (
        <a class="shs-card card-elev-glow" href={`/site-health#${c.anchor}`}>
          <span class="shs-num">{c.num}</span>
          <span class="shs-label">{c.label}</span>
          <span class="shs-sub">{c.sub}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .site-health-strip {
    max-width: var(--max-width);
    margin: var(--space-2xl) auto;
    padding: 0 var(--space-md);
  }
  .shs-head {
    max-width: 720px;
    margin: 0 auto var(--space-lg);
    text-align: center;
  }
  .shs-eyebrow {
    color: var(--color-primary);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: var(--text-xs);
    font-weight: 600;
    margin: 0 0 var(--space-xs);
  }
  .shs-intro {
    font-size: var(--text-base);
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
  }
  .shs-more {
    display: inline-block;
    margin-top: var(--space-xs);
    color: var(--color-link);
    font-weight: 600;
    text-decoration: none;
  }
  .shs-more:hover { text-decoration: underline; }
  .shs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }
  .shs-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .shs-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--elev-3-shadow), var(--elev-glow);
  }
  .shs-num {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .shs-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }
  .shs-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-light);
    margin-top: 0.4rem;
    line-height: 1.4;
  }
  @media (max-width: 600px) {
    .shs-grid { grid-template-columns: repeat(2, 1fr); }
    .shs-num { font-size: 1.9rem; }
  }
</style>
