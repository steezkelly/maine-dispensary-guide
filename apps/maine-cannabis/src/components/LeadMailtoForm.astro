---
/**
 * LeadMailtoForm.astro (cycle 15 Stage 2 compatibility shim)
 *
 * The original mailto:-based lead-capture form. As of cycle 15, this
 * component is a thin wrapper around LeadIntakeForm.astro with
 * `endpoint=""` so the existing 6+ call sites keep working unchanged.
 *
 * For new pages, use LeadIntakeForm directly with a `endpoint` URL
 * (Cloudflare Worker) for the server-side intake path. This shim is
 * kept only as a compatibility surface.
 *
 * Props: identical to the original LeadMailtoForm. The component name
 * is preserved because 6+ pages import it. New code should not import
 * from this path; it should import LeadIntakeForm directly.
 */

import LeadIntakeForm from './LeadIntakeForm.astro';

interface Props {
  formId: string;
  leadTo: string;
  leadSubject: string;
  leadBody: string;
  formName: string;
  successPath: string;
  trackFields?: string[];
}

const {
  formId,
  leadTo,
  leadSubject,
  leadBody,
  formName,
  successPath,
  trackFields = ['stage', 'interest', 'service'],
} = Astro.props;
---

<LeadIntakeForm
  formId={formId}
  leadTo={leadTo}
  leadSubject={leadSubject}
  leadBody={leadBody}
  formName={formName}
  successPath={successPath}
  endpoint=""
  trackFields={trackFields}
>
  <slot />
</LeadIntakeForm>
