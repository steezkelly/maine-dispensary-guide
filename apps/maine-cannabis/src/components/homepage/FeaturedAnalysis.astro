---
interface Story {
  title: string;
  href: string;
  date: string;
  image: { src: string; alt: string };
  paragraphs: string[];
  figure?: { label: string; value: string; source: string; sourceHref: string };
}

interface Props {
  story: Story;
}

const { story } = Astro.props;
const displayDate = new Date(`${story.date}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---

<section class="featured-section editorial-section" aria-labelledby="featured-title">
  <p class="section-eyebrow">Featured analysis</p>
  <article class="featured-analysis">
    <a class="featured-analysis__image-link" href={story.href} aria-label={`Read ${story.title}`}>
      <img src={story.image.src} alt={story.image.alt} loading="eager" />
    </a>
    <div class="featured-analysis__body">
      <p class="featured-analysis__date"><time datetime={story.date}>{displayDate}</time></p>
      <h2 id="featured-title"><a href={story.href}>{story.title}</a></h2>
      {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      {story.figure && (
        <dl class="featured-analysis__figure">
          <dt>{story.figure.label}</dt>
          <dd>{story.figure.value}</dd>
          <dd><a class="editorial-text-link" href={story.figure.sourceHref}>{story.figure.source}</a></dd>
        </dl>
      )}
      <a class="editorial-text-link" href={story.href}>Read the analysis <span aria-hidden="true">→</span></a>
    </div>
  </article>
</section>

<style>
  .featured-analysis { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem); align-items: start; }
  .featured-analysis__image-link { display: block; }
  img { display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .featured-analysis__date { margin: 0; color: var(--color-text-light); font-size: 0.875rem; }
  h2 { margin: 0.5rem 0 1rem; font-family: var(--font-serif); font-size: clamp(1.8rem, 3.5vw, 3rem); line-height: 1.04; }
  h2 a { color: inherit; text-decoration: none; }
  .featured-analysis__body > p:not(.featured-analysis__date) { color: var(--color-text-light); line-height: 1.6; }
  .featured-analysis__figure { display: grid; grid-template-columns: 1fr auto; gap: 0.4rem 1rem; margin: 1.5rem 0; padding-block: 1rem; border-block: 1px solid var(--color-rule); }
  .featured-analysis__figure dt, .featured-analysis__figure dd { margin: 0; }
  .featured-analysis__figure dt, .featured-analysis__figure dd:last-child { color: var(--color-text-light); font-size: 0.8125rem; }
  .featured-analysis__figure dd:nth-child(2) { font-family: var(--font-serif); font-size: 1.5rem; font-variant-numeric: tabular-nums; }
  .featured-analysis__figure dd:last-child { grid-column: 1 / -1; }
  @media (max-width: 768px) { .featured-analysis { grid-template-columns: 1fr; } }
</style>