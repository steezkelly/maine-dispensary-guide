---
interface EvidenceItem {
  label: string;
  value: string;
  source: string;
  href: string;
}

interface Props {
  items: EvidenceItem[];
}

const { items } = Astro.props;
---

<section class="evidence-strip editorial-section" aria-labelledby="evidence-title">
  <p class="section-eyebrow">Current market evidence</p>
  <h2 id="evidence-title">The operating picture, in source-backed numbers.</h2>
  <dl class="evidence-strip__list">
    {items.map((item) => (
      <div class="evidence-strip__row">
        <dt>{item.label}</dt>
        <dd class="evidence-strip__value">{item.value}</dd>
        <dd class="evidence-strip__source"><a class="editorial-text-link" href={item.href}>{item.source}</a></dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .evidence-strip__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .evidence-strip__row {
    padding: 1.25rem 1rem;
    border-block-start: 1px solid var(--color-rule);
  }
  .evidence-strip__row:not(:first-child) { border-block-start: 0; }
  @media (min-width: 720px) {
    .evidence-strip__list { border-block-start: 1px solid var(--color-rule); }
    .evidence-strip__row {
      padding: 1.25rem 1.25rem;
      border-block-start: 0;
      border-inline-start: 1px solid var(--color-rule);
    }
    .evidence-strip__row:first-child { border-inline-start: 0; }
  }
  .evidence-strip__row dt { margin: 0; color: var(--color-text-light); font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .evidence-strip__value { margin: 0.25rem 0 0.5rem; font-family: var(--font-serif); font-size: clamp(1.75rem, 4vw, 2.5rem); font-variant-numeric: tabular-nums; line-height: 1; }
  .evidence-strip__source { margin: 0; font-size: 0.875rem; color: var(--color-text-light); }
</style>