{
  "name": "@network/maine-cannabis",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node -e \"require('fs').rmSync('.vercel/output',{recursive:true,force:true})\" && NODE_PATH=../node_modules astro build && node -e \"const fs=require('fs');const src='.vercel/output/static';const dst='../../dist';if(fs.existsSync(src)){fs.rmSync(dst,{recursive:true,force:true});fs.cpSync(src,dst,{recursive:true});console.log('Copied clean output to '+dst);}\"",
    "preview": "astro preview",
    "typecheck": "astro check",
    "verify:pre-push": "node ../../scripts/git/pre-push-verify.cjs",
    "verify:pre-push:fast": "node ../../scripts/git/pre-push-verify.cjs --fast-only",
    "hooks:install": "node ../../scripts/git/install-hooks.cjs",
    "health-check": "node ./scripts/health-check.cjs",
    "check:sitemap-xml": "node ./scripts/build/check-sitemap-xml.cjs",
    "check:sitemap-postprocess": "node ./scripts/build/sitemap-postprocess.test.mjs",
    "check:hrefs": "node ./scripts/content/check-malformed-hrefs.cjs",
    "check:hrefs:test": "node ./scripts/content/check-malformed-hrefs.test.cjs",
    "check:directory-coverage:test": "node ./scripts/content/check-directory-coverage.test.cjs",
    "check:build-warnings": "node ./scripts/build/check-build-warnings.cjs",
    "check:content-health": "node ./scripts/content/check-content-health.cjs",
    "check:content-health:regression": "node ./scripts/content/check-content-health-regression.cjs",
    "check:content-health:test": "node ./scripts/content/check-content-health.test.cjs",
    "check:docs-vs-code": "node ./scripts/content/check-docs-vs-code.cjs",
    "ci-check": "node ./scripts/ci-checks.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/mdx": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@astrojs/vercel": "^10.0.1",
    "@fal-ai/client": "^1.9.5",
    "@network/config": "*",
    "@network/content-types": "*",
    "@network/design-system": "*",
    "@network/layouts": "*",
    "@network/ui": "*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.0.5",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3"
  }
}
